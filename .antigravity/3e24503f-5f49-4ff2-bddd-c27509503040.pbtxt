        instruction: "import { RoleCode } from \'../types\';\n\nexport interface CadreRoleInfo {\n  role: RoleCode;\n  title: string;\n  badgeName: string;\n  emoji: string;\n  shortEmoji: string;\n  accentColor: string;\n  gradientBg: string;\n  borderTone: string;\n  badgeLevel: string;\n  motto: string;\n  duty: string;\n}\n\nexport const CADRE_ROLES_INFO: Record<RoleCode, CadreRoleInfo> = {\n  LT: {\n    role: \'LT\',\n    title: \'L\341\273\233p tr\306\260\341\273\237ng\',\n    badgeName: \'Ch\341\273\211 Huy Tr\306\260\341\273\237ng 10A5\',\n    emoji: \'\360\237\221\221\',\n    shortEmoji: \'\360\237\221\221\',\n    accentColor: \'#D97706\', // Gold / Amber\n    gradientBg: \'from-amber-500/20 via-amber-500/10 to-transparent\',\n    borderTone: \'border-amber-500/40\',\n    badgeLevel: \'Huy hi\341\273\207u Ho\303\240ng Kim \360\237\214\237\',\n    motto: \'G\306\260\306\241ng m\341\272\253u - Quy\341\272\277t \304\221o\303\241n - \304\220\341\273\223ng h\303\240nh c\303\271ng t\341\272\255p th\341\273\203\',\n    duty: \'\304\220i\341\273\201u h\303\240nh n\341\273\201 n\341\272\277p chung to\303\240n l\341\273\233p, ph\341\273\221i h\341\273\243p gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m & \304\221\303\264n \304\221\341\273\221c ban c\303\241n s\341\273\261.\'\n  },\n  BT: {\n    role: \'BT\',\n    title: \'B\303\255 th\306\260 Chi \304\221o\303\240n\',\n    badgeName: \'Ng\341\273\215n C\341\273\235 Phong Tr\303\240o\',\n    emoji: \'\360\237\232\251\',\n    shortEmoji: \'\360\237\232\251\',\n    accentColor: \'#E11D48\', // Crimson / Rose\n    gradientBg: \'from-rose-500/20 via-rose-500/10 to-transparent\',\n    borderTone: \'border-rose-500/40\',\n    badgeLevel: \'Huy hi\341\273\207u H\341\273\223ng Ng\341\273\215c \360\237\224\245\',\n    motto: \'Nhi\341\273\207t huy\341\272\277t - S\303\241ng t\341\272\241o - Ti\303\252n phong h\303\240nh \304\221\341\273\231ng\',\n    duty: \'Ph\341\273\245 tr\303\241ch c\303\264ng t\303\241c \304\220o\303\240n, phong tr\303\240o thanh ni\303\252n, thi \304\221ua 26/3, ho\341\272\241t \304\221\341\273\231ng ngo\303\240i gi\341\273\235.\'\n  },\n  LP_HT: {\n    role: \'LP_HT\',\n    title: \'L\341\273\233p ph\303\263 H\341\273\215c t\341\272\255p\',\n    badgeName: \'H\341\273\215c Gi\341\272\243 10A5\',\n    emoji: \'\360\237\223\226\',\n    shortEmoji: \'\360\237\223\226\',\n    accentColor: \'#059669\', // Emerald\n    gradientBg: \'from-emerald-500/20 via-emerald-500/10 to-transparent\',\n    borderTone: \'border-emerald-500/40\',\n    badgeLevel: \'Huy hi\341\273\207u L\341\273\245c B\341\272\243o \360\237\214\277\',\n    motto: \'Ki\303\252n tr\303\254 - V\341\273\257ng v\303\240ng - Chinh ph\341\273\245c tri th\341\273\251c\',\n    duty: \'Theo d\303\265i vi\341\273\207c chu\341\272\251n b\341\273\213 b\303\240i v\341\273\237, ki\341\273\203m tra b\303\240i t\341\272\255p 15 ph\303\272t \304\221\341\272\247u gi\341\273\235, th\303\272c \304\221\341\272\251y \304\221\303\264i b\341\272\241n c\303\271ng ti\341\272\277n.\'\n  },\n  LP_LD: {\n    role: \'LP_LD\',\n    title: \'L\341\273\233p ph\303\263 Lao \304\221\341\273\231ng\',\n    badgeName: \'Chi\341\272\277n Binh N\304\203ng \304\220\341\273\231ng\',\n    emoji: \'\342\232\241\',\n    shortEmoji: \'\342\232\241\',\n    accentColor: \'#D97706\', // Orange / Amber\n    gradientBg: \'from-orange-500/20 via-orange-500/10 to-transparent\',\n    borderTone: \'border-orange-500/40\',\n    badgeLevel: \'Huy hi\341\273\207u \303\201nh Tia Ch\341\273\233p \342\232\241\',\n    motto: \'S\341\272\241ch \304\221\341\272\271p - Chu \304\221\303\241o - Tr\303\241ch nhi\341\273\207m v\303\254 l\341\273\233p h\341\273\215c xanh\',\n    duty: \'Ph\303\242n c\303\264ng tr\341\273\261c nh\341\272\255t, b\341\272\243o qu\341\272\243n b\303\240n gh\341\272\277, qu\341\272\241t \304\221\303\250n, c\306\241 s\341\273\237 v\341\272\255t ch\341\272\245t ph\303\262ng h\341\273\215c.\'\n  },\n  TT: {\n    role: \'TT\',\n    title: \'T\341\273\225 tr\306\260\341\273\237ng\',\n    badgeName: \'Th\341\273\247 L\304\251nh T\341\273\225 Emulation\',\n    emoji: \'\360\237\233\241\357\270\217\',\n    shortEmoji: \'\360\237\233\241\357\270\217\',\n    accentColor: \'#2563EB\', // Sapphire\n    gradientBg: \'from-blue-500/20 via-blue-500/10 to-transparent\',\n    borderTone: \'border-blue-500/40\',\n    badgeLevel: \'Huy hi\341\273\207u Lam Th\341\272\241ch \360\237\233\241\357\270\217\',\n    motto: \'B\303\241m s\303\241t - C\303\264ng t\303\242m - \304\220o\303\240n k\341\272\277t t\341\273\225 vi\303\252n\',\n    duty: \'Theo d\303\265i n\341\273\201 n\341\272\277p h\303\240ng ng\303\240y c\341\273\247a 10-11 th\303\240nh vi\303\252n trong t\341\273\225, nh\341\272\257c nh\341\273\237 v\303\240 ghi nh\341\272\255n c\303\264ng b\341\272\261ng.\'\n  },\n  GV: {\n    role: \'GV\',\n    title: \'Gi\303\241o vi\303\252n Ch\341\273\247 nhi\341\273\207m\',\n    badgeName: \'Ng\306\260\341\273\235i C\341\272\247m L\303\241i Y\303\252u Th\306\260\306\241ng\',\n    emoji: \'\360\237\216\223\',\n    shortEmoji: \'\360\237\216\223\',\n    accentColor: \'#7C3AED\', // Purple\n    gradientBg: \'from-purple-500/20 via-purple-500/10 to-transparent\',\n    borderTone: \'border-purple-500/40\',\n    badgeLevel: \'Ban C\341\273\221 V\341\272\245n \360\237\214\237\',\n    motto: \'T\341\272\255n t\303\242m - Th\341\272\245u hi\341\273\203u - \304\220\341\273\213nh h\306\260\341\273\233ng t\306\260\306\241ng lai\',\n    duty: \'Qu\341\272\243n l\303\275 to\303\240n di\341\273\207n n\341\273\201 n\341\272\277p, ph\303\252 duy\341\273\207t gi\341\272\243i tr\303\254nh, \304\221\303\241nh gi\303\241 x\341\272\277p lo\341\272\241i thi \304\221ua tu\341\272\247n v\303\240 th\303\241ng.\'\n  },\n  HS: {\n    role: \'HS\',\n    title: \'H\341\273\215c sinh 10A5\',\n    badgeName: \'Th\303\240nh vi\303\252n T\341\273\217a S\303\241ng\',\n    emoji: \'\342\234\250\',\n    shortEmoji: \'\342\234\250\',\n    accentColor: \'#4F46E5\', // Indigo\n    gradientBg: \'from-indigo-500/10 via-indigo-500/5 to-transparent\',\n    borderTone: \'border-token\',\n    badgeLevel: \'Ng\303\264i Sao Tri\341\273\203n V\341\273\215ng \342\255\220\',\n    motto: \'N\341\273\227 l\341\273\261c m\341\273\227i ng\303\240y - T\341\273\261 tin kh\341\272\263ng \304\221\341\273\213nh m\303\254nh\',\n    duty: \'Ch\341\272\245p h\303\240nh nghi\303\252m t\303\272c n\341\273\231i quy tr\306\260\341\273\235ng l\341\273\233p, r\303\250n luy\341\273\207n h\341\273\215c t\341\272\255p v\303\240 gi\341\273\257 g\303\254n n\341\273\201 n\341\272\277p v\304\203n minh.\'\n  }\n};\n\nexport interface StudentAchievementBadge {\n  id: string;\n  title: string;\n  emoji: string;\n  description: string;\n  criteria: string;\n  category: \'discipline\' | \'academic\' | \'diligence\' | \'spirit\';\n  accentColor: string;\n}\n\nexport const STUDENT_ACHIEVEMENTS: StudentAchievementBadge[] = [\n  {\n    id: \'badge_iron_discipline\',\n    title: \'K\341\273\267 Lu\341\272\255t Th\303\251p\',\n    emoji: \'\360\237\233\241\357\270\217\',\n    description: \'Gi\341\273\257 tr\341\273\215n v\341\272\271n 100 \304\221i\341\273\203m, kh\303\264ng vi ph\341\272\241m b\341\272\245t k\341\273\263 n\341\273\231i quy n\303\240o trong tu\341\272\247n.\',\n    criteria: \'100 \304\221i\341\273\203m tu\341\272\247n & 0 l\341\273\227i\',\n    category: \'discipline\',\n    accentColor: \'#059669\'\n  },\n  {\n    id: \'badge_punctual_master\',\n    title: \'Chi\341\272\277n Th\341\272\247n \304\220\303\272ng Gi\341\273\235\',\n    emoji: \'\342\217\260\',\n    description: \'Chuy\303\252n c\341\272\247n tuy\341\273\207t \304\221\341\273\221i, kh\303\264ng tr\341\273\205 gi\341\273\235 h\341\273\215c hay gi\341\273\235 ch\303\240o c\341\273\235.\',\n    criteria: \'0 l\341\272\247n \304\221i mu\341\273\231n\',\n    category: \'discipline\',\n    accentColor: \'#2563EB\'\n  },\n  {\n    id: \'badge_active_spirit\',\n    title: \'Ng\303\264i Sao S\303\241ng T\341\272\241o\',\n    emoji: \'\360\237\214\237\',\n    description: \'T\303\255ch c\341\273\261c tham gia ho\341\272\241t \304\221\341\273\231ng l\341\273\233p, phong tr\303\240o \304\220o\303\240n v\303\240 sinh ho\341\272\241t t\341\272\255p th\341\273\203.\',\n    criteria: \'N\304\203ng n\341\273\225 phong tr\303\240o\',\n    category: \'spirit\',\n    accentColor: \'#E11D48\'\n  },\n  {\n    id: \'badge_academic_spark\',\n    title: \'Ch\304\203m Ch\341\273\211 Chuy\303\252n T\303\242m\',\n    emoji: \'\360\237\223\232\',\n    description: \'Lu\303\264n chu\341\272\251n b\341\273\213 b\303\240i \304\221\341\272\247y \304\221\341\273\247, ghi ch\303\251p c\341\272\251n th\341\272\255n v\303\240 ch\303\272 \303\275 nghe gi\341\272\243ng.\',\n    criteria: \'\304\220\341\272\247y \304\221\341\273\247 b\303\240i v\341\273\237\',\n    category: \'academic\',\n    accentColor: \'#D97706\'\n  },\n  {\n    id: \'badge_green_classroom\',\n    title: \'Hi\341\273\207p S\304\251 M\303\264i Tr\306\260\341\273\235ng\',\n    emoji: \'\360\237\214\277\',\n    description: \'Gi\341\273\257 g\303\254n v\341\273\207 sinh chung, b\303\240n gh\341\272\277 ng\304\203n n\341\272\257p v\303\240 ti\341\272\277t ki\341\273\207m \304\221i\341\273\207n qu\341\272\241t.\',\n    criteria: \'\303\235 th\341\273\251c v\341\273\207 sinh t\341\273\221t\',\n    category: \'diligence\',\n    accentColor: \'#10B981\'\n  },\n  {\n    id: \'badge_streak_master\',\n    title: \'B\341\272\245t Kh\341\272\243 Chi\341\272\277n B\341\272\241i\',\n    emoji: \'\360\237\224\245\',\n    description: \'Duy tr\303\254 x\341\272\277p lo\341\272\241i T\341\273\221t li\303\252n ti\341\272\277p trong su\341\273\221t nhi\341\273\201u tu\341\272\247n h\341\273\215c.\',\n    criteria: \'Chu\341\273\227i x\341\272\277p lo\341\272\241i T\341\273\221t\',\n    category: \'spirit\',\n    accentColor: \'#EA580C\'\n  }\n];\n\n// Teen-friendly motivational quotes for 10A5\nexport const DAILY_MOTTO_QUOTES = [\n  \'\342\200\234H\341\273\215c h\341\272\277t m\303\254nh - Ch\306\241i nhi\341\273\207t t\303\254nh - N\341\273\201 n\341\272\277p \304\221\341\273\211nh cao!\342\200\235 \360\237\232\200\',\n  \'\342\200\23410A5: Kh\303\264ng ch\341\273\211 l\303\240 m\341\273\231t l\341\273\233p h\341\273\215c, \304\221\303\242y l\303\240 m\341\273\231t \304\221\341\272\241i gia \304\221\303\254nh!\342\200\235 \342\235\244\357\270\217\',\n  \'\342\200\234M\341\273\227i ng\303\240y \304\221\341\272\277n tr\306\260\341\273\235ng l\303\240 m\341\273\231t ng\303\240y t\341\273\217a s\303\241ng theo c\303\241ch c\341\273\247a b\341\272\241n!\342\200\235 \342\234\250\',\n  \'\342\200\234K\341\273\267 lu\341\272\255t t\341\272\241o n\303\252n s\341\273\251c m\341\272\241nh - \304\220o\303\240n k\341\272\277t mang l\341\272\241i th\303\240nh c\303\264ng!\342\200\235 \360\237\214\237\',\n  \'\342\200\234Ch\304\203m ch\341\273\211 h\303\264m nay - G\341\272\267t h\303\241i t\306\260\306\241ng lai ng\303\240y mai!\342\200\235 \360\237\216\257\'\n];\n"
        path {
          absolute_uri: "file:///src/data/badgeData.ts"
        }
        overwrite: true
      }
    }
