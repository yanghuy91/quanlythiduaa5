  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { \n  X, \n  Search, \n  ChevronDown, \n  ChevronUp, \n  Clock, \n  Star, \n  Check, \n  AlertCircle,\n  Plus,\n  Users\n} from \'lucide-react\';\nimport { Student, RuleItem, RoleCode } from \'../../types\';\nimport { getCurrentSession } from \'../../utils/emulation\';\nimport { removeVietnameseAccents } from \'../../utils/vietnamese\';\n\ninterface RecordBottomSheetProps {\n  isOpen: boolean;\n  onClose: () => void;\n  students: Student[];\n  rules: RuleItem[];\n  allowBonus: boolean;\n  fastSaveMode?: boolean; // 1-touch fast save\n  onSave: (payload: {\n    students: Student[];\n    rule: RuleItem;\n    date: string;\n    session: \'Sang\' | \'Chieu\';\n    note?: string;\n  }) => void;\n  currentUserRole: RoleCode;\n}\n\nexport const RecordBottomSheet: React.FC<RecordBottomSheetProps> = ({\n  isOpen,\n  onClose,\n  students,\n  rules,\n  allowBonus,\n  fastSaveMode = false,\n  onSave,\n}) => {\n  const [selectedRuleId, setSelectedRuleId] = useState<string>(\'\');\n  const [activeCategory, setActiveCategory] = useState<string>(\'all\');\n  const [ruleSearch, setRuleSearch] = useState<string>(\'\');\n  const [showDetails, setShowDetails] = useState<boolean>(false);\n  const [date, setDate] = useState<string>(() => new Date().toISOString().split(\'T\')[0]);\n  const [session, setSession] = useState<\'Sang\' | \'Chieu\'>(getCurrentSession);\n  const [note, setNote] = useState<string>(\'\');\n\n  // Available categories\n  const categories = useMemo(() => {\n    const list = [\'all\', \'Chuy\303\252n c\341\272\247n\', \'H\341\273\215c t\341\272\255p\', \'N\341\273\201 n\341\272\277p\', \'Phong tr\303\240o\', \'Lao \304\221\341\273\231ng - V\341\273\207 sinh\'];\n    if (allowBonus) {\n      list.push(\'\304\220i\341\273\203m c\341\273\231ng\');\n    }\n    return list;\n  }, [allowBonus]);\n\n  // Pinned \"Hay d\303\271ng\" rules\n  const frequentRules = useMemo(() => {\n    return rules.filter(r => r.ghim && (allowBonus || r.loaiDiem !== \'Cong\'));\n  }, [rules, allowBonus]);\n\n  // Filtered rules\n  const filteredRules = useMemo(() => {\n    return rules.filter(r => {\n      // Hide bonus rules if disabled\n      if (!allowBonus && r.loaiDiem === \'Cong\') return false;\n\n      // Category filter\n      if (activeCategory !== \'all\' && r.nhomHanhVi !== activeCategory) {\n        return false;\n      }\n\n      // Search filter\n      if (ruleSearch.trim()) {\n        const cleanSearch = removeVietnameseAccents(ruleSearch);\n        const cleanName = removeVietnameseAccents(r.tenHanhVi);\n        const cleanGroup = removeVietnameseAccents(r.nhomHanhVi);\n        return cleanName.includes(cleanSearch) || cleanGroup.includes(cleanSearch);\n      }\n\n      return true;\n    });\n  }, [rules, allowBonus, activeCategory, ruleSearch]);\n\n  const selectedRule = useMemo(() => {\n    return rules.find(r => r.maNoiQuy === selectedRuleId);\n  }, [rules, selectedRuleId]);\n\n  if (!isOpen || students.length === 0) return null;\n\n  const handleSelectRule = (rule: RuleItem) => {\n    setSelectedRuleId(rule.maNoiQuy);\n\n    // Fast save 1-touch mode for proficient cadres\n    if (fastSaveMode) {\n      onSave({\n        students,\n        rule,\n        date,\n        session,\n        note: note.trim() || undefined,\n      });\n      onClose();\n    }\n  };\n\n  const handleManualSave = () => {\n    if (!selectedRule) return;\n\n    onSave({\n      students,\n      rule: selectedRule,\n      date,\n      session,\n      note: note.trim() || undefined,\n    });\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-40 flex items-end justify-center bg-black/50 backdrop-blur-xs transition-opacity\">\n      {/* Bottom Sheet Modal */}\n      <div \n        className=\"w-full max-w-xl bg-surface rounded-t-2xl border-t border-token shadow-2xl flex flex-col max-h-[85vh] animate-slide-up\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Handle bar */}\n        <div className=\"w-full pt-2.5 pb-1 flex justify-center cursor-grab active:cursor-grabbing\">\n          <div className=\"w-10 h-1 rounded-full bg-token opacity-60\" />\n        </div>\n\n        {/* Sheet Header */}\n        <div className=\"px-4 py-2 border-b border-token flex items-center justify-between\">\n          <div className=\"min-w-0\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs font-bold text-main\">\n                {students.length === 1 ? students[0].hoTen : `Ghi ${students.length} h\341\273\215c sinh`}\n              </span>\n              <span className=\"text-[10px] font-semibold px-1.5 py-0.5 rounded bg-surface-2 text-muted\">\n                {session === \'Sang\' ? \'Bu\341\273\225i S\303\241ng\' : \'Bu\341\273\225i Chi\341\273\201u\'}\n              </span>\n            </div>\n            <p className=\"text-[11px] text-muted truncate mt-0.5\">\n              {students.length === 1 ? (\n                `T\341\273\225 ${students[0].to} \302\267 D\303\243y ${students[0].dayBan} - B\303\240n ${students[0].soBan}`\n              ) : (\n                students.map(s => s.tenRutGon).join(\', \')\n              )}\n            </p>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\"\n            aria-label=\"\304\220\303\263ng b\341\272\243ng ghi nh\341\272\255n\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Sheet Content (Scrollable) */}\n        <div className=\"p-4 overflow-y-auto space-y-4\">\n          {/* Section: Hay d\303\271ng (Fast thumb taps) */}\n          {!ruleSearch && activeCategory === \'all\' && frequentRules.length > 0 && (\n            <div>\n              <div className=\"flex items-center gap-1.5 text-xs font-semibold text-muted mb-2\">\n                <Star className=\"w-3.5 h-3.5 text-accent\" />\n                <span>Hay d\303\271ng</span>\n              </div>\n\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2\">\n                {frequentRules.map(rule => {\n                  const isSelected = selectedRuleId === rule.maNoiQuy;\n                  return (\n                    <button\n                      key={rule.maNoiQuy}\n                      type=\"button\"\n                      onClick={() => handleSelectRule(rule)}\n                      className={`min-h-[44px] p-2 rounded-xl border text-left flex flex-col justify-between transition-all cursor-pointer ${\n                        isSelected \n                          ? \'border-accent bg-accent/10 ring-2 ring-accent/30\' \n                          : \'border-token bg-surface hover:bg-surface-2\'\n                      }`}\n                    >\n                      <span className=\"text-xs font-semibold text-main line-clamp-2 leading-tight\">\n                        {rule.tenHanhVi}\n                      </span>\n                      <div className=\"flex items-center justify-between mt-1 text-[11px]\">\n                        <span className=\"font-bold text-[var(--st-bad)]\">\n                          -{rule.diemSo}\304\221\n                        </span>\n                        {rule.mucDo === \'Nang\' && (\n                          <span className=\"text-[9px] font-bold px-1 rounded bg-[var(--st-bad)]/15 text-[var(--st-bad)]\">\n                            N\341\272\267ng\n                          </span>\n                        )}\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n\n          {/* Search Rule */}\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none\" />\n            <input\n              type=\"text\"\n              value={ruleSearch}\n              onChange={e => setRuleSearch(e.target.value)}\n              placeholder=\"T\303\254m h\303\240nh vi vi ph\341\272\241m...\"\n              className=\"w-full pl-9 pr-4 py-2 bg-surface border border-token rounded-lg text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40\"\n            />\n          </div>\n\n          {/* Category Filter Tabs */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5\">\n            {categories.map(cat => (\n              <button\n                key={cat}\n                type=\"button\"\n                onClick={() => setActiveCategory(cat)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors cursor-pointer ${\n                  activeCategory === cat \n                    ? \'bg-primary text-on-primary font-bold\' \n                    : \'bg-surface-2 border border-token text-muted hover:text-main\'\n                }`}\n              >\n                {cat === \'all\' ? \'T\341\272\245t c\341\272\243\' : cat}\n              </button>\n            ))}\n          </div>\n\n          {/* Rules List */}\n          <div className=\"space-y-1.5 max-h-48 overflow-y-auto pr-1\">\n            {filteredRules.map(rule => {\n              const isSelected = selectedRuleId === rule.maNoiQuy;\n              const isBonus = rule.loaiDiem === \'Cong\';\n\n              return (\n                <button\n                  key={rule.maNoiQuy}\n                  type=\"button\"\n                  onClick={() => handleSelectRule(rule)}\n                  className={`w-full min-h-[44px] px-3 py-2 rounded-xl border flex items-center justify-between text-left transition-colors cursor-pointer ${\n                    isSelected \n                      ? \'border-accent bg-accent/10 ring-2 ring-accent/30\' \n                      : \'border-token bg-surface hover:bg-surface-2\'\n                  }`}\n                >\n                  <div className=\"min-w-0 pr-2\">\n                    <div className=\"text-xs font-semibold text-main truncate\">\n                      {rule.tenHanhVi}\n                    </div>\n                    <div className=\"text-[10px] text-muted flex items-center gap-1.5 mt-0.5\">\n                      <span>{rule.nhomHanhVi}</span>\n                      {rule.mucDo === \'Nang\' && (\n                        <span className=\"text-[9px] font-bold text-[var(--st-bad)]\">\302\267 M\341\273\251c N\341\272\267ng</span>\n                      )}\n                    </div>\n                  </div>\n\n                  <div className=\"shrink-0 flex items-center gap-2\">\n                    <span className={`text-xs font-bold px-2 py-0.5 rounded-full ${\n                      isBonus \n                        ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' \n                        : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\n                    }`}>\n                      {isBonus ? `+${rule.diemSo}` : `-${rule.diemSo}`}\304\221\n                    </span>\n                    {isSelected && (\n                      <span className=\"w-4 h-4 rounded-full bg-accent text-on-accent flex items-center justify-center\">\n                        <Check className=\"w-2.5 h-2.5 stroke-[3]\" />\n                      </span>\n                    )}\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Details toggle (date, note) */}\n          <div className=\"pt-2 border-t border-token\">\n            <button\n              type=\"button\"\n              onClick={() => setShowDetails(!showDetails)}\n              className=\"flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline cursor-pointer\"\n            >\n              <span>{showDetails ? \'\341\272\250n chi ti\341\272\277t b\341\273\225 sung\' : \'Th\303\252m chi ti\341\272\277t (Ng\303\240y, bu\341\273\225i, ghi ch\303\272)\'}</span>\n              {showDetails ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n            </button>\n\n            {showDetails && (\n              <div className=\"mt-3 space-y-3 p-3 rounded-xl bg-surface-2 border border-token animate-scale-up\">\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-muted mb-1\">\n                      Ng\303\240y vi ph\341\272\241m\n                    </label>\n                    <input\n                      type=\"date\"\n                      value={date}\n                      onChange={e => setDate(e.target.value)}\n                      className=\"w-full px-2.5 py-1.5 bg-surface border border-token rounded-lg text-xs text-main\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[11px] font-semibold text-muted mb-1\">\n                      Bu\341\273\225i h\341\273\215c\n                    </label>\n                    <select\n                      value={session}\n                      onChange={e => setSession(e.target.value as \'Sang\' | \'Chieu\')}\n                      className=\"w-full px-2.5 py-1.5 bg-surface border border-token rounded-lg text-xs text-main\"\n                    >\n                      <option value=\"Sang\">Bu\341\273\225i S\303\241ng</option>\n                      <option value=\"Chieu\">Bu\341\273\225i Chi\341\273\201u</option>\n                    </select>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-[11px] font-semibold text-muted mb-1\">\n                    Ghi ch\303\272 th\303\252m (kh\303\264ng b\341\272\257t bu\341\273\231c)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={note}\n                    onChange={e => setNote(e.target.value)}\n                    placeholder=\"VD: Kh\303\264ng mang s\303\241ch To\303\241n, ti\341\272\277t 2...\"\n                    className=\"w-full px-3 py-1.5 bg-surface border border-token rounded-lg text-xs text-main placeholder:text-muted\"\n                  />\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Sheet Footer: Big Thumb Save Button */}\n        <div className=\"p-4 border-t border-token bg-surface flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"flex-1 py-3 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\"\n          >\n            H\341\273\247y\n          </button>\n          <button\n            type=\"button\"\n            disabled={!selectedRule}\n            onClick={handleManualSave}\n            className={`flex-2 py-3 rounded-xl text-xs font-bold transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer ${\n              selectedRule \n                ? \'bg-primary text-on-primary hover:opacity-95 active:scale-98\' \n                : \'bg-surface-2 text-muted border border-token cursor-not-allowed\'\n            }`}\n          >\n            <Check className=\"w-4 h-4 stroke-[2.5]\" />\n            <span>\n              {selectedRule \n                ? `L\306\260u: ${selectedRule.tenHanhVi} (${selectedRule.loaiDiem === \'Cong\' ? \'+\' : \'-\'}${selectedRule.diemSo}\304\221)` \n                : \'Ch\341\273\215n h\303\240nh vi \304\221\341\273\203 L\306\260u\'}\n            </span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/record/RecordBottomSheet.tsx"
        }
        overwrite: true
      }
    }
