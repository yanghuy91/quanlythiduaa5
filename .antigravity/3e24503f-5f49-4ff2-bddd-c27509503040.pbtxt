      thinking_signature: "\022\272\005\n\267\005\001i\024}\023\201h\035\361\252\254\2534C\277Z|\036E\300\027\341L0\2133\216\364\266\"\033&\323\207\245\347j\236\"\216\205\\\364\341\344$}&\315\211\226\031\027J\233GM\343-\316\326oA\204\034\241[hNa\347%Jj<\3002\t\330\224\311\326\327\022\211{\037\'\nx\317\306\227\241\245\347\364\036\353\243\316w4\262_\3559\266\274W\036\"\312\356\261\235?L\320\026Dm?>_\333<\006\223\017@#\3773\263H\203\330\220A\350\032\366\355V\217\332j1\374\335\224$\au\342l\275~\221V\371\346 \334\351f\321\\\352\"I\267\376\270\r\262r\206\332\034d4\375\213\025\317:\367\237c\363\003\357\"u\221$\204\277G\263\222\036\213\312\241\v\355\366\020*_\316\317\021l(\233\271\a\220\234\206\323\207c%\256\3761\322\346\251\365V\371m5\277Bq,I\303\200BP\214\301\203\267\276\330P\364\263\350\335\2276\307p\023\020<\341\372.@\2254#\0278\31771\002E\016%:\257I\244]\227\377[A\r\307j\354\367\v\316\267qzZ\366>\372\366\343\231\236~<\021\247\231\265\252\027\r\361\330\277\030`\033\274\324Cshg\265\3079\310\260\313V+%\231}\246~\364\326J\277JG\vX\266Rg\37142d>\322\357\366,Lz,\356\211\267$2\f$4\300\367\317\v5\355~\236\231\332px\367\212\220\\\021\361\226\266\357\241\035\004\257p\t\224\375po\177O@WS\302\233\326\257\373\"\254\343\327\237Z\023\202\342\"\030&.f\\\317E\224\362l$\3666IT\330\320{\315\300\246\004\352*\225k;\247\316\310\r\033\245\327w\334s\313\aP\244\373\213\245B\017Q\365\267\241\0264\td\\\\mY9\222t!N\003\352h\233(wx/\211\020\360\2060\306\021Tl\271\231\316{3I\371\022aZ\242\346\242\256|\276\t)\367\"\304&\302V\0176}\215\214$\355\333\225\273O>]\256\240\217\vC\275\367\226\325@\203]/\332\231HH\234\001\266x\265\a\303\347\272v*\374\205\225$\275S\360\251\251l\310J`oE\261\025\006h<\354\203\260;\245\273\207K\336*\251n\325\305\365\304\303\234h(\315,\t\030\274;\243\022\320\263U\334\341\273\371`Tk\335@\207\244\251\00631H\267\"\242\r\354\215\306\001\277=0\006h\340\310f[\321:\300\244V\201I\332\315\263+|\334\255\205\262w\207\201\247\006v-4\202 \377i.\307\304\304\244\3056\027K\030\3379\277"
