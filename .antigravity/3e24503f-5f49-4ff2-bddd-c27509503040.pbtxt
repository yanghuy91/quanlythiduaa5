  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { X, Award, Shield, Sparkles, User, MapPin } from \'lucide-react\';\nimport { Student } from \'../../types\';\nimport { CADRE_ROLES_INFO } from \'../../data/badgeData\';\n\ninterface CadreHonorsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  students: Student[];\n}\n\nexport const CadreHonorsModal: React.FC<CadreHonorsModalProps> = ({\n  isOpen,\n  onClose,\n  students,\n}) => {\n  if (!isOpen) return null;\n\n  // Find all cadres\n  const cadres = students.filter(s => s.vaiTro.some(r => r !== \'HS\'));\n\n  // Sort by cadre hierarchy: LT -> BT -> LP_HT -> LP_LD -> TT 1..4\n  const rolePriority: Record<string, number> = {\n    LT: 1,\n    BT: 2,\n    LP_HT: 3,\n    LP_LD: 4,\n    TT: 5,\n  };\n\n  const sortedCadres = [...cadres].sort((a, b) => {\n    const aPrio = Math.min(...a.vaiTro.map(r => rolePriority[r] || 99));\n    const bPrio = Math.min(...b.vaiTro.map(r => rolePriority[r] || 99));\n    if (aPrio !== bPrio) return aPrio - bPrio;\n    return (a.toTruongTo || 0) - (b.toTruongTo || 0);\n  });\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-xs animate-fade-in\">\n      <div \n        className=\"w-full max-w-2xl bg-surface border border-token rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh] animate-scale-up\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Header with Leadership Crest Visual */}\n        <div className=\"relative p-5 sm:p-6 bg-gradient-to-r from-amber-500/15 via-blue-500/10 to-purple-500/15 border-b border-token flex items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3.5\">\n            <div className=\"w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden border-2 border-amber-500/40 shadow-md shrink-0 bg-surface\">\n              <img\n                src=\"/src/assets/images/cadre_leadership_crest_1794145976007.jpg\"\n                alt=\"Huy hi\341\273\207u Ban C\303\241n S\341\273\261 10A5\"\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-amber-600 dark:text-amber-400\">\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                <span>VINH DANH BAN C\303\201N S\341\273\260 L\341\273\232P 10A5</span>\n              </div>\n              <h3 className=\"text-base sm:text-lg font-extrabold text-main leading-tight mt-0.5\">\n                \304\220\341\273\231i Ng\305\251 \304\220\341\272\247u T\303\240u N\341\273\201 N\341\272\277p &amp; Thi \304\220ua \360\237\221\221\n              </h3>\n              <p className=\"text-xs text-muted mt-0.5\">\n                THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225 \302\267 N\304\203m h\341\273\215c 2026-2027\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer shrink-0\"\n            aria-label=\"\304\220\303\263ng\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Cadre List */}\n        <div className=\"p-4 sm:p-6 overflow-y-auto divide-y divide-token/60 space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n            {sortedCadres.map(student => {\n              const primaryRole = student.vaiTro.find(r => r !== \'HS\') || \'HS\';\n              const info = CADRE_ROLES_INFO[primaryRole] || CADRE_ROLES_INFO.HS;\n              const displayTitle = primaryRole === \'TT\' && student.toTruongTo\n                ? `T\341\273\225 tr\306\260\341\273\237ng T\341\273\225 ${student.toTruongTo}`\n                : info.title;\n              const displayBadge = primaryRole === \'TT\' && student.toTruongTo\n                ? `Th\341\273\247 L\304\251nh T\341\273\225 ${student.toTruongTo}`\n                : info.badgeName;\n\n              return (\n                <div\n                  key={student.maHS}\n                  className={`p-3.5 rounded-2xl border ${info.borderTone} bg-gradient-to-br ${info.gradientBg} bg-surface transition-all hover:shadow-md flex flex-col justify-between gap-2.5`}\n                >\n                  <div className=\"flex items-start gap-3\">\n                    <div \n                      className=\"w-11 h-11 rounded-2xl flex items-center justify-center text-xl shrink-0 shadow-inner\"\n                      style={{ \n                        backgroundColor: `${info.accentColor}25`, \n                        border: `1.5px solid ${info.accentColor}40` \n                      }}\n                    >\n                      {info.emoji}\n                    </div>\n\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-1.5 flex-wrap\">\n                        <span \n                          className=\"text-[10px] font-extrabold px-1.5 py-0.2 rounded\"\n                          style={{\n                            color: info.accentColor,\n                            backgroundColor: `${info.accentColor}20`\n                          }}\n                        >\n                          {displayTitle}\n                        </span>\n                        <span className=\"text-[10px] text-muted font-medium\">\n                          {info.badgeLevel}\n                        </span>\n                      </div>\n\n                      <h4 className=\"text-sm font-bold text-main mt-0.5 truncate\">\n                        {student.hoTen}\n                      </h4>\n\n                      <div className=\"text-[11px] text-muted flex items-center gap-2 mt-0.5\">\n                        <span className=\"flex items-center gap-0.5\">\n                          <MapPin className=\"w-3 h-3 text-accent\" />\n                          <span>D\303\243y {student.dayBan} - B\303\240n {student.soBan} (Gh\341\272\277 {student.viTriGhe})</span>\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"p-2 rounded-xl bg-surface-2/60 border border-token text-[11px] text-muted space-y-1\">\n                    <div className=\"italic font-medium text-main text-[11px]\">\n                      \"{info.motto}\"\n                    </div>\n                    <div className=\"text-[10px] text-muted line-clamp-2\">\n                      <strong className=\"text-main\">Tr\303\241ch nhi\341\273\207m:</strong> {info.duty}\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n          <div className=\"pt-4 text-center\">\n            <p className=\"text-xs text-muted max-w-md mx-auto italic\">\n              \"Ban c\303\241n s\341\273\261 l\341\273\233p l\303\240 nh\341\273\257ng b\341\272\241n ti\303\252n phong r\303\250n luy\341\273\207n b\341\272\243n th\303\242n, gi\341\273\257 g\303\254n k\341\273\267 lu\341\272\255t c\303\264ng b\341\272\261ng, kh\303\241ch quan v\303\240 c\303\271ng nhau \304\221\306\260a t\341\272\255p th\341\273\203 10A5 d\341\272\253n \304\221\341\272\247u phong tr\303\240o thi \304\221ua to\303\240n tr\306\260\341\273\235ng!\"\n            </p>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-3 bg-surface-2 border-t border-token flex items-center justify-between\">\n          <div className=\"text-xs font-semibold text-muted\">\n            10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\n          </div>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-90 transition-opacity cursor-pointer\"\n          >\n            \304\220\303\263ng\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/common/CadreHonorsModal.tsx"
        }
        overwrite: true
      }
    }
