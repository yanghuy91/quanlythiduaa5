  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef } from \'react\';\nimport { Camera, Upload, Trash2, X, Check, Sparkles, Image as ImageIcon } from \'lucide-react\';\nimport { Student } from \'../../types\';\n\ninterface AvatarUploadModalProps {\n  student: Student;\n  isOpen: boolean;\n  onClose: () => void;\n  onSaveAvatar: (studentId: string, avatarUrl: string) => void;\n}\n\n// Preset fun high-school stickers/avatars if student doesn\'t have an image ready\nconst PRESET_AVATARS = [\n  \'\360\237\216\223\', \'\360\237\232\200\', \'\342\232\241\', \'\360\237\214\237\', \'\360\237\216\256\', \n  \'\360\237\216\247\', \'\360\237\216\250\', \'\342\232\275\', \'\360\237\220\257\', \'\360\237\246\212\', \n  \'\360\237\214\270\', \'\360\237\223\232\', \'\360\237\224\245\', \'\360\237\222\216\', \'\360\237\217\206\'\n];\n\nexport const AvatarUploadModal: React.FC<AvatarUploadModalProps> = ({\n  student,\n  isOpen,\n  onClose,\n  onSaveAvatar,\n}) => {\n  const [previewUrl, setPreviewUrl] = useState<string>(student.avatarUrl || \'\');\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  if (!isOpen) return null;\n\n  // Process and resize image file to max 256x256 Base64 data URL\n  const processImageFile = (file: File) => {\n    if (!file.type.startsWith(\'image/\')) {\n      setErrorMsg(\'Vui l\303\262ng ch\341\273\215n t\341\273\207p h\303\254nh \341\272\243nh (PNG, JPG, WebP)\');\n      return;\n    }\n\n    if (file.size > 5 * 1024 * 1024) {\n      setErrorMsg(\'K\303\255ch th\306\260\341\273\233c \341\272\243nh t\341\273\221i \304\221a 5MB\');\n      return;\n    }\n\n    setIsProcessing(true);\n    setErrorMsg(null);\n\n    const reader = new FileReader();\n    reader.onload = (e) => {\n      const img = new Image();\n      img.onload = () => {\n        try {\n          const canvas = document.createElement(\'canvas\');\n          const maxDim = 256;\n          \n          // Center-crop to square\n          const minSide = Math.min(img.width, img.height);\n          const startX = (img.width - minSide) / 2;\n          const startY = (img.height - minSide) / 2;\n\n          canvas.width = maxDim;\n          canvas.height = maxDim;\n\n          const ctx = canvas.getContext(\'2d\');\n          if (!ctx) throw new Error(\'Canvas not supported\');\n\n          ctx.drawImage(\n            img, \n            startX, startY, minSide, minSide, \n            0, 0, maxDim, maxDim\n          );\n\n          // Compress to JPEG data URL\n          const compressedDataUrl = canvas.toDataURL(\'image/jpeg\', 0.82);\n          setPreviewUrl(compressedDataUrl);\n          setIsProcessing(false);\n        } catch {\n          setErrorMsg(\'Kh\303\264ng th\341\273\203 x\341\273\255 l\303\275 h\303\254nh \341\272\243nh n\303\240y. Vui l\303\262ng th\341\273\255 \341\272\243nh kh\303\241c.\');\n          setIsProcessing(false);\n        }\n      };\n      img.onerror = () => {\n        setErrorMsg(\'Kh\303\264ng th\341\273\203 \304\221\341\273\215c h\303\254nh \341\272\243nh. Vui l\303\262ng ch\341\273\215n t\341\273\207p h\341\273\243p l\341\273\207.\');\n        setIsProcessing(false);\n      };\n      img.src = e.target?.result as string;\n    };\n    reader.onerror = () => {\n      setErrorMsg(\'\304\220\341\273\215c t\341\273\207p th\341\272\245t b\341\272\241i.\');\n      setIsProcessing(false);\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      processImageFile(file);\n    }\n  };\n\n  // Drag and drop handlers\n  const handleDrop = (e: React.DragEvent<HTMLDivElement>) => {\n    e.preventDefault();\n    const file = e.dataTransfer.files?.[0];\n    if (file) {\n      processImageFile(file);\n    }\n  };\n\n  // Generate SVG Data URL from emoji preset\n  const handleSelectPresetEmoji = (emoji: string) => {\n    const canvas = document.createElement(\'canvas\');\n    canvas.width = 160;\n    canvas.height = 160;\n    const ctx = canvas.getContext(\'2d\');\n    if (ctx) {\n      // Soft background circle\n      const gradient = ctx.createLinearGradient(0, 0, 160, 160);\n      gradient.addColorStop(0, \'#3b82f6\');\n      gradient.addColorStop(1, \'#8b5cf6\');\n      ctx.fillStyle = gradient;\n      ctx.fillRect(0, 0, 160, 160);\n\n      ctx.font = \'80px sans-serif\';\n      ctx.textAlign = \'center\';\n      ctx.textBaseline = \'middle\';\n      ctx.fillText(emoji, 80, 85);\n\n      setPreviewUrl(canvas.toDataURL(\'image/png\'));\n    }\n  };\n\n  const handleSave = () => {\n    onSaveAvatar(student.maHS, previewUrl);\n    onClose();\n  };\n\n  const handleRemove = () => {\n    setPreviewUrl(\'\');\n    onSaveAvatar(student.maHS, \'\');\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/70 backdrop-blur-xs animate-fade-in\">\n      <div \n        className=\"w-full max-w-md bg-surface border border-token rounded-3xl shadow-2xl overflow-hidden flex flex-col animate-scale-up\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-accent/15 via-blue-500/10 to-purple-500/15 border-b border-token flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-2xl bg-accent text-on-accent flex items-center justify-center shadow-xs\">\n              <Camera className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-main leading-tight\">\n                C\341\272\255p nh\341\272\255t \341\272\242nh \304\221\341\272\241i di\341\273\207n\n              </h3>\n              <p className=\"text-xs text-muted\">\n                {student.hoTen} \302\267 T\341\273\225 {student.to} \302\267 Gh\341\272\277 #{student.viTriGhe}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-xl text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Body */}\n        <div className=\"p-5 space-y-4\">\n          {/* Avatar Preview */}\n          <div className=\"flex flex-col items-center justify-center gap-2\">\n            <div className=\"relative group\">\n              <div className=\"w-28 h-28 rounded-3xl overflow-hidden border-3 border-accent/40 shadow-lg bg-surface-2 flex items-center justify-center\">\n                {previewUrl ? (\n                  <img\n                    src={previewUrl}\n                    alt={student.hoTen}\n                    className=\"w-full h-full object-cover object-center\"\n                  />\n                ) : (\n                  <div className=\"w-full h-full bg-gradient-to-tr from-accent to-blue-500 text-white flex items-center justify-center text-3xl font-extrabold select-none\">\n                    {student.tenRutGon.slice(-2)}\n                  </div>\n                )}\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => fileInputRef.current?.click()}\n                className=\"absolute bottom-1 right-1 p-2 rounded-xl bg-accent text-on-accent shadow-md hover:scale-105 transition-transform cursor-pointer\"\n                title=\"Ch\341\273\215n \341\272\243nh t\341\273\253 thi\341\272\277t b\341\273\213\"\n              >\n                <Camera className=\"w-4 h-4\" />\n              </button>\n            </div>\n            <span className=\"text-xs text-muted font-medium\">\n              \341\272\242nh s\341\272\275 hi\341\273\203n th\341\273\213 tr\303\252n s\306\241 \304\221\341\273\223 l\341\273\233p v\303\240 danh s\303\241ch thi \304\221ua\n            </span>\n          </div>\n\n          {/* Hidden File Input */}\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            accept=\"image/*\"\n            className=\"hidden\"\n            onChange={handleFileChange}\n          />\n\n          {/* Dropzone */}\n          <div\n            onDragOver={e => e.preventDefault()}\n            onDrop={handleDrop}\n            onClick={() => fileInputRef.current?.click()}\n            className=\"p-4 rounded-2xl border-2 border-dashed border-token/80 hover:border-accent bg-surface-2/40 hover:bg-accent/5 transition-all flex flex-col items-center justify-center gap-1.5 cursor-pointer text-center\"\n          >\n            <Upload className=\"w-6 h-6 text-accent animate-bounce\" />\n            <span className=\"text-xs font-bold text-main\">\n              Ch\341\272\241m ho\341\272\267c k\303\251o th\341\272\243 \341\272\243nh v\303\240o \304\221\303\242y\n            </span>\n            <span className=\"text-[11px] text-muted\">\n              H\341\273\227 tr\341\273\243 PNG, JPG, WebP (T\341\273\261 \304\221\341\273\231ng c\341\272\257t vu\303\264ng \304\221\341\272\271p)\n            </span>\n          </div>\n\n          {errorMsg && (\n            <div className=\"p-2.5 rounded-xl bg-[var(--st-bad)]/10 text-[var(--st-bad)] text-xs font-semibold text-center\">\n              {errorMsg}\n            </div>\n          )}\n\n          {/* Preset Emojis */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center gap-1 text-xs text-muted font-semibold\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span>Ho\341\272\267c ch\341\273\215n bi\341\273\203u t\306\260\341\273\243ng \304\221\341\272\241i di\341\273\207n Gen Z:</span>\n            </div>\n            <div className=\"flex items-center justify-between gap-1 overflow-x-auto py-1 no-scrollbar\">\n              {PRESET_AVATARS.map(emoji => (\n                <button\n                  key={emoji}\n                  type=\"button\"\n                  onClick={() => handleSelectPresetEmoji(emoji)}\n                  className=\"w-8 h-8 rounded-xl bg-surface-2 hover:bg-accent/20 border border-token text-lg flex items-center justify-center transition-transform hover:scale-110 shrink-0 cursor-pointer\"\n                >\n                  {emoji}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Footer Actions */}\n        <div className=\"p-4 bg-surface-2 border-t border-token flex items-center justify-between gap-2\">\n          {student.avatarUrl ? (\n            <button\n              type=\"button\"\n              onClick={handleRemove}\n              className=\"px-3 py-2 rounded-xl text-xs font-semibold text-red-500 hover:bg-red-500/10 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              <span>G\341\273\241 \341\272\243nh</span>\n            </button>\n          ) : (\n            <div />\n          )}\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-3.5 py-2 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main\"\n            >\n              H\341\273\247y\n            </button>\n            <button\n              type=\"button\"\n              disabled={isProcessing}\n              onClick={handleSave}\n              className=\"px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 shadow-md flex items-center gap-1.5 cursor-pointer disabled:opacity-50\"\n            >\n              <Check className=\"w-4 h-4\" />\n              <span>{isProcessing ? \'\304\220ang n\303\251n \341\272\243nh...\' : \'L\306\260u \341\272\243nh \304\221\341\272\241i di\341\273\207n\'}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/common/AvatarUploadModal.tsx"
        }
        overwrite: true
      }
    }
