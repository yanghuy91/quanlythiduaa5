  planner_response {
    thinking: "**Refining UI Component**\n\nI\'m currently working on updating `RecordBottomSheet.tsx`. My focus is integrating semester and week data using imports from the hierarchy utility. I need to add properties to handle initial week and semester data for the bottom sheet.\n\n\n**Implementing Time Hierarchy**\n\nI\'ve been mapping out the UI components for the time hierarchy within `RecordBottomSheet.tsx`. The plan is to include a clear visual block for year, semester (with dropdowns for selection: `H\341\273\215c k\303\254 1` / `H\341\273\215c k\303\254 2`), and week. We are computing the `availableWeeks` dynamically based on the semester selection, rendering the correct range. I\'m also adding a date picker and session toggle. I\'ll need to update the data handling functions to pass the selected values for students.\n\n\n"
    tool_calls {
      id: "call_7086327038904118161"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { \\n  X, \\n  Search, \\n  ChevronDown, \\n  ChevronUp, \\n  Calendar, \\n  Clock, \\n  Star, \\n  Check, \\n  AlertCircle,\\n  Plus,\\n  Users,\\n  Layers\\n} from \'lucide-react\';\\nimport { Student, RuleItem, RoleCode } from \'../../types\';\\nimport { getCurrentSession } from \'../../utils/emulation\';\\nimport { removeVietnameseAccents } from \'../../utils/vietnamese\';\\nimport { \\n  SEMESTER_1_WEEKS, \\n  SEMESTER_2_WEEKS, \\n  getSemesterFromWeek,\\n  CURRENT_SCHOOL_YEAR\\n} from \'../../utils/hierarchy\';\\n\\nexport interface RecordSavePayload {\\n  students: Student[];\\n  rule: RuleItem;\\n  date: string;\\n  session: \'Sang\' | \'Chieu\';\\n  hocKi: 1 | 2;\\n  tuanHoc: number;\\n  note?: string;\\n}\\n\\ninterface RecordBottomSheetProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  students: Student[];\\n  rules: RuleItem[];\\n  allowBonus: boolean;\\n  fastSaveMode?: boolean; // 1-touch fast save\\n  initialWeek?: number;\\n  initialSemester?: 1 | 2;\\n  onSave: (payload: RecordSavePayload) => void;\\n  currentUserRole: RoleCode;\\n}\\n\\nexport const RecordBottomSheet: React.FC<RecordBottomSheetProps> = ({\\n  isOpen,\\n  onClose,\\n  students,\\n  rules,\\n  allowBonus,\\n  fastSaveMode = false,\\n  initialWeek = 3,\\n  initialSemester,\\n  onSave,\\n}) => {\\n  const [selectedRuleId, setSelectedRuleId] = useState<string>(\'\');\\n  const [activeCategory, setActiveCategory] = useState<string>(\'all\');\\n  const [ruleSearch, setRuleSearch] = useState<string>(\'\');\\n  const [showTimeCustomizer, setShowTimeCustomizer] = useState<boolean>(false);\\n  \\n  // Time Hierarchy State: N\304\203m h\341\273\215c -> H\341\273\215c k\303\254 -> Tu\341\272\247n -> Bu\341\273\225i (B\341\273\217 qua th\303\241ng)\\n  const [hocKi, setHocKi] = useState<1 | 2>(() => {\\n    if (initialSemester) return initialSemester;\\n    return getSemesterFromWeek(initialWeek);\\n  });\\n  const [tuanHoc, setTuanHoc] = useState<number>(initialWeek);\\n  const [session, setSession] = useState<\'Sang\' | \'Chieu\'>(getCurrentSession);\\n  const [date, setDate] = useState<string>(() => new Date().toISOString().split(\'T\')[0]);\\n  const [note, setNote] = useState<string>(\'\');\\n\\n  // Weeks available according to chosen semester (HK1: 1..19, HK2: 20..38)\\n  const availableWeeks = useMemo(() => {\\n    return hocKi === 1 ? SEMESTER_1_WEEKS : SEMESTER_2_WEEKS;\\n  }, [hocKi]);\\n\\n  // Handle changing semester\\n  const handleChangeSemester = (newHocKi: 1 | 2) => {\\n    setHocKi(newHocKi);\\n    if (newHocKi === 1 && (tuanHoc < 1 || tuanHoc > 19)) {\\n      setTuanHoc(1);\\n    } else if (newHocKi === 2 && (tuanHoc < 20 || tuanHoc > 38)) {\\n      setTuanHoc(20);\\n    }\\n  };\\n\\n  // Available categories\\n  const categories = useMemo(() => {\\n    const list = [\'all\', \'Chuy\303\252n c\341\272\247n\', \'H\341\273\215c t\341\272\255p\', \'N\341\273\201 n\341\272\277p\', \'Phong tr\303\240o\', \'Lao \304\221\341\273\231ng - V\341\273\207 sinh\'];\\n    if (allowBonus) {\\n      list.push(\'\304\220i\341\273\203m c\341\273\231ng\');\\n    }\\n    return list;\\n  }, [allowBonus]);\\n\\n  // Pinned \\\"Hay d\303\271ng\\\" rules\\n  const frequentRules = useMemo(() => {\\n    return rules.filter(r => r.ghim && (allowBonus || r.loaiDiem !== \'Cong\'));\\n  }, [rules, allowBonus]);\\n\\n  // Filtered rules\\n  const filteredRules = useMemo(() => {\\n    return rules.filter(r => {\\n      // Hide bonus rules if disabled\\n      if (!allowBonus && r.loaiDiem === \'Cong\') return false;\\n\\n      // Category filter\\n      if (activeCategory !== \'all\' && r.nhomHanhVi !== activeCategory) {\\n        return false;\\n      }\\n\\n      // Search filter\\n      if (ruleSearch.trim()) {\\n        const cleanSearch = removeVietnameseAccents(ruleSearch);\\n        const cleanName = removeVietnameseAccents(r.tenHanhVi);\\n        const cleanGroup = removeVietnameseAccents(r.nhomHanhVi);\\n        return cleanName.includes(cleanSearch) || cleanGroup.includes(cleanSearch);\\n      }\\n\\n      return true;\\n    });\\n  }, [rules, allowBonus, activeCategory, ruleSearch]);\\n\\n  const selectedRule = useMemo(() => {\\n    return rules.find(r => r.maNoiQuy === selectedRuleId);\\n  }, [rules, selectedRuleId]);\\n\\n  if (!isOpen || students.length === 0) return null;\\n\\n  const handleSelectRule = (rule: RuleItem) => {\\n    setSelectedRuleId(rule.maNoiQuy);\\n\\n    // Fast save 1-touch mode for proficient cadres\\n    if (fastSaveMode) {\\n      onSave({\\n        students,\\n        rule,\\n        date,\\n        session,\\n        hocKi,\\n        tuanHoc,\\n        note: note.trim() || undefined,\\n      });\\n      onClose();\\n    }\\n  };\\n\\n  const handleManualSave = () => {\\n    if (!selectedRule) return;\\n\\n    onSave({\\n      students,\\n      rule: selectedRule,\\n      date,\\n      session,\\n      hocKi,\\n      tuanHoc,\\n      note: note.trim() || undefined,\\n    });\\n    onClose();\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-40 flex items-end justify-center bg-black/50 backdrop-blur-xs transition-opacity\\\">\\n      {/* Bottom Sheet Modal */}\\n      <div \\n        className=\\\"w-full max-w-xl bg-surface rounded-t-2xl border-t border-token shadow-2xl flex flex-col max-h-[88vh] animate-slide-up\\\"\\n        onClick={e => e.stopPropagation()}\\n      >\\n        {/* Handle bar */}\\n        <div className=\\\"w-full pt-2 pb-1 flex justify-center cursor-grab active:cursor-grabbing\\\">\\n          <div className=\\\"w-10 h-1 rounded-full bg-token opacity-60\\\" />\\n        </div>\\n\\n        {/* Sheet Header */}\\n        <div className=\\\"px-4 py-2 border-b border-token flex items-center justify-between\\\">\\n          <div className=\\\"min-w-0\\\">\\n            <div className=\\\"flex items-center gap-2 flex-wrap\\\">\\n              <span className=\\\"text-xs font-bold text-main\\\">\\n                {students.length === 1 ? students[0].hoTen : `Ghi ${students.length} h\341\273\215c sinh`}\\n              </span>\\n              <span className=\\\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent/15 text-accent border border-accent/20\\\">\\n                HK{hocKi} \302\267 Tu\341\272\247n {tuanHoc} \302\267 {session === \'Sang\' ? \'Bu\341\273\225i S\303\241ng\' : \'Bu\341\273\225i Chi\341\273\201u\'}\\n              </span>\\n            </div>\\n            <p className=\\\"text-[11px] text-muted truncate mt-0.5\\\">\\n              {students.length === 1 ? (\\n                `T\341\273\225 ${students[0].to} \302\267 D\303\243y ${students[0].dayBan} - B\303\240n ${students[0].soBan}`\\n              ) : (\\n                students.map(s => s.tenRutGon).join(\', \')\\n              )}\\n            </p>\\n          </div>\\n\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1.5 rounded-lg text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\\\"\\n            aria-label=\\\"\304\220\303\263ng b\341\272\243ng ghi nh\341\272\255n\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Time Hierarchy Selector Bar (N\304\203m h\341\273\215c -> H\341\273\215c k\303\254 -> Tu\341\272\247n -> Bu\341\273\225i, B\341\273\217 qua th\303\241ng) */}\\n        <div className=\\\"px-4 py-2 bg-surface-2 border-b border-token flex items-center justify-between gap-2\\\">\\n          <div className=\\\"flex items-center gap-1.5 min-w-0\\\">\\n            <Layers className=\\\"w-3.5 h-3.5 text-accent shrink-0\\\" />\\n            <span className=\\\"text-[11px] font-bold text-main truncate\\\">\\n              H\341\273\215c k\303\254 {hocKi} &gt; Tu\341\272\247n {tuanHoc} &gt; {session === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'}\\n            </span>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowTimeCustomizer(!showTimeCustomizer)}\\n            className=\\\"text-[11px] font-bold text-accent hover:underline flex items-center gap-1 cursor-pointer shrink-0\\\"\\n          >\\n            <span>{showTimeCustomizer ? \'Thu g\341\273\215n\' : \'\304\220\341\273\225i tu\341\272\247n/bu\341\273\225i\'}</span>\\n            <ChevronDown className={`w-3 h-3 transition-transform ${showTimeCustomizer ? \'rotate-180\' : \'\'}`} />\\n          </button>\\n        </div>\\n\\n        {/* Time Customizer Panel (Hierarchical Week & Session Picker) */}\\n        {showTimeCustomizer && (\\n          <div className=\\\"px-4 py-3 bg-accent/5 border-b border-token space-y-2.5 animate-fadeIn text-xs\\\">\\n            <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n              {/* 1. H\341\273\215c k\303\254 */}\\n              <div>\\n                <label className=\\\"block text-[10px] font-bold text-muted mb-0.5 uppercase tracking-wide\\\">\\n                  H\341\273\215c k\303\254\\n                </label>\\n                <select\\n                  value={hocKi}\\n                  onChange={e => handleChangeSemester(Number(e.target.value) as 1 | 2)}\\n                  className=\\\"w-full px-2 py-1.5 bg-surface border border-token rounded-lg text-xs font-semibold text-main cursor-pointer\\\"\\n                >\\n                  <option value={1}>H\341\273\215c k\303\254 1 (T1-19)</option>\\n                  <option value={2}>H\341\273\215c k\303\254 2 (T20-38)</option>\\n                </select>\\n              </div>\\n\\n              {/* 2. Tu\341\272\247n h\341\273\215c (List tu\341\272\247n t\306\260\306\241ng \341\273\251ng h\341\273\215c k\303\254 \304\221\303\243 ch\341\273\215n) */}\\n              <div>\\n                <label className=\\\"block text-[10px] font-bold text-muted mb-0.5 uppercase tracking-wide\\\">\\n                  Tu\341\272\247n h\341\273\215c ({hocKi === 1 ? \'1-19\' : \'20-38\'})\\n                </label>\\n                <select\\n                  value={tuanHoc}\\n                  onChange={e => setTuanHoc(Number(e.target.value))}\\n                  className=\\\"w-full px-2 py-1.5 bg-surface border border-token rounded-lg text-xs font-semibold text-main cursor-pointer\\\"\\n                >\\n                  {availableWeeks.map(w => (\\n                    <option key={w} value={w}>\\n                      Tu\341\272\247n {w}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n\\n              {/* 3. Bu\341\273\225i h\341\273\215c */}\\n              <div>\\n                <label className=\\\"block text-[10px] font-bold text-muted mb-0.5 uppercase tracking-wide\\\">\\n                  Bu\341\273\225i h\341\273\215c\\n                </label>\\n                <select\\n                  value={session}\\n                  onChange={e => setSession(e.target.value as \'Sang\' | \'Chieu\')}\\n                  className=\\\"w-full px-2 py-1.5 bg-surface border border-token rounded-lg text-xs font-semibold text-main cursor-pointer\\\"\\n                >\\n                  <option value=\\\"Sang\\\">Bu\341\273\225i S\303\241ng</option>\\n                  <option value=\\\"Chieu\\\">Bu\341\273\225i Chi\341\273\201u</option>\\n                </select>\\n              </div>\\n\\n              {/* 4. Ng\303\240y h\341\273\215c */}\\n              <div>\\n                <label className=\\\"block text-[10px] font-bold text-muted mb-0.5 uppercase tracking-wide\\\">\\n                  Ng\303\240y ghi nh\341\272\255n\\n                </label>\\n                <input\\n                  type=\\\"date\\\"\\n                  value={date}\\n                  onChange={e => setDate(e.target.value)}\\n                  className=\\\"w-full px-2 py-1 bg-surface border border-token rounded-lg text-xs font-semibold text-main\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* Note input */}\\n            <div>\\n              <label className=\\\"block text-[10px] font-bold text-muted mb-0.5 uppercase tracking-wide\\\">\\n                Ghi ch\303\272 th\303\252m (t\303\271y ch\341\273\215n)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={note}\\n                onChange={e => setNote(e.target.value)}\\n                placeholder=\\\"VD: Ti\341\272\277t 3, \304\221\303\243 nh\341\272\257c nh\341\273\237 l\341\272\247n 1...\\\"\\n                className=\\\"w-full px-2.5 py-1 bg-surface border border-token rounded-lg text-xs text-main placeholder:text-muted\\\"\\n              />\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Sheet Content (Scrollable) */}\\n        <div className=\\\"p-4 overflow-y-auto space-y-4\\\">\\n          {/* Section: Hay d\303\271ng (Fast thumb taps) */}\\n          {!ruleSearch && activeCategory === \'all\' && frequentRules.length > 0 && (\\n            <div>\\n              <div className=\\\"flex items-center gap-1.5 text-xs font-semibold text-muted mb-2\\\">\\n                <Star className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n                <span>Hay d\303\271ng</span>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-3 gap-2\\\">\\n                {frequentRules.map(rule => {\\n                  const isSelected = selectedRuleId === rule.maNoiQuy;\\n                  return (\\n                    <button\\n                      key={rule.maNoiQuy}\\n                      type=\\\"button\\\"\\n                      onClick={() => handleSelectRule(rule)}\\n                      className={`min-h-[44px] p-2 rounded-xl border text-left flex flex-col justify-between transition-all cursor-pointer ${\\n                        isSelected \\n                          ? \'border-accent bg-accent/10 ring-2 ring-accent/30\' \\n                          : \'border-token bg-surface hover:bg-surface-2\'\\n                      }`}\\n                    >\\n                      <span className=\\\"text-xs font-semibold text-main line-clamp-2 leading-tight\\\">\\n                        {rule.tenHanhVi}\\n                      </span>\\n                      <div className=\\\"flex items-center justify-between mt-1 text-[11px]\\\">\\n                        <span className=\\\"font-bold text-[var(--st-bad)]\\\">\\n                          -{rule.diemSo}\304\221\\n                        </span>\\n                        {rule.mucDo === \'Nang\' && (\\n                          <span className=\\\"text-[9px] font-bold px-1 rounded bg-[var(--st-bad)]/15 text-[var(--st-bad)]\\\">\\n                            N\341\272\267ng\\n                          </span>\\n                        )}\\n                      </div>\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* Search Rule */}\\n          <div className=\\\"relative\\\">\\n            <Search className=\\\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={ruleSearch}\\n              onChange={e => setRuleSearch(e.target.value)}\\n              placeholder=\\\"T\303\254m h\303\240nh vi vi ph\341\272\241m...\\\"\\n              className=\\\"w-full pl-9 pr-4 py-2 bg-surface border border-token rounded-lg text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40\\\"\\n            />\\n          </div>\\n\\n          {/* Category Filter Tabs */}\\n          <div className=\\\"flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5\\\">\\n            {categories.map(cat => (\\n              <button\\n                key={cat}\\n                type=\\\"button\\\"\\n                onClick={() => setActiveCategory(cat)}\\n                className={`px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors cursor-pointer ${\\n                  activeCategory === cat \\n                    ? \'bg-primary text-on-primary font-bold\' \\n                    : \'bg-surface-2 border border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                {cat === \'all\' ? \'T\341\272\245t c\341\272\243\' : cat}\\n              </button>\\n            ))}\\n          </div>\\n\\n          {/* Rules List */}\\n          <div className=\\\"space-y-1.5 max-h-48 overflow-y-auto pr-1\\\">\\n            {filteredRules.map(rule => {\\n              const isSelected = selectedRuleId === rule.maNoiQuy;\\n              const isBonus = rule.loaiDiem === \'Cong\';\\n\\n              return (\\n                <button\\n                  key={rule.maNoiQuy}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleSelectRule(rule)}\\n                  className={`w-full min-h-[44px] px-3 py-2 rounded-xl border flex items-center justify-between text-left transition-colors cursor-pointer ${\\n                    isSelected \\n                      ? \'border-accent bg-accent/10 ring-2 ring-accent/30\' \\n                      : \'border-token bg-surface hover:bg-surface-2\'\\n                  }`}\\n                >\\n                  <div className=\\\"min-w-0 pr-2\\\">\\n                    <div className=\\\"text-xs font-semibold text-main truncate\\\">\\n                      {rule.tenHanhVi}\\n                    </div>\\n                    <div className=\\\"text-[10px] text-muted flex items-center gap-1.5 mt-0.5\\\">\\n                      <span>{rule.nhomHanhVi}</span>\\n                      {rule.mucDo === \'Nang\' && (\\n                        <span className=\\\"text-[9px] font-bold text-[var(--st-bad)]\\\">\302\267 M\341\273\251c N\341\272\267ng</span>\\n                      )}\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"shrink-0 flex items-center gap-2\\\">\\n                    <span className={`text-xs font-bold px-2 py-0.5 rounded-full ${\\n                      isBonus \\n                        ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' \\n                        : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\\n                    }`}>\\n                      {isBonus ? `+${rule.diemSo}` : `-${rule.diemSo}`}\304\221\\n                    </span>\\n                    {isSelected && (\\n                      <span className=\\\"w-4 h-4 rounded-full bg-accent text-on-accent flex items-center justify-center\\\">\\n                        <Check className=\\\"w-2.5 h-2.5 stroke-[3]\\\" />\\n                      </span>\\n                    )}\\n                  </div>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Sheet Footer: Big Thumb Save Button */}\\n        <div className=\\\"p-4 border-t border-token bg-surface flex items-center gap-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"flex-1 py-3 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\\\"\\n          >\\n            H\341\273\247y\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            disabled={!selectedRule}\\n            onClick={handleManualSave}\\n            className={`flex-2 py-3 rounded-xl text-xs font-bold transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer ${\\n              selectedRule \\n                ? \'bg-primary text-on-primary hover:opacity-95 active:scale-98\' \\n                : \'bg-surface-2 text-muted border border-token cursor-not-allowed\'\\n            }`}\\n          >\\n            <Check className=\\\"w-4 h-4 stroke-[2.5]\\\" />\\n            <span>\\n              {selectedRule \\n                ? `L\306\260u: ${selectedRule.tenHanhVi} (${selectedRule.loaiDiem === \'Cong\' ? \'+\' : \'-\'}${selectedRule.diemSo}\304\221) [T${tuanHoc}]` \\n                : \'Ch\341\273\215n h\303\240nh vi \304\221\341\273\203 L\306\260u\'}\\n            </span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update RecordBottomSheet with dynamic week selection corresponding to semester and omit month\", \"Overwrite\":true, \"TargetFile\":\"/src/components/record/RecordBottomSheet.tsx\", \"toolAction\":\"Writing updated RecordBottomSheet\", \"toolSummary\":\"Update RecordBottomSheet with semester week selection\"}"
      thinking_signature: "\022\320\f\n\315\f\001i\024}\023@\307\000W\2218\314\344c2%\261\f\356\241\'_\0171\261\263\331\271\314\242Y\026\345\234\233\301~\325a\v\f\360\313(}o\017\234x>\260\217!U\240\037\204\307\340\241.-\362\330\240\262!\000\317C\a\343M\346M\311\363\032\234%\240a\311\"s\272\n\'\240\016=H\326s\355\216q\236\372\034\006\203\276\002:\233\003\bL\312\017\027c\217\n\223t\347\232:\300\217:\027J\362\345\241\356iU\365z\233Q\361\363\347y\241\037p+^\\\034\305\000u<\226\254\3626\257>\317P\325\355\350Y\207z\3559^\027\360\363\004:\351\241\'\341\303Z[\177k\217\247\260\251+\207\a\331A\354\326Z\225\213\207\257l\'\227\363;\362s\344\034\020h\023\305\310v\"\\p\361d\016\031\a\001\242\332)8\362\216%\000\307\220\211\211\t\002\302(}\206\364\246\004\335Y\303$GZ\256\035KlD1\aw]\355,\215cB\3457;D-\274\3708\200\333>\312\221\177gX\342\2745\376/\270\034\261\300\313\243s\325C\312\327+\343%K\275\fL\254\031\326\311\252\271\236l;\n\256\200\261+m8\017\273\t\363\253V\305\344\020\021\370<\212\2455\317\352\360\017ON\206\364\242\327\345\242\340R\233\300}\037HY\365[~\375\257\224\222\377\275\034\225\351\307\t\270\240\3114\223\314J\255|\233\237k\023=\330_\376am\322\221\272\325]S\270\305q|\223\226\206\241\312-\322n\"\237Ai-\307n+\214\315-\026\272Z\2710\301\037\f!\305\352\t\372P\204\3628\023\303j\233,!\2707\3618\021|(hEZtzx\\z\203eE0\bW\370\342\263\n\341\\\313-\312I\353\321\253\177\3718\224z\317\330\235R\324\256\267\321\204\313:\255#\301\210\301\021\207\371\256A^\377\262\335\331Gh\b}\255\250\261\354\022\022\252{\351\345\205\213~\324>\036\213\025hS\356\242X\273|G:\233i\243\033\274\a\226\231q\031AT\005\352c\242$\365~\236\020\337\333\267\020\023\310\300\270o\357\215\225\2461\312L:\254F\217\a\335bGD\017e\222\002\3517\351\236\252\035\344\260\243\312\242\016\211\301&^\321\316\371\270\373\202\017?\006xg\254t_\263\365\001M\000\376Mz\r\f)\"uK\220\266\025\375\2241\236\324\255\213\331W\244\305\235\271\240\360+\352\327\266SM#b\023\306\366\255~\264\210\000\375x4@\217\261\340i\373\\\260\366O\016l\256\223\272\262\2222\035\025\223R\373V{\310\016I[.\tG\006\331K*\251\336\017\266!\277\375{\224\233\002S\353\017\210\322\003\332\337\031\233\370W\376\356\224\360\017\325[Z\262\244fc\230\230\220ei_\252\3452\317\210\021C\253\016W\324\004\024\000h\002\030\241\257c):\376C\357\267\202\206&\305a\341\022\363]\313\345\221}JW\001\321:\330\005\213\000\312Y\\\320\237\265ixT\247\336\003O\317M+n)\000\376\364N\004.\'\240\t\341h(>\000\006e\322S\b\336rG|4C\221JY\271\006jY\033\333\334\250z\242\212\213A\246\236\362\n\020l\000\320\034\350\230\310V\267\336~?%\'\016p\250\302\367\375\320\237Y\t\301\250%\227\237\321\207p@\247\022\244\246+{,\322\200`\233)K<\032\250\021D\004\252\345\016\323\300\213\361V0\314c\363\262\250f\f\343C]~r]\231QR\202\a\034W\301\241\002\223%d\274\241\377\307*{\217\343<?\214a\2463\315\337>N\202\331~\341t\v\307jQ\236\334}\257\272ZM\266Bo\232c0xsK\310a_\337>\331\033+\r\235\016\306\252\005w\371\333\376\302\037\221\v\357\226\201Gc\344\222\302\n\210do(P\256\277Z/<\350}t8\323\335\034\032\206S\037\332@+\005<\224\346\232D\357\336\377\214\031\324\313\004\240D\267!\212o:\353w\005(z\250\246\0266\333h_\362\a\031\240;\2036BLw$\372CH\277.\207\237\027FE\373\333\256\261\227L\312\330#\225\304\331\'\346f\314\300.\'\333\265\250\301\322\224e\315\367+s(\240\003\260\351l|\276\2704+i\003\360Jq\255em!\264\245\323\327\352\240z\026\325\210\fH\017#a\364\v\363\301\267\230\031e\314\006q\240\231\202\036\355R\024\357@:\357q/:z\371\237\2032J\266\227\326o\000\305\370@\253\354\271\326\315\037\302\272\312&2\263m\267?v\305;\3405\f\230<\304\204\331Du\2448\233\310#\364\036\341&\222\247yx\230\265\354G\226\333\\\377v\346\022\025>\305\373@\203\256yO\276\236\\\265g\324U\376\322\373\306}\272\241r\360\0354\326\371\210~\377X\347\317\242_R{\323\b\230\260\234+[e\230s\263v\364Eu\375R\265\330\364\026\253\274>\315\v\002`s\332#\334\262\201i\ay{\317\003d\313\274\223\272\374\337\300]\025\002\'\364\331\335y\213\351\203\251\351\220r\353\262]\021^\310\a\n\207\311\311i\t\213S\246$k\030\244\245\276\325z\304\365\273:*\206\213\006\270\241