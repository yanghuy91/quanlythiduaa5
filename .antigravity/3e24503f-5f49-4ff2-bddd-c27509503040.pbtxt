      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import { DisciplineRecord, StudentWeekSummary, TeacherSettings, WeekEvaluation, StatusColorLevel } from \'../types\';\\n\\nexport function calculateStudentWeekSummary(\\n  maHS: string,\\n  hoTen: string,\\n  to: number,\\n  tuanHoc: number,\\n  records: DisciplineRecord[],\\n  settings: TeacherSettings\\n): StudentWeekSummary {\\n  // L\341\273\215c b\341\272\243n ghi c\341\273\247a h\341\273\215c sinh trong tu\341\272\247n\\n  const studentRecords = records.filter(r => \\n    r.maHS === maHS &&\\n    r.tuanHoc === tuanHoc &&\\n    r.trangThai !== \'DaHuy\' &&\\n    r.trangThai !== \'DaChapNhan\' // B\341\272\243n ghi \304\221\303\243 ch\341\272\245p nh\341\272\255n gi\341\272\243i tr\303\254nh th\303\254 kh\303\264ng t\303\255nh \304\221i\341\273\203m\\n  );\\n\\n  let tongDiemTru = 0;\\n  let tongDiemCong = 0;\\n  let coLoiNang = false;\\n\\n  studentRecords.forEach(rec => {\\n    if (rec.loaiDiem === \'Tru\') {\\n      tongDiemTru += rec.diemSo;\\n      if (rec.mucDo === \'Nang\') {\\n        coLoiNang = true;\\n      }\\n    } else if (rec.loaiDiem === \'Cong\' && settings.batDiemCong) {\\n      tongDiemCong += rec.diemSo;\\n    }\\n  });\\n\\n  const diemHienTai = settings.diemKhoiDau - tongDiemTru + tongDiemCong;\\n\\n  // X\341\272\277p lo\341\272\241i c\303\241 nh\303\242n\\n  let xepLoai: WeekEvaluation = \'ChuaDat\';\\n  if (diemHienTai >= settings.nguongTot) {\\n    xepLoai = \'Tot\';\\n  } else if (diemHienTai >= settings.nguongKha) {\\n    xepLoai = \'Kha\';\\n  } else if (diemHienTai >= settings.nguongDat) {\\n    xepLoai = \'Dat\';\\n  } else {\\n    xepLoai = \'ChuaDat\';\\n  }\\n\\n  // M\341\273\251c m\303\240u tr\341\272\241ng th\303\241i vi\341\273\201n s\306\241 \304\221\341\273\223\\n  let mucMau: StatusColorLevel = \'none\';\\n  if (settings.batDiemCong && tongDiemCong > tongDiemTru && tongDiemTru === 0) {\\n    mucMau = \'ok\';\\n  } else if (tongDiemTru >= 10 || coLoiNang) {\\n    mucMau = \'bad\';\\n  } else if (tongDiemTru > 0) {\\n    mucMau = \'warn\';\\n  } else {\\n    mucMau = \'none\';\\n  }\\n\\n  return {\\n    maHS,\\n    hoTen,\\n    to,\\n    tuanHoc,\\n    diemKhoiDau: settings.diemKhoiDau,\\n    tongDiemTru,\\n    tongDiemCong,\\n    diemHienTai,\\n    xepLoai,\\n    mucMau,\\n    soLoiTrongTuan: studentRecords.length,\\n    coLoiNang\\n  };\\n}\\n\\nexport function getCurrentSession(): \'Sang\' | \'Chieu\' {\\n  const hour = new Date().getHours();\\n  // Bu\341\273\225i s\303\241ng: 06:30 -> 12:00, Bu\341\273\225i chi\341\273\201u: 12:00 -> 18:00\\n  return hour < 12 ? \'Sang\' : \'Chieu\';\\n}\\n\\nexport function checkDuplicateRecord(\\n  records: DisciplineRecord[],\\n  maHS: string,\\n  ngayHoc: string,\\n  buoi: \'Sang\' | \'Chieu\',\\n  maNoiQuy: string\\n): {\\n  isDuplicate: boolean;\\n  isIdentical: boolean;\\n  existingRecords: DisciplineRecord[];\\n  lanThu: number;\\n} {\\n  const existing = records.filter(\\n    r => r.maHS === maHS &&\\n         r.ngayHoc === ngayHoc &&\\n         r.buoi === buoi &&\\n         r.trangThai !== \'DaHuy\'\\n  );\\n\\n  if (existing.length === 0) {\\n    return {\\n      isDuplicate: false,\\n      isIdentical: false,\\n      existingRecords: [],\\n      lanThu: 1\\n    };\\n  }\\n\\n  const isIdentical = existing.some(r => r.maNoiQuy === maNoiQuy);\\n\\n  return {\\n    isDuplicate: true,\\n    isIdentical,\\n    existingRecords: existing,\\n    lanThu: existing.length + 1\\n  };\\n}\\n\", \"Description\":\"Calculation for individual student discipline scores, week summary, duplicate detection, and session time\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/emulation.ts\", \"toolAction\":\"Creating emulation utility\", \"toolSummary\":\"Create src/utils/emulation.ts\"}"
      thinking_signature: "\022\245\001\n\242\001\001i\024}\023\020$K\362q\250\245z.\314Di\375\030\200\306\364\205\362h\353l\373\333\352\373S\020_&\351\232\300<T\345:\357\364\250{\265Z\353w.{\376\371\2677~$q\352\030\366\251/>\t\222\217\032\302\207\350\265\026\331<\fm\357\346\340\270W\003\03298\275\232\352\306\032\210\367\306;/\214T\225\366\273\264\322l\366\211D\031\177?p\315#\304\005\022\266\224\331;_\220\322 \033@\275\242\212J\356e\246\207\003fiz\261\006=\336\337\273\311h\030\303\203H\351\273=\225\332\005\206y\361]\265"
