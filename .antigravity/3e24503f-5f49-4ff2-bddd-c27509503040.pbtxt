  code_action {
    action_spec {
      command {
        instruction: "Add handleUpdateStudentAvatar and handleImportRecords and pass down props in App.tsx"
        is_edit: true
        file {
          absolute_uri: "file:///src/App.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  // Teacher updates classroom seating and layout\n  const handleUpdateLayout = useCallback((newLayout: SeatLayoutNode[], updatedStudents: Student[]) => {\n    setLayout(newLayout);\n    setStudents(updatedStudents);\n    localStorage.setItem(\'app_layout_10a5\', JSON.stringify(newLayout));\n    localStorage.setItem(\'app_students_10a5\', JSON.stringify(updatedStudents));\n    setToast({\n      id: Date.now().toString(),\n      message: \'\304\220\303\243 l\306\260u s\306\241 \304\221\341\273\223 l\341\273\233p h\341\273\215c \342\234\250\',\n      subMessage: \'V\341\273\213 tr\303\255 42 h\341\273\215c sinh v\303\240 b\341\273\221 tr\303\255 ph\303\262ng h\341\273\215c \304\221\303\243 \304\221\306\260\341\273\243c c\341\272\255p nh\341\272\255t th\303\240nh c\303\264ng!\',\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-app text-main antialiased selection:bg-accent/20\">\n      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n          />\n        )}\n\n        {currentUser && currentRole !== \'GV\' && currentRole !== \'HS\' && (\n          <CadreView\n            currentCadre={currentUser as Student}\n            cadreRole={currentRole}\n            allStudents={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onAddRecord={handleAddRecord}\n            onVoidRecord={handleVoidRecord}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n\n        {currentUser && currentRole === \'HS\' && (\n          <StudentView\n            currentStudent={currentUser as Student}\n            allStudents={students}\n            layout={layout}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n      </main>"
          replacement_content: "  // Teacher updates classroom seating and layout\n  const handleUpdateLayout = useCallback((newLayout: SeatLayoutNode[], updatedStudents: Student[]) => {\n    setLayout(newLayout);\n    setStudents(updatedStudents);\n    localStorage.setItem(\'app_layout_10a5\', JSON.stringify(newLayout));\n    localStorage.setItem(\'app_students_10a5\', JSON.stringify(updatedStudents));\n    setToast({\n      id: Date.now().toString(),\n      message: \'\304\220\303\243 l\306\260u s\306\241 \304\221\341\273\223 l\341\273\233p h\341\273\215c \342\234\250\',\n      subMessage: \'V\341\273\213 tr\303\255 42 h\341\273\215c sinh v\303\240 b\341\273\221 tr\303\255 ph\303\262ng h\341\273\215c \304\221\303\243 \304\221\306\260\341\273\243c c\341\272\255p nh\341\272\255t th\303\240nh c\303\264ng!\',\n    });\n  }, []);\n\n  // Student avatar update\n  const handleUpdateStudentAvatar = useCallback((studentId: string, avatarUrl: string) => {\n    setStudents(prev => {\n      const updated = prev.map(s => (s.maHS === studentId ? { ...s, avatarUrl } : s));\n      localStorage.setItem(\'app_students_10a5\', JSON.stringify(updated));\n      return updated;\n    });\n\n    setCurrentUser(prev => {\n      if (prev && \'maHS\' in prev && (prev as Student).maHS === studentId) {\n        return { ...prev, avatarUrl } as Student;\n      }\n      return prev;\n    });\n\n    setToast({\n      id: Date.now().toString(),\n      message: \'\304\220\303\243 c\341\272\255p nh\341\272\255t \341\272\243nh \304\221\341\272\241i di\341\273\207n \342\234\250\',\n      subMessage: \'\341\272\242nh \304\221\341\272\241i di\341\273\207n m\341\273\233i \304\221\303\243 \304\221\306\260\341\273\243c \303\241p d\341\273\245ng v\303\240o h\341\273\223 s\306\241 v\303\240 s\306\241 \304\221\341\273\223 l\341\273\233p!\',\n    });\n  }, []);\n\n  // Teacher import time-stamped records from file\n  const handleImportRecords = useCallback((newRecords: DisciplineRecord[]) => {\n    setRecords(prev => [...newRecords, ...prev]);\n    setToast({\n      id: Date.now().toString(),\n      message: `\304\220\303\243 n\341\272\241p ${newRecords.length} b\341\272\243n ghi th\341\273\235i gian \342\234\250`,\n      subMessage: \'D\341\273\257 li\341\273\207u thi \304\221ua t\341\273\253 file \304\221\303\243 \304\221\306\260\341\273\243c t\303\255ch h\341\273\243p th\303\240nh c\303\264ng v\303\240o h\341\273\207 th\341\273\221ng!\',\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-app text-main antialiased selection:bg-accent/20\">\n      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n            onImportRecords={handleImportRecords}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n          />\n        )}\n\n        {currentUser && currentRole !== \'GV\' && currentRole !== \'HS\' && (\n          <CadreView\n            currentCadre={currentUser as Student}\n            cadreRole={currentRole}\n            allStudents={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onAddRecord={handleAddRecord}\n            onVoidRecord={handleVoidRecord}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n\n        {currentUser && currentRole === \'HS\' && (\n          <StudentView\n            currentStudent={currentUser as Student}\n            allStudents={students}\n            layout={layout}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onSubmitExplanation={handleSubmitExplanation}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n          />\n        )}\n      </main>"
