    replacement_infos {
      original_chunk {
        target_content: "  // Attempt to submit a rule violation\n  const handleAttemptSubmitRule = (rule: RuleItem, extraNote?: string, date?: string, buoi?: \'Sang\' | \'Chieu\') => {\n    const targetStudents = isMultiSelect ? selectedStudents : (singleSelectedStudent ? [singleSelectedStudent] : []);\n    if (targetStudents.length === 0) return;\n\n    const duplicates: { student: Student; existingRecords: DisciplineRecord[] }[] = [];\n    const safeIds: string[] = [];\n    const targetDate = date || new Date().toISOString().split(\'T\')[0];\n    const targetBuoi = buoi || (new Date().getHours() < 12 ? \'Sang\' : \'Chieu\');\n\n    targetStudents.forEach(st => {\n      const dupCheck = checkDuplicateRecord(\n        records,\n        st.maHS,\n        targetDate,\n        targetBuoi,\n        rule.maNoiQuy\n      );\n\n      if (dupCheck.isDuplicate) {\n        duplicates.push({ student: st, existingRecords: dupCheck.existingRecords });\n      } else {\n        safeIds.push(st.maHS);\n      }\n    });\n\n    if (duplicates.length > 0) {\n      setDuplicateWarningData({\n        pendingRule: rule,\n        duplicateStudents: duplicates,\n        safeStudentIds: safeIds,\n      });\n      return;\n    }\n\n    // No duplicates: proceed to commit\n    commitRecords(targetStudents, rule, extraNote, date, buoi, false);\n  };\n\n  // Actually commit records to state\n  const commitRecords = (\n    targets: Student[],\n    rule: RuleItem,\n    extraNote?: string,\n    date?: string,\n    buoi?: \'Sang\' | \'Chieu\',\n    confirmedDuplicate = false\n  ) => {\n    const targetDate = date || new Date().toISOString().split(\'T\')[0];\n    const targetBuoi = buoi || (new Date().getHours() < 12 ? \'Sang\' : \'Chieu\');\n\n    targets.forEach(student => {\n      onAddRecord({\n        namHoc: CURRENT_SCHOOL_YEAR,\n        hocKi: 1,\n        thang: new Date(targetDate).getMonth() + 1,\n        tuanHoc: currentWeek,\n        ngayHoc: targetDate,\n        buoi: targetBuoi,\n        doiTuong: \'HocSinh\',\n        maHS: student.maHS,\n        hoTen: student.hoTen,\n        to: student.to,\n        maNoiQuy: rule.maNoiQuy,\n        nhomHanhVi: rule.nhomHanhVi,\n        tenHanhVi: rule.tenHanhVi,\n        mucDo: rule.mucDo,\n        diemSo: rule.diemSo,\n        loaiDiem: rule.loaiDiem,\n        ghiChu: extraNote,\n        nguoiGhi: currentCadre.hoTen,\n        vaiTroNguoiGhi: cadreRole,\n        nguonGhi: \'TrucTiep\',\n        lanThuTrongBuoi: 1,\n        daXacNhanTrung: confirmedDuplicate,\n        trangThai: \'HieuLuc\',\n      });\n    });\n\n    // Reset selection & close sheet\n    setSelectedStudentIds([]);\n    setIsBottomSheetOpen(false);\n    setDuplicateWarningData(null);\n  };"
        replacement_content: "  // Attempt to submit a rule violation\n  const handleAttemptSubmitRule = (\n    rule: RuleItem, \n    extraNote?: string, \n    date?: string, \n    buoi?: \'Sang\' | \'Chieu\',\n    hocKi: 1 | 2 = 1,\n    tuanHoc: number = currentWeek\n  ) => {\n    const targetStudents = isMultiSelect ? selectedStudents : (singleSelectedStudent ? [singleSelectedStudent] : []);\n    if (targetStudents.length === 0) return;\n\n    const duplicates: { student: Student; existingRecords: DisciplineRecord[] }[] = [];\n    const safeIds: string[] = [];\n    const targetDate = date || new Date().toISOString().split(\'T\')[0];\n    const targetBuoi = buoi || (new Date().getHours() < 12 ? \'Sang\' : \'Chieu\');\n\n    targetStudents.forEach(st => {\n      const dupCheck = checkDuplicateRecord(\n        records,\n        st.maHS,\n        targetDate,\n        targetBuoi,\n        rule.maNoiQuy\n      );\n\n      if (dupCheck.isDuplicate) {\n        duplicates.push({ student: st, existingRecords: dupCheck.existingRecords });\n      } else {\n        safeIds.push(st.maHS);\n      }\n    });\n\n    if (duplicates.length > 0) {\n      setDuplicateWarningData({\n        pendingRule: rule,\n        duplicateStudents: duplicates,\n        safeStudentIds: safeIds,\n      });\n      return;\n    }\n\n    // No duplicates: proceed to commit\n    commitRecords(targetStudents, rule, extraNote, date, buoi, false, hocKi, tuanHoc);\n  };\n\n  // Actually commit records to state\n  const commitRecords = (\n    targets: Student[],\n    rule: RuleItem,\n    extraNote?: string,\n    date?: string,\n    buoi?: \'Sang\' | \'Chieu\',\n    confirmedDuplicate = false,\n    hocKi: 1 | 2 = 1,\n    tuanHoc: number = currentWeek\n  ) => {\n    const targetDate = date || new Date().toISOString().split(\'T\')[0];\n    const targetBuoi = buoi || (new Date().getHours() < 12 ? \'Sang\' : \'Chieu\');\n\n    targets.forEach(student => {\n      onAddRecord({\n        namHoc: CURRENT_SCHOOL_YEAR,\n        hocKi: hocKi,\n        thang: new Date(targetDate).getMonth() + 1,\n        tuanHoc: tuanHoc,\n        ngayHoc: targetDate,\n        buoi: targetBuoi,\n        doiTuong: \'HocSinh\',\n        maHS: student.maHS,\n        hoTen: student.hoTen,\n        to: student.to,\n        maNoiQuy: rule.maNoiQuy,\n        nhomHanhVi: rule.nhomHanhVi,\n        tenHanhVi: rule.tenHanhVi,\n        mucDo: rule.mucDo,\n        diemSo: rule.diemSo,\n        loaiDiem: rule.loaiDiem,\n        ghiChu: extraNote,\n        nguoiGhi: currentCadre.hoTen,\n        vaiTroNguoiGhi: cadreRole,\n        nguonGhi: \'TrucTiep\',\n        lanThuTrongBuoi: 1,\n        daXacNhanTrung: confirmedDuplicate,\n        trangThai: \'HieuLuc\',\n      });\n    });\n\n    // Reset selection & close sheet\n    setSelectedStudentIds([]);\n    setIsBottomSheetOpen(false);\n    setDuplicateWarningData(null);\n  };"
