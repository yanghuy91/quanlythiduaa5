  view_file {
    absolute_path_uri: "file:///src/components/student-picker/SeatGrid.tsx"
    end_line: 368
    content: "import React, { useState } from \'react\';\nimport { \n  Check, \n  AlertCircle, \n  AlertTriangle, \n  CheckCircle,\n  Armchair,\n  BookOpen,\n  DoorOpen\n} from \'lucide-react\';\nimport { Student, SeatLayoutNode, StudentWeekSummary, RoleCode } from \'../../types\';\nimport { ROLE_CONFIG } from \'../../data/mockData\';\n\ninterface SeatGridProps {\n  layout: SeatLayoutNode[];\n  students: Student[];\n  studentSummaries?: Record<string, StudentWeekSummary>;\n  selectedStudentIds: string[];\n  onSelectStudent: (student: Student) => void;\n  viewerRole?: RoleCode;\n  viewerTo?: number; // 1..4 if viewer is TT\n  showStatusColors?: boolean; // false during login\n  isMultiSelect?: boolean;\n}\n\nexport const SeatGrid: React.FC<SeatGridProps> = ({\n  layout,\n  students,\n  studentSummaries = {},\n  selectedStudentIds,\n  onSelectStudent,\n  viewerRole,\n  viewerTo,\n  showStatusColors = true,\n  isMultiSelect = false,\n}) => {\n  const [activeD\303\243yTab, setActiveD\303\243yTab] = useState<\'all\' | \'1-2\' | \'3-4\' | \'5-6\'>(\'all\');\n\n  // Map student by ID\n  const studentMap = React.useMemo(() => {\n    const map = new Map<string, Student>();\n    students.forEach(s => map.set(s.maHS, s));\n    return map;\n  }, [students]);\n\n  // Determine if a seat is locked for this viewer\n  // T\341\273\225 tr\306\260\341\273\237ng: only members of their group are clickable\n  const isSeatLockedForViewer = (student?: Student): boolean => {\n    if (!student) return false;\n    if (viewerRole === \'TT\' && viewerTo !== undefined) {\n      return student.to !== viewerTo;\n    }\n    return false;\n  };\n\n  // Group nodes by row\n  const rows = React.useMemo(() => {\n    const grouped: Record<number, SeatLayoutNode[]> = {};\n    layout.forEach(node => {\n      if (!grouped[node.hang]) {\n        grouped[node.hang] = [];\n      }\n      grouped[node.hang].push(node);\n    });\n\n    Object.keys(grouped).forEach(r => {\n      grouped[Number(r)].sort((a, b) => a.cot - b.cot);\n    });\n\n    return grouped;\n  }, [layout]);\n\n  // Filter columns based on mobile tab if not \'all\'\n  const shouldRenderCol = (cot: number): boolean => {\n    if (activeD\303\243yTab === \'all\') return true;\n    if (activeD\303\243yTab === \'1-2\') return cot === 0 || cot === 1 || cot === 2;\n    if (activeD\303\243yTab === \'3-4\') return cot === 3 || cot === 4 || cot === 5;\n    if (activeD\303\243yTab === \'5-6\') return cot === 6 || cot === 7;\n    return true;\n  };\n\n  return (\n    <div className=\"w-full flex flex-col gap-2\">\n      {/* Mobile D\303\243y Selector Tabs */}\n      <div className=\"flex sm:hidden items-center justify-between gap-1 p-1 bg-surface-2 rounded-lg border border-token text-xs\">\n        <button\n          onClick={() => setActiveD\303\243yTab(\'all\')}\n          className={`flex-1 py-1 rounded-md font-medium transition-colors ${\n            activeD\303\243yTab === \'all\' \n              ? \'bg-surface text-main font-bold shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          C\341\272\243 l\341\273\233p\n        </button>\n        <button\n          onClick={() => setActiveD\303\243yTab(\'1-2\')}\n          className={`flex-1 py-1 rounded-md font-medium transition-colors ${\n            activeD\303\243yTab === \'1-2\' \n              ? \'bg-surface text-main font-bold shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          D\303\243y 1-2\n        </button>\n        <button\n          onClick={() => setActiveD\303\243yTab(\'3-4\')}\n          className={`flex-1 py-1 rounded-md font-medium transition-colors ${\n            activeD\303\243yTab === \'3-4\' \n              ? \'bg-surface text-main font-bold shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          D\303\243y 3-4\n        </button>\n        <button\n          onClick={() => setActiveD\303\243yTab(\'5-6\')}\n          className={`flex-1 py-1 rounded-md font-medium transition-colors ${\n            activeD\303\243yTab === \'5-6\' \n              ? \'bg-surface text-main font-bold shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          D\303\243y 5-6\n        </button>\n      </div>\n\n      {/* Seating Container */}\n      <div className=\"w-full overflow-x-auto no-scrollbar pb-2 pt-1\">\n        <div className=\"min-w-[340px] max-w-full mx-auto flex flex-col gap-2\">\n          {Object.entries(rows).map(([rowKey, nodes]) => {\n            const rowIndex = Number(rowKey);\n\n            // H\303\240ng 0: \304\220\341\272\247u l\341\273\233p - B\303\240n GV, B\341\272\243ng, C\341\273\255a ch\303\255nh \341\273\237 d\341\272\241ng ch\341\273\257 KH\303\224NG \304\220\303\223NG \303\224\n            if (rowIndex === 0) {\n              const banGVNode = nodes.find(n => n.loaiO === \'banGV\');\n              const cuaNode = nodes.find(n => n.loaiO === \'cua\');\n              const isBanGVLeft = (banGVNode?.cot ?? 0) <= (cuaNode?.cot ?? 7);\n\n              return (\n                <div \n                  key={rowKey}\n                  className=\"w-full flex items-center justify-between px-3 py-1.5 text-xs text-muted border-b border-dashed border-token/60 mb-1 select-none font-medium\"\n                >\n                  {isBanGVLeft ? (\n                    <>\n                      <span className=\"text-[var(--role-gv-fg)] font-bold text-xs tracking-tight\">\n                        B\303\240n GV\n                      </span>\n                      <span className=\"text-main font-bold tracking-widest text-[11px] uppercase opacity-75\">\n                        \342\200\224 B\341\272\242NG \342\200\224\n                      </span>\n                      <span className=\"text-muted font-bold text-xs tracking-tight\">\n                        C\341\273\255a ch\303\255nh\n                      </span>\n                    </>\n                  ) : (\n                    <>\n                      <span className=\"text-muted font-bold text-xs tracking-tight\">\n                        C\341\273\255a ch\303\255nh\n                      </span>\n                      <span className=\"text-main font-bold tracking-widest text-[11px] uppercase opacity-75\">\n                        \342\200\224 B\341\272\242NG \342\200\224\n                      </span>\n                      <span className=\"text-[var(--role-gv-fg)] font-bold text-xs tracking-tight\">\n                        B\303\240n GV\n                      </span>\n                    </>\n                  )}\n                </div>\n              );\n            }\n\n            // H\303\240ng 8: Cu\341\273\221i l\341\273\233p - D\341\272\241ng ch\341\273\257 \304\221\306\241n gi\341\272\243n\n            if (rowIndex === 8) {\n              return (\n                <div \n                  key={rowKey}\n                  className=\"w-full flex items-center justify-between px-3 py-1 text-[10px] text-muted opacity-50 select-none border-t border-dashed border-token/30 mt-1\"\n                >\n                  <span>C\341\273\255a sau</span>\n                  <span>Cu\341\273\221i l\341\273\233p</span>\n                </div>\n              );\n            }\n\n            return (\n              <div \n                key={rowKey}\n                className=\"grid grid-cols-8 gap-1.5 sm:gap-2 items-center\"\n              >\n                {nodes.map(node => {\n                  if (!shouldRenderCol(node.cot)) {\n                    return null;\n                  }\n\n                  // Non-seat special nodes\n                  if (node.loaiO === \'loidi\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`} \n                        className=\"h-11 sm:h-12 flex items-center justify-center text-[10px] text-muted opacity-40 select-none\"\n                      >\n                        \302\267\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'cua\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-surface-2 border border-dashed border-token flex flex-col items-center justify-center text-[10px] text-muted p-1\"\n                        title={node.ghiChu || \'C\341\273\255a\'}\n                      >\n                        <DoorOpen className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px]\">C\341\273\255a</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'banGV\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-[var(--role-gv-bg)] border border-[var(--role-gv-fg)] flex flex-col items-center justify-center text-[10px] text-[var(--role-gv-fg)] font-semibold p-1\"\n                      >\n                        <Armchair className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px]\">B\303\240n GV</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'buc\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-surface-2 border border-token flex flex-col items-center justify-center text-[10px] text-muted p-1\"\n                      >\n                        <BookOpen className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px] font-medium\">B\341\273\245c</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'trong\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md border border-dashed border-token bg-transparent flex items-center justify-center text-[10px] text-muted opacity-40 select-none\"\n                        title={node.ghiChu || \'Ch\341\273\227 tr\341\273\221ng\'}\n                      >\n                        <span className=\"text-[10px]\">Tr\341\273\221ng</span>\n                      </div>\n                    );\n                  }\n\n                  // Student Seat\n                  const student = node.maHS ? studentMap.get(node.maHS) : undefined;\n                  if (!student) {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md border border-dashed border-token bg-surface-2\"\n                      />\n                    );\n                  }\n\n                  const isSelected = selectedStudentIds.includes(student.maHS);\n                  const isLocked = isSeatLockedForViewer(student);\n                  const summary = studentSummaries[student.maHS];\n\n                  // Determine status border\n                  let borderColor = \'var(--border)\';\n                  let statusIcon: React.ReactNode = null;\n\n                  if (showStatusColors && summary) {\n                    if (summary.mucMau === \'bad\') {\n                      borderColor = \'var(--st-bad)\';\n                      statusIcon = <AlertCircle className=\"w-3 h-3 text-[var(--st-bad)]\" />;\n                    } else if (summary.mucMau === \'warn\') {\n                      borderColor = \'var(--st-warn)\';\n                      statusIcon = <AlertTriangle className=\"w-3 h-3 text-[var(--st-warn)]\" />;\n                    } else if (summary.mucMau === \'ok\') {\n                      borderColor = \'var(--st-ok)\';\n                      statusIcon = <CheckCircle className=\"w-3 h-3 text-[var(--st-ok)]\" />;\n                    } else {\n                      borderColor = \'var(--st-none)\';\n                    }\n                  }\n\n                  // Top priority role badge\n                  const topRole = student.vaiTro[0] || \'HS\';\n                  const roleConfig = ROLE_CONFIG[topRole];\n\n                  return (\n                    <button\n                      key={`${node.hang}-${node.cot}`}\n                      type=\"button\"\n                      disabled={isLocked}\n                      onClick={() => onSelectStudent(student)}\n                      style={{\n                        borderColor: isSelected ? \'var(--accent)\' : borderColor,\n                        borderWidth: isSelected ? \'2px\' : \'1.5px\',\n                      }}\n                      className={`\n                        relative h-11 sm:h-12 rounded-lg p-1 flex flex-col justify-between text-left transition-all cursor-pointer\n                        bg-surface hover:shadow-xs select-none\n                        ${isSelected ? \'seat-selected bg-surface-2 ring-2 ring-accent/30\' : \'\'}\n                        ${isLocked ? \'opacity-30 cursor-not-allowed bg-surface-2/50\' : \'active:scale-95\'}\n                      `}\n                      title={`${student.hoTen} \302\267 T\341\273\225 ${student.to} \302\267 Gh\341\272\277 ${student.viTriGhe}`}\n                    >\n                      {/* Top micro bar: Group & Role badge & Multi-check */}\n                      <div className=\"flex items-center justify-between w-full leading-none\">\n                        <span className=\"text-[9px] font-semibold text-muted\">\n                          T{student.to}\n                        </span>\n\n                        <div className=\"flex items-center gap-0.5\">\n                          {statusIcon}\n                          {topRole !== \'HS\' && (\n                            <span \n                              className=\"text-[9px] font-bold px-1 py-0.2 rounded flex items-center gap-0.5\"\n                              style={{ \n                                color: roleConfig.fg, \n                                backgroundColor: roleConfig.bg \n                              }}\n                              title={roleConfig.label}\n                            >\n                              <span>\n                                {topRole === \'LT\' ? \'\360\237\221\221\' :\n                                 topRole === \'BT\' ? \'\360\237\232\251\' :\n                                 topRole === \'LP_HT\' ? \'\360\237\223\226\' :\n                                 topRole === \'LP_LD\' ? \'\342\232\241\' : \'\360\237\233\241\357\270\217\'}\n                              </span>\n                              <span>{topRole === \'TT\' && student.toTruongTo ? `T${student.toTruongTo}` : roleConfig.short}</span>\n                            </span>\n                          )}\n\n                          {isSelected && isMultiSelect && (\n                            <span className=\"w-3.5 h-3.5 rounded bg-accent text-on-accent flex items-center justify-center\">\n                              <Check className=\"w-2.5 h-2.5 stroke-[3]\" />\n                            </span>\n                          )}\n                        </div>\n                      </div>\n\n                      {/* Student Short Name & Seat Number */}\n                      <div className=\"flex items-center justify-between w-full\">\n                        <div className=\"text-[11px] sm:text-xs font-semibold text-main truncate tracking-tight\">\n                          {student.tenRutGon}\n                        </div>\n                        <span className=\"text-[9px] text-muted opacity-75 tabular-nums\">\n                          #{student.viTriGhe}\n                        </span>\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 369
    num_bytes: 15072
    line_range_bytes: 15072
  }
}
