    content: "/**\n * Type definitions for Qu\341\272\243n l\303\275 N\341\273\201 n\341\272\277p & Thi \304\221ua L\341\273\233p h\341\273\215c 10A5\n */\n\nexport type RoleCode = \'HS\' | \'TT\' | \'LT\' | \'BT\' | \'LP_HT\' | \'LP_LD\' | \'GV\';\n\nexport interface StudentRoleBadge {\n  code: RoleCode;\n  label: string;\n  shortLabel: string;\n  to?: number; // 1, 2, 3, 4 for To truong\n}\n\nexport interface Student {\n  maHS: string;\n  hoTen: string;\n  tenRutGon: string;\n  to: number; // 1 | 2 | 3 | 4\n  dayBan: number; // 1 to 6\n  soBan: number; // 1 to 4\n  viTriGhe: number; // 1 to 42\n  vaiTro: RoleCode[];\n  toTruongTo?: number; // 1..4 if TT\n  sdtPhuHuynh?: string;\n  avatarSeed?: string;\n}\n\nexport type SeatNodeType = \'ghe\' | \'trong\' | \'loidi\' | \'banGV\' | \'cua\' | \'buc\';\n\nexport interface SeatLayoutNode {\n  hang: number;\n  cot: number;\n  loaiO: SeatNodeType;\n  maHS?: string;\n  ghiChu?: string;\n}\n\nexport type PointType = \'Tru\' | \'Cong\';\nexport type SeverityLevel = \'Nhe\' | \'Vua\' | \'Nang\';\n\nexport interface RuleItem {\n  maNoiQuy: string;\n  nhomHanhVi: string; // Chuy\303\252n c\341\272\247n, H\341\273\215c t\341\272\255p, N\341\273\201 n\341\272\277p, Phong tr\303\240o, Lao \304\221\341\273\231ng - V\341\273\207 sinh, \304\220i\341\273\203m c\341\273\231ng\n  tenHanhVi: string;\n  loaiDiem: PointType;\n  diemSo: number; // positive number, applied according to loaiDiem\n  mucDo: SeverityLevel;\n  ghim: boolean;\n  thuTu: number;\n}\n\nexport type RecordStatus = \n  | \'HieuLuc\' \n  | \'ChoDuyet\' \n  | \'DaChapNhan\' \n  | \'BiTuChoi\' \n  | \'DaHuy\' \n  | \'ChoXacNhanTrung\';\n\nexport interface TimeHierarchy {\n  namHoc: string; // vd: \'2026-2027\'\n  hocKi: 1 | 2;   // H\341\273\215c k\303\254 1 ho\341\272\267c 2\n  thang: number;  // Th\303\241ng 1..12\n  tuanHoc: number; // Tu\341\272\247n 1..35\n  ngayHoc: string; // YYYY-MM-DD\n  buoi: \'Sang\' | \'Chieu\'; // Bu\341\273\225i s\303\241ng ho\341\272\267c chi\341\273\201u\n}\n\nexport type PeriodLevel = \'namHoc\' | \'hocKi\' | \'thang\' | \'tuanHoc\' | \'ngayHoc\' | \'buoi\';\n\nexport interface HierarchyPeriodFilter {\n  namHoc: string; // vd: \'2026-2027\'\n  hocKi: 1 | 2 | \'all\';\n  thang: number | \'all\';\n  tuanHoc: number | \'all\';\n  ngayHoc: string | \'all\';\n  buoi: \'Sang\' | \'Chieu\' | \'all\';\n}\n\nexport interface DisciplineRecord {\n  maGhiNhan: string; // UUID\n  thoiGianMayChu: string; // ISO string\n  thoiGianMay: string;\n  namHoc: string; // 2026-2027\n  hocKi: 1 | 2;\n  thang: number; // 9, 10, 11...\n  tuanHoc: number;\n  ngayHoc: string; // YYYY-MM-DD\n  buoi: \'Sang\' | \'Chieu\';\n  doiTuong: \'HocSinh\' | \'To\';\n  maHS: string;\n  hoTen: string;\n  to: number;\n  maNoiQuy: string;\n  nhomHanhVi: string;\n  tenHanhVi: string;\n  mucDo: SeverityLevel;\n  diemSo: number;\n  loaiDiem: PointType;\n  ghiChu?: string;\n  nguoiGhi: string;\n  vaiTroNguoiGhi: RoleCode;\n  nguonGhi: \'TrucTiep\' | \'NgoaiTuyen\' | \'NhapTep\' | \'NhapVanBan\';\n  loaiThietBi?: string;\n  maLoNhap?: string;\n  lanThuTrongBuoi: number;\n  daXacNhanTrung: boolean;\n  trangThai: RecordStatus;\n  noiDungGiaiTrinh?: string;\n  thoiGianGiaiTrinh?: string;\n  nguoiDuyet?: string;\n  ketQuaDuyet?: \'ChapNhan\' | \'TuChoi\';\n  lyDoDuyet?: string;\n  lyDoHuy?: string;\n  thoiGianHuy?: string;\n}\n\nexport type WeekEvaluation = \'Tot\' | \'Kha\' | \'Dat\' | \'ChuaDat\';\n\nexport type StatusColorLevel = \'none\' | \'warn\' | \'bad\' | \'ok\';\n\nexport interface StudentWeekSummary {\n  maHS: string;\n  hoTen: string;\n  to: number;\n  tuanHoc: number;\n  diemKhoiDau: number;\n  tongDiemTru: number;\n  tongDiemCong: number;\n  diemHienTai: number;\n  xepLoai: WeekEvaluation;\n  mucMau: StatusColorLevel;\n  soLoiTrongTuan: number;\n  coLoiNang: boolean;\n}\n\nexport interface StudentPeriodSummary {\n  maHS: string;\n  hoTen: string;\n  to: number;\n  diemTrungBinh: number;\n  tongDiemTru: number;\n  tongDiemCong: number;\n  soLoi: number;\n  xepLoai: WeekEvaluation;\n  mucMau: StatusColorLevel;\n  lichSuTuan: {\n    tuanHoc: number;\n    diem: number;\n    soLoi: number;\n  }[];\n}\n\nexport interface TeacherSettings {\n  diemKhoiDau: number;\n  nguongTot: number; // >= 90\n  nguongKha: number; // >= 75\n  nguongDat: number; // >= 60\n  batDiemCong: boolean; // default false\n  batDiemThuongGoLoi: boolean; // default false\n  tranDiemBu: number; // default 50%\n  thoiHanSuaHuyPhut: number; // default 1440 (24h)\n  toTruongTuCham: boolean; // default false\n  hocSinhThayMau: \'CaLop\' | \'ChiBanThan\';\n  hanGuiGiaiTrinhNgay: number; // 7 days\n  nguoiDuyetGiaiTrinh: \'GV\' | \'GV_va_BCS\';\n  mocBuoiSang: string; // \'06:30-11:30\'\n  mocBuoiChieu: string; // \'12:30-17:30\'\n  khoaKhanCap: boolean;\n  maLop: string; // \'10A5DP\'\n}\n\nexport type ActiveTab = \'my_page\' | \'seating\' | \'personal_log\' | \'overview\' | \'rules\' | \'settings\' | \'import_export\' | \'audit_log\';\n"
    num_lines: 174
