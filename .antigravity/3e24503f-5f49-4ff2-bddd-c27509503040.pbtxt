              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <div className=\"relative p-2 rounded-full bg-gradient-to-tr from-accent/20 via-blue-500/10 to-purple-500/20 border-4 border-token shadow-2xl\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
