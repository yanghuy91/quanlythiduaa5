  planner_response {
    response: "\304\220\303\243 ho\303\240n th\303\240nh c\341\272\255p nh\341\272\255t theo \304\221\303\272ng y\303\252u c\341\272\247u c\341\273\247a th\341\272\247y/c\303\264:\n\n- **\304\220\341\273\225i v\341\273\213 tr\303\255 B\303\240n GV & C\341\273\255a ch\303\255nh**: \n  - V\341\273\213 tr\303\255 m\341\272\267c \304\221\341\273\213nh \341\273\237 \304\221\341\272\247u l\341\273\233p hi\341\273\207n t\341\272\241i: **B\303\240n GV** \341\273\237 b\303\252n tr\303\241i, **\342\200\224 B\341\272\242NG \342\200\224** \341\273\237 gi\341\273\257a, v\303\240 **C\341\273\255a ch\303\255nh** \341\273\237 b\303\252n ph\341\272\243i.\n  - T\341\273\261 \304\221\341\273\231ng di chuy\341\273\203n (migrate) c\341\272\243 d\341\273\257 li\341\273\207u s\306\241 \304\221\341\273\223 \304\221\303\243 l\306\260u trong tr\303\254nh duy\341\273\207t v\341\273\201 c\341\272\245u h\303\254nh m\341\273\233i n\303\240y.\n- **\304\220\306\241n gi\341\272\243n ho\303\241 d\341\272\241ng ch\341\273\257 kh\303\264ng \304\221\303\263ng \303\264**:\n  - Lo\341\272\241i b\341\273\217 ho\303\240n to\303\240n c\303\241c \303\264 vu\303\264ng \304\221\303\263ng khung c\341\273\251ng nh\341\272\257c cho B\303\240n GV, B\341\272\243ng, C\341\273\255a ch\303\255nh \341\273\237 h\303\240ng \304\221\341\272\247u l\341\273\233p; thay b\341\272\261ng d\303\262ng ch\341\273\211 d\341\272\253n ch\341\273\257 thanh l\341\273\213ch: `B\303\240n GV` ... `\342\200\224 B\341\272\242NG \342\200\224` ... `C\341\273\255a ch\303\255nh`.\n  - Cu\341\273\221i l\341\273\233p c\305\251ng \304\221\306\260\341\273\243c tinh gi\341\272\243n th\303\240nh d\303\262ng ch\341\273\257 nh\341\272\271: `C\341\273\255a sau` ... `Cu\341\273\221i l\341\273\233p`.\n- **C\303\264ng c\341\273\245 b\341\273\221 tr\303\255 nhanh cho GVCN**:\n  - Trong c\341\273\255a s\341\273\225 **\"S\341\272\257p x\341\272\277p S\306\241 \304\221\341\273\223 & K\303\251o th\341\272\243 Ch\341\273\227 ng\341\273\223i\"**, b\341\273\225 sung n\303\272t **\"Ho\303\241n \304\221\341\273\225i B\303\240n GV \342\207\204 C\341\273\255a ch\303\255nh\"** gi\303\272p GVCN d\341\273\205 d\303\240ng chuy\341\273\203n \304\221\341\273\225i qua l\341\272\241i gi\341\273\257a 2 v\341\273\213 tr\303\255 b\341\272\245t k\341\273\263 l\303\272c n\303\240o ch\341\273\211 v\341\273\233i m\341\273\231t ch\341\272\241m."
