        instruction: "@import \"tailwindcss\";\n\n:root {\n  font-family: \'Be Vietnam Pro\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  color-scheme: light;\n\n  /* Light mode defaults */\n  --bg: #F6F6F3;\n  --surface: #FFFFFF;\n  --surface-2: #EFEFEA;\n  --border: #DEDDD6;\n  --text: #15191E;\n  --text-muted: #565D66;\n  --accent: #2457D6;\n  --on-accent: #FFFFFF;\n  --primary: #15191E;\n  --on-primary: #FFFFFF;\n  \n  --st-ok: #1B7F4B;\n  --st-none: #9AA1AB;\n  --st-warn: #C98A0B;\n  --st-bad: #C62828;\n\n  /* Roles Light */\n  --role-lt-fg: #C2410C;\n  --role-lt-bg: rgba(194, 65, 12, 0.14);\n  --role-tt-fg: #0F766E;\n  --role-tt-bg: rgba(15, 118, 110, 0.14);\n  --role-ht-fg: #6D28D9;\n  --role-ht-bg: rgba(109, 40, 217, 0.14);\n  --role-ld-fg: #7C4A1D;\n  --role-ld-bg: rgba(124, 74, 29, 0.14);\n  --role-bt-fg: #BE185D;\n  --role-bt-bg: rgba(190, 24, 93, 0.14);\n  --role-gv-fg: #1E3A8A;\n  --role-gv-bg: rgba(30, 58, 138, 0.14);\n}\n\n[data-theme=\"dark\"] {\n  color-scheme: dark;\n\n  /* Dark mode defaults */\n  --bg: #0E1114;\n  --surface: #161A1F;\n  --surface-2: #1E242B;\n  --border: #2B323A;\n  --text: #ECEFF3;\n  --text-muted: #A2ABB6;\n  --accent: #7AA2F7;\n  --on-accent: #0B1220;\n  --primary: #ECEFF3;\n  --on-primary: #0E1114;\n  \n  --st-ok: #4ADE80;\n  --st-none: #6B7480;\n  --st-warn: #F2C14E;\n  --st-bad: #FF6B6B;\n\n  /* Roles Dark */\n  --role-lt-fg: #FB923C;\n  --role-lt-bg: rgba(251, 146, 60, 0.22);\n  --role-tt-fg: #2DD4BF;\n  --role-tt-bg: rgba(45, 212, 191, 0.22);\n  --role-ht-fg: #A78BFA;\n  --role-ht-bg: rgba(167, 139, 250, 0.22);\n  --role-ld-fg: #D6A66B;\n  --role-ld-bg: rgba(214, 166, 107, 0.22);\n  --role-bt-fg: #F472B6;\n  --role-bt-bg: rgba(244, 114, 182, 0.22);\n  --role-gv-fg: #93B4F5;\n  --role-gv-bg: rgba(147, 180, 245, 0.22);\n}\n\nbody {\n  background-color: var(--bg);\n  color: var(--text);\n  margin: 0;\n  padding: 0;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  font-feature-settings: \'cv02\', \'cv03\', \'cv04\', \'cv11\';\n}\n\n/* Number alignment */\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n/* Base custom utility helpers using design tokens */\n.bg-app { background-color: var(--bg); }\n.bg-surface { background-color: var(--surface); }\n.bg-surface-2 { background-color: var(--surface-2); }\n.border-token { border-color: var(--border); }\n.text-main { color: var(--text); }\n.text-muted { color: var(--text-muted); }\n.text-accent { color: var(--accent); }\n.bg-accent { background-color: var(--accent); }\n.text-on-accent { color: var(--on-accent); }\n.bg-primary { background-color: var(--primary); }\n.text-on-primary { color: var(--on-primary); }\n\n/* Ripple keyframe for seat selection */\n@keyframes seat-ripple {\n  0% { transform: scale(0.98); opacity: 0.8; }\n  50% { transform: scale(1.05); opacity: 1; }\n  100% { transform: scale(1.03); opacity: 1; }\n}\n\n.seat-selected {\n  animation: seat-ripple 280ms ease-out forwards;\n}\n\n/* Hide scrollbar for clean horizontal scrolling */\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n"
