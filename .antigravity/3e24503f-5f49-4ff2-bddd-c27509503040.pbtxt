n            <Info className=\"w-4 h-4 text-accent shrink-0\" />\n            <span>\n              {feedbackMsg ? (\n                <strong className=\"text-accent\">{feedbackMsg}</strong>\n              ) : selectedSlotForSwap ? (\n                <span>\n                  \304\220ang ch\341\273\215n 1 \303\264. <strong>Ch\341\272\241m ho\341\272\267c k\303\251o v\303\240o \303\264 th\341\273\251 2</strong> \304\221\341\273\203 ho\303\241n \304\221\341\273\225i ch\341\273\227 ng\341\273\223i!\n                </span>\n              ) : (\n                <span>\n                  <strong>M\341\272\271o:</strong> K\303\251o chu\341\273\231t k\303\251o th\341\272\243 h\341\273\215c sinh, ho\341\272\267c ch\341\272\241m l\341\272\247n l\306\260\341\273\243t 2 gh\341\272\277 \304\221\341\273\203 \304\221\341\273\225i ch\341\273\227 nhanh!\n                </span>\n              )}\n            </span>\n          </div>\n\n          {selectedSlotForSwap && (\n            <button\n              onClick={() => setSelectedSlotForSwap(null)}\n              className=\"px-2 py-0.5 rounded text-[11px] font-bold text-muted hover:text-main border border-token bg-surface cursor-pointer\"\n            >\n              H\341\273\247y ch\341\273\215n\n            </button>\n          )}\n        </div>\n\n        {/* Classroom Grid Container */}\n        <div className=\"p-4 sm:p-6 overflow-auto flex-1 bg-surface-2/40\">\n          <div className=\"min-w-[500px] max-w-full mx-auto flex flex-col gap-2\">\n            {Object.entries(rows).map(([rowKey, nodes]) => {\n              const rowIndex = Number(rowKey);\n\n              // H\303\240ng 0: \304\220\341\272\247u l\341\273\233p - D\341\272\241ng ch\341\273\257 KH\303\224NG \304\220\303\223NG \303\224\n              if (rowIndex === 0) {\n                const banGVNode = nodes.find(n => n.loaiO === \'banGV\');\n                const cuaNode = nodes.find(n => n.loaiO === \'cua\');\n                const isBanGVLeft = (banGVNode?.cot ?? 0) <= (cuaNode?.cot ?? 7);\n\n                return (\n                  <div \n                    key={rowKey}\n                    className=\"w-full flex items-center justify-between px-4 py-2 bg-surface/70 rounded-xl border-b border-dashed border-token/60 mb-2 select-none font-medium\"\n                  >\n                    {isBanGVLeft ? (\n                      <>\n                        <div className=\"flex items-center gap-1.5 text-[var(--role-gv-fg)] font-bold text-xs\">\n                          <span className=\"w-2 h-2 rounded-full bg-[var(--role-gv-fg)]\" />\n                          <span>B\303\240n GV</span>\n                        </div>\n                        <span className=\"text-main font-bold tracking-widest text-xs uppercase opacity-75\">\n                          \342\200\224 B\341\272\242NG \342\200\224\n                        </span>\n                        <div className=\"flex items-center gap-1.5 text-muted font-bold text-xs\">\n                          <span>C\341\273\255a ch\303\255nh</span>\n                        </div>\n                      </>\n                    ) : (\n                      <>\n                        <div className=\"flex items-center gap-1.5 text-muted font-bold text-xs\">\n                          <span>C\341\273\255a ch\303\255nh</span>\n                        </div>\n                        <span className=\"text-main font-bold tracking-widest text-xs uppercase opacity-75\">\n                          \342\200\224 B\341\272\242NG \342\200\224\n                        </span>\n                        <div className=\"flex items-center gap-1.5 text-[var(--role-gv-fg)] font-bold text-xs\">\n                          <span className=\"w-2 h-2 rounded-full bg-[var(--role-gv-fg)]\" />\n                          <span>B\303\240n GV</span>\n                        </div>\n                      </>\n                    )}\n                  </div>\n                );\n              }\n\n 