        replacement_chunks {
          target_content: "  // Preset: Move Teacher Desk to Left vs Right\n  const applyPresetTeacherDesk = (side: \'left\' | \'right\') => {\n    const newLayout = layout.map(node => {\n      if (node.hang === 0) {\n        if (side === \'left\') {\n          // B\303\240n GV at col 0, 1; B\341\273\245c col 3, 4; C\341\273\255a col 7\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n Gi\303\241o vi\303\252n\' };\n          if (node.cot === 7) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a tr\306\260\341\273\233c\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\273\245c gi\341\272\243ng\' };\n        } else {\n          // Standard: C\341\273\255a col 0; B\341\273\245c col 3, 4; B\303\240n GV col 6, 7\n          if (node.cot === 0) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a tr\306\260\341\273\233c\' };\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n Gi\303\241o vi\303\252n\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\273\245c gi\341\272\243ng\' };\n        }\n      }\n      return node;\n    });\n    setLayout(newLayout);\n    setHasChanges(true);\n    showFeedback(`\304\220\303\243 chuy\341\273\203n B\303\240n Gi\303\241o vi\303\252n sang b\303\252n ${side === \'left\' ? \'Tr\303\241i\' : \'Ph\341\272\243i\'}`);\n  };"
          replacement_content: "  // Preset: Move Teacher Desk to Left vs Right (swapping with C\341\273\255a ch\303\255nh)\n  const applyPresetTeacherDesk = (side: \'left\' | \'right\') => {\n    const newLayout = layout.map(node => {\n      if (node.hang === 0) {\n        if (side === \'left\') {\n          // B\303\240n GV at col 0, 1; B\341\273\245c col 3, 4; C\341\273\255a ch\303\255nh col 6, 7\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n GV\' };\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a ch\303\255nh\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\272\243ng\' };\n        } else {\n          // C\341\273\255a ch\303\255nh col 0, 1; B\341\273\245c col 3, 4; B\303\240n GV col 6, 7\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a ch\303\255nh\' };\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n GV\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\272\243ng\' };\n        }\n      }\n      return node;\n    });\n    setLayout(newLayout);\n    setHasChanges(true);\n    showFeedback(`\304\220\303\243 chuy\341\273\203n: B\303\240n GV b\303\252n ${side === \'left\' ? \'Tr\303\241i, C\341\273\255a ch\303\255nh b\303\252n Ph\341\272\243i\' : \'Ph\341\272\243i, C\341\273\255a ch\303\255nh b\303\252n Tr\303\241i\'}`);\n  };\n\n  const handleToggleDeskDoorSwap = () => {\n    const banGVNode = layout.find(n => n.hang === 0 && n.loaiO === \'banGV\');\n    const isBanGVLeft = (banGVNode?.cot ?? 0) <= 2;\n    applyPresetTeacherDesk(isBanGVLeft ? \'right\' : \'left\');\n  };"
          start_line: 253
          end_line: 275
        }
      }
    }
