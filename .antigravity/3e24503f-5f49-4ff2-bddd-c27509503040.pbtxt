    content: "import { Student, SeatLayoutNode, RuleItem, DisciplineRecord, TeacherSettings } from \'../types\';\nimport { getTimeHierarchyFromDate, CURRENT_SCHOOL_YEAR } from \'../utils/hierarchy\';\n\nexport const INITIAL_SETTINGS: TeacherSettings = {\n  diemKhoiDau: 100,\n  nguongTot: 90,\n  nguongKha: 75,\n  nguongDat: 60,\n  batDiemCong: false, // M\341\272\267c \304\221\341\273\213nh T\341\272\256T theo y\303\252u c\341\272\247u\n  batDiemThuongGoLoi: false,\n  tranDiemBu: 50,\n  thoiHanSuaHuyPhut: 1440, // 24 gi\341\273\235\n  toTruongTuCham: false,\n  hocSinhThayMau: \'CaLop\',\n  hanGuiGiaiTrinhNgay: 7,\n  nguoiDuyetGiaiTrinh: \'GV\',\n  mocBuoiSang: \'06:30-11:30\',\n  mocBuoiChieu: \'12:30-17:30\',\n  khoaKhanCap: false,\n  maLop: \'10A5DP\',\n};\n\n// 42 h\341\273\215c sinh l\341\273\233p 10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\nexport const MOCK_STUDENTS: Student[] = [\n  // T\341\273\224 1 (11 HS)\n  { maHS: \'HS01\', hoTen: \'Nguy\341\273\205n Kh\341\272\257c Huy\', tenRutGon: \'N.K.Huy\', to: 1, dayBan: 1, soBan: 1, viTriGhe: 1, vaiTro: [\'LT\'] },\n  { maHS: \'HS02\', hoTen: \'Tr\341\272\247n Th\341\273\213 Mai Anh\', tenRutGon: \'T.T.M.Anh\', to: 1, dayBan: 1, soBan: 1, viTriGhe: 2, vaiTro: [\'BT\', \'TT\'], toTruongTo: 1 },\n  { maHS: \'HS03\', hoTen: \'L\303\252 Ho\303\240ng Long\', tenRutGon: \'L.H.Long\', to: 1, dayBan: 1, soBan: 2, viTriGhe: 3, vaiTro: [\'LP_HT\'] },\n  { maHS: \'HS04\', hoTen: \'Ph\341\272\241m Qu\341\273\221c B\341\272\243o\', tenRutGon: \'P.Q.B\341\272\243o\', to: 1, dayBan: 1, soBan: 2, viTriGhe: 4, vaiTro: [\'LP_LD\'] },\n  { maHS: \'HS05\', hoTen: \'Nguy\341\273\205n V\304\203n Huy\', tenRutGon: \'N.V.Huy\', to: 1, dayBan: 1, soBan: 3, viTriGhe: 5, vaiTro: [\'HS\'] },\n  { maHS: \'HS06\', hoTen: \'Nguy\341\273\205n V\304\203n H\303\271ng\', tenRutGon: \'N.V.H\303\271ng\', to: 1, dayBan: 1, soBan: 3, viTriGhe: 6, vaiTro: [\'HS\'] },\n  { maHS: \'HS07\', hoTen: \'\304\220inh Th\341\273\213 Thu\341\