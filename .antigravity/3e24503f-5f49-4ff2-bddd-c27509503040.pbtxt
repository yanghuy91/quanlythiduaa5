et?: string;\\n  lyDoHuy?: string;\\n  thoiGianHuy?: string;\\n}\\n\\nexport type WeekEvaluation = \'Tot\' | \'Kha\' | \'Dat\' | \'ChuaDat\';\\n\\nexport type StatusColorLevel = \'none\' | \'warn\' | \'bad\' | \'ok\';\\n\\nexport interface StudentWeekSummary {\\n  maHS: string;\\n  hoTen: string;\\n  to: number;\\n  tuanHoc: number;\\n  diemKhoiDau: number;\\n  tongDiemTru: number;\\n  tongDiemCong: number;\\n  diemHienTai: number;\\n  xepLoai: WeekEvaluation;\\n  mucMau: StatusColorLevel;\\n  soLoiTrongTuan: number;\\n  coLoiNang: boolean;\\n}\\n\\nexport interface StudentPeriodSummary {\\n  maHS: string;\\n  hoTen: string;\\n  to: number;\\n  diemTrungBinh: number;\\n  tongDiemTru: number;\\n  tongDiemCong: number;\\n  soLoi: number;\\n  xepLoai: WeekEvaluation;\\n  mucMau: StatusColorLevel;\\n  lichSuTuan: {\\n    tuanHoc: number;\\n    diem: number;\\n    soLoi: number;\\n  }[];\\n}\", \"StartLine\":60, \"TargetContent\":\"export interface DisciplineRecord {\\n  maGhiNhan: string; // UUID\\n  thoiGianMayChu: string; // ISO string\\n  thoiGianMay: string;\\n  ngayHoc: string; // YYYY-MM-DD\\n  buoi: \'Sang\' | \'Chieu\';\\n  tuanHoc: number;\\n  doiTuong: \'HocSinh\' | \'To\';\\n  maHS: string;\\n  hoTen: string;\\n  to: number;\\n  maNoiQuy: string;\\n  nhomHanhVi: string;\\n  tenHanhVi: string;\\n  mucDo: SeverityLevel;\\n  diemSo: number;\\n  loaiDiem: PointType;\\n  ghiChu?: string;\\n  nguoiGhi: string;\\n  vaiTroNguoiGhi: RoleCode;\\n  nguonGhi: \'TrucTiep\' | \'NgoaiTuyen\' | \'NhapTep\' | \'NhapVanBan\';\\n  loaiThietBi?: string;\\n  maLoNhap?: string;\\n  lanThuTrongBuoi: number;\\n  daXacNhanTrung: boolean;\\n  trangThai: RecordStatus;\\n  noiDungGiaiTrinh?: string;\\n  thoiGianGiaiTrinh?: string;\\n  nguoiDuyet?: string;\\n  ketQuaDuyet?: \'ChapNhan\' | \'TuChoi\';\\n  lyDoDuyet?: string;\\n  lyDoHuy?: string;\\n  thoiGianHuy?: string;\\n}\\n\\nexport type WeekEvaluation = \'Tot\' | \'Kha\' | \'Dat\' | \'ChuaDat\';\\n\\nexport type StatusColorLevel = \