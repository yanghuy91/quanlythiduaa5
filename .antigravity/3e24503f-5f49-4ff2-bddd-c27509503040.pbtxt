        target_content: "  const [layout, setLayout] = useState<SeatLayoutNode[]>(() => {\n    const saved = localStorage.getItem(\'app_layout_10a5\');\n    return saved ? JSON.parse(saved) : MOCK_SEAT_LAYOUT;\n  });"
        replacement_content: "  const [layout, setLayout] = useState<SeatLayoutNode[]>(() => {\n    const saved = localStorage.getItem(\'app_layout_10a5\');\n    if (saved) {\n      try {\n        const parsed: SeatLayoutNode[] = JSON.parse(saved);\n        // Migration check: If col 0 of row 0 is \'cua\', swap to new default (banGV left, cua right)\n        const row0Col0 = parsed.find(n => n.hang === 0 && n.cot === 0);\n        if (row0Col0 && row0Col0.loaiO === \'cua\') {\n          const migrated = parsed.map(n => {\n            if (n.hang === 0) {\n              if (n.cot === 0 || n.cot === 1) return { ...n, loaiO: \'banGV\' as const, ghiChu: \'B\303\240n GV\' };\n              if (n.cot === 3 || n.cot === 4) return { ...n, loaiO: \'buc\' as const, ghiChu: \'B\341\272\243ng\' };\n              if (n.cot === 6 || n.cot === 7) return { ...n, loaiO: \'cua\' as const, ghiChu: \'C\341\273\255a ch\303\255nh\' };\n            }\n            return n;\n          });\n          localStorage.setItem(\'app_layout_10a5\', JSON.stringify(migrated));\n          return migrated;\n        }\n        return parsed;\n      } catch {\n        return MOCK_SEAT_LAYOUT;\n      }\n    }\n    return MOCK_SEAT_LAYOUT;\n  });"
        start_line: 60
        end_line: 65
      }
      num_matches: 1
    }
    description: "Migrate cached layout in localStorage if needed so B\303\240n GV is on the left and C\341\273\255a ch\303\255nh on the right"
