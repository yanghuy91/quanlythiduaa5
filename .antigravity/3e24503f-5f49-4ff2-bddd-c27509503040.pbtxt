        target_content: "      {/* Record Bottom Sheet (2-touch) */}\n      <RecordBottomSheet\n        isOpen={isBottomSheetOpen}\n        onClose={() => setIsBottomSheetOpen(false)}\n        selectedStudent={singleSelectedStudent}\n        selectedCount={selectedStudents.length}\n        rules={rules}\n        onSelectRule={handleAttemptSubmitRule}\n        enableBonus={settings.batDiemCong}\n        fastSave={fastSaveEnabled}\n      />\n\n      {/* Duplicate Warning Modal */}\n      {duplicateWarningData && (\n        <DuplicateWarningModal\n          pendingRule={duplicateWarningData.pendingRule}\n          duplicateStudents={duplicateWarningData.duplicateStudents}\n          safeStudentIds={duplicateWarningData.safeStudentIds}\n          onConfirmAddMore={(targetStudents) => {\n            commitRecords(\n              targetStudents,\n              duplicateWarningData.pendingRule,\n              undefined,\n              undefined,\n              undefined,\n              true\n            );\n          }}\n          onCancel={() => setDuplicateWarningData(null)}\n        />\n      )}"
        replacement_content: "      {/* Record Bottom Sheet (2-touch) */}\n      <RecordBottomSheet\n        isOpen={isBottomSheetOpen}\n        onClose={() => {\n          setIsBottomSheetOpen(false);\n          if (!isMultiSelect) setSelectedStudentIds([]);\n        }}\n        students={isMultiSelect ? selectedStudents : (singleSelectedStudent ? [singleSelectedStudent] : [])}\n        rules={rules}\n        allowBonus={settings.batDiemCong}\n        fastSaveMode={fastSaveEnabled}\n        onSave={(payload) => {\n          handleAttemptSubmitRule(payload.rule, payload.note, payload.date, payload.session);\n        }}\n        currentUserRole={cadreRole}\n      />\n\n      {/* Duplicate Warning Modal */}\n      {duplicateWarningData && (\n        <DuplicateWarningModal\n          isOpen={true}\n          onClose={() => setDuplicateWarningData(null)}\n          onConfirm={(confirmedStudents) => {\n            commitRecords(\n              confirmedStudents,\n              duplicateWarningData.pendingRule,\n              undefined,\n              undefined,\n              undefined,\n              true\n            );\n          }}\n          selectedStudents={isMultiSelect ? selectedStudents : (singleSelectedStudent ? [singleSelectedStudent] : [])}\n          selectedRule={duplicateWarningData.pendingRule}\n          existingRecordsByStudent={\n            duplicateWarningData.duplicateStudents.reduce((acc, item) => {\n              acc[item.student.maHS] = item.existingRecords;\n              return acc;\n            }, {} as Record<string, DisciplineRecord[]>)\n          }\n        />\n      )}"
        start_line: 497
        end_line: 528
      }
