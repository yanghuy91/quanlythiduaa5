  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { \n  Gamepad2, \n  Dices, \n  Bomb, \n  Rocket, \n  Gift, \n  Zap, \n  Grid, \n  Music, \n  Sparkles, \n  Filter, \n  RotateCcw, \n  Volume2, \n  VolumeX, \n  Flame, \n  Users,\n  CheckCircle2,\n  ChevronRight\n} from \'lucide-react\';\nimport { Student } from \'../../../types\';\nimport { soundEffects } from \'../../../utils/soundEffects\';\nimport { WinnerModal } from \'./WinnerModal\';\n\n// Game Sub-components\nimport { WheelOfFortune } from \'./WheelOfFortune\';\nimport { TimeBomb } from \'./TimeBomb\';\nimport { SlotMachine } from \'./SlotMachine\';\nimport { MysteryCards } from \'./MysteryCards\';\nimport { TurboRace } from \'./TurboRace\';\nimport { CosmicRocket } from \'./CosmicRocket\';\nimport { LuckyEnvelopes } from \'./LuckyEnvelopes\';\nimport { ClawMachine } from \'./ClawMachine\';\nimport { SecretMatrix } from \'./SecretMatrix\';\nimport { VinylDJ } from \'./VinylDJ\';\n\ntype GameId = \n  | \'wheel\' \n  | \'bomb\' \n  | \'slot\' \n  | \'cards\' \n  | \'race\' \n  | \'rocket\' \n  | \'envelope\' \n  | \'claw\' \n  | \'matrix\' \n  | \'vinyl\';\n\ninterface GameInfo {\n  id: GameId;\n  title: string;\n  badge: string;\n  desc: string;\n  icon: React.ReactNode;\n  gradient: string;\n}\n\nconst GAMES_LIST: GameInfo[] = [\n  {\n    id: \'wheel\',\n    title: \'V\303\262ng Quay May M\341\272\257n\',\n    badge: \'Kinh \304\221i\341\273\203n\',\n    desc: \'V\303\262ng quay s\341\272\257c m\303\240u h\341\273\223i h\341\273\231p, kim ch\341\273\211 \304\221\341\273\211nh cao gi\341\272\243i tr\303\255 l\341\273\233p h\341\273\215c.\',\n    icon: <Dices className=\"w-6 h-6 text-amber-300\" />,\n    gradient: \'from-amber-500 to-orange-600\',\n  },\n  {\n    id: \'bomb\',\n    title: \'Bom N\341\273\225 Ch\341\272\255m / Gh\341\272\277 N\303\263ng\',\n    badge: \'Si\303\252u Hot \360\237\224\245\',\n    desc: \'Ng\303\262i n\341\273\225 \304\221\341\272\277m ng\306\260\341\273\243c d\341\273\223n d\341\272\255p, ti\341\272\277ng t\303\255ch t\341\272\257c ngh\341\272\271t th\341\273\237 \304\221\341\272\277n khi n\341\273\225 tung!\',\n    icon: <Bomb className=\"w-6 h-6 text-red-300\" />,\n    gradient: \'from-red-600 to-rose-700\',\n  },\n  {\n    id: \'slot\',\n    title: \'M\303\241y X\303\250ng Tri Th\341\273\251c 777\',\n    badge: \'Arcade\',\n    desc: \'Gi\341\272\255t c\341\272\247n g\341\272\241t c\306\241 h\341\273\215c, 3 gu\341\273\223ng quay T\341\273\225 - T\303\252n - Th\341\273\255 th\303\241ch c\341\273\261c \304\221\303\243.\',\n    icon: <Sparkles className=\"w-6 h-6 text-yellow-300\" />,\n    gradient: \'from-yellow-600 to-amber-700\',\n  },\n  {\n    id: \'cards\',\n    title: \'R\303\272t Th\341\272\273 Nh\303\242n Ph\341\272\251m\',\n    badge: \'Gacha Ma Thu\341\272\255t\',\n    desc: \'12 l\303\241 b\303\240i l\341\272\255t 3D v\303\240ng r\341\273\261c h\303\251 l\341\273\231 g\306\260\306\241ng m\341\272\267t v\303\240ng c\341\273\247a bu\341\273\225i h\341\273\215c.\',\n    icon: <Gift className=\"w-6 h-6 text-purple-300\" />,\n    gradient: \'from-purple-600 to-indigo-700\',\n  },\n  {\n    id: \'race\',\n    title: \'\304\220ua Xe F1 10A5\',\n    badge: \'T\341\273\221c \304\221\341\273\231\',\n    desc: \'4 chi\341\272\277n m\303\243 F1 t\304\203ng t\341\273\221c turbo, ai c\303\241n \304\221\303\255ch tr\306\260\341\273\233c l\303\252n b\341\272\243ng.\',\n    icon: <Zap className=\"w-6 h-6 text-rose-300\" />,\n    gradient: \'from-rose-600 to-red-800\',\n  },\n  {\n    id: \'rocket\',\n    title: \'Phi Thuy\341\273\201n V\305\251 Tr\341\273\245\',\n    badge: \'Khoa h\341\273\215c\',\n    desc: \'\304\220\341\272\277m ng\306\260\341\273\243c 3-2-1 ph\303\263ng t\303\252n l\341\273\255a qu\303\251t t\341\273\215a \304\221\341\273\231 thi\303\252n h\303\240 ch\341\273\215n phi h\303\240nh gia.\',\n    icon: <Rocket className=\"w-6 h-6 text-cyan-300\" />,\n    gradient: \'from-cyan-600 to-blue-800\',\n  },\n  {\n    id: \'envelope\',\n    title: \'Bao L\303\254 X\303\254 May M\341\272\257n\',\n    badge: \'H\303\252n xui\',\n    desc: \'D\303\243y phong bao \304\221\341\273\217 \304\221u \304\221\306\260a, x\303\251 bao tung kim tuy\341\272\277n \304\221\303\263n l\341\273\231c b\341\272\243ng \304\221en.\',\n    icon: <Gift className=\"w-6 h-6 text-amber-200\" />,\n    gradient: \'from-red-700 to-orange-800\',\n  },\n  {\n    id: \'claw\',\n    title: \'M\303\241y G\341\272\257p Th\303\272 Arcade\',\n    badge: \'D\341\273\205 th\306\260\306\241ng\',\n    desc: \'H\341\272\241 c\303\240ng g\341\272\257p c\306\241 kh\303\255 xu\341\273\221ng h\341\273\223 g\341\272\245u b\303\264ng b\341\272\257t tr\303\272ng capsule may m\341\272\257n.\',\n    icon: <Gamepad2 className=\"w-6 h-6 text-pink-300\" />,\n    gradient: \'from-pink-600 to-purple-800\',\n  },\n  {\n    id: \'matrix\',\n    title: \'Ma Tr\341\272\255n 42 \303\224 S\341\273\221 Th\341\272\247n B\303\255\',\n    badge: \'Radar Laser\',\n    desc: \'B\341\272\243ng 42 s\341\273\221 t\306\260\306\241ng \341\273\251ng 42 h\341\273\215c sinh, ch\341\273\215n s\341\273\221 h\303\252n ho\341\272\267c qu\303\251t laser t\341\273\261 \304\221\341\273\231ng.\',\n    icon: <Grid className=\"w-6 h-6 text-emerald-300\" />,\n    gradient: \'from-emerald-600 to-teal-800\',\n  },\n  {\n    id: \'vinyl\',\n    title: \'DJ \304\220\304\251a Than & D\341\273\253ng Nh\341\272\241c\',\n    badge: \'\303\202m nh\341\272\241c\',\n    desc: \'Nh\341\272\241c s\303\240n xoay \304\221\304\251a s\303\264i \304\221\341\273\231ng, th\341\272\247y c\303\264 b\341\272\245m d\341\273\253ng \304\221\304\251a \304\221\341\273\203 kh\303\263a m\341\273\245c ti\303\252u!\',\n    icon: <Music className=\"w-6 h-6 text-violet-300\" />,\n    gradient: \'from-violet-600 to-fuchsia-800\',\n  },\n];\n\ninterface CallingGamesHubProps {\n  students: Student[];\n  onQuickRecord?: (student: Student, type: \'Cong\' | \'Tru\') => void;\n}\n\nexport const CallingGamesHub: React.FC<CallingGamesHubProps> = ({\n  students,\n  onQuickRecord,\n}) => {\n  const [selectedGame, setSelectedGame] = useState<GameId | null>(null);\n  const [selectedGroup, setSelectedGroup] = useState<\'all\' | 1 | 2 | 3 | 4>(\'all\');\n  const [selectedGender, setSelectedGender] = useState<\'all\' | \'nam\' | \'nu\'>(\'all\');\n  const [excludeCalled, setExcludeCalled] = useState(false);\n  const [calledHistory, setCalledHistory] = useState<string[]>([]);\n  const [isMuted, setIsMuted] = useState(false);\n\n  // Winner Modal State\n  const [winningStudent, setWinningStudent] = useState<Student | null>(null);\n  const [winnerModalOpen, setWinnerModalOpen] = useState(false);\n\n  // Filter candidates based on group, gender, and exclusion\n  const candidates = useMemo(() => {\n    return students.filter(st => {\n      // Group filter\n      if (selectedGroup !== \'all\' && st.to !== selectedGroup) return false;\n\n      // Gender filter (in mockData, female students usually have Thi / My / Ngoc / Duyen / Trang / Hang / Uyen / Linh / Anh etc.)\n      if (selectedGender !== \'all\') {\n        const isNu = /Th\341\273\213|Anh|Ng\341\273\215c|Duy\303\252n|Trang|H\341\272\261ng|Uy\303\252n|Linh|My|Ti\303\252n|Qu\341\273\263nh|Huy\341\273\201n|Ph\306\260\306\241ng/i.test(st.hoTen);\n        if (selectedGender === \'nu\' && !isNu) return false;\n        if (selectedGender === \'nam\' && isNu) return false;\n      }\n\n      // Exclude already called\n      if (excludeCalled && calledHistory.includes(st.maHS)) return false;\n\n      return true;\n    });\n  }, [students, selectedGroup, selectedGender, excludeCalled, calledHistory]);\n\n  const handleSelectWinner = (student: Student) => {\n    setWinningStudent(student);\n    setWinnerModalOpen(true);\n    setCalledHistory(prev => (prev.includes(student.maHS) ? prev : [student.maHS, ...prev]));\n  };\n\n  const handleToggleMute = () => {\n    const next = !isMuted;\n    setIsMuted(next);\n    soundEffects.setMuted(next);\n  };\n\n  const handleResetHistory = () => {\n    setCalledHistory([]);\n  };\n\n  const activeGameInfo = selectedGame ? GAMES_LIST.find(g => g.id === selectedGame) : null;\n\n  return (\n    <div className=\"w-full space-y-4 animate-fade-in\">\n      {/* Header Banner */}\n      <div className=\"p-4 sm:p-5 rounded-3xl bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white shadow-md relative overflow-hidden flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div className=\"relative z-10 flex items-center gap-3.5\">\n          <div className=\"w-12 h-12 rounded-2xl bg-white/15 border border-white/20 backdrop-blur-md flex items-center justify-center text-amber-300 shadow-md shrink-0\">\n            <Gamepad2 className=\"w-7 h-7\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-400 text-gray-900 tracking-wider uppercase\">\n                10 Tr\303\262 G\341\273\215i B\341\272\243ng Hot \360\237\216\257\n              </span>\n              <span className=\"text-xs text-white/80\">L\341\273\233p 10A5 \304\220\341\273\251c Ph\341\273\225</span>\n            </div>\n            <h2 className=\"text-lg sm:text-xl font-black tracking-tight mt-0.5\">\n              Kho \341\273\250ng D\341\273\245ng &amp; Tr\303\262 Ch\306\241i G\341\273\215i H\341\273\215c Sinh\n            </h2>\n            <p className=\"text-xs text-white/80 mt-0.5\">\n              Bi\341\272\277n gi\341\273\235 ki\341\273\203m tra b\303\240i c\305\251 v\303\240 g\341\273\215i b\341\272\243ng th\303\240nh s\303\242n ch\306\241i s\303\264i n\341\273\225i, c\303\264ng b\341\272\261ng, g\341\272\257n k\341\272\277t h\341\273\215c sinh\n            </p>\n          </div>\n        </div>\n\n        {/* Global Sound Mute Toggle */}\n        <div className=\"relative z-10 flex items-center gap-2 shrink-0\">\n          <button\n            onClick={handleToggleMute}\n            className=\"px-3 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 text-xs font-bold text-white flex items-center gap-1.5 transition-colors cursor-pointer\"\n            title={isMuted ? \'B\341\272\255t \303\242m thanh\' : \'T\341\272\257t \303\242m thanh\'}\n          >\n            {isMuted ? <VolumeX className=\"w-4 h-4 text-rose-300\" /> : <Volume2 className=\"w-4 h-4 text-emerald-300\" />}\n            <span>{isMuted ? \'\303\202m thanh: T\341\272\257t\' : \'\303\202m thanh: B\341\272\255t\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Bar */}\n      <div className=\"p-3 sm:p-4 rounded-2xl bg-surface border border-token shadow-xs flex flex-wrap items-center justify-between gap-3 text-xs\">\n        {/* T\341\273\225 selector */}\n        <div className=\"flex items-center gap-1.5 flex-wrap\">\n          <span className=\"font-bold text-muted mr-1 flex items-center gap-1\">\n            <Filter className=\"w-3.5 h-3.5\" />\n            <span>Ph\341\272\241m vi:</span>\n          </span>\n          <button\n            onClick={() => setSelectedGroup(\'all\')}\n            className={`px-2.5 py-1 rounded-lg font-bold transition-colors cursor-pointer ${\n              selectedGroup === \'all\' ? \'bg-primary text-on-primary\' : \'bg-surface-2 text-muted hover:text-main\'\n            }`}\n          >\n            C\341\272\243 l\341\273\233p (42 HS)\n          </button>\n          {[1, 2, 3, 4].map(to => (\n            <button\n              key={to}\n              onClick={() => setSelectedGroup(to as 1 | 2 | 3 | 4)}\n              className={`px-2.5 py-1 rounded-lg font-bold transition-colors cursor-pointer ${\n                selectedGroup === to ? \'bg-primary text-on-primary\' : \'bg-surface-2 text-muted hover:text-main\'\n              }`}\n            >\n              T\341\273\225 {to}\n            </button>\n          ))}\n        </div>\n\n        {/* Exclusion & Candidate Count */}\n        <div className=\"flex items-center gap-3\">\n          <label className=\"flex items-center gap-1.5 cursor-pointer text-muted hover:text-main select-none font-semibold\">\n            <input\n              type=\"checkbox\"\n              checked={excludeCalled}\n              onChange={e => setExcludeCalled(e.target.checked)}\n              className=\"w-4 h-4 rounded accent-accent\"\n            />\n            <span>Lo\341\272\241i tr\341\273\253 em \304\221\303\243 g\341\273\215i ({calledHistory.length})</span>\n          </label>\n\n          {calledHistory.length > 0 && (\n            <button\n              onClick={handleResetHistory}\n              className=\"text-[11px] text-muted hover:text-main flex items-center gap-1 underline cursor-pointer\"\n              title=\"\304\220\341\272\267t l\341\272\241i danh s\303\241ch \304\221\303\243 g\341\273\215i\"\n            >\n              <RotateCcw className=\"w-3 h-3\" />\n              <span>Reset</span>\n            </button>\n          )}\n\n          <div className=\"px-2.5 py-1 rounded-lg bg-accent/15 border border-accent/30 text-accent font-extrabold\">\n            {candidates.length} \341\273\251ng vi\303\252n\n          </div>\n        </div>\n      </div>\n\n      {/* Main Container: Game Selection Grid OR Active Game */}\n      {!selectedGame ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5\">\n          {GAMES_LIST.map(game => (\n            <div\n              key={game.id}\n              onClick={() => {\n                setSelectedGame(game.id);\n                soundEffects.tick(900);\n              }}\n              className=\"group relative p-4 rounded-3xl bg-surface border border-token hover:border-accent shadow-xs hover:shadow-lg transition-all cursor-pointer flex flex-col justify-between overflow-hidden\"\n            >\n              <div className=\"space-y-2.5\">\n                {/* Header: Icon + Badge */}\n                <div className=\"flex items-center justify-between\">\n                  <div className={`w-12 h-12 rounded-2xl bg-gradient-to-br ${game.gradient} text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform`}>\n                    {game.icon}\n                  </div>\n                  <span className=\"text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-surface-2 text-main border border-token\">\n                    {game.badge}\n                  </span>\n                </div>\n\n                {/* Title & Description */}\n                <div>\n                  <h3 className=\"text-base font-black text-main group-hover:text-accent transition-colors\">\n                    {game.title}\n                  </h3>\n                  <p className=\"text-xs text-muted line-clamp-2 mt-0.5\">\n                    {game.desc}\n                  </p>\n                </div>\n              </div>\n\n              {/* Action Link */}\n              <div className=\"pt-3 border-t border-token/60 mt-3 flex items-center justify-between text-xs font-bold text-accent\">\n                <span>V\303\240o ch\306\241i ngay</span>\n                <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"p-4 sm:p-6 rounded-3xl bg-surface border border-token shadow-md\">\n          {selectedGame === \'wheel\' && (\n            <WheelOfFortune\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'bomb\' && (\n            <TimeBomb\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'slot\' && (\n            <SlotMachine\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'cards\' && (\n            <MysteryCards\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'race\' && (\n            <TurboRace\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'rocket\' && (\n            <CosmicRocket\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'envelope\' && (\n            <LuckyEnvelopes\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'claw\' && (\n            <ClawMachine\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'matrix\' && (\n            <SecretMatrix\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n\n          {selectedGame === \'vinyl\' && (\n            <VinylDJ\n              candidates={candidates}\n              onSelectWinner={handleSelectWinner}\n              onBack={() => setSelectedGame(null)}\n            />\n          )}\n        </div>\n      )}\n\n      {/* Winner Celebration Modal */}\n      <WinnerModal\n        student={winningStudent}\n        isOpen={winnerModalOpen}\n        gameTitle={activeGameInfo?.title || \'Tr\303\262 ch\306\241i\'}\n        onClose={() => setWinnerModalOpen(false)}\n        onPlayAgain={() => {\n          setWinnerModalOpen(false);\n          soundEffects.tick(1000);\n        }}\n        onQuickRecord={(student, type) => {\n          setWinnerModalOpen(false);\n          if (onQuickRecord) {\n            onQuickRecord(student, type);\n          }\n        }}\n      />\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/teacher/calling-games/CallingGamesHub.tsx"
        }
        overwrite: true
      }
    }
