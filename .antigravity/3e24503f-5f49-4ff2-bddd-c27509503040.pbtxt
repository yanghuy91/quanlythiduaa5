        replacement_content: "      {/* 6. IMPORT / EXPORT (Teacher Only) */}\n      {activeTab === \'import_export\' && (\n        <div className=\"space-y-4\">\n          {/* Time & Schedule Data Import Card (CSV/Excel) */}\n          <TimeDataImportCard\n            students={students}\n            onImportRecords={onImportRecords}\n          />\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {/* Import Smart Preview */}\n            <div className=\"p-4 rounded-2xl bg-surface border border-token space-y-3 shadow-xs\">\n              <div className=\"flex items-center gap-2\">\n                <Upload className=\"w-4 h-4 text-accent\" />\n                <h3 className=\"text-xs font-bold text-main uppercase tracking-wider\">\n                  Tr\303\254nh nh\341\272\255p th\303\264ng minh (D\303\241n v\304\203n b\341\272\243n / File)\n                </h3>\n              </div>\n              <p className=\"text-xs text-muted\">\n                D\303\241n danh s\303\241ch l\341\273\233p, s\306\241 \304\221\341\273\223 l\341\273\233p t\341\273\253 Word/Excel ho\341\272\267c bi\303\252n b\341\272\243n vi ph\341\272\241m vi\341\272\277t tay. H\341\273\207 th\341\273\221ng t\341\273\261 \304\221\341\273\231ng ph\303\242n t\303\241ch v\303\240 kh\341\273\233p t\303\252n m\341\273\235.\n              </p>\n\n              <textarea\n                rows={4}\n                placeholder=\"VD: 10/11 - S\303\241ng: Huy \304\221i mu\341\273\231n, Qu\303\242n d\303\271ng \304\221i\341\273\207n tho\341\272\241i...\"\n                className=\"w-full p-2.5 bg-surface-2 border border-token rounded-xl text-xs text-main placeholder:text-muted\"\n              />\n\n              <div className=\"flex items-center justify-between pt-2\">\n                <span className=\"text-[11px] text-muted\">M\303\243 l\303\264 nh\341\272\255p: L\303\224-202611-01</span>\n                <button\n                  type=\"button\"\n                  onC