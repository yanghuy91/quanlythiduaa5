            lines {
              text: "    onVoidRecord(voidModalRecord.maGhiNhan, voidReason.trim());"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setVoidModalRecord(null);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
