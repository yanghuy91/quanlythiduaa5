      create_file {
        instruction: "import React, { useState, useRef, useEffect } from \'react\';\nimport { ArrowLeft, Sparkles, Dices, RotateCcw } from \'lucide-react\';\nimport { Student } from \'../../../types\';\nimport { soundEffects } from \'../../../utils/soundEffects\';\n\ninterface SlotMachineProps {\n  candidates: Student[];\n  onSelectWinner: (student: Student) => void;\n  onBack: () => void;\n}\n\nconst MISSIONS = [\n  \'Gi\341\272\243i c\303\242u h\341\273\217i b\303\240i c\305\251 \342\255\220\',\n  \'L\303\252n b\341\272\243ng ch\341\273\257a b\303\240i t\341\272\255p \342\234\217\357\270\217\',\n  \'Nh\341\272\255n +1 \304\221i\341\273\203m c\341\273\231ng n\341\272\277u \304\221\303\272ng \360\237\216\201\',\n  \'\304\220\341\273\215c thu\341\273\231c \304\221\341\273\213nh l\303\275 / th\306\241 \360\237\223\226\',\n  \'H\341\273\217i \304\221\303\241p nhanh 30 gi\303\242y \342\232\241\',\n  \'Tr\341\273\243 l\303\275 \304\221\341\272\257c l\341\273\261c c\341\273\247a GVCN \360\237\216\257\'\n];\n\nexport const SlotMachine: React.FC<SlotMachineProps> = ({\n  candidates,\n  onSelectWinner,\n  onBack,\n}) => {\n  const [isSpinning, setIsSpinning] = useState(false);\n  const [reel1, setReel1] = useState(\'T\341\273\225 1\');\n  const [reel2, setReel2] = useState(\'Ch\341\273\215n h\341\273\215c sinh\');\n  const [reel3, setReel3] = useState(\'Nhi\341\273\207m v\341\273\245 vui\');\n  const [leverPulled, setLeverPulled] = useState(false);\n\n  const spinSlots = () => {\n    if (isSpinning || candidates.length === 0) return;\n\n    setIsSpinning(true);\n    setLeverPulled(true);\n    soundEffects.lever();\n\n    setTimeout(() => setLeverPulled(false), 400);\n\n    const winner = candidates[Math.floor(Math.random() * candidates.length)];\n    const chosenMission = MISSIONS[Math.floor(Math.random() * MISSIONS.length)];\n    const chosenTo = `T\341\273\225 ${winner.to}`;\n\n    // Roll Reel 1 for 1.2s, Reel 2 for 2.2s, Reel 3 for 3.2s\n    const startTime = performance.now();\n\n    const intervalId = window.setInterval(() => {\n      const now = performance.now();\n      const elapsed = now - startTime;\n\n      soundEffects.tick(1000);\n\n      if (elapsed < 1200) {\n        setReel1(`T\341\273\225 ${Math.floor(Math.random() * 4) + 1}`);\n      } else {\n        setReel1(chosenTo);\n      }\n\n      if (elapsed < 2400) {\n        const tempStudent = candidates[Math.floor(Math.random() * candidates.length)];\n        setReel2(tempStudent.tenRutGon);\n      } else {\n        setReel2(winner.tenRutGon);\n      }\n\n      if (elapsed < 3400) {\n        setReel3(MISSIONS[Math.floor(Math.random() * MISSIONS.length)]);\n      } else {\n        setReel3(chosenMission);\n      }\n\n      if (elapsed >= 3500) {\n        clearInterval(intervalId);\n        setIsSpinning(false);\n        soundEffects.coin();\n        setTimeout(() => {\n          onSelectWinner(winner);\n        }, 600);\n      }\n    }, 90);\n  };\n\n  return (\n    <div className=\"flex flex-col items-center gap-4 py-2 animate-fade-in w-full max-w-lg mx-auto text-center\">\n      {/* Top Bar */}\n      <div className=\"w-full flex items-center justify-between\">\n        <button\n          onClick={onBack}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main cursor-pointer\"\n        >\n          <ArrowLeft className=\"w-3.5 h-3.5\" />\n          <span>Ch\341\273\215n tr\303\262 kh\303\241c</span>\n        </button>\n\n        <span className=\"text-xs font-bold text-amber-500 px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 flex items-center gap-1\">\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          <span>M\303\241y X\303\250ng Tri Th\341\273\251c 777</span>\n        </span>\n      </div>\n\n      {/* Arcade Slot Machine Cabinet */}\n      <div className=\"relative w-full p-4 sm:p-6 rounded-3xl bg-gradient-to-b from-amber-600 via-amber-700 to-amber-900 border-4 border-amber-400 shadow-2xl flex items-center justify-center\">\n        {/* Lights bar on top */}\n        <div className=\"absolute top-2 inset-x-6 flex items-center justify-between px-4\">\n          <span className=\"w-2.5 h-2.5 rounded-full bg-yellow-300 animate-ping\" />\n          <span className=\"text-[11px] font-black text-yellow-300 uppercase tracking-widest\">\n            \342\230\205 10A5 LUCKY SLOTS \342\230\205\n          </span>\n          <span className=\"w-2.5 h-2.5 rounded-full bg-yellow-300 animate-ping\" />\n        </div>\n\n        {/* 3 Reels Grid */}\n        <div className=\"grid grid-cols-3 gap-2 w-full mt-4 bg-gray-900 p-3 rounded-2xl border-2 border-amber-300 shadow-inner\">\n          {/* Reel 1: T\341\273\225 */}\n          <div className=\"h-28 rounded-xl bg-gradient-to-b from-gray-800 via-surface to-gray-800 border border-token flex flex-col items-center justify-center p-2 overflow-hidden shadow-md\">\n            <span className=\"text-[9px] uppercase font-bold text-muted mb-1\">D\303\243y / T\341\273\225</span>\n            <div className={`text-base sm:text-lg font-black text-accent truncate ${isSpinning ? \'blur-[0.5px] animate-pulse\' : \'\'}`}>\n              {reel1}\n            </div>\n          </div>\n\n          {/* Reel 2: T\303\252n H\341\273\215c Sinh */}\n          <div className=\"h-28 rounded-xl bg-gradient-to-b from-gray-800 via-surface to-gray-800 border-2 border-amber-400 flex flex-col items-center justify-center p-2 overflow-hidden shadow-lg\">\n            <span className=\"text-[9px] uppercase font-bold text-amber-500 mb-1\">G\306\260\306\241ng m\341\272\267t</span>\n            <div className={`text-base sm:text-lg font-black text-amber-500 truncate ${isSpinning ? \'blur-[0.5px] animate-pulse\' : \'\'}`}>\n              {reel2}\n            </div>\n          </div>\n\n          {/* Reel 3: Nhi\341\273\207m v\341\273\245 */}\n          <div className=\"h-28 rounded-xl bg-gradient-to-b from-gray-800 via-surface to-gray-800 border border-token flex flex-col items-center justify-center p-2 overflow-hidden shadow-md\">\n            <span className=\"text-[9px] uppercase font-bold text-muted mb-1\">Th\341\273\255 th\303\241ch</span>\n            <div className={`text-xs sm:text-xs font-bold text-main line-clamp-2 ${isSpinning ? \'blur-[0.5px] animate-pulse\' : \'\'}`}>\n              {reel3}\n            </div>\n          </div>\n        </div>\n\n        {/* Mechanical Lever Arm on Right (Visible on sm+) */}\n        <div \n          onClick={spinSlots}\n          className={`absolute -right-4 top-1/2 -translate-y-1/2 cursor-pointer transition-transform duration-200 hidden sm:block ${leverPulled ? \'translate-y-4\' : \'\'}`}\n          title=\"K\303\251o c\341\272\247n g\341\272\241t\"\n        >\n          <div className=\"w-3 h-20 bg-gray-400 border border-gray-600 rounded-full flex flex-col justify-start items-center\">\n            <div className=\"w-7 h-7 rounded-full bg-red-600 border-2 border-white shadow-lg -mt-3.5 hover:scale-110 transition-transform\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Button to Spin */}\n      <button\n        disabled={isSpinning || candidates.length === 0}\n        onClick={spinSlots}\n        className={`\n          px-8 py-3.5 rounded-2xl font-black text-base shadow-xl flex items-center gap-2.5 transition-all cursor-pointer mt-1\n          ${isSpinning \n            ? \'bg-muted text-surface opacity-75 cursor-not-allowed scale-95\' \n            : \'bg-gradient-to-r from-yellow-500 via-amber-500 to-orange-500 text-black font-extrabold hover:opacity-95 hover:scale-105 active:scale-95 ring-4 ring-yellow-500/20\'}\n        `}\n      >\n        <Dices className={`w-5 h-5 ${isSpinning ? \'animate-spin\' : \'\'}`} />\n        <span>{isSpinning ? \'\304\220ANG QUAY CU\341\273\230N...\' : \'GI\341\272\254T C\341\272\246N G\341\272\240T \360\237\216\260\'}</span>\n      </button>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/teacher/calling-games/SlotMachine.tsx"
        }
        overwrite: true
      }
    }
