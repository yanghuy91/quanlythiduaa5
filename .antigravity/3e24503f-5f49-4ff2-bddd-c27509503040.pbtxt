          target_content: "export const CURRENT_SCHOOL_YEAR = \'2026-2027\';\n\n// Mapping weeks to month and semester\nexport function getTimeHierarchyFromDate(dateStr: string, session: \'Sang\' | \'Chieu\'): TimeHierarchy {\n  const d = new Date(dateStr);\n  const month = d.getMonth() + 1; // 1..12\n  const year = d.getFullYear();\n\n  // School year: from Aug/Sep to May/Jun\n  let namHoc = `${year}-${year + 1}`;\n  if (month < 8) {\n    namHoc = `${year - 1}-${year}`;\n  }\n\n  // Semester: HK1 (Th\303\241ng 9 -> Th\303\241ng 1), HK2 (Th\303\241ng 1 -> Th\303\241ng 5)\n  const hocKi: 1 | 2 = (month >= 9 || month <= 1) ? 1 : 2;\n\n  // Approximate school week starting from Sept 1\n  let week = 1;\n  if (month === 9) week = Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 10) week = 4 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 11) week = 8 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 12) week = 12 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 1) week = 16 + Math.min(3, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month >= 2) week = 19 + Math.min(16, Math.max(1, (month - 2) * 4 + Math.ceil(d.getDate() / 7)));\n\n  return {\n    namHoc,\n    hocKi,\n    thang: month,\n    tuanHoc: week,\n    ngayHoc: dateStr,\n    buoi: session,\n  };\n}"
