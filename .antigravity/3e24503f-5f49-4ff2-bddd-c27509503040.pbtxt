 className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    onClick={() => setIsLayoutEditorOpen(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs font-bold border border-white/30 transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <Move className=\"w-3.5 h-3.5 text-amber-300\" />\n                    <span>K\303\251o th\341\272\243 S\306\241 \304\221\341\273\223 \360\237\252\221</span>\n                  </button>\n\n                  <button\n                    onClick={() => setShowCadreModal(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-amber-500/80 hover:bg-amber-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <span>\360\237\221\221 Ban c\303\241n s\341\273\261</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Time Hierarchy Period Filter */}\n          <PeriodFilterComponent\n            filter={periodFilter}\n            onChange={setPeriodFilter}\n            availableWeeks={[1, 2, 3]}\n            compact={true}\n          />\n\n          {/* Top Quick Stats */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"p-3.5 rounded-2xl bg-surface border border-token\">\n              <div className=\"text-[11px] text-muted font-medium\">H\341\273\215c sinh l\341\273\233p</div>\n              <div className=\"text-xl font-bold text-main mt-0.5\">42 em</div>\n              <div className=\"text-[10px] text-muted mt-1\">6 d\303\243y b\303\240n \302\267 4 t\341\273\225</div>\n            </div>\n\n            <div className=\"p-3.5 rounded-2xl bg-surface border border-token\">\n              <div className=\"text-[11px] text-muted font-medium\">Vi ph