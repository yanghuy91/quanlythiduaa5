      thinking_signature: "\022\257\t\n\254\t\001i\024}\023\244\201k\002c\321{w\247g\202B\376\206r\373\030\f\235\r\356l\360\212\237N\001\375\365Ei\223\273\334\v0\204\337\361\000\240\r\r\336-@\336/\350\262\363\362\255\233h\203\224^\371\006\200Z\377#lY\235Ra\2737\033\024\252\273:\332\234\324I\274X\024_i\221\033\350\232u\\\204?\a+\370Q\002zA*\276\254o\362\227\365\212\216G\004\235y\374C\256}\276A\036c\331\343\006\005\250\025\201\374\004\327\220\226\225\016:\037\347Y\204\375x\247\210X7H\225\313\001\324\\g\363\341\vR\264\230s\327\027\235;\227\326\265\177v/\333\254\255XT_\352\235\022\250\224\270\343\254;\200N\030\"\334[\317U\305I\201\273\001O\263\0340\342\3125\272g\305,\016i\261c\240\000\237^\2356\200?\n\342t\324PN5\236x\364\366c\264\342\036\023\265\022\372\020A\302\324\347\027\277\330\rf\220A4P\212%Q\260\277j,|\343\271\252\231\177\213R\273;=R:vO\321\267u\360\341\353\364|kW\365S\bE#1o<F\v\314\353z\326\t\366%\315\366N\271\317\214Q\351\214\020\375\030\203a\202\363tP\337X`p\032qr\032y+?j\225\301\002\271*\352\r:y\261V\271\232\035\vLX_o\260\355I\200\333\343Z\340L\275E\271\311\372\027v\264\272\"\255iv\213C\206\333)*\257B\247\017\272gtr\246J\246!\247g;V \243\031]\275\335\361Q\273X\372\370F\323|nu5# \362\251\234\177\366\211\\\021C\3126\025\323\242\266\241\353$\247\326$S\005\215@\335?\212\345\302\375\364\274rPA\3520\243\027\306\311bK\006)-1\234:+\226\224)X\267\362\301\265)2T\323@\017\246\254\273k\a]\002\'5\351\ak\227l\022w\374\240^\2124\366\307\205)\374^\221\373\376\200\236\304\243\250P\000\307\343\261\307\365\265\262\260>\221\215\367\326\326\366\364\232\214\212#\227v\322Sk\241\367\tHs\360\037@\266\216aj{F\371\320[\235B\3771\374N.\252i\333\376!\333t\324\001\250*d\342[\307U]=\330\037\355*P\364\v\256\314T\244{\"\037$7\034C\260|sS\027\002\322\v\300\263R\363\233\242\'\276\223\253\340\037\330\202\341\202A\345\b8\301Lay\230\306\036j\270\215\f\273&[\203\314}-n\331\224\374\320)h\203\274\207\312vi!)\2344\374\240c|\037\212\263\225\375A\353\215\233\274LLA\353\251\353~\225\2432\274\023\023\201\200\"\375\230\"aK\022`\005 \324\212\310\bL7\227\356\240\313T=bR\034\201\2026\211\302\301\022\242\002\314\037\026\355\250\207\\\261\352\264\344\274\210\343B\315\023=\252;&\343b\356\223\355\360#\301\211\217Y\354\222\'Q>\362\266\334\330k\361\036v\247aM\b1JYI\377\257\375\233<\373\330\352@\270\357\205\004\017\300\372e\344\237\322\252\311\300\v$\372\234\a;\3712X\375_\363\373,#?\rEoa\226\347\300\330\246%\247\271\2520\340\207\371\243\n\334\032\333\254\375;\2337bP\273,\273\3142\322\262`\t2\210\265\326\232\004\360b\320\261\376\031\2276\344\036\265\210dS~8_\004\262\030\336\034\366\334\315\214+\b\"\f\025\274\030i_]\352\264\004\000\257\252\ry\250k\223\335\302\tI@\233w!\v\216+\022\020\266i\202\004\371W#\311\222\027\237\241\207q\251\001rhk\333^k\306\232\303|\222\312m\236{\003,\221@J\346M\340\333Y\225g\252\352\217\253\357\267\242\251v\325\340\362\337\256\fL \236F\231Y\025{;\032\352\311\024N0\334\345]\"\334\030tQ\300\226\271\006tP\332\311Z\364k\342\316\344\244\te\037\224\331[\320@H\230\2565\0202}\326\276\026\224\315\351<C\356\377\034\345*\342\270\227\207B\264\235v\355\261\"\341U0\177\275\235\036\037\207\236\342\vY\203\343[\\\004\375\000@\021\2002\017\333W\2771A\037\211\242_\253\212\3614\231\022p\234=6w[\3430!Cr\364\'D\327\235\322\263\373^\266\202*cZ\302\322\355k\340\031Z\203\237n\317\377)[S\270i6o\205\2422Hk\222\237P\215\2526\265\023s%\025\033X\'\236\326\354\256\323\332\231\325\300F\002\217.7\241\232\250\031\212\364n\207\212i\235(\302A"
