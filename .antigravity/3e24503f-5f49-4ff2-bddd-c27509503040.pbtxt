    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "export const CURRENT_SCHOOL_YEAR = \'2026-2027\';\n\n// Mapping weeks to month and semester\nexport function getTimeHierarchyFromDate(dateStr: string, session: \'Sang\' | \'Chieu\'): TimeHierarchy {\n  const d = new Date(dateStr);\n  const month = d.getMonth() + 1; // 1..12\n  const year = d.getFullYear();\n\n  // School year: from Aug/Sep to May/Jun\n  let namHoc = `${year}-${year + 1}`;\n  if (month < 8) {\n    namHoc = `${year - 1}-${year}`;\n  }\n\n  // Semester: HK1 (Th\303\241ng 9 -> Th\303\241ng 1), HK2 (Th\303\241ng 1 -> Th\303\241ng 5)\n  const hocKi: 1 | 2 = (month >= 9 || month <= 1) ? 1 : 2;\n\n  // Approximate school week starting from Sept 1\n  let week = 1;\n  if (month === 9) week = Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 10) week = 4 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 11) week = 8 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 12) week = 12 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 1) week = 16 + Math.min(3, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month >= 2) week = 19 + Math.min(16, Math.max(1, (month - 2) * 4 + Math.ceil(d.getDate() / 7)));\n\n  return {\n    namHoc,\n    hocKi,\n    thang: month,\n    tuanHoc: week,\n    ngayHoc: dateStr,\n    buoi: session,\n  };\n}"
        replacement_content: "export const CURRENT_SCHOOL_YEAR = \'2026-2027\';\n\n// Ph\303\242n c\341\272\245p chu\341\272\251n theo ch\341\273\211 \304\221\341\272\241o: Tu\341\272\247n 1 -> 19 thu\341\273\231c HK1, Tu\341\272\247n 20 -> 38 thu\341\273\231c HK2\nexport const SEMESTER_1_WEEKS = Array.from({ length: 19 }, (_, i) => i + 1); // Tu\341\272\247n 1 -> 19\nexport const SEMESTER_2_WEEKS = Array.from({ length: 19 }, (_, i) => i + 20); // Tu\341\272\247n 20 -> 38\nexport const ALL_SCHOOL_WEEKS = Array.from({ length: 38 }, (_, i) => i + 1); // Tu\341\272\247n 1 -> 38\n\nexport function getSemesterFromWeek(week: number): 1 | 2 {\n  return week <= 19 ? 1 : 2;\n}\n\n// Mapping weeks and semester from date (Tu\341\272\247n 1..19: HK1, Tu\341\272\247n 20..38: HK2)\nexport function getTimeHierarchyFromDate(dateStr: string, session: \'Sang\' | \'Chieu\'): TimeHierarchy {\n  const d = new Date(dateStr);\n  const month = d.getMonth() + 1; // 1..12\n  const year = d.getFullYear();\n\n  // School year: from Aug/Sep to May/Jun\n  let namHoc = `${year}-${year + 1}`;\n  if (month < 8) {\n    namHoc = `${year - 1}-${year}`;\n  }\n\n  // Calculate week: Week 1..19 in HK1 (Sep -> Jan), Week 20..38 in HK2 (Feb -> May)\n  let week = 1;\n  if (month === 9) week = Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 10) week = 4 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 11) week = 8 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 12) week = 12 + Math.min(4, Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month === 1) week = Math.min(19, 16 + Math.max(1, Math.ceil(d.getDate() / 7)));\n  else if (month >= 2 && month <= 5) week = Math.min(38, 19 + (month - 2) * 4 + Math.ceil(d.getDate() / 7));\n  else week = 1;\n\n  // Strict semester constraint: 1..19 is HK1, 20..38 is HK2\n  const hocKi: 1 | 2 = getSemesterFromWeek(week);\n\n  return {\n    namHoc,\n    hocKi,\n    thang: month,\n    tuanHoc: week,\n    ngayHoc: dateStr,\n    buoi: session,\n  };\n}"
        start_line: 12
