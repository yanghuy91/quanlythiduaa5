    content: "import React, { useState, useMemo } from \'react\';\nimport { \n  User, \n  LayoutGrid, \n  Trophy, \n  AlertCircle, \n  CheckCircle2, \n  Clock, \n  MessageSquare, \n  X,\n  Send,\n  HelpCircle\n} from \'lucide-react\';\nimport { \n  Student, \n  SeatLayoutNode, \n  DisciplineRecord, \n  StudentWeekSummary, \n  TeacherSettings \n} from \'../../types\';\nimport { SeatGrid } from \'../student-picker/SeatGrid\';\nimport { sortVietnameseNames } from \'../../utils/vietnamese\';\n\ninterface StudentViewProps {\n  currentStudent: Student;\n  allStudents: Student[];\n  layout: SeatLayoutNode[];\n  records: DisciplineRecord[];\n  studentSummaries: Record<string, StudentWeekSummary>;\n  currentWeek: number;\n  settings: TeacherSettings;\n  onSubmitExplanation: (recordId: string, explanation: string) => void;\n}\n\nexport const StudentView: React.FC<StudentViewProps> = ({\n  currentStudent,\n  allStudents,\n  layout,\n  records,\n  studentSummaries,\n  currentWeek,\n  settings,\n  onSubmitExplanation,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'my_score\' | \'seating\' | \'ranking\'>(\'my_score\');\n  const [selectedRecordForExplanation, setSelectedRecordForExplanation] = useState<DisciplineRecord | null>(null);\n  const [explanationText, setExplanationText] = useState(\'\');\n\n  // My summary for the week\n  const mySummary = studentSummaries[currentStudent.maHS] || {\n    diemHienTai: settings.diemKhoiDau,\n    tongDiemTru: 0,\n    tongDiemCong: 0,\n    xepLoai: \'Tot\',\n    mucMau: \'none\',\n    soLoiTrongTuan: 0,\n    coLoiNang: false,\n  };\n\n  // My personal records"
