  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { \n  Move, \n  RotateCcw, \n  Save, \n  Check, \n  X, \n  ArrowRightLeft, \n  Info,\n  Sparkles\n} from \'lucide-react\';\nimport { Student, SeatLayoutNode, SeatNodeType } from \'../../types\';\nimport { CADRE_ROLES_INFO } from \'../../data/badgeData\';\n\ninterface ClassroomLayoutEditorProps {\n  initialLayout: SeatLayoutNode[];\n  initialStudents: Student[];\n  onSave: (newLayout: SeatLayoutNode[], updatedStudents: Student[]) => void;\n  onClose: () => void;\n}\n\nexport const ClassroomLayoutEditor: React.FC<ClassroomLayoutEditorProps> = ({\n  initialLayout,\n  initialStudents,\n  onSave,\n  onClose,\n}) => {\n  const [layout, setLayout] = useState<SeatLayoutNode[]>(() => JSON.parse(JSON.stringify(initialLayout)));\n  const [students, setStudents] = useState<Student[]>(() => JSON.parse(JSON.stringify(initialStudents)));\n  \n  // Drag and drop state\n  const [draggedNode, setDraggedNode] = useState<{ hang: number; cot: number; maHS?: string } | null>(null);\n  const [dragOverNode, setDragOverNode] = useState<{ hang: number; cot: number } | null>(null);\n  \n  // Click-to-swap state (for mobile touchscreens)\n  const [selectedSlotForSwap, setSelectedSlotForSwap] = useState<{ hang: number; cot: number; maHS?: string } | null>(null);\n  const [hasChanges, setHasChanges] = useState(false);\n  const [feedbackMsg, setFeedbackMsg] = useState<string | null>(null);\n\n  // Map student by ID\n  const studentMap = useMemo(() => {\n    const map = new Map<string, Student>();\n    students.forEach(s => map.set(s.maHS, s));\n    return map;\n  }, [students]);\n\n  // Group nodes by row\n  const rows = useMemo(() => {\n    const grouped: Record<number, SeatLayoutNode[]> = {};\n    layout.forEach(node => {\n      if (!grouped[node.hang]) {\n        grouped[node.hang] = [];\n      }\n      grouped[node.hang].push(node);\n    });\n\n    Object.keys(grouped).forEach(r => {\n      grouped[Number(r)].sort((a, b) => a.cot - b.cot);\n    });\n\n    return grouped;\n  }, [layout]);\n\n  // Show a temporary feedback message\n  const showFeedback = (msg: string) => {\n    setFeedbackMsg(msg);\n    setTimeout(() => {\n      setFeedbackMsg(prev => (prev === msg ? null : prev));\n    }, 4000);\n  };\n\n  // Helper to get D\303\243y b\303\240n (1..6) from column index\n  const getDayFromCot = (cot: number): number => {\n    if (cot === 0) return 1;\n    if (cot === 1) return 2;\n    if (cot === 3) return 3;\n    if (cot === 4) return 4;\n    if (cot === 6) return 5;\n    if (cot === 7) return 6;\n    return 1;\n  };\n\n  // Helper to get S\341\273\221 b\303\240n (1..4) from row index\n  const getBanFromHang = (hang: number): number => {\n    if (hang <= 2) return 1;\n    if (hang <= 4) return 2;\n    if (hang <= 6) return 3;\n    return 4;\n  };\n\n  // Swap two student seats in layout\n  const performSwap = (\n    src: { hang: number; cot: number; maHS?: string },\n    tgt: { hang: number; cot: number; maHS?: string }\n  ) => {\n    if (src.hang === tgt.hang && src.cot === tgt.cot) {\n      setSelectedSlotForSwap(null);\n      return;\n    }\n\n    const newLayout = [...layout];\n    const srcIndex = newLayout.findIndex(n => n.hang === src.hang && n.cot === src.cot);\n    const tgtIndex = newLayout.findIndex(n => n.hang === tgt.hang && n.cot === tgt.cot);\n\n    if (srcIndex === -1 || tgtIndex === -1) return;\n\n    const srcNode = newLayout[srcIndex];\n    const tgtNode = newLayout[tgtIndex];\n\n    const srcStudent = srcNode.maHS ? studentMap.get(srcNode.maHS) : undefined;\n    const tgtStudent = tgtNode.maHS ? studentMap.get(tgtNode.maHS) : undefined;\n\n    // Swap students\n    const tempMaHS = srcNode.maHS;\n    srcNode.maHS = tgtNode.maHS;\n    tgtNode.maHS = tempMaHS;\n\n    // If one was \'trong\', convert to \'ghe\' if receiving a student\n    if (tgtNode.loaiO === \'trong\' && tgtNode.maHS) {\n      tgtNode.loaiO = \'ghe\';\n    }\n    if (srcNode.loaiO === \'ghe\' && !srcNode.maHS) {\n      srcNode.loaiO = \'trong\';\n    }\n\n    // Update student positions (dayBan, soBan)\n    const updatedStudents = students.map(s => {\n      if (srcStudent && s.maHS === srcStudent.maHS) {\n        return {\n          ...s,\n          dayBan: getDayFromCot(tgt.cot),\n          soBan: getBanFromHang(tgt.hang)\n        };\n      }\n      if (tgtStudent && s.maHS === tgtStudent.maHS) {\n        return {\n          ...s,\n          dayBan: getDayFromCot(src.cot),\n          soBan: getBanFromHang(src.hang)\n        };\n      }\n      return s;\n    });\n\n    setLayout(newLayout);\n    setStudents(updatedStudents);\n    setHasChanges(true);\n\n    const srcName = srcStudent?.hoTen || \'Ch\341\273\227 tr\341\273\221ng\';\n    const tgtName = tgtStudent?.hoTen || \'Ch\341\273\227 tr\341\273\221ng\';\n    showFeedback(`\304\220\303\243 ho\303\241n \304\221\341\273\225i v\341\273\213 tr\303\255: ${srcName} \342\207\204 ${tgtName}`);\n\n    setSelectedSlotForSwap(null);\n    setDraggedNode(null);\n    setDragOverNode(null);\n  };\n\n  // Handle cell click (Click-to-swap)\n  const handleCellClick = (node: SeatLayoutNode) => {\n    if (node.loaiO === \'loidi\' || node.loaiO === \'cua\' || node.loaiO === \'banGV\' || node.loaiO === \'buc\') {\n      return;\n    }\n\n    if (!selectedSlotForSwap) {\n      setSelectedSlotForSwap({ hang: node.hang, cot: node.cot, maHS: node.maHS });\n      const student = node.maHS ? studentMap.get(node.maHS) : undefined;\n      showFeedback(`\304\220ang ch\341\273\215n: ${student ? student.hoTen : \'Ch\341\273\227 tr\341\273\221ng\'}. Ch\341\272\241m \303\264 ti\341\272\277p theo \304\221\341\273\203 ho\303\241n \304\221\341\273\225i!`);\n    } else {\n      performSwap(selectedSlotForSwap, { hang: node.hang, cot: node.cot, maHS: node.maHS });\n    }\n  };\n\n  // HTML5 Drag Events\n  const handleDragStart = (e: React.DragEvent, node: SeatLayoutNode) => {\n    if (node.loaiO === \'loidi\' || node.loaiO === \'cua\' || node.loaiO === \'banGV\' || node.loaiO === \'buc\') {\n      e.preventDefault();\n      return;\n    }\n    setDraggedNode({ hang: node.hang, cot: node.cot, maHS: node.maHS });\n    e.dataTransfer.setData(\'text/plain\', JSON.stringify({ hang: node.hang, cot: node.cot, maHS: node.maHS }));\n    e.dataTransfer.effectAllowed = \'move\';\n  };\n\n  const handleDragOver = (e: React.DragEvent, node: SeatLayoutNode) => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = \'move\';\n    if (!dragOverNode || dragOverNode.hang !== node.hang || dragOverNode.cot !== node.cot) {\n      setDragOverNode({ hang: node.hang, cot: node.cot });\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent, targetNode: SeatLayoutNode) => {\n    e.preventDefault();\n    if (!draggedNode) return;\n    performSwap(draggedNode, { hang: targetNode.hang, cot: targetNode.cot, maHS: targetNode.maHS });\n  };\n\n  // Toggle B\303\240n GV and C\341\273\255a ch\303\255nh\n  const handleToggleDeskDoorSwap = () => {\n    const banGVNode = layout.find(n => n.hang === 0 && n.loaiO === \'banGV\');\n    const isBanGVLeft = (banGVNode?.cot ?? 0) <= 2;\n    const toLeft = !isBanGVLeft;\n\n    const newLayout = layout.map(node => {\n      if (node.hang === 0) {\n        if (toLeft) {\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n GV\' };\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a ch\303\255nh\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\272\243ng\' };\n        } else {\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a ch\303\255nh\' };\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n GV\' };\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\272\243ng\' };\n        }\n      }\n      return node;\n    });\n\n    setLayout(newLayout);\n    setHasChanges(true);\n    showFeedback(`\304\220\303\243 chuy\341\273\203n: B\303\240n GV b\303\252n ${toLeft ? \'Tr\303\241i\' : \'Ph\341\272\243i\'}, C\341\273\255a ch\303\255nh b\303\252n ${toLeft ? \'Ph\341\272\243i\' : \'Tr\303\241i\'}`);\n  };\n\n  // Reset to default initial layout\n  const handleReset = () => {\n    if (window.confirm(\'Kh\303\264i ph\341\273\245c l\341\272\241i s\306\241 \304\221\341\273\223 v\341\273\213 tr\303\255 ban \304\221\341\272\247u?\')) {\n      setLayout(JSON.parse(JSON.stringify(initialLayout)));\n      setStudents(JSON.parse(JSON.stringify(initialStudents)));\n      setSelectedSlotForSwap(null);\n      setHasChanges(false);\n      showFeedback(\'\304\220\303\243 kh\303\264i ph\341\273\245c l\341\272\241i s\306\241 \304\221\341\273\223 g\341\273\221c.\');\n    }\n  };\n\n  // Save changes\n  const handleSave = () => {\n    onSave(layout, students);\n    setHasChanges(false);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/70 backdrop-blur-xs animate-fade-in\">\n      <div \n        className=\"w-full max-w-4xl bg-surface border border-token rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[95vh] animate-scale-up\"\n        onClick={e => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-5 bg-gradient-to-r from-blue-500/15 via-accent/10 to-purple-500/15 border-b border-token flex items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-2xl bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0\">\n              <Move className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-base sm:text-lg font-extrabold text-main leading-tight\">\n                  K\303\251o th\341\272\243 &amp; S\341\272\257p x\341\272\277p Ch\341\273\227 ng\341\273\223i H\341\273\215c sinh\n                </h3>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-accent/20 text-accent\">\n                  D\303\240nh cho GVCN\n                </span>\n              </div>\n              <p className=\"text-xs text-muted mt-0.5\">\n                K\303\251o th\341\272\243 chu\341\273\231t ho\341\272\267c ch\341\272\241m 2 gh\341\272\277 \304\221\341\273\203 ho\303\241n \304\221\341\273\225i v\341\273\213 tr\303\255 h\341\273\215c sinh trong l\341\273\233p (\303\224 xanh: Nam \302\267 \303\224 h\341\273\223ng: N\341\273\257)\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleReset}\n              className=\"px-3 py-1.5 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main hover:bg-surface-2 transition-colors flex items-center gap-1.5 cursor-pointer\"\n              title=\"Kh\303\264i ph\341\273\245c s\306\241 \304\221\341\273\223 g\341\273\221c\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Kh\303\264i ph\341\273\245c</span>\n            </button>\n            <button\n              onClick={handleSave}\n              className=\"px-4 py-1.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 shadow-md transition-opacity flex items-center gap-1.5 cursor-pointer\"\n            >\n              <Save className=\"w-3.5 h-3.5\" />\n              <span>L\306\260u s\306\241 \304\221\341\273\223</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-xl text-muted hover:text-main hove