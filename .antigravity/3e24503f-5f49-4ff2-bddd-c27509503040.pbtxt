  view_file {
    absolute_path_uri: "file:///src/components/common/PeriodHierarchyFilter.tsx"
    end_line: 139
    content: "import React, { useState } from \'react\';\nimport { \n  Calendar, \n  ChevronRight, \n  Clock, \n  Filter, \n  Layers, \n  ChevronDown,\n  RotateCcw,\n  Sparkles\n} from \'lucide-react\';\nimport { HierarchyPeriodFilter } from \'../../types\';\nimport { \n  SEMESTER_1_WEEKS, \n  SEMESTER_2_WEEKS, \n  ALL_SCHOOL_WEEKS, \n  getSemesterFromWeek \n} from \'../../utils/hierarchy\';\n\ninterface PeriodHierarchyFilterProps {\n  filter: HierarchyPeriodFilter;\n  onChangeFilter: (newFilter: HierarchyPeriodFilter) => void;\n  compact?: boolean;\n}\n\nexport const PeriodHierarchyFilter: React.FC<PeriodHierarchyFilterProps> = ({\n  filter,\n  onChangeFilter,\n  compact = false,\n}) => {\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  // Quick preset handlers\n  const setPresetWeek3 = () => {\n    onChangeFilter({\n      namHoc: \'2026-2027\',\n      hocKi: 1,\n      thang: \'all\',\n      tuanHoc: 3,\n      ngayHoc: \'all\',\n      buoi: \'all\',\n    });\n  };\n\n  const setPresetMorningToday = () => {\n    onChangeFilter({\n      namHoc: \'2026-2027\',\n      hocKi: 1,\n      thang: \'all\',\n      tuanHoc: 3,\n      ngayHoc: \'all\',\n      buoi: \'Sang\',\n    });\n  };\n\n  const setPresetSemester1 = () => {\n    onChangeFilter({\n      namHoc: \'2026-2027\',\n      hocKi: 1,\n      thang: \'all\',\n      tuanHoc: \'all\',\n      ngayHoc: \'all\',\n      buoi: \'all\',\n    });\n  };\n\n  const setPresetSemester2 = () => {\n    onChangeFilter({\n      namHoc: \'2026-2027\',\n      hocKi: 2,\n      thang: \'all\',\n      tuanHoc: \'all\',\n      ngayHoc: \'all\',\n      buoi: \'all\',\n    });\n  };\n\n  const setPresetFullYear = () => {\n    onChangeFilter({\n      namHoc: \'2026-2027\',\n      hocKi: \'all\',\n      thang: \'all\',\n      tuanHoc: \'all\',\n      ngayHoc: \'all\',\n      buoi: \'all\',\n    });\n  };\n\n  // Determine available weeks based on selected semester\n  const availableWeeks = filter.hocKi === 1 \n    ? SEMESTER_1_WEEKS \n    : filter.hocKi === 2 \n      ? SEMESTER_2_WEEKS \n      : ALL_SCHOOL_WEEKS;\n\n  // Human readable label for 4-level hierarchy: N\304\203m h\341\273\215c - H\341\273\215c k\303\254 - Tu\341\272\247n - Bu\341\273\225i\n  const currentLabel = () => {\n    const parts: string[] = [];\n    parts.push(`N\304\203m ${filter.namHoc}`);\n\n    if (filter.hocKi !== \'all\') {\n      parts.push(`H\341\273\215c k\303\254 ${filter.hocKi} (${filter.hocKi === 1 ? \'Tu\341\272\247n 1-19\' : \'Tu\341\272\247n 20-38\'})`);\n    } else {\n      parts.push(\'C\341\272\243 n\304\203m h\341\273\215c\');\n    }\n\n    if (filter.tuanHoc !== \'all\') {\n      parts.push(`Tu\341\272\247n ${filter.tuanHoc}`);\n    } else {\n      parts.push(\'T\341\272\245t c\341\272\243 tu\341\272\247n\');\n    }\n\n    if (filter.buoi !== \'all\') {\n      parts.push(filter.buoi === \'Sang\' ? \'Bu\341\273\225i S\303\241ng\' : \'Bu\341\273\225i Chi\341\273\201u\');\n    } else {\n      parts.push(\'C\341\272\243 ng\303\240y\');\n    }\n\n    return parts.join(\' > \');\n  };\n\n  return (\n    <div className=\"w-full bg-surface rounded-xl border border-token p-2.5 space-y-2 shadow-xs text-xs\">\n      {/* Top Header: Current Hierarchy Breadcrumb & Expand Button */}\n      <div className=\"flex items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-2 min-w-0\">\n          <div className=\"w-6 h-6 rounded-lg bg-accent/15 text-accent flex items-center justify-center shrink-0\">\n            <Layers className=\"w-3.5 h-3.5\" />\n          </div>\n          <div className=\"min-w-0\">\n            <div className=\"text-[10px] font-semibold text-muted uppercase tracking-wider\">\n              Ph\303\242n c\341\272\245p: N\304\203m h\341\273\215c \342\206\222 H\341\273\215c k\303\254 \342\206\222 Tu\341\272\247n \342\206\222 Bu\341\273\225i\n            </div>\n            <div className=\"font-bold text-main truncate text-xs\">\n              {currentLabel()}\n            </div>\n          </div>\n        </div>\n\n        <button"
    num_lines: 312
    num_bytes: 11219
    line_range_bytes: 3525
  }
}
