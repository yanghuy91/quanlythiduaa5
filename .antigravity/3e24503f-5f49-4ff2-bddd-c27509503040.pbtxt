utton\n                type=\"button\"\n                onClick={() => setVoidModalRecord(null)}\n                className=\"px-3 py-1.5 rounded-xl border border-token text-xs text-muted hover:text-main\"\n              >\n                Quay l\341\272\241i\n              </button>\n              <button\n                type=\"button\"\n                disabled={!voidReason.trim()}"
