    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "  // Teacher import time-stamped records from file\n  const handleImportRecords = useCallback((newRecords: DisciplineRecord[]) => {\n    setRecords(prev => [...newRecords, ...prev]);\n    setToast({\n      id: Date.now().toString(),\n      message: `\304\220\303\243 n\341\272\241p ${newRecords.length} b\341\272\243n ghi th\341\273\235i gian \342\234\250`,\n      subMessage: \'D\341\273\257 li\341\273\207u thi \304\221ua t\341\273\253 file \304\221\303\243 \304\221\306\260\341\273\243c t\303\255ch h\341\273\243p th\303\240nh c\303\264ng v\303\240o h\341\273\207 th\341\273\221ng!\',\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-app text-main antialiased selection:bg-accent/20\">\n      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n            onImportRecords={handleImportRecords}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n          />\n        )}"
        replacement_content: "  // Teacher import time-stamped records from file\n  const handleImportRecords = useCallback((newRecords: DisciplineRecord[]) => {\n    setRecords(prev => [...newRecords, ...prev]);\n    setToast({\n      id: Date.now().toString(),\n      message: `\304\220\303\243 n\341\272\241p ${newRecords.length} b\341\272\243n ghi th\341\273\235i gian \342\234\250`,\n      subMessage: \'D\341\273\257 li\341\273\207u thi \304\221ua t\341\273\253 file \304\221\303\243 \304\221\306\260\341\273\243c t\303\255ch h\341\273\243p th\303\240nh c\303\264ng v\303\240o h\341\273\207 th\341\273\221ng!\',\n    });\n  }, []);\n\n  // Teacher assigns custom frame to student\n  const handleAssignFrame = useCallback((studentId: string, frameId: string | undefined) => {\n    setStudents(prev => {\n      const updated = prev.map(s => (s.maHS === studentId ? { ...s, customFrameId: frameId } : s));\n      localStorage.setItem(\'app_students_10a5\', JSON.stringify(updated));\n      return updated;\n    });\n  }, []);\n\n  // Teacher auto awards frames according to ranking\n  const handleBatchAutoAssignByRank = useCallback(() => {\n    const sorted = [...students].sort((a, b) => {\n      const sA = studentSummaries[a.maHS]?.diemHienTai ?? 100;\n      const sB = studentSummaries[b.maHS]?.diemHienTai ?? 100;\n      return sB - sA;\n    });\n\n    const updated = sorted.map((st, idx) => {\n      const rank = idx + 1;\n      let frameId: string | undefined = undefined;\n      if (rank === 1) frameId = \'diamond_champion\';\n      else if (rank <= 3) frameId = \'platinum_elite\';\n      else if (rank <= 10) frameId = \'gold_royal\';\n      return { ...st, customFrameId: frameId };\n    });\n\n    setStudents(updated);\n    localStorage.setItem(\'app_students_10a5\', JSON.stringify(updated));\n    setToast({\n      id: Date.now().toString(),\n      message: \'\304\220\303\243 t\341\273\261 \304\221\341\273\231ng phong t\341\272\267ng khung vinh danh \342\234\250\',\n      subMessage: \'Top 1 (Kim C\306\260\306\241ng), Top 2-3 (B\341\272\241ch Kim), Top 4-10 (Ho\303\240ng Kim) \304\221\303\243 \304\221\306\260\341\273\243c trao!\',\n    });\n  }, [students, studentSummaries]);\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-app text-main antialiased selection:bg-accent/20\">\n      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n            onImportRecords={handleImportRecords}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n            onAssignFrame={handleAssignFrame}\n            onBatchAutoAssignByRank={handleBatchAutoAssignByRank}\n          />\n        )}"
        start_line: 330
        end_line: 373
      }
      num_matches: 1
    }
    description: "Add frame management callbacks and pass them to TeacherDashboard"
    diff_stats {
      additions: 37
    }
  }
}
