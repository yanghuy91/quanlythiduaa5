            }
            lines {
              text: "  // 24-hour remaining countdown helper"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const getRemainingHours = (isoTime: string) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const recordTime = new Date(isoTime).getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const now = new Date().getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const limitMs = settings.thoiHanSuaHuyPhut * 60 * 1000;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const diff = (recordTime + limitMs) - now;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return Math.max(0, Math.floor(diff / (1000 * 60 * 60)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
