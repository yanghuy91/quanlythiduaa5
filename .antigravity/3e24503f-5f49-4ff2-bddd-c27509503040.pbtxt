    content: "        <div className=\"min-w-[340px] max-w-full mx-auto flex flex-col gap-2\">\n          {Object.entries(rows).map(([rowKey, nodes]) => {\n            const rowIndex = Number(rowKey);\n\n            return (\n              <div \n                key={rowKey}\n                className=\"grid grid-cols-8 gap-1.5 sm:gap-2 items-center\"\n              >\n                {nodes.map(node => {\n                  if (!shouldRenderCol(node.cot)) {\n                    return null;\n                  }\n\n                  // Non-seat special nodes\n                  if (node.loaiO === \'loidi\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`} \n                        className=\"h-11 sm:h-12 flex items-center justify-center text-[10px] text-muted opacity-40 select-none\"\n                      >\n                        \302\267\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'cua\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-surface-2 border border-dashed border-token flex flex-col items-center justify-center text-[10px] text-muted p-1\"\n                        title={node.ghiChu || \'C\341\273\255a\'}\n                      >\n                        <DoorOpen className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px]\">C\341\273\255a</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'banGV\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-[var(--role-gv-bg)] border border-[var(--role-gv-fg)] flex flex-col items-center justify-center text-[10px] text-[var(--role-gv-fg)] font-semibold p-1\"\n                      >\n                        <Armchair className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px]\">B\303\240n GV</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'buc\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md bg-surface-2 border border-token flex flex-col items-center justify-center text-[10px] text-muted p-1\"\n                      >\n                        <BookOpen className=\"w-3.5 h-3.5\" />\n                        <span className=\"truncate max-w-full text-[9px] font-medium\">B\341\273\245c</span>\n                      </div>\n                    );\n                  }\n\n                  if (node.loaiO === \'trong\') {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md border border-dashed border-token bg-transparent flex items-center justify-center text-[10px] text-muted opacity-40 select-none\"\n                        title={node.ghiChu || \'Ch\341\273\227 tr\341\273\221ng\'}\n                      >\n                        <span className=\"text-[10px]\">Tr\341\273\221ng</span>\n                      </div>\n                    );\n                  }\n\n                  // Student Seat\n                  const student = node.maHS ? studentMap.get(node.maHS) : undefined;\n                  if (!student) {\n                    return (\n                      <div \n                        key={`${node.hang}-${node.cot}`}\n                        className=\"h-11 sm:h-12 rounded-md border border-dashed border-token bg-surface-2\"\n                      />\n                    );\n                  }\n"
