  planner_response {
    thinking: "**Building the Teacher Dashboard**\n\nI\'m now focusing on the teacher dashboard, specifically building the `TeacherDashboard.tsx` component. I\'m integrating requirements derived from M\341\273\245c 7.3 and 8. The initial focus is on the teacher navigation, planning a tabbed or sidebar approach. I\'m starting with the \"T\341\273\225ng quan\" (Overview) section, concentrating on displaying today\'s key metrics, potential alerts, and urgent tasks.\n\n\n**Refining Data Displays**\n\nI\'m now diving into the specifics of data presentation within the \"T\341\273\225ng quan\" section. I\'m focusing on displaying key student behaviors and infractions for the current week. I\'m prioritizing the display of pending explanations and records needing confirmation. A crucial update: user feedback is clear; I\'m **omitting any team scoring or ranking**, per their direct request. I\'m thinking about how to handle the approval queue for student explanations with \"Approve\" (accept) and \"Reject\" (mandatory reason) actions.\n\n\n"
    tool_calls {
      id: "call_1108199579554362998"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { \\n  BarChart3, \\n  ClipboardList, \\n  CheckSquare, \\n  Users, \\n  Settings, \\n  FileSpreadsheet, \\n  FileDown, \\n  Upload, \\n  ShieldAlert, \\n  CheckCircle2, \\n  XCircle, \\n  Star, \\n  Layers, \\n  Sparkles,\\n  AlertTriangle,\\n  Info\\n} from \'lucide-react\';\\nimport { \\n  Student, \\n  SeatLayoutNode, \\n  DisciplineRecord, \\n  RuleItem, \\n  StudentWeekSummary, \\n  TeacherSettings \\n} from \'../../types\';\\nimport { StudentPicker } from \'../student-picker/StudentPicker\';\\nimport { RecordBottomSheet } from \'../record/RecordBottomSheet\';\\nimport { DuplicateWarningModal } from \'../record/DuplicateWarningModal\';\\nimport { checkDuplicateRecord } from \'../../utils/emulation\';\\n\\ninterface TeacherDashboardProps {\\n  students: Student[];\\n  layout: SeatLayoutNode[];\\n  rules: RuleItem[];\\n  records: DisciplineRecord[];\\n  studentSummaries: Record<string, StudentWeekSummary>;\\n  currentWeek: number;\\n  settings: TeacherSettings;\\n  onUpdateSettings: (newSettings: Partial<TeacherSettings>) => void;\\n  onAddRecord: (record: Omit<DisciplineRecord, \'maGhiNhan\' | \'thoiGianMayChu\' | \'thoiGianMay\'>) => void;\\n  onResolveExplanation: (recordId: string, result: \'ChapNhan\' | \'TuChoi\', reason: string) => void;\\n  onToggleRulePin: (ruleId: string) => void;\\n}\\n\\nexport const TeacherDashboard: React.FC<TeacherDashboardProps> = ({\\n  students,\\n  layout,\\n  rules,\\n  records,\\n  studentSummaries,\\n  currentWeek,\\n  settings,\\n  onUpdateSettings,\\n  onAddRecord,\\n  onResolveExplanation,\\n  onToggleRulePin,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'record\' | \'explanations\' | \'roster\' | \'rules\' | \'import_export\' | \'settings\'>(\'overview\');\\n\\n  // Record flow state\\n  const [selectedStudentIds, setSelectedStudentIds] = useState<string[]>([]);\\n  const [isMultiSelect, setIsMultiSelect] = useState(false);\\n  const [isBottomSheetOpen, setIsBottomSheetOpen] = useState(false);\\n  const [pendingRecordPayload, setPendingRecordPayload] = useState<{\\n    students: Student[];\\n    rule: RuleItem;\\n    date: string;\\n    session: \'Sang\' | \'Chieu\';\\n    note?: string;\\n  } | null>(null);\\n  const [duplicateModalOpen, setDuplicateModalOpen] = useState(false);\\n\\n  // Explanation review state\\n  const [rejectingRecordId, setRejectingRecordId] = useState<string | null>(null);\\n  const [rejectReason, setRejectReason] = useState<string>(\'\');\\n\\n  // Pending explanations list\\n  const pendingExplanations = useMemo(() => {\\n    return records.filter(r => r.trangThai === \'ChoDuyet\');\\n  }, [records]);\\n\\n  // Today\'s records\\n  const todayRecords = useMemo(() => {\\n    const todayStr = \'2026-11-09\'; // demo date\\n    return records.filter(r => r.ngayHoc === todayStr && r.trangThai !== \'DaHuy\');\\n  }, [records]);\\n\\n  // Students requiring attention (warn / bad)\\n  const attentionStudents = useMemo(() => {\\n    return students.filter(s => {\\n      const summary = studentSummaries[s.maHS];\\n      return summary && (summary.mucMau === \'bad\' || summary.mucMau === \'warn\');\\n    });\\n  }, [students, studentSummaries]);\\n\\n  // Handle student selection from teacher record view\\n  const handleSelectStudent = (student: Student) => {\\n    if (isMultiSelect) {\\n      setSelectedStudentIds(prev => \\n        prev.includes(student.maHS)\\n          ? prev.filter(id => id !== student.maHS)\\n          : [...prev, student.maHS]\\n      );\\n    } else {\\n      setSelectedStudentIds([student.maHS]);\\n      setIsBottomSheetOpen(true);\\n    }\\n  };\\n\\n  const handleRequestSave = (payload: {\\n    students: Student[];\\n    rule: RuleItem;\\n    date: string;\\n    session: \'Sang\' | \'Chieu\';\\n    note?: string;\\n  }) => {\\n    const existingMap: Record<string, DisciplineRecord[]> = {};\\n    let hasDuplicate = false;\\n\\n    payload.students.forEach(st => {\\n      const dupCheck = checkDuplicateRecord(records, st.maHS, payload.date, payload.session, payload.rule.maNoiQuy);\\n      if (dupCheck.isDuplicate) {\\n        hasDuplicate = true;\\n        existingMap[st.maHS] = dupCheck.existingRecords;\\n      }\\n    });\\n\\n    if (hasDuplicate) {\\n      setPendingRecordPayload(payload);\\n      setDuplicateModalOpen(true);\\n    } else {\\n      executeSave(payload.students, payload.rule, payload.date, payload.session, payload.note);\\n    }\\n  };\\n\\n  const executeSave = (\\n    targetStudents: Student[],\\n    rule: RuleItem,\\n    date: string,\\n    session: \'Sang\' | \'Chieu\',\\n    note?: string\\n  ) => {\\n    targetStudents.forEach(st => {\\n      const dupCheck = checkDuplicateRecord(records, st.maHS, date, session, rule.maNoiQuy);\\n\\n      onAddRecord({\\n        ngayHoc: date,\\n        buoi: session,\\n        tuanHoc: currentWeek,\\n        doiTuong: \'HocSinh\',\\n        maHS: st.maHS,\\n        hoTen: st.hoTen,\\n        to: st.to,\\n        maNoiQuy: rule.maNoiQuy,\\n        nhomHanhVi: rule.nhomHanhVi,\\n        tenHanhVi: rule.tenHanhVi,\\n        mucDo: rule.mucDo,\\n        diemSo: rule.diemSo,\\n        loaiDiem: rule.loaiDiem,\\n        ghiChu: note,\\n        nguoiGhi: \'Tr\341\272\247n V\304\203n B\303\254nh (GVCN)\',\\n        vaiTroNguoiGhi: \'GV\',\\n        nguonGhi: \'TrucTiep\',\\n        lanThuTrongBuoi: dupCheck.lanThu,\\n        daXacNhanTrung: dupCheck.isDuplicate,\\n        trangThai: \'HieuLuc\',\\n      });\\n    });\\n\\n    setSelectedStudentIds([]);\\n    setIsMultiSelect(false);\\n    setIsBottomSheetOpen(false);\\n  };\\n\\n  return (\\n    <div className=\\\"w-full flex flex-col gap-4\\\">\\n      {/* Teacher Navigation Tabs */}\\n      <div className=\\\"flex items-center gap-1.5 overflow-x-auto no-scrollbar p-1 bg-surface-2 rounded-xl border border-token\\\">\\n        <button\\n          onClick={() => setActiveTab(\'overview\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'overview\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <BarChart3 className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>T\341\273\225ng quan</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'record\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'record\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <ClipboardList className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>Ghi nh\341\272\255n</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'explanations\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'explanations\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <CheckSquare className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>Gi\341\272\243i tr\303\254nh</span>\\n          {pendingExplanations.length > 0 && (\\n            <span className=\\\"w-4 h-4 rounded-full bg-[var(--st-bad)] text-white text-[10px] flex items-center justify-center font-bold\\\">\\n              {pendingExplanations.length}\\n            </span>\\n          )}\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'roster\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'roster\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <Users className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>L\341\273\233p &amp; S\306\241 \304\221\341\273\223 (42 HS)</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'rules\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'rules\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <Layers className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>N\341\273\231i quy</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'import_export\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'import_export\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <FileSpreadsheet className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>Nh\341\272\255p / Xu\341\272\245t</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'settings\')}\\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\\n            activeTab === \'settings\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <Settings className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>C\303\240i \304\221\341\272\267t</span>\\n        </button>\\n      </div>\\n\\n      {/* 1. OVERVIEW */}\\n      {activeTab === \'overview\' && (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Top Quick Stats */}\\n          <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3\\\">\\n            <div className=\\\"p-3.5 rounded-2xl bg-surface border border-token\\\">\\n              <div className=\\\"text-[11px] text-muted font-medium\\\">H\341\273\215c sinh l\341\273\233p</div>\\n              <div className=\\\"text-xl font-bold text-main mt-0.5\\\">42 em</div>\\n              <div className=\\\"text-[10px] text-muted mt-1\\\">6 d\303\243y b\303\240n \302\267 4 t\341\273\225</div>\\n            </div>\\n\\n            <div className=\\\"p-3.5 rounded-2xl bg-surface border border-token\\\">\\n              <div className=\\\"text-[11px] text-muted font-medium\\\">Vi ph\341\272\241m h\303\264m nay</div>\\n              <div className=\\\"text-xl font-bold text-main mt-0.5\\\">{todayRecords.length} l\306\260\341\273\243t</div>\\n              <div className=\\\"text-[10px] text-muted mt-1\\\">\304\220\303\243 ki\341\273\203m tra tr\303\271ng bu\341\273\225i</div>\\n            </div>\\n\\n            <div className=\\\"p-3.5 rounded-2xl bg-surface border border-token\\\">\\n              <div className=\\\"text-[11px] text-muted font-medium\\\">Gi\341\272\243i tr\303\254nh ch\341\273\235 duy\341\273\207t</div>\\n              <div className=\\\"text-xl font-bold text-accent mt-0.5\\\">{pendingExplanations.length} \304\221\306\241n</div>\\n              <div className=\\\"text-[10px] text-muted mt-1\\\">H\341\272\241n x\341\273\255 l\303\275 trong 7 ng\303\240y</div>\\n            </div>\\n\\n            <div className=\\\"p-3.5 rounded-2xl bg-surface border border-token\\\">\\n              <div className=\\\"text-[11px] text-muted font-medium\\\">H\341\273\215c sinh c\341\272\247n l\306\260u \303\275</div>\\n              <div className=\\\"text-xl font-bold text-[var(--st-bad)] mt-0.5\\\">{attentionStudents.length} em</div>\\n              <div className=\\\"text-[10px] text-muted mt-1\\\">Vi\341\273\201n \304\221\341\273\217 ho\341\272\267c v\303\240ng</div>\\n            </div>\\n          </div>\\n\\n          {/* Attention List */}\\n          <div className=\\\"p-4 rounded-2xl bg-surface border border-token shadow-xs space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <AlertTriangle className=\\\"w-4 h-4 text-[var(--st-warn)]\\\" />\\n                <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                  H\341\273\215c sinh c\303\263 \304\221i\341\273\203m tr\341\273\253 c\341\272\247n nh\341\272\257c nh\341\273\237 tu\341\272\247n n\303\240y\\n                </h3>\\n              </div>\\n              <span className=\\\"text-xs text-muted\\\">\\n                {attentionStudents.length} / 42 h\341\273\215c sinh\\n              </span>\\n            </div>\\n\\n            <div className=\\\"divide-y divide-token\\\">\\n              {attentionStudents.length === 0 ? (\\n                <div className=\\\"py-4 text-center text-xs text-muted\\\">\\n                  Kh\303\264ng c\303\263 h\341\273\215c sinh n\303\240o b\341\273\213 nh\341\272\257c nh\341\273\237 trong tu\341\272\247n n\303\240y!\\n                </div>\\n              ) : (\\n                attentionStudents.map(st => {\\n                  const summary = studentSummaries[st.maHS];\\n                  return (\\n                    <div key={st.maHS} className=\\\"py-2.5 flex items-center justify-between text-xs\\\">\\n                      <div className=\\\"flex items-center gap-2.5\\\">\\n                        <span className=\\\"w-6 h-6 rounded-md bg-surface-2 flex items-center justify-center font-bold text-[11px] text-muted\\\">\\n                          {st.viTriGhe}\\n                        </span>\\n                        <div>\\n                          <span className=\\\"font-bold text-main\\\">{st.hoTen}</span>\\n                          <span className=\\\"text-[11px] text-muted ml-2\\\">T\341\273\225 {st.to} \302\267 D\303\243y {st.dayBan}</span>\\n                        </div>\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <span className=\\\"font-bold text-[var(--st-bad)]\\\">\\n                          -{summary?.tongDiemTru} \304\221i\341\273\203m\\n                        </span>\\n                        <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${\\n                          summary?.mucMau === \'bad\' \\n                            ? \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\' \\n                            : \'bg-[var(--st-warn)]/15 text-[var(--st-warn)]\'\\n                        }`}>\\n                          {summary?.mucMau === \'bad\' ? \'C\341\272\247n l\306\260u \303\275\' : \'Nh\341\272\257c nh\341\273\237\'}\\n                        </span>\\n                      </div>\\n                    </div>\\n                  );\\n                })\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* 2. RECORD (Full Authority for Teacher) */}\\n      {activeTab === \'record\' && (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"p-3 bg-surface rounded-xl border border-token text-xs text-main flex items-center justify-between\\\">\\n            <span className=\\\"font-semibold\\\">\\n              Khu v\341\273\261c ghi nh\341\272\255n c\341\273\247a Gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m (To\303\240n quy\341\273\201n 42 h\341\273\215c sinh &amp; m\341\273\215i nh\303\263m n\341\273\231i quy)\\n            </span>\\n            <span className=\\\"text-xs text-muted\\\">2 ch\341\272\241m: Ch\341\273\215n ng\306\260\341\273\235i $\\\\rightarrow$ Ch\341\273\215n l\341\273\227i</span>\\n          </div>\\n\\n          <StudentPicker\\n            students={students}\\n            layout={layout}\\n            studentSummaries={studentSummaries}\\n            selectedStudentIds={selectedStudentIds}\\n            onSelectStudent={handleSelectStudent}\\n            viewerRole=\\\"GV\\\"\\n            showStatusColors={true}\\n            isMultiSelect={isMultiSelect}\\n            onToggleMultiSelect={() => {\\n              setIsMultiSelect(!isMultiSelect);\\n              if (isMultiSelect) setSelectedStudentIds([]);\\n            }}\\n          />\\n\\n          {isMultiSelect && selectedStudentIds.length > 0 && (\\n            <div className=\\\"fixed bottom-20 left-1/2 -translate-x-1/2 z-30 w-11/12 max-w-md bg-primary text-on-primary rounded-xl shadow-2xl p-3 border border-token flex items-center justify-between animate-slide-up\\\">\\n              <div className=\\\"text-xs font-semibold\\\">\\n                \304\220\303\243 ch\341\273\215n <strong className=\\\"text-accent underline\\\">{selectedStudentIds.length}</strong> h\341\273\215c sinh\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setIsBottomSheetOpen(true)}\\n                className=\\\"px-4 py-2 rounded-lg bg-accent text-on-accent text-xs font-bold shadow-xs hover:opacity-95 transition-opacity cursor-pointer flex items-center gap-1.5\\\"\\n              >\\n                <span>Ch\341\273\215n h\303\240nh vi \304\221\341\273\203 ghi</span>\\n              </button>\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {/* 3. EXPLANATIONS QUEUE */}\\n      {activeTab === \'explanations\' && (\\n        <div className=\\\"bg-surface rounded-2xl border border-token overflow-hidden shadow-xs\\\">\\n          <div className=\\\"px-4 py-3 border-b border-token flex items-center justify-between\\\">\\n            <div>\\n              <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                H\303\240ng \304\221\341\273\243i duy\341\273\207t gi\341\272\243i tr\303\254nh h\341\273\215c sinh\\n              </h3>\\n              <p className=\\\"text-[11px] text-muted mt-0.5\\\">\\n                Ch\341\272\245p nh\341\272\255n s\341\272\275 h\341\273\247y \304\221i\341\273\203m tr\341\273\253; T\341\273\253 ch\341\273\221i b\341\272\257t bu\341\273\231c nh\341\272\255p l\303\275 do ph\341\272\243n h\341\273\223i cho h\341\273\215c sinh.\\n              </p>\\n            </div>\\n            <span className=\\\"text-xs font-bold px-2 py-0.5 rounded-full bg-accent/15 text-accent\\\">\\n              {pendingExplanations.length} ch\341\273\235 duy\341\273\207t\\n            </span>\\n          </div>\\n\\n          <div className=\\\"divide-y divide-token\\\">\\n            {pendingExplanations.length === 0 ? (\\n              <div className=\\\"p-8 text-center text-xs text-muted\\\">\\n                <CheckCircle2 className=\\\"w-8 h-8 text-[var(--st-ok)] mx-auto mb-2\\\" />\\n                Hi\341\273\207n kh\303\264ng c\303\263 gi\341\272\243i tr\303\254nh n\303\240o \304\221ang ch\341\273\235 duy\341\273\207t.\\n              </div>\\n            ) : (\\n              pendingExplanations.map(rec => (\\n                <div key={rec.maGhiNhan} className=\\\"p-4 space-y-3\\\">\\n                  <div className=\\\"flex items-start justify-between\\\">\\n                    <div>\\n                      <div className=\\\"flex items-center gap-2\\\">\\n                        <span className=\\\"text-xs font-bold text-main\\\">{rec.hoTen}</span>\\n                        <span className=\\\"text-[11px] text-muted\\\">(T\341\273\225 {rec.to})</span>\\n                        <span className=\\\"text-xs font-bold text-[var(--st-bad)]\\\">-{rec.diemSo}\304\221</span>\\n                      </div>\\n                      <div className=\\\"text-xs font-medium text-main mt-0.5\\\">\\n                        L\341\273\227i: {rec.tenHanhVi} ({rec.ngayHoc})\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"p-3 rounded-xl bg-surface-2 border border-token text-xs text-main\\\">\\n                    <div className=\\\"text-[10px] font-semibold text-muted mb-1\\\">\\n                      N\341\273\231i dung gi\341\272\243i tr\303\254nh c\341\273\247a h\341\273\215c sinh:\\n                    </div>\\n                    <p className=\\\"italic\\\">\\\"{rec.noiDungGiaiTrinh}\\\"</p>\\n                  </div>\\n\\n                  {/* Action buttons */}\\n                  <div className=\\\"flex items-center justify-end gap-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setRejectingRecordId(rec.maGhiNhan)}\\n                      className=\\\"px-3 py-1.5 rounded-lg border border-[var(--st-bad)]/40 text-[var(--st-bad)] text-xs font-semibold hover:bg-[var(--st-bad)]/10 transition-colors cursor-pointer\\\"\\n                    >\\n                      T\341\273\253 ch\341\273\221i\\n                    </button>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onResolveExplanation(rec.maGhiNhan, \'ChapNhan\', \'Gi\303\241o vi\303\252n ch\341\272\245p nh\341\272\255n gi\341\272\243i tr\303\254nh h\341\273\243p l\303\275.\')}\\n                      className=\\\"px-4 py-1.5 rounded-lg bg-[var(--st-ok)] text-white text-xs font-bold hover:opacity-90 transition-opacity cursor-pointer\\\"\\n                    >\\n                      Ch\341\272\245p nh\341\272\255n (H\341\273\247y tr\341\273\253 \304\221i\341\273\203m)\\n                    </button>\\n                  </div>\\n                </div>\\n              ))\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* 4. ROSTER & SEATING (42 Students, 6 Desks, Empty spots) */}\\n      {activeTab === \'roster\' && (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"p-4 rounded-2xl bg-surface border border-token shadow-xs\\\">\\n            <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider mb-2\\\">\\n              S\306\241 \304\221\341\273\223 ch\341\273\227 ng\341\273\223i 6 d\303\243y b\303\240n l\341\273\233p 10A5 (42 h\341\273\215c sinh)\\n            </h3>\\n            <StudentPicker\\n              students={students}\\n              layout={layout}\\n              studentSummaries={studentSummaries}\\n              selectedStudentIds={[]}\\n              onSelectStudent={() => {}}\\n              viewerRole=\\\"GV\\\"\\n              showStatusColors={true}\\n            />\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* 5. RULES & BONUS TOGGLE */}\\n      {activeTab === \'rules\' && (\\n        <div className=\\\"bg-surface rounded-2xl border border-token p-4 space-y-4 shadow-xs\\\">\\n          <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-token pb-3\\\">\\n            <div>\\n              <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                Danh m\341\273\245c n\341\273\231i quy n\341\273\201 n\341\272\277p thi \304\221ua\\n              </h3>\\n              <p className=\\\"text-[11px] text-muted mt-0.5\\\">\\n                Quy \304\221\341\273\213nh m\341\273\251c tr\341\273\253 \304\221i\341\273\203m, ph\303\242n lo\341\272\241i nh\341\272\271/v\341\273\253a/n\341\272\267ng v\303\240 ghim h\303\240nh vi hay d\303\271ng\\n              </p>\\n            </div>\\n\\n            {/* Crucial User Requirement: \304\220i\341\273\203m c\341\273\231ng l\303\240 tu\341\273\263 ch\341\273\215n c\341\273\247a GV, m\341\272\267c \304\221\341\273\213nh T\341\272\256T */}\\n            <div className=\\\"flex items-center gap-2 p-2 rounded-xl bg-surface-2 border border-token\\\">\\n              <Sparkles className=\\\"w-4 h-4 text-accent\\\" />\\n              <div className=\\\"text-xs\\\">\\n                <span className=\\\"font-bold text-main block\\\">Ch\341\272\277 \304\221\341\273\231 \304\220i\341\273\203m c\341\273\231ng:</span>\\n                <span className=\\\"text-[10px] text-muted\\\">\\n                  {settings.batDiemCong ? \'\304\220ang B\341\272\254T\' : \'\304\220ang T\341\272\256T (M\341\272\267c \304\221\341\273\213nh ch\341\273\211 \304\221i\341\273\203m tr\341\273\253)\'}\\n                </span>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onUpdateSettings({ batDiemCong: !settings.batDiemCong })}\\n                className={`ml-2 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors cursor-pointer ${\\n                  settings.batDiemCong \\n                    ? \'bg-[var(--st-ok)] text-white\' \\n                    : \'bg-primary text-on-primary\'\\n                }`}\\n              >\\n                {settings.batDiemCong ? \'T\341\272\257t \304\221i\341\273\203m c\341\273\231ng\' : \'B\341\272\255t \304\221i\341\273\203m c\341\273\231ng\'}\\n              </button>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"divide-y divide-token max-h-[500px] overflow-y-auto\\\">\\n            {rules.map(rule => {\\n              const isBonus = rule.loaiDiem === \'Cong\';\\n              if (isBonus && !settings.batDiemCong) return null;\\n\\n              return (\\n                <div key={rule.maNoiQuy} className=\\\"py-2.5 flex items-center justify-between text-xs\\\">\\n                  <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onToggleRulePin(rule.maNoiQuy)}\\n                      className={`p-1 rounded cursor-pointer ${\\n                        rule.ghim ? \'text-accent\' : \'text-muted hover:text-main\'\\n                      }`}\\n                      title=\\\"Ghim v\303\240o danh s\303\241ch Hay d\303\271ng\\\"\\n                    >\\n                      <Star className={`w-4 h-4 ${rule.ghim ? \'fill-accent\' : \'\'}`} />\\n                    </button>\\n\\n                    <div className=\\\"min-w-0\\\">\\n                      <span className=\\\"font-semibold text-main\\\">{rule.tenHanhVi}</span>\\n                      <div className=\\\"text-[10px] text-muted flex items-center gap-1.5 mt-0.5\\\">\\n                        <span>{rule.nhomHanhVi}</span>\\n                        {rule.mucDo === \'Nang\' && (\\n                          <span className=\\\"font-bold text-[var(--st-bad)]\\\">\302\267 M\341\273\251c N\341\272\267ng (Chuy\341\273\203n \304\221\341\273\217 vi\341\273\201n)</span>\\n                        )}\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                    <span className={`font-bold px-2.5 py-0.5 rounded-full ${\\n                      isBonus \\n                        ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' \\n                        : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\\n                    }`}>\\n                      {isBonus ? `+${rule.diemSo}` : `-${rule.diemSo}`}\304\221\\n                    </span>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* 6. IMPORT / EXPORT (Teacher Only) */}\\n      {activeTab === \'import_export\' && (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n          {/* Import Smart Preview */}\\n          <div className=\\\"p-4 rounded-2xl bg-surface border border-token space-y-3 shadow-xs\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <Upload className=\\\"w-4 h-4 text-accent\\\" />\\n              <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                Tr\303\254nh nh\341\272\255p th\303\264ng minh (D\303\241n v\304\203n b\341\272\243n / File)\\n              </h3>\\n            </div>\\n            <p className=\\\"text-xs text-muted\\\">\\n              D\303\241n danh s\303\241ch l\341\273\233p, s\306\241 \304\221\341\273\223 l\341\273\233p t\341\273\253 Word/Excel ho\341\272\267c bi\303\252n b\341\272\243n vi ph\341\272\241m vi\341\272\277t tay. H\341\273\207 th\341\273\221ng t\341\273\261 \304\221\341\273\231ng ph\303\242n t\303\241ch v\303\240 kh\341\273\233p t\303\252n m\341\273\235.\\n            </p>\\n\\n            <textarea\\n              rows={4}\\n              placeholder=\\\"VD: 10/11 - S\303\241ng: Huy \304\221i mu\341\273\231n, Qu\303\242n d\303\271ng \304\221i\341\273\207n tho\341\272\241i...\\\"\\n              className=\\\"w-full p-2.5 bg-surface-2 border border-token rounded-xl text-xs text-main placeholder:text-muted\\\"\\n            />\\n\\n            <div className=\\\"flex items-center justify-between pt-2\\\">\\n              <span className=\\\"text-[11px] text-muted\\\">M\303\243 l\303\264 nh\341\272\255p: L\303\224-202611-01</span>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => alert(\'Ch\341\272\277 \304\221\341\273\231 Demo: Tr\303\254nh ph\303\242n t\303\255ch quy t\341\272\257c c\341\273\245c b\341\273\231 \304\221\303\243 nh\341\272\255n d\341\272\241ng c\341\272\245u tr\303\272c!\')}\\n                className=\\\"px-3 py-1.5 rounded-lg bg-primary text-on-primary text-xs font-bold cursor-pointer\\\"\\n              >\\n                Ph\303\242n t\303\255ch &amp; Xem tr\306\260\341\273\233c\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Export Customizer */}\\n          <div className=\\\"p-4 rounded-2xl bg-surface border border-token space-y-3 shadow-xs\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <FileDown className=\\\"w-4 h-4 text-accent\\\" />\\n              <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                Xu\341\272\245t b\303\241o c\303\241o &amp; Th\341\272\273 \341\272\243nh Ph\341\273\245 huynh\\n              </h3>\\n            </div>\\n            <p className=\\\"text-xs text-muted\\\">\\n              Xu\341\272\245t t\341\273\207p Excel/CSV \304\221\341\272\247y \304\221\341\273\247 l\341\273\213ch s\341\273\255 ngu\341\273\223n g\341\273\221c (ng\306\260\341\273\235i nh\341\272\255p, vai tr\303\262, th\341\273\235i gian m\303\241y ch\341\273\247, thi\341\272\277t b\341\273\213) ho\341\272\267c t\341\272\241o th\341\272\273 \341\272\243nh g\341\273\255i ph\341\273\245 huynh.\\n            </p>\\n\\n            <div className=\\\"space-y-2 text-xs\\\">\\n              <div className=\\\"p-2.5 rounded-xl bg-surface-2 border border-token flex items-center justify-between\\\">\\n                <span>Xu\341\272\245t b\341\272\243ng \304\221i\341\273\203m tu\341\272\247n {currentWeek} (.xlsx)</span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => alert(\'Ch\341\272\277 \304\221\341\273\231 Demo: \304\220\303\243 t\341\272\241o t\341\273\207p Excel k\303\250m c\341\273\231t ngu\341\273\223n g\341\273\221c d\341\273\257 li\341\273\207u!\')}\\n                  className=\\\"px-3 py-1 rounded-lg border border-token bg-surface text-main font-semibold hover:bg-surface-2 cursor-pointer\\\"\\n                >\\n                  T\341\272\243i .xlsx\\n                </button>\\n              </div>\\n\\n              <div className=\\\"p-2.5 rounded-xl bg-surface-2 border border-token flex items-center justify-between\\\">\\n                <div>\\n                  <span className=\\\"font-semibold block\\\">Th\341\272\273 \341\272\243nh g\341\273\255i Ph\341\273\245 huynh</span>\\n                  <span className=\\\"text-[10px] text-muted\\\">C\303\263 ch\303\242n trang: 10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225</span>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => alert(\'Ch\341\272\277 \304\221\341\273\231 Demo: Th\341\272\273 \341\272\243nh \304\221\303\243 \304\221\306\260\341\273\243c t\341\272\241o v\341\273\233i font Be Vietnam Pro chu\341\272\251n d\341\272\245u!\')}\\n                  className=\\\"px-3 py-1 rounded-lg bg-accent text-on-accent font-semibold hover:opacity-90 cursor-pointer\\\"\\n                >\\n                  T\341\272\241o th\341\272\273 \341\272\243nh\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* 7. SETTINGS */}\\n      {activeTab === \'settings\' && (\\n        <div className=\\\"p-4 rounded-2xl bg-surface border border-token space-y-4 shadow-xs max-w-xl mx-auto\\\">\\n          <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider border-b border-token pb-2\\\">\\n            C\341\272\245u h\303\254nh tham s\341\273\221 h\341\273\207 th\341\273\221ng (L\306\260u t\341\272\241i trang t\303\255nh 7_CauHinh)\\n          </h3>\\n\\n          <div className=\\\"space-y-3 text-xs\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <span className=\\\"font-semibold text-main block\\\">\304\220i\341\273\203m kh\341\273\237i \304\221\341\272\247u m\341\273\227i tu\341\272\247n:</span>\\n                <span className=\\\"text-[11px] text-muted\\\">M\341\272\267c \304\221\341\273\213nh 100 \304\221i\341\273\203m</span>\\n              </div>\\n              <input\\n                type=\\\"number\\\"\\n                value={settings.diemKhoiDau}\\n                onChange={e => onUpdateSettings({ diemKhoiDau: Number(e.target.value) })}\\n                className=\\\"w-20 p-1.5 bg-surface-2 border border-token rounded-lg text-center font-bold text-main\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <span className=\\\"font-semibold text-main block\\\">Th\341\273\235i h\341\272\241n s\341\273\255a / h\341\273\247y c\341\273\247a Ban c\303\241n s\341\273\261:</span>\\n                <span className=\\\"text-[11px] text-muted\\\">T\303\255nh t\341\273\253 th\341\273\235i \304\221i\341\273\203m ghi nh\341\272\255n</span>\\n              </div>\\n              <span className=\\\"font-bold text-main px-2 py-1 rounded bg-surface-2 border border-token\\\">\\n                {settings.thoiHanSuaHuyPhut / 60} gi\341\273\235\\n              </span>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div>\\n                <span className=\\\"font-semibold text-main block\\\">Quy\341\273\201n th\341\272\245y m\303\240u c\341\273\247a H\341\273\215c sinh:</span>\\n                <span className=\\\"text-[11px] text-muted\\\">H\341\273\215c sinh xem s\306\241 \304\221\341\273\223 n\341\273\201 n\341\272\277p</span>\\n              </div>\\n              <select\\n                value={settings.hocSinhThayMau}\\n                onChange={e => onUpdateSettings({ hocSinhThayMau: e.target.value as \'CaLop\' | \'ChiBanThan\' })}\\n                className=\\\"p-1.5 bg-surface-2 border border-token rounded-lg text-xs font-semibold text-main\\\"\\n              >\\n                <option value=\\\"CaLop\\\">C\341\272\243 l\341\273\233p</option>\\n                <option value=\\\"ChiBanThan\\\">Ch\341\273\211 b\341\272\243n th\303\242n</option>\\n              </select>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-between pt-2 border-t border-token\\\">\\n              <div>\\n                <span className=\\\"font-semibold text-[var(--st-bad)] block\\\">Kho\303\241 kh\341\272\251n c\341\272\245p (Kill Switch):</span>\\n                <span className=\\\"text-[11px] text-muted\\\">T\341\272\241m ng\306\260ng m\341\273\215i l\341\273\207nh ghi nh\341\272\255n t\341\273\253 Ban c\303\241n s\341\273\261</span>\\n              </div>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={settings.khoaKhanCap}\\n                onChange={e => onUpdateSettings({ khoaKhanCap: e.target.checked })}\\n                className=\\\"w-5 h-5 accent-[var(--st-bad)] rounded\\\"\\n              />\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Rejection Modal */}\\n      {rejectingRecordId && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\\\">\\n          <div className=\\\"w-full max-w-md bg-surface border border-token rounded-2xl shadow-2xl p-4 space-y-3 animate-scale-up\\\">\\n            <h4 className=\\\"text-sm font-bold text-main\\\">\\n              T\341\273\253 ch\341\273\221i gi\341\272\243i tr\303\254nh vi ph\341\272\241m\\n            </h4>\\n            <p className=\\\"text-xs text-muted\\\">\\n              Nh\341\272\255p l\303\275 do t\341\273\253 ch\341\273\221i \304\221\341\273\203 h\341\273\215c sinh hi\341\273\203u r\303\265 v\303\240 r\303\272t kinh nghi\341\273\207m:\\n            </p>\\n            <textarea\\n              rows={3}\\n              value={rejectReason}\\n              onChange={e => setRejectReason(e.target.value)}\\n              placeholder=\\\"VD: Minh ch\341\273\251ng ch\306\260a \304\221\341\273\247 thuy\341\272\277t ph\341\273\245c, tr\341\273\261c ban \304\221\303\243 x\303\241c nh\341\272\255n...\\\"\\n              className=\\\"w-full p-2 bg-surface-2 border border-token rounded-xl text-xs text-main\\\"\\n            />\\n            <div className=\\\"flex items-center justify-end gap-2 pt-2 border-t border-token\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setRejectingRecordId(null);\\n                  setRejectReason(\'\');\\n                }}\\n                className=\\\"px-3 py-1.5 rounded-lg border border-token text-xs text-muted\\\"\\n              >\\n                H\341\273\247y\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                disabled={!rejectReason.trim()}\\n                onClick={() => {\\n                  onResolveExplanation(rejectingRecordId, \'TuChoi\', rejectReason.trim());\\n                  setRejectingRecordId(null);\\n                  setRejectReason(\'\');\\n                }}\\n                className=\\\"px-4 py-1.5 rounded-lg bg-[var(--st-bad)] text-white text-xs font-bold disabled:opacity-50 cursor-pointer\\\"\\n              >\\n                X\303\241c nh\341\272\255n t\341\273\253 ch\341\273\221i\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Record Bottom Sheet for Teacher */}\\n      <RecordBottomSheet\\n        isOpen={isBottomSheetOpen}\\n        onClose={() => {\\n          setIsBottomSheetOpen(false);\\n          if (!isMultiSelect) setSelectedStudentIds([]);\\n        }}\\n        students={students.filter(s => selectedStudentIds.includes(s.maHS))}\\n        rules={rules}\\n        allowBonus={settings.batDiemCong}\\n        onSave={handleRequestSave}\\n        currentUserRole=\\\"GV\\\"\\n      />\\n\\n      {/* Duplicate Warning Modal for Teacher */}\\n      {pendingRecordPayload && (\\n        <DuplicateWarningModal\\n          isOpen={duplicateModalOpen}\\n          onClose={() => {\\n            setDuplicateModalOpen(false);\\n            setPendingRecordPayload(null);\\n          }}\\n          onConfirm={(confirmedStudents) => {\\n            executeSave(\\n              confirmedStudents,\\n              pendingRecordPayload.rule,\\n              pendingRecordPayload.date,\\n              pendingRecordPayload.session,\\n              pendingRecordPayload.note\\n            );\\n            setDuplicateModalOpen(false);\\n            setPendingRecordPayload(null);\\n          }}\\n          selectedStudents={pendingRecordPayload.students}\\n          selectedRule={pendingRecordPayload.rule}\\n          existingRecordsByStudent={\\n            pendingRecordPayload.students.reduce((acc, st) => {\\n              const res = checkDuplicateRecord(\\n                records,\\n                st.maHS,\\n                pendingRecordPayload.date,\\n                pendingRecordPayload.session,\\n                pendingRecordPayload.rule.maNoiQuy\\n              );\\n              acc[st.maHS] = res.existingRecords;\\n              return acc;\\n            }, {} as Record<string, DisciplineRecord[]>)\\n          }\\n        />\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Teacher dashboard supporting overview, full recording, explanation approval, roster & seating, rules & bonus toggle, and import/export preview\", \"Overwrite\":true, \"TargetFile\":\"/src/components/teacher/TeacherDashboard.tsx\", \"toolAction\":\"Creating TeacherDashboard component\", \"toolSummary\":\"Create src/components/teacher/TeacherDashboard.tsx\"}"
