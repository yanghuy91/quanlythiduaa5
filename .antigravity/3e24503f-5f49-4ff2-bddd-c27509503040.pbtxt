      thinking_signature: "\022\266%\n\263%\001i\024}\023\224[3\224y0@3\246\003\353\3728\004%w^\v\274F0\262\355K-\307\353\"jx.-F\333\r\315i\331\\p\372P\271O\311V0\276u\320\"\3738\a\262Y\3231\264e\327-\030\261\001\a\376\302\201\207\324D\021\255^\035\032\352O\315\"\005yt\373\00106\t\263o,=\303\313\364\2447\b\v97KU\355\3213j<#\356\242?\267\367\314\216a`-\337W\370\313\\\251.\324\272O\032HQ\033K\334\367\237#\3614N\fyL=\206\214\241\002\343\376\364\261\337\312\021\326\033Z\223-Xy\316l\370\t\363\034\265\242AL\033\301\266\2679.\243\307!\217\021M\237\245,9\020\366\v\347\230\300\0251\034&\3618\335\217r\222\213\325\002\233\\\362\2261\235J\341\366\265\345b\210\271\374R\023\r\237\321\331\3562\331\271\273v\264\322\250KJ1\n\374C\332+\352\362\017\247M\256\325`N\020b\026\346\006;$U\371\207\\\334L\376md\030\235\350\335\b\023(!0\342k}(=\310u\214\361\307n\337\264s\321\321\027\027Qg\310\231\002.9)?\202e\215\317fE{6\031\0162F\033zbFr\355\376\355\202\361\317\325\370>(\347Ch:Q\320F\r1\f<\363\024\235e)\f\031\313\223(\242F\342\331\334.$\337\321j\320\2017$M\037\334o\356\327\000Zq\253\364\371\002\271B.pc\217Q\225%\335\351\217\262$\314}Z\345\032\261C#jH\372/\315\303Je\336\335+\326\224\372\337\302\221g\a\024\374\317\215\271}%\236\262\363\371\270\330\337\222\370\326\f\343\204\300$\257sb\260\276\207@5\334 e\023\206\261\016\b\324\366\203y\2358\237\001:\335\213\344\022\224HP\035\264\314g?G\001r\252\335\323\271k`\205\374\222\"\"\304\345I\345\262\373\235P\002D2\315\366\265~\300V\221\220\247qj\313M\312\323Y\356\n\021\340\000\254\371jZ\021\320\355=\372\024-\263\217\377==\331\332\243\274\255=\333[\335\256\260\226\372\025\2422\204\326mc\201\204\020\272\024\351\'\234\365\227\223\243c\262}\312{\f\221\004\270\232\371,\362\265S\002\262]\273\362\020\267\321\352%\233\263\"2\262#\203A\216\322]u\0334;g\377\030\022\365\3141*m*\020Iu\t\376jy0V\376\353\266eZ\\\203\206[i\303\020\362\024\206j\303\002\3541\371p\241om\322\257\020\267/\212[\001\260r\332Fi\371\024\343s\216!l\210\313\353Z\023_;F=9\2570\300K~\375\243,\000\35