  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 371
    content: "/**\n * Qu\341\272\243n l\303\275 N\341\273\201 n\341\272\277p & Thi \304\221ua L\341\273\233p h\341\273\215c - 10A5 THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\n * Giai \304\221o\341\272\241n 1: Giao di\341\273\207n + Demo\n */\n\nimport React, { useState, useEffect, useMemo, useCallback } from \'react\';\nimport { \n  Student, \n  RoleCode, \n  DisciplineRecord, \n  RuleItem, \n  TeacherSettings,\n  StudentWeekSummary,\n  SeatLayoutNode\n} from \'./types\';\nimport { \n  MOCK_STUDENTS, \n  MOCK_RULES, \n  MOCK_SEAT_LAYOUT, \n  INITIAL_RECORDS, \n  INITIAL_SETTINGS \n} from \'./data/mockData\';\nimport { calculateStudentWeekSummary } from \'./utils/emulation\';\nimport { Header } from \'./components/common/Header\';\nimport { Footer } from \'./components/common/Footer\';\nimport { Toast, ToastData } from \'./components/common/Toast\';\nimport { LoginModal } from \'./components/auth/LoginModal\';\nimport { StudentView } from \'./components/student/StudentView\';\nimport { CadreView } from \'./components/cadre/CadreView\';\nimport { TeacherDashboard } from \'./components/teacher/TeacherDashboard\';\n\nexport default function App() {\n  // Theme state\n  const [theme, setTheme] = useState<\'light\' | \'dark\' | \'system\'>(() => {\n    const saved = localStorage.getItem(\'app_theme\');\n    return (saved as \'light\' | \'dark\' | \'system\') || \'system\';\n  });\n\n  // Apply theme to document\n  useEffect(() => {\n    localStorage.setItem(\'app_theme\', theme);\n    const isDark = theme === \'dark\' || (theme === \'system\' && window.matchMedia(\'(prefers-color-scheme: dark)\').matches);\n    document.documentElement.setAttribute(\'data-theme\', isDark ? \'dark\' : \'light\');\n\n    const listener = (e: MediaQueryListEvent) => {\n      if (theme === \'system\') {\n        document.documentElement.setAttribute(\'data-theme\', e.matches ? \'dark\' : \'light\');\n      }\n    };\n    const mediaQuery = window.matchMedia(\'(prefers-color-scheme: dark)\');\n    mediaQuery.addEventListener(\'change\', listener);\n    return () => mediaQuery.removeEventListener(\'change\', listener);\n  }, [theme]);\n\n  // App dataset\n  const [students, setStudents] = useState<Student[]>(() => {\n    const saved = localStorage.getItem(\'app_students_10a5\');\n    return saved ? JSON.parse(saved) : MOCK_STUDENTS;\n  });\n  const [layout, setLayout] = useState<SeatLayoutNode[]>(() => {\n    const saved = localStorage.getItem(\'app_layout_10a5\');\n    return saved ? JSON.parse(saved) : MOCK_SEAT_LAYOUT;\n  });\n  const [rules, setRules] = useState<RuleItem[]>(() => {\n    const saved = localStorage.getItem(\'app_rules_10a5\');\n    return saved ? JSON.parse(saved) : MOCK_RULES;\n  });\n  const [settings, setSettings] = useState<TeacherSettings>(() => {\n    const saved = localStorage.getItem(\'app_settings_10a5\');\n    return saved ? JSON.parse(saved) : INITIAL_SETTINGS;\n  });\n  const [records, setRecords] = useState<DisciplineRecord[]>(() => {\n    const saved = localStorage.getItem(\'app_records_10a5\');\n    return saved ? JSON.parse(saved) : INITIAL_RECORDS;\n  });\n\n  // Current session & week\n  const [currentWeek] = useState(3);\n  \n  // Auth state: Default to Teacher for Demo exploration, with easy role switching\n  const [currentUser, setCurrentUser] = useState<Student | { hoTen: string; vaiTro: RoleCode[] } | null>(() => ({\n    hoTen: \'Tr\341\272\247n V\304\203n B\303\254nh (GVCN)\',\n    vaiTro: [\'GV\'],\n  }));\n  const [currentRole, setCurrentRole] = useState<RoleCode>(\'GV\');\n  const [isLoginModalOpen, setIsLoginModalOpen] = useState(false);\n\n  // Toast notification state\n  const [toast, setToast] = useState<ToastData | null>(null);\n\n  // Sync to local storage\n  useEffect(() => {\n    localStorage.setItem(\'app_records_10a5\', JSON.stringify(records));\n  }, [records]);\n\n  useEffect(() => {\n    localStorage.setItem(\'app_rules_10a5\', JSON.stringify(rules));\n  }, [rules]);\n\n  useEffect(() => {\n    localStorage.setItem(\'app_settings_10a5\', JSON.stringify(settings));\n  }, [settings]);\n\n  // Compute student summaries\n  const studentSummaries = useMemo(() => {\n    const map: Record<string, StudentWeekSummary> = {};\n    students.forEach(st => {\n      map[st.maHS] = calculateStudentWeekSummary(\n        st.maHS,\n        st.hoTen,\n        st.to,\n        currentWeek,\n        records,\n        settings\n      );\n    });\n    return map;\n  }, [students, currentWeek, records, settings]);\n\n  // Add record handler\n  const handleAddRecord = useCallback((newRecordData: Omit<DisciplineRecord, \'maGhiNhan\' | \'thoiGianMayChu\' | \'thoiGianMay\'>) => {\n    const id = `REC-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;\n    const nowISO = new Date().toISOString();\n\n    const record: DisciplineRecord = {\n      ...newRecordData,\n      maGhiNhan: id,\n      thoiGianMayChu: nowISO,\n      thoiGianMay: nowISO,\n    };\n\n    setRecords(prev => [record, ...prev]);\n\n    // Show 8-second Toast with Undo\n    setToast({\n      id,\n      recordId: id,\n      message: `\304\220\303\243 ghi: ${record.hoTen} \342\200\223 ${record.tenHanhVi}`,\n      subMessage: `Tr\341\273\253 ${record.diemSo} \304\221i\341\273\203m \302\267 Bu\341\273\225i ${record.buoi === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'}`,\n    });\n  }, []);\n\n  // Undo / Void record handler\n  const handleUndoRecord = useCallback((recordId: string) => {\n    setRecords(prev => prev.map(r => {\n      if (r.maGhiNhan === recordId) {\n        return {\n          ...r,\n          trangThai: \'DaHuy\',\n          lyDoHuy: \'Ng\306\260\341\273\235i ghi b\341\272\245m Ho\303\240n t\303\241c trong 8 gi\303\242y\',\n          thoiGianHuy: new Date().toISOString(),\n        };\n      }\n      return r;\n    }));\n\n    setToast({\n      id: `undo-${Date.now()}`,\n      message: \'\304\220\303\243 ho\303\240n t\303\241c b\341\272\243n ghi vi ph\341\272\241m th\303\240nh c\303\264ng.\',\n    });\n  }, []);\n\n  // Manual void by cadre or teacher\n  const handleVoidRecord = useCallback((recordId: string, reason: string) => {\n    setRecords(prev => prev.map(r => {\n      if (r.maGhiNhan === recordId) {\n        return {\n          ...r,\n          trangThai: \'DaHuy\',\n          lyDoHuy: reason,\n          thoiGianHuy: new Date().toISOString(),\n        };\n      }\n      return r;\n    }));\n\n    setToast({\n      id: `void-${Date.now()}`,\n      message: \'B\341\272\243n ghi \304\221\303\243 \304\221\306\260\341\273\243c chuy\341\273\203n sang tr\341\272\241ng th\303\241i \304\220\303\243 h\341\273\247y.\',\n    });\n  }, []);\n\n  // Explanation submit\n  const handleSubmitExplanation = useCallback((recordId: string, explanation: string) => {\n    setRecords(prev => prev.map(r => {\n      if (r.maGhiNhan === recordId) {\n        return {\n          ...r,\n          trangThai: \'ChoDuyet\',\n          noiDungGiaiTrinh: explanation,\n          thoiGianGiaiTrinh: new Date().toISOString(),\n        };\n      }\n      return r;\n    }));\n\n    setToast({\n      id: `exp-${Date.now()}`,\n      message: \'\304\220\303\243 g\341\273\255i gi\341\272\243i tr\303\254nh. Vui l\303\262ng ch\341\273\235 Gi\303\241o vi\303\252n xem x\303\251t.\',\n    });\n  }, []);\n\n  // Teacher resolve explanation\n  const handleResolveExplanation = useCallback((recordId: string, result: \'ChapNhan\' | \'TuChoi\', reason: string) => {\n    setRecords(prev => prev.map(r => {\n      if (r.maGhiNhan === recordId) {\n        return {\n          ...r,\n          trangThai: result === \'ChapNhan\' ? \'DaChapNhan\' : \'BiTuChoi\',\n          nguoiDuyet: \'Tr\341\272\247n V\304\203n B\303\254nh (GVCN)\',\n          ketQuaDuyet: result,\n          lyDoDuyet: reason,\n        };\n      }\n      return r;\n    }));\n\n    setToast({\n      id: `res-${Date.now()}`,\n      message: result === \'ChapNhan\' ? \'\304\220\303\243 ch\341\272\245p nh\341\272\255n gi\341\272\243i tr\303\254nh (H\341\273\247y tr\341\273\253 \304\221i\341\273\203m).\' : \'\304\220\303\243 t\341\273\253 ch\341\273\221i gi\341\272\243i tr\303\254nh.\',\n    });\n  }, []);\n\n  // Toggle rule pin\n  const handleToggleRulePin = useCallback((ruleId: string) => {\n    setRules(prev => prev.map(r => {\n      if (r.maNoiQuy === ruleId) {\n        return { ...r, ghim: !r.ghim };\n      }\n      return r;\n    }));\n  }, []);\n\n  // Fast demo role switcher\n  const handleSwitchDemoRole = (role: RoleCode, studentId?: string) => {\n    setCurrentRole(role);\n    if (role === \'GV\') {\n      setCurrentUser({\n        hoTen: \'Tr\341\272\247n V\304\203n B\303\254nh (GVCN)\',\n        vaiTro: [\'GV\'],\n      });\n    } else {\n      const student = students.find(s => s.maHS === (studentId || \'HS01\'));\n      if (student) {\n        setCurrentUser(student);\n      }\n    }\n  };\n\n  // Logout\n  const handleLogout = () => {\n    setCurrentUser(null);\n    setIsLoginModalOpen(true);\n  };\n\n  // Student login from modal\n  const handleLoginStudent = (student: Student, role: RoleCode) => {\n    setCurrentUser(student);\n    setCurrentRole(role);\n    setIsLoginModalOpen(false);\n  };\n\n  // Teacher login from modal\n  const handleLoginTeacher = () => {\n    setCurrentUser({\n      hoTen: \'Tr\341\272\247n V\304\203n B\303\254nh (GVCN)\',\n      vaiTro: [\'GV\'],\n    });\n    setCurrentRole(\'GV\');\n    setIsLoginModalOpen(false);\n  };\n\n  // Teacher updates classroom seating and layout\n  const handleUpdateLayout = useCallback((newLayout: SeatLayoutNode[], updatedStudents: Student[]) => {\n    setLayout(newLayout);\n    setStudents(updatedStudents);\n    localStorage.setItem(\'app_layout_10a5\', JSON.stringify(newLayout));\n    localStorage.setItem(\'app_students_10a5\', JSON.stringify(updatedStudents));\n    setToast({\n      id: Date.now().toString(),\n      message: \'\304\220\303\243 l\306\260u s\306\241 \304\221\341\273\223 l\341\273\233p h\341\273\215c \342\234\250\',\n      subMessage: \'V\341\273\213 tr\303\255 42 h\341\273\215c sinh v\303\240 b\341\273\221 tr\303\255 ph\303\262ng h\341\273\215c \304\221\303\243 \304\221\306\260\341\273\243c c\341\272\255p nh\341\272\255t th\303\240nh c\303\264ng!\',\n    });\n  }, []);\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-app text-main antialiased selection:bg-accent/20\">\n      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n          />\n        )}\n\n        {currentUser && currentRole !== \'GV\' && currentRole !== \'HS\' && (\n          <CadreView\n            currentCadre={currentUser as Student}\n            cadreRole={currentRole}\n            allStudents={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onAddRecord={handleAddRecord}\n            onVoidRecord={handleVoidRecord}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n\n        {currentUser && currentRole === \'HS\' && (\n          <StudentView\n            currentStudent={currentUser as Student}\n            allStudents={students}\n            layout={layout}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n      </main>\n\n      {/* Footer with exact title \"10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\" (without teacher name) */}\n      <Footer />\n\n      {/* 8-second Toast with Undo */}\n      <Toast\n        toast={toast}\n        onUndo={handleUndoRecord}\n        onClose={() => setToast(null)}\n      />\n\n      {/* Login Gate Modal if logged out */}\n      {isLoginModalOpen && (\n        <LoginModal\n          students={students}\n          layout={layout}\n          onLoginStudent={handleLoginStudent}\n          onLoginTeacher={handleLoginTeacher}\n          classCode={settings.maLop}\n        />\n      )}\n    </div>\n  );\n}\n"
    num_lines: 372
    num_bytes: 11718
    line_range_bytes: 11718
  }
}
