        replacement_content: "export interface TimeHierarchy {\n  namHoc: string; // vd: \'2026-2027\'\n  hocKi: 1 | 2;   // H\341\273\215c k\303\254 1 ho\341\272\267c 2\n  thang: number;  // Th\303\241ng 1..12\n  tuanHoc: number; // Tu\341\272\247n 1..35\n  ngayHoc: string; // YYYY-MM-DD\n  buoi: \'Sang\' | \'Chieu\'; // Bu\341\273\225i s\303\241ng ho\341\272\267c chi\341\273\201u\n}\n\nexport type PeriodLevel = \'namHoc\' | \'hocKi\' | \'thang\' | \'tuanHoc\' | \'ngayHoc\' | \'buoi\';\n\nexport interface HierarchyPeriodFilter {\n  namHoc: string; // vd: \'2026-2027\'\n  hocKi: 1 | 2 | \'all\';\n  thang: number | \'all\';\n  tuanHoc: number | \'all\';\n  ngayHoc: string | \'all\';\n  buoi: \'Sang\' | \'Chieu\' | \'all\';\n}\n\nexport interface DisciplineRecord {\n  maGhiNhan: string; // UUID\n  thoiGianMayChu: string; // ISO string\n  thoiGianMay: string;\n  namHoc: string; // 2026-2027\n  hocKi: 1 | 2;\n  thang: number; // 9, 10, 11...\n  tuanHoc: number;\n  ngayHoc: string; // YYYY-MM-DD\n  buoi: \'Sang\' | \'Chieu\';\n  doiTuong: \'HocSinh\' | \'To\';\n  maHS: string;\n  hoTen: string;\n  to: number;\n  maNoiQuy: string;\n  nhomHanhVi: string;\n  tenHanhVi: string;\n  mucDo: SeverityLevel;\n  diemSo: number;\n  loaiDiem: PointType;\n  ghiChu?: string;\n  nguoiGhi: string;\n  vaiTroNguoiGhi: RoleCode;\n  nguonGhi: \'TrucTiep\' | \'NgoaiTuyen\' | \'NhapTep\' | \'NhapVanBan\';\n  loaiThietBi?: string;\n  maLoNhap?: string;\n  lanThuTrongBuoi: number;\n  daXacNhanTrung: boolean;\n  trangThai: RecordStatus;\n  noiDungGiaiTrinh?: string;\n  thoiGianGiaiTrinh?: string;\n  nguoiDuyet?: string;\n  ketQuaDuyet?: \'ChapNhan\' | \'TuChoi\';\n  lyDoDuyet?: string;\n  lyDoHuy?: string;\n  thoiGianHuy?: string;\n}\n\nexport type WeekEvaluation = \'Tot\' | \'Kha\' | \'Dat\' | \'ChuaDat\';\n\nexport type StatusColorLevel = \'none\' | \'warn\' | \'bad\' | \'ok\';\n\nexport interface StudentWeekSummary {\n  maHS: string;\n  hoTen: string;\n  to: number;\n  tuanHoc: number;\n  diemKhoiDau: number;\n  tongDiemTru: number;\n  tongDiemCong: number;\n  diemHienTai: number;\n  xepLoai: WeekEvaluation;\n  mucMau: StatusColorLevel;\n  soLoiTrongTuan: number;\n  coLoiNang: boolean;\n}\n\nexport interface StudentPeriodSummary {\n  maHS: string;\n  hoTen: string;\n  to: number;\n  diemTrungBinh: number;\n  tongDiemTru: number;\n  tongDiemCong: number;\n  soLoi: number;\n  xepLoai: WeekEvaluation;\n  mucMau: StatusColorLevel;\n  lichSuTuan: {\n    tuanHoc: number;\n    diem: number;\n    soLoi: number;\n  }[];\n}"
