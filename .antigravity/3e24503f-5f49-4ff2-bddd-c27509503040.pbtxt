  planner_response {
    thinking: "**Constructing Student View**\n\nI\'m now diving into building the `StudentView.tsx` component. I\'m focusing on the bottom tabs; \"C\341\273\247a t\303\264i\" will display a personal week score card. I\'m visualizing the scoring: 100 minus deductions equals the final score, categorized as T\341\273\221t/Kh\303\241/\304\220\341\272\241t, and considering a ranking display. I\'m aiming for simplicity and clarity in the design.\n\n\n"
    tool_calls {
      id: "call_11486675215275736729"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { \\n  User, \\n  LayoutGrid, \\n  Trophy, \\n  AlertCircle, \\n  CheckCircle2, \\n  Clock, \\n  MessageSquare, \\n  X,\\n  Send,\\n  HelpCircle\\n} from \'lucide-react\';\\nimport { \\n  Student, \\n  SeatLayoutNode, \\n  DisciplineRecord, \\n  StudentWeekSummary, \\n  TeacherSettings \\n} from \'../../types\';\\nimport { SeatGrid } from \'../student-picker/SeatGrid\';\\nimport { sortVietnameseNames } from \'../../utils/vietnamese\';\\n\\ninterface StudentViewProps {\\n  currentStudent: Student;\\n  allStudents: Student[];\\n  layout: SeatLayoutNode[];\\n  records: DisciplineRecord[];\\n  studentSummaries: Record<string, StudentWeekSummary>;\\n  currentWeek: number;\\n  settings: TeacherSettings;\\n  onSubmitExplanation: (recordId: string, explanation: string) => void;\\n}\\n\\nexport const StudentView: React.FC<StudentViewProps> = ({\\n  currentStudent,\\n  allStudents,\\n  layout,\\n  records,\\n  studentSummaries,\\n  currentWeek,\\n  settings,\\n  onSubmitExplanation,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'my_score\' | \'seating\' | \'ranking\'>(\'my_score\');\\n  const [selectedRecordForExplanation, setSelectedRecordForExplanation] = useState<DisciplineRecord | null>(null);\\n  const [explanationText, setExplanationText] = useState(\'\');\\n\\n  // My summary for the week\\n  const mySummary = studentSummaries[currentStudent.maHS] || {\\n    diemHienTai: settings.diemKhoiDau,\\n    tongDiemTru: 0,\\n    tongDiemCong: 0,\\n    xepLoai: \'Tot\',\\n    mucMau: \'none\',\\n    soLoiTrongTuan: 0,\\n    coLoiNang: false,\\n  };\\n\\n  // My personal records\\n  const myRecords = useMemo(() => {\\n    return records\\n      .filter(r => r.maHS === currentStudent.maHS && r.trangThai !== \'DaHuy\')\\n      .sort((a, b) => new Date(b.thoiGianMayChu).getTime() - new Date(a.thoiGianMayChu).getTime());\\n  }, [records, currentStudent.maHS]);\\n\\n  // Class Individual Ranking (NO group ranking, as per user requirement)\\n  const classRankings = useMemo(() => {\\n    const list = allStudents.map(student => {\\n      const summary = studentSummaries[student.maHS] || {\\n        diemHienTai: settings.diemKhoiDau,\\n        tongDiemTru: 0,\\n        tongDiemCong: 0,\\n        xepLoai: \'Tot\',\\n      };\\n      return {\\n        student,\\n        score: summary.diemHienTai,\\n        xepLoai: summary.xepLoai,\\n        deductions: summary.tongDiemTru,\\n      };\\n    });\\n\\n    // Sort descending by score, then name\\n    return list.sort((a, b) => {\\n      if (b.score !== a.score) return b.score - a.score;\\n      return a.student.hoTen.localeCompare(b.student.hoTen, \'vi\');\\n    });\\n  }, [allStudents, studentSummaries, settings.diemKhoiDau]);\\n\\n  const handleOpenExplanation = (record: DisciplineRecord) => {\\n    setSelectedRecordForExplanation(record);\\n    setExplanationText(record.noiDungGiaiTrinh || \'\');\\n  };\\n\\n  const handleSubmitExplanation = () => {\\n    if (!selectedRecordForExplanation || !explanationText.trim()) return;\\n    onSubmitExplanation(selectedRecordForExplanation.maGhiNhan, explanationText.trim());\\n    setSelectedRecordForExplanation(null);\\n    setExplanationText(\'\');\\n  };\\n\\n  return (\\n    <div className=\\\"w-full flex flex-col gap-4\\\">\\n      {/* Student Nav Tabs */}\\n      <div className=\\\"flex items-center justify-center p-1 bg-surface-2 rounded-xl border border-token max-w-md mx-auto w-full\\\">\\n        <button\\n          onClick={() => setActiveTab(\'my_score\')}\\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\\n            activeTab === \'my_score\' \\n              ? \'bg-surface text-main shadow-xs\' \\n              : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <User className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>C\341\273\247a t\303\264i</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'seating\')}\\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\\n            activeTab === \'seating\' \\n              ? \'bg-surface text-main shadow-xs\' \\n              : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <LayoutGrid className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>S\306\241 \304\221\341\273\223 l\341\273\233p</span>\\n        </button>\\n\\n        <button\\n          onClick={() => setActiveTab(\'ranking\')}\\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\\n            activeTab === \'ranking\' \\n              ? \'bg-surface text-main shadow-xs\' \\n              : \'text-muted hover:text-main\'\\n          }`}\\n        >\\n          <Trophy className=\\\"w-3.5 h-3.5 text-accent\\\" />\\n          <span>B\341\272\243ng thi \304\221ua</span>\\n        </button>\\n      </div>\\n\\n      {/* TAB 1: C\341\273\246A T\303\224I */}\\n      {activeTab === \'my_score\' && (\\n        <div className=\\\"space-y-4\\\">\\n          {/* Main Score Card */}\\n          <div className=\\\"p-4 rounded-2xl bg-surface border border-token shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4\\\">\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <div className=\\\"w-12 h-12 rounded-2xl bg-primary text-on-primary flex items-center justify-center font-bold text-lg\\\">\\n                {currentStudent.viTriGhe}\\n              </div>\\n              <div>\\n                <h2 className=\\\"text-base font-bold text-main leading-tight\\\">\\n                  {currentStudent.hoTen}\\n                </h2>\\n                <p className=\\\"text-xs text-muted mt-0.5\\\">\\n                  T\341\273\225 {currentStudent.to} \302\267 D\303\243y {currentStudent.dayBan} - B\303\240n {currentStudent.soBan}\\n                </p>\\n              </div>\\n            </div>\\n\\n            {/* Score & Ranking Pill */}\\n            <div className=\\\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-3 sm:pt-0 border-token\\\">\\n              <div className=\\\"text-right\\\">\\n                <div className=\\\"text-[11px] text-muted font-medium\\\">\304\220i\341\273\203m tu\341\272\247n {currentWeek}</div>\\n                <div className=\\\"text-2xl font-bold tabular-nums text-main leading-none mt-1\\\">\\n                  {mySummary.diemHienTai} <span className=\\\"text-xs font-normal text-muted\\\">/ 100</span>\\n                </div>\\n              </div>\\n\\n              <div className={`px-3 py-1.5 rounded-xl text-xs font-bold ${\\n                mySummary.xepLoai === \'Tot\' \\n                  ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)] border border-[var(--st-ok)]/30\'\\n                  : mySummary.xepLoai === \'Kha\'\\n                  ? \'bg-accent/15 text-accent border border-accent/30\'\\n                  : mySummary.xepLoai === \'Dat\'\\n                  ? \'bg-[var(--st-warn)]/15 text-[var(--st-warn)] border border-[var(--st-warn)]/30\'\\n                  : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)] border border-[var(--st-bad)]/30\'\\n              }`}>\\n                {mySummary.xepLoai === \'Tot\' ? \'X\341\272\277p lo\341\272\241i: T\341\273\221t\' :\\n                 mySummary.xepLoai === \'Kha\' ? \'X\341\272\277p lo\341\272\241i: Kh\303\241\' :\\n                 mySummary.xepLoai === \'Dat\' ? \'X\341\272\277p lo\341\272\241i: \304\220\341\272\241t\' : \'Ch\306\260a \304\221\341\272\241t\'}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Infraction Log */}\\n          <div className=\\\"bg-surface rounded-2xl border border-token overflow-hidden shadow-xs\\\">\\n            <div className=\\\"px-4 py-3 border-b border-token flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <AlertCircle className=\\\"w-4 h-4 text-accent\\\" />\\n                <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n                  Nh\341\272\255t k\303\275 vi ph\341\272\241m c\341\273\247a b\341\272\241n\\n                </h3>\\n              </div>\\n              <span className=\\\"text-xs text-muted\\\">\\n                T\341\273\225ng c\341\273\231ng: -{mySummary.tongDiemTru} \304\221i\341\273\203m\\n              </span>\\n            </div>\\n\\n            <div className=\\\"divide-y divide-token\\\">\\n              {myRecords.length === 0 ? (\\n                <div className=\\\"p-8 text-center text-xs text-muted\\\">\\n                  <CheckCircle2 className=\\\"w-8 h-8 text-[var(--st-ok)] mx-auto mb-2\\\" />\\n                  B\341\272\241n ch\306\260a c\303\263 vi ph\341\272\241m n\303\240o trong tu\341\272\247n. H\303\243y ti\341\272\277p t\341\273\245c ph\303\241t huy n\341\273\201 n\341\272\277p t\341\273\221t!\\n                </div>\\n              ) : (\\n                myRecords.map(rec => {\\n                  const isCurrentWeek = rec.tuanHoc === currentWeek;\\n                  const isPending = rec.trangThai === \'ChoDuyet\';\\n                  const isAccepted = rec.trangThai === \'DaChapNhan\';\\n                  const isRejected = rec.trangThai === \'BiTuChoi\';\\n\\n                  return (\\n                    <div key={rec.maGhiNhan} className=\\\"p-3.5 space-y-2\\\">\\n                      <div className=\\\"flex items-start justify-between gap-2\\\">\\n                        <div className=\\\"min-w-0\\\">\\n                          <div className=\\\"flex items-center gap-2\\\">\\n                            <span className=\\\"text-xs font-bold text-main\\\">\\n                              {rec.tenHanhVi}\\n                            </span>\\n                            <span className=\\\"text-xs font-bold text-[var(--st-bad)]\\\">\\n                              -{rec.diemSo}\304\221\\n                            </span>\\n                            {rec.mucDo === \'Nang\' && (\\n                              <span className=\\\"text-[9px] font-bold px-1.5 py-0.2 rounded bg-[var(--st-bad)]/15 text-[var(--st-bad)]\\\">\\n                                N\341\272\267ng\\n                              </span>\\n                            )}\\n                          </div>\\n                          <div className=\\\"text-[11px] text-muted flex items-center gap-2 mt-0.5\\\">\\n                            <span>{rec.ngayHoc} ({rec.buoi === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'})</span>\\n                            <span>\302\267</span>\\n                            <span>Ng\306\260\341\273\235i ghi: {rec.nguoiGhi}</span>\\n                          </div>\\n                        </div>\\n\\n                        {/* Status Badge */}\\n                        <div className=\\\"shrink-0\\\">\\n                          {isAccepted ? (\\n                            <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--st-ok)]/15 text-[var(--st-ok)]\\\">\\n                              \304\220\303\243 ch\341\272\245p nh\341\272\255n gi\341\272\243i tr\303\254nh\\n                            </span>\\n                          ) : isRejected ? (\\n                            <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--st-bad)]/15 text-[var(--st-bad)]\\\">\\n                              B\341\273\213 t\341\273\253 ch\341\273\221i\\n                            </span>\\n                          ) : isPending ? (\\n                            <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--st-warn)]/15 text-[var(--st-warn)] flex items-center gap-1\\\">\\n                              <Clock className=\\\"w-2.5 h-2.5\\\" />\\n                              <span>\304\220ang ch\341\273\235 duy\341\273\207t</span>\\n                            </span>\\n                          ) : (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleOpenExplanation(rec)}\\n                              className=\\\"px-2.5 py-1 rounded-lg border border-token text-[11px] font-semibold text-accent hover:bg-surface-2 transition-colors cursor-pointer flex items-center gap-1\\\"\\n                            >\\n                              <MessageSquare className=\\\"w-3 h-3\\\" />\\n                              <span>Gi\341\272\243i tr\303\254nh</span>\\n                            </button>\\n                          )}\\n                        </div>\\n                      </div>\\n\\n                      {/* Explanation content preview if exists */}\\n                      {rec.noiDungGiaiTrinh && (\\n                        <div className=\\\"p-2 rounded-lg bg-surface-2 text-[11px] text-main border border-token space-y-1\\\">\\n                          <div className=\\\"font-semibold text-muted text-[10px]\\\">Gi\341\272\243i tr\303\254nh c\341\273\247a b\341\272\241n:</div>\\n                          <p className=\\\"italic\\\">\\\"{rec.noiDungGiaiTrinh}\\\"</p>\\n                          {rec.lyDoDuyet && (\\n                            <div className=\\\"text-[10px] text-muted pt-1 border-t border-token\\\">\\n                              <strong>Ph\341\272\243n h\341\273\223i t\341\273\253 gi\303\241o vi\303\252n:</strong> {rec.lyDoDuyet}\\n                            </div>\\n                          )}\\n                        </div>\\n                      )}\\n                    </div>\\n                  );\\n                })\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: S\306\240 \304\220\341\273\222 L\341\273\232P */}\\n      {activeTab === \'seating\' && (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"bg-surface p-3 rounded-2xl border border-token\\\">\\n            <div className=\\\"mb-2 text-xs text-muted flex items-center justify-between\\\">\\n              <span>S\306\241 \304\221\341\273\223 v\341\273\213 tr\303\255 v\303\240 tr\341\272\241ng th\303\241i n\341\273\201 n\341\272\277p c\341\272\243 l\341\273\233p</span>\\n              <div className=\\\"flex items-center gap-2 text-[10px]\\\">\\n                <span className=\\\"flex items-center gap-1\\\"><span className=\\\"w-2 h-2 rounded-full bg-[var(--st-none)]\\\" /> B\303\254nh th\306\260\341\273\235ng</span>\\n                <span className=\\\"flex items-center gap-1\\\"><span className=\\\"w-2 h-2 rounded-full bg-[var(--st-warn)]\\\" /> Nh\341\272\257c nh\341\273\237</span>\\n                <span className=\\\"flex items-center gap-1\\\"><span className=\\\"w-2 h-2 rounded-full bg-[var(--st-bad)]\\\" /> C\341\272\247n l\306\260u \303\275</span>\\n              </div>\\n            </div>\\n\\n            <SeatGrid\\n              layout={layout}\\n              students={allStudents}\\n              studentSummaries={studentSummaries}\\n              selectedStudentIds={[currentStudent.maHS]}\\n              onSelectStudent={() => {}}\\n              viewerRole=\\\"HS\\\"\\n              showStatusColors={settings.hocSinhThayMau === \'CaLop\'}\\n            />\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: B\341\272\242NG THI \304\220UA C\303\201 NH\303\202N (NO GROUP LEADERBOARD) */}\\n      {activeTab === \'ranking\' && (\\n        <div className=\\\"bg-surface rounded-2xl border border-token overflow-hidden shadow-xs\\\">\\n          <div className=\\\"px-4 py-3 border-b border-token\\\">\\n            <h3 className=\\\"text-xs font-bold text-main uppercase tracking-wider\\\">\\n              B\341\272\243ng x\341\272\277p h\341\272\241ng c\303\241 nh\303\242n l\341\273\233p 10A5\\n            </h3>\\n            <p className=\\\"text-[11px] text-muted mt-0.5\\\">\\n              Kh\341\273\237i \304\221\341\272\247u 100 \304\221i\341\273\203m/tu\341\272\247n \302\267 X\341\272\277p lo\341\272\241i: T\341\273\221t (\342\211\24590), Kh\303\241 (\342\211\24575), \304\220\341\272\241t (\342\211\24560)\\n            </p>\\n          </div>\\n\\n          <div className=\\\"divide-y divide-token max-h-[600px] overflow-y-auto\\\">\\n            {classRankings.map((item, idx) => {\\n              const isMe = item.student.maHS === currentStudent.maHS;\\n              const rank = idx + 1;\\n\\n              return (\\n                <div\\n                  key={item.student.maHS}\\n                  className={`px-4 py-2.5 flex items-center justify-between transition-colors ${\\n                    isMe ? \'bg-accent/10 font-semibold\' : \'hover:bg-surface-2\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                    <span className={`w-6 text-center text-xs font-bold shrink-0 ${\\n                      rank === 1 ? \'text-[var(--st-warn)]\' :\\n                      rank === 2 ? \'text-accent\' :\\n                      rank === 3 ? \'text-muted\' : \'text-muted\'\\n                    }`}>\\n                      #{rank}\\n                    </span>\\n\\n                    <div className=\\\"min-w-0\\\">\\n                      <div className=\\\"text-xs text-main truncate\\\">\\n                        {item.student.hoTen} {isMe && <span className=\\\"text-accent font-bold\\\">(B\341\272\241n)</span>}\\n                      </div>\\n                      <div className=\\\"text-[10px] text-muted\\\">\\n                        T\341\273\225 {item.student.to} \302\267 Gh\341\272\277 {item.student.viTriGhe}\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                    <span className=\\\"text-xs font-bold tabular-nums text-main\\\">\\n                      {item.score} \304\221\\n                    </span>\\n                    <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${\\n                      item.xepLoai === \'Tot\' ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' :\\n                      item.xepLoai === \'Kha\' ? \'bg-accent/15 text-accent\' :\\n                      item.xepLoai === \'Dat\' ? \'bg-[var(--st-warn)]/15 text-[var(--st-warn)]\' :\\n                      \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\\n                    }`}>\\n                      {item.xepLoai}\\n                    </span>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Explanation Modal */}\\n      {selectedRecordForExplanation && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\\\">\\n          <div className=\\\"w-full max-w-md bg-surface border border-token rounded-2xl shadow-2xl p-4 space-y-3 animate-scale-up\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-token pb-2.5\\\">\\n              <div>\\n                <h4 className=\\\"text-sm font-bold text-main\\\">\\n                  G\341\273\255i gi\341\272\243i tr\303\254nh vi ph\341\272\241m\\n                </h4>\\n                <p className=\\\"text-[11px] text-muted\\\">\\n                  {selectedRecordForExplanation.tenHanhVi} (-{selectedRecordForExplanation.diemSo}\304\221)\\n                </p>\\n              </div>\\n              <button\\n                onClick={() => setSelectedRecordForExplanation(null)}\\n                className=\\\"p-1 rounded-md text-muted hover:text-main\\\"\\n              >\\n                <X className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-main mb-1\\\">\\n                L\303\275 do / Minh ch\341\273\251ng (t\341\273\221i \304\221a 300 k\303\275 t\341\273\261):\\n              </label>\\n              <textarea\\n                value={explanationText}\\n                onChange={e => setExplanationText(e.target.value.slice(0, 300))}\\n                rows={4}\\n                placeholder=\\\"Tr\303\254nh b\303\240y l\303\275 do trung th\341\273\261c, kh\303\241ch quan...\\\"\\n                className=\\\"w-full p-2.5 bg-surface-2 border border-token rounded-xl text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40\\\"\\n              />\\n              <div className=\\\"text-right text-[10px] text-muted mt-1\\\">\\n                {explanationText.length}/300 k\303\275 t\341\273\261\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-end gap-2 pt-2 border-t border-token\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setSelectedRecordForExplanation(null)}\\n                className=\\\"px-3 py-1.5 rounded-lg border border-token text-xs text-muted hover:text-main\\\"\\n              >\\n                H\341\273\247y\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                disabled={!explanationText.trim()}\\n                onClick={handleSubmitExplanation}\\n                className=\\\"px-4 py-1.5 rounded-lg bg-primary text-on-primary text-xs font-bold flex items-center gap-1.5 hover:opacity-95 disabled:opacity-50 cursor-pointer\\\"\\n              >\\n                <Send className=\\\"w-3 h-3\\\" />\\n                <span>G\341\273\255i gi\341\272\243i tr\303\254nh</span>\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Student view component providing personal score card, violation log with explanation, classmate status map, and class individual ranking\", \"Overwrite\":true, \"TargetFile\":\"/src/components/student/StudentView.tsx\", \"toolAction\":\"Creating StudentView component\", \"toolSummary\":\"Create src/components/student/StudentView.tsx\"}"
      thinking_signature: "\022\306\n\n\303\n\001i\024}\023\335\215%\003`[6\034\305\236R\326 _-\235\250V6N\250\036d3\235:\fvAcD\3658\360\242(k\342\034\334/\023H&\t\237\tn\325\346roU\212\276Q\340\226k\321\272xQ\371\210\2640\0230%\"\354%\242\373\217\207\002S[\242\350`\266\006\2112\265\217\343B\003Ol\006\342Q\224\003\003 pw\215F\252\231S\230\342|\373D\300H\211SJ\206|\347\371;\017\371Z\362\3730\267\004\202D5\316\006\351\336\337\266z\264]:\'\376|\234\360\232\023\267>\346ShoD;\241\033Wb\325\202\320\001r\251\\\221~\376\361Hm\\jp\376\332\262\ne\264\315\357\235\343\a\345\f\332\3536\221\207\006]\342\0179\031\216p\331\363\3303\177`\204\005\274\276\313a\266\026v\370`\334\374\272\254\237\365\017\362\311\302s/\225n4`\363&\234\214y\205\341\033@\226\361m\b\217\177\347\314\333\222\244h;\350\006\221D\246\356\211\317\205\361gM\353\037p{~D\257\300\336\033rh\217\363T\310\371S#E\272a\232\316\b\360\365\262b\350\277@\261\vG\221\245{[\241F\226\324\201\320q\264NXz\n90c\023\352\206u\261\001\246\303&\361Z\356\272\257\210\003\320\004\322\317\232I\004\254_\303\2772\227\247\235J\245\357\356\336\223\031\220\227n\373 \366<\202`\221\270\330\214\000z\310\203WU\n\315F\243\'@\342\323\005\031J\335T\365\327\362\210\202\257p\024C\335B\234[j\264\312\312\215e1\351\306\233QU\262\020\242\214\312\036\253\177\f\373\202L3\247\247{\361\237\347\257a\230\357\350\230in\361\353b\037\0049\331UQ\361\261\216\357\001l\232U\243\027\276e\361[\272y\334\034\354MG\333\215\267\303\a \036\3503\204\322M0Q\343\262\334\206/\f\257?6UTO\201MI\025b\212\256^\025\302:y0\000\356\236`\217\321\225.\324\277\023\313N\332\245\363\020v\\\036EF\342Q\031_\376\261(c\240#\225\276T\034]\350\360\257GX\357 v\316\201\332\310\240\271\003B\322\263k\330\3058M\304\313\a\325`\246gs\256\261J\327\025\332\004\031;\351T\366m{\335(k$\'\273\3737$\036\305\267\227\225\023\207\373\t\206H\r\253\' V\fN\375\275q\223\325\027\177\335`\272\374\324\300\342\022d\242\000\257L\341l\260\220\367?\202\253E\036\343\332\225Nw\005\271\033\315K\254\001\337\236\274\001\330\313\rN\355\354\025\351\245\243=\236\210\241\n\020\240\346\016\021[O]&M\032 \200\307\004\036\315\216\270\300\255\355\230\307P\355\333\207Ew\330(\3102\3165)\237\210M\274=\331^\3019\374\270\226\3073Ir\310\037\263\355\344\036\246$\220\352\003\237\307\265m\224#F\327+\301\207K\034t\373\341\234[y\231\006A\262\377\020=w-1\t\301\032\335\n\242y\002\307#\315\001\2474\204\213\325~\222\031X\231\350\274X\277\277\301n7,\205\267\310\345\327\237~j>frM\337\322xqO\177T\036\231\255\3718\230\016\360\271;\254\000\214\315\252\273[-\bQ\3737\323\2647\031\217\340Ht\306t\272^\361I\203KK\247\253e\307\b(\227\331o\270\245x2\272\346\365)U\340\277\261\376\265\361\027\256\324W\006\345\314\264\323\201\213#\224\0056\257\001@\231\346A\257h\3523\326Vt\2060p\231|?H\362cA~\351\361vL\027@8\240Y\361!|\334A\270\254\370`\022SPx\364\006#\212a\244^D\030Qj\345KO\231=\202\035\352$\030\371\r\365i\025\206.K\v[e\343&\252So<H:\330Ac\370\256 \016 `\244\232<D\260Jt\273P\177\236U\035\271\213\020\031\016dD\f\361\210V\217\232\221\224\340\030\025v3z\356\366\266\b\005:\2547\017\b\003K\216\017\354\213U\366\240!\271\021!\006`\266m\333@l\217\353x\240\267r\034?24\032\247\335_\276\366\337\022\255\3613A\\\314\272\037b\233\323\215\212\206\207\334\352\212\324\213B\306>\363\031\302\265\250\334\\\323\2627\212k\0325#\207\311\234u\304\216s\214P\\L\355:\004\206\202\254\r\341\a,\344\275\214\a\225\327\360\267\371Q\001(\212\251#n\232\357\213\362\2754\351\316\267f\265\023\371\t\356\322\346{K^N\360\213\267\227I\304\"\r^\031f\225\235w\274\306(\016\264\315\017\301\327L\256\304\364\313\216H\334\247\331\315S\016\002\373J\334\301\355\207\263j\342P$\347>P\0047\363B\031\267\361\233\217W\030\216\205Y\361Y\233\336<\267\327]\016\2041\336\337q\0374C\3731\f|H\201v\362\256\320\322\v\303\234\201uQ \n\266\377W\002\260@\035\372\243\201M[]\254\211i\366\356\261\324v\027|\355\333.\2643\006\017\360B\264\027\372\301\356`\320M\321I\005\260\215\177\005%\314\337O\274O\206\2524+\241\242\207"
