    content: "\304\220\341\272\266C T\341\272\242 & H\306\257\341\273\232NG D\341\272\252N X\303\202Y D\341\273\260NG\r\nWeb App Qu\341\272\243n l\303\275 N\341\273\201 n\341\272\277p & Thi \304\221ua L\341\273\233p h\341\273\215c\r\nT\303\240i li\341\273\207u \304\221\306\260a cho Google AI Studio th\341\273\261c hi\341\273\207n  \302\267  Phi\303\252n b\341\272\243n 2.0\r\nGiao di\341\273\207n ti\341\272\277ng Vi\341\273\207t, \306\260u ti\303\252n \304\221i\341\273\207n tho\341\272\241i   \302\267   D\341\273\257 li\341\273\207u: Google Sheets qua Google Apps Script\r\n0. C\303\241ch s\341\273\255 d\341\273\245ng t\303\240i li\341\273\207u n\303\240y\r\n\304\220\303\242y l\303\240 b\341\272\243n \304\221\341\272\267c t\341\272\243 \304\221\341\272\247y \304\221\341\273\247 \304\221\341\273\203 giao cho Google AI Studio (ch\341\272\277 \304\221\341\273\231 Build). T\303\240i li\341\273\207u d\303\240i n\303\252n kh\303\264ng y\303\252u c\341\272\247u l\303\240m m\341\273\231t l\341\272\247n to\303\240n b\341\273\231. H\303\243y g\341\273\255i t\303\240i li\341\273\207u, d\303\241n \342\200\234Prompt kh\341\273\237i \304\221\341\273\231ng\342\200\235 b\303\252n d\306\260\341\273\233i, r\341\273\223i cho AI Studio l\303\240m l\341\272\247n l\306\260\341\273\243t t\341\273\253ng giai \304\221o\341\272\241n \341\273\237 M\341\273\245c 15. M\341\273\227i giai \304\221o\341\272\241n xong th\303\254 ki\341\273\203m tra r\341\273\223i m\341\273\233i sang giai \304\221o\341\272\241n k\341\272\277.\r\nPrompt kh\341\273\237i \304\221\341\273\231ng (d\303\241n v\303\240o AI Studio c\303\271ng v\341\273\233i t\303\240i li\341\273\207u):\r\nB\341\272\241n l\303\240 k\341\273\271 s\306\260 full-stack c\341\272\245p cao ki\303\252m thi\341\272\277t k\341\272\277 s\341\272\243n ph\341\272\251m. H\303\243y \304\221\341\273\215c to\303\240n b\341\273\231 t\303\240i li\341\273\207u\r\n\304\221\341\272\267c t\341\272\243 \304\221\303\255nh k\303\250m v\341\273\201 web app qu\341\272\243n l\303\275 n\341\273\201 n\341\272\277p - thi \304\221ua l\341\273\233p h\341\273\215c.\r\n \r\nB\306\260\341\273\233c 1 (ch\306\260a vi\341\272\277t code): t\303\263m t\341\272\257t nh\341\273\257ng g\303\254 b\341\272\241n hi\341\273\203u trong t\341\273\221i \304\221a 15 g\341\272\241ch \304\221\341\272\247u d\303\262ng,\r\nli\341\273\207t k\303\252 c\303\241c \304\221i\341\273\203m m\303\242u thu\341\272\253n ho\341\272\267c thi\341\272\277u th\303\264ng tin n\341\272\277u c\303\263, r\341\273\223i d\341\273\253ng l\341\272\241i ch\341\273\235 t\303\264i x\303\241c nh\341\272\255n.\r\nB\306\260\341\273\233c 2: sau khi t\303\264i x\303\241c nh\341\272\255n, ch\341\273\211 th\341\273\261c hi\341\273\207n Giai \304\221o\341\272\241n 1 \341\273\237 M\341\273\245c 15.\r\n \r\nR\303\240ng bu\341\273\231c b\341\272\257t bu\341\273\231c: to\303\240n b\341\273\231 giao di\341\273\207n b\341\272\261ng ti\341\272\277ng Vi\341\273\207t c\303\263 d\341\272\245u; thi\341\272\277t k\341\272\277 \306\260u ti\303\252n \304\221i\341\273\207n\r\ntho\341\272\241i; c\303\263 giao di\341\273\207n S\303\241ng/T\341\273\221i v\341\273\233i m\341\273\215i m\303\240u khai b\303\241o b\341\272\261ng token (c\341\272\245m hard-code m\303\240u);\r\nkh\303\264ng t\341\273\261 th\303\252m t\303\255nh n\304\203ng ngo\303\240i \304\221\341\272\267c t\341\272\243; kh\303\264ng d\303\271ng emoji l\303\240m bi\341\273\203u t\306\260\341\273\243ng.\r\n\r\nL\306\260u \303\275 quan tr\341\273\215ng v\341\273\201 c\303\241ch l\303\240m vi\341\273\207c: AI Studio t\341\272\241o \304\221\306\260\341\273\243c ph\341\272\247n giao di\341\273\207n v\303\240 m\303\243 Google Apps Script, nh\306\260ng vi\341\273\207c tri\341\273\203n khai (t\341\272\241o Google Sheet, d\303\241n m\303\243 Apps Script, t\341\272\241o OAuth Client ID, \304\221\306\260a web app l\303\252n m\341\272\241ng) do ch\341\273\247 d\341\273\261 \303\241n th\341\273\261c hi\341\273\207n theo file README m\303\240 AI Studio ph\341\272\243i vi\341\272\277t \341\273\237 Giai \304\221o\341\272\241n 2.\r\n1. T\341\273\225ng quan v\303\240 nguy\303\252n t\341\272\257c c\341\273\221t l\303\265i\r\n\341\273\250ng d\341\273\245ng gi\303\272p m\341\273\231t l\341\273\233p h\341\273\215c (kho\341\272\243ng 44 h\341\273\215c sinh, 4 t\341\273\225, 6 d\303\243y b\303\240n) ghi nh\341\272\255n vi ph\341\272\241m n\341\273\201 n\341\272\277p, t\303\255nh \304\221i\341\273\203m thi \304\221ua theo tu\341\272\247n, x\341\272\277p h\341\272\241ng gi\341\273\257a c\303\241c t\341\273\225 v\303\240 c\303\263 th\341\273\203 d\303\271ng b\303\241o c\303\241o cho ph\341\273\245 huynh. Thi\341\272\277t b\341\273\213 s\341\273\255 d\341\273\245ng ch\341\273\247 y\341\272\277u l\303\240 \304\221i\341\273\207n tho\341\272\241i; gi\303\241o vi\303\252n c\303\263 th\341\273\203 d\303\271ng c\341\272\243 m\303\241y t\303\255nh.\r\nT\303\241m nguy\303\252n t\341\272\257c kh\303\264ng \304\221\306\260\341\273\243c vi ph\341\272\241m khi thi\341\272\277t k\341\272\277 v\303\240 l\341\272\255p tr\303\254nh:\r\n\342\200\242\tH\341\273\215c sinh v\303\240 Ban c\303\241n s\341\273\261: \304\221\306\241n gi\341\272\243n, nhanh. Sau khi ch\341\273\215n h\341\273\215c sinh, ghi m\341\273\231t vi ph\341\272\241m ch\341\273\211 c\341\272\247n 2 ch\341\272\241m (ch\341\273\215n h\303\240nh vi, b\341\272\245m L\306\260u). Kh\303\264ng c\303\263 m\303\240n h\303\254nh th\341\273\253a, kh\303\264ng c\303\263 c\303\240i \304\221\341\272\267t r\306\260\341\273\235m r\303\240.\r\n\342\200\242\tGi\303\241o vi\303\252n: nhi\341\273\201u tu\341\273\263 ch\341\273\215n. M\341\273\215i quy t\341\272\257c (\304\221i\341\273\203m, ng\306\260\341\273\241ng m\303\240u, quy\341\273\201n, m\341\273\221c bu\341\273\225i, th\341\273\235i gian s\341\273\255a\342\200\246) \304\221\341\273\201u ch\341\273\211nh \304\221\306\260\341\273\243c trong khu v\341\273\261c c\341\273\247a gi\303\241o vi\303\252n m\303\240 kh\303\264ng ph\341\272\243i s\341\273\255a code.\r\n\342\200\242\tCh\341\273\211 gi\303\241o vi\303\252n \304\221\306\260\341\273\243c nh\341\272\255p v\303\240 xu\341\272\245t d\341\273\257 li\341\273\207u. N\303\272t nh\341\272\255p, xu\341\272\245t, t\341\272\243i v\341\273\201, sao ch\303\251p b\303\241o c\303\241o h\303\240ng lo\341\272\241t kh\303\264ng t\341\273\223n t\341\272\241i trong giao di\341\273\207n c\341\273\247a h\341\273\215c sinh v\303\240 Ban c\303\241n s\341\273\261; \304\221\341\273\223ng th\341\273\235i m\303\241y ch\341\273\247 t\341\273\253 ch\341\273\221i m\341\273\215i l\341\273\207nh nh\341\272\255p/xu\341\272\245t n\341\272\277u kh\303\264ng ph\341\272\243i gi\303\241o vi\303\252n.\r\n\342\200\242\tM\341\272\267c \304\221\341\273\213nh ch\341\273\211 c\303\263 \304\221i\341\273\203m tr\341\273\253. \304\220i\341\273\203m c\341\273\231ng v\303\240 \304\221i\341\273\203m th\306\260\341\273\237ng g\341\273\241 l\341\273\227i l\303\240 tu\341\273\263 ch\341\273\215n do gi\303\241o vi\303\252n b\341\272\255t, m\341\272\267c \304\221\341\273\213nh T\341\272\256T.\r\n\342\200\242\tKh\303\264ng c\303\263 gi\303\241o vi\303\252n b\341\273\231 m\303\264n trong h\341\273\207 th\341\273\221ng. Ch\341\273\211 c\303\263 m\341\273\231t gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m (c\303\263 th\341\273\203 khai b\303\241o nhi\341\273\201u email gi\303\241o vi\303\252n qu\341\272\243n tr\341\273\213 n\341\272\277u c\341\272\247n).\r\n\342\200\242\tB\341\272\243o m\341\272\255t \341\273\237 ph\303\255a m\303\241y ch\341\273\247. M\341\273\215i ki\341\273\203m tra vai tr\303\262 v\303\240 ph\341\272\241m vi \304\221\341\273\201u th\341\273\261c hi\341\273\207n trong Apps Script; giao di\341\273\207n ch\341\273\211 l\303\240 l\341\273\233p hi\341\273\203n th\341\273\213.\r\n\342\200\242\tGiao di\341\273\207n th\306\260\306\241ng m\341\272\241i, chuy\303\252n nghi\341\273\207p, c\303\263 S\303\241ng/T\341\273\221i, \304\221\341\273\215c r\303\265 \341\273\237 c\341\272\243 hai ch\341\272\277 \304\221\341\273\231 (M\341\273\245c 10).\r\n\342\200\242\tTi\341\272\277ng Vi\341\273\207t l\303\240 ng\303\264n ng\341\273\257 ch\303\255nh: t\303\254m ki\341\272\277m kh\303\264ng d\341\272\245u, s\341\272\257p x\341\272\277p theo b\341\272\243ng ch\341\273\257 c\303\241i ti\341\272\277ng Vi\341\273\207t, font h\341\273\227 tr\341\273\243 \304\221\341\272\247y \304\221\341\273\247 d\341\272\245u.\r\n2. C\303\264ng ngh\341\273\207 v\303\240 ki\341\272\277n tr\303\272c\r\n2.1. C\303\264ng ngh\341\273\207 \304\221\341\273\201 xu\341\272\245t\r\nL\341\273\233p\tL\341\273\261a ch\341\273\215n\tGhi ch\303\272\r\nGiao di\341\273\207n\tReact 18 + TypeScript + Vite\t\341\273\250ng d\341\273\245ng m\341\273\231t trang (SPA), c\303\240i \304\221\306\260\341\273\243c l\303\252n m\303\240n h\303\254nh ch\303\255nh (PWA).\r\nKi\341\273\203u d\303\241ng\tTailwind CSS + bi\341\272\277n CSS (design tokens)\tM\341\273\215i m\303\240u l\341\272\245y t\341\273\253 token, kh\303\264ng vi\341\272\277t m\303\243 m\303\240u tr\341\273\261c ti\341\272\277p trong component.\r\nTh\303\240nh ph\341\272\247n\tRadix UI (headless) + vaul (bottom sheet) + lucide-react\tKh\303\264ng d\303\271ng b\341\273\231 UI m\341\272\267c \304\221\341\273\213nh c\303\263 di\341\273\207n m\341\272\241o d\341\273\205 nh\341\272\255n ra.\r\nL\306\260u t\341\272\241m\tidb (IndexedDB)\tH\303\240ng \304\221\341\273\243i ngo\341\272\241i tuy\341\272\277n, b\341\273\231 nh\341\273\233 \304\221\341\273\207m danh s\303\241ch l\341\273\233p.\r\nT\341\273\207p\tSheetJS (xlsx), mammoth (docx), html-to-image, jszip\tCh\341\273\211 d\303\271ng trong khu v\341\273\261c gi\303\241o vi\303\252n.\r\nBi\341\273\203u \304\221\341\273\223\tSVG t\341\273\261 v\341\272\275 ho\341\272\267c Recharts\tCh\341\273\211 c\341\272\247n c\341\273\231t ngang so s\303\241nh 4 t\341\273\225 v\303\240 \304\221\306\260\341\273\235ng xu h\306\260\341\273\233ng tu\341\272\247n.\r\nM\303\241y ch\341\273\247\tGoogle Apps Script (Web App, ch\341\272\241y d\306\260\341\273\233i quy\341\273\201n ch\341\273\247 file)\tAPI JSON; POST d\303\271ng Content-Type: text/plain \304\221\341\273\203 tr\303\241nh l\341\273\227i CORS preflight.\r\nC\306\241 s\341\273\237 d\341\273\257 li\341\273\207u\tGoogle Sheets (ri\303\252ng t\306\260)\tKH\303\224NG \304\221\341\272\267t ch\341\272\277 \304\221\341\273\231 \342\200\234b\341\272\245t k\341\273\263 ai c\303\263 li\303\252n k\341\272\277t\342\200\235. Ch\341\273\211 t\303\240i kho\341\272\243n gi\303\241o vi\303\252n m\341\273\237 \304\221\306\260\341\273\243c.\r\nNh\341\272\255n d\341\272\241ng v\304\203n b\341\272\243n/\341\272\243nh\tQuy t\341\272\257c c\341\273\245c b\341\273\231 + Gemini API (g\341\273\215i t\341\273\253 Apps Script)\tKho\303\241 API n\341\272\261m trong Script Properties, kh\303\264ng bao gi\341\273\235 \304\221\306\260a xu\341\273\221ng tr\303\254nh duy\341\273\207t.\r\n\r\n2.2. S\341\272\243n ph\341\272\251m AI Studio ph\341\272\243i b\303\240n giao\r\n\342\200\242\tM\303\243 ngu\341\273\223n giao di\341\273\207n ho\303\240n ch\341\273\211nh, ch\341\272\241y \304\221\306\260\341\273\243c \341\273\237 ch\341\272\277 \304\221\341\273\231 Demo (d\341\273\257 li\341\273\207u m\341\272\253u n\341\273\231i b\341\273\231) khi ch\306\260a c\341\272\245u h\303\254nh \304\221\341\273\213a ch\341\273\211 API.\r\n\342\200\242\tM\341\273\231t file Code.gs duy nh\341\272\245t, c\303\263 ch\303\272 th\303\255ch ti\341\272\277ng Vi\341\273\207t, g\341\273\223m to\303\240n b\341\273\231 API (M\341\273\245c 12) v\303\240 h\303\240m setupSheets() t\341\273\261 t\341\272\241o m\341\273\215i trang t\303\255nh v\341\273\233i ti\303\252u \304\221\341\273\201 c\341\273\231t v\303\240 c\341\272\245u h\303\254nh m\341\272\253u.\r\n\342\200\242\tFile README_TrienKhai.md b\341\272\261ng ti\341\272\277ng Vi\341\273\207t: t\341\273\253ng b\306\260\341\273\233c t\341\272\241o Google Sheet, d\303\241n m\303\243, t\341\272\241o OAuth Client ID, tri\341\273\203n khai Web App, \304\221\341\272\267t bi\341\272\277n m\303\264i tr\306\260\341\273\235ng, \304\221\306\260a giao di\341\273\207n l\303\252n hosting mi\341\273\205n ph\303\255.\r\n\342\200\242\tB\341\273\231 d\341\273\257 li\341\273\207u m\341\272\253u (M\341\273\245c 14) v\303\240 danh s\303\241ch ki\341\273\203m th\341\273\255 nghi\341\273\207m thu (M\341\273\245c 16).\r\n2.3. Bi\341\272\277n c\341\272\245u h\303\254nh\r\nBi\341\272\277n\tN\306\241i \304\221\341\272\267t\t\303\235 ngh\304\251a\r\nVITE_API_URL\tGiao di\341\273\207n (.env)\t\304\220\341\273\213a ch\341\273\211 Web App c\341\273\247a Apps Script. \304\220\341\273\203 tr\341\273\221ng = ch\341\272\277 \304\221\341\273\231 Demo.\r\nVITE_GOOGLE_CLIENT_ID\tGiao di\341\273\207n (.env)\tOAuth Client ID cho n\303\272t \342\200\234\304\220\304\203ng nh\341\272\255p b\341\272\261ng Google\342\200\235 c\341\273\247a gi\303\241o vi\303\252n.\r\nPEPPER\tScript Properties\tChu\341\273\227i b\303\255 m\341\272\255t tr\341\273\231n v\303\240o khi b\304\203m m\341\272\255t kh\341\272\251u.\r\nGOOGLE_CLIENT_ID\tScript Properties\tD\303\271ng \304\221\341\273\203 ki\341\273\203m tra ID token Google c\303\263 \304\221\303\272ng c\341\273\247a \341\273\251ng d\341\273\245ng n\303\240y.\r\nGEMINI_API_KEY\tScript Properties\tTu\341\273\263 ch\341\273\215n. Ch\341\273\211 d\303\271ng cho nh\341\272\255n d\341\272\241ng n\303\242ng cao (M\341\273\245c 9).\r\n\r\n3. Vai tr\303\262 v\303\240 ph\303\242n quy\341\273\201n\r\n3.1. Danh s\303\241ch vai tr\303\262\r\nM\341\273\231t h\341\273\215c sinh c\303\263 th\341\273\203 gi\341\273\257 nhi\341\273\201u vai tr\303\262 c\303\271ng l\303\272c (v\303\255 d\341\273\245 T\341\273\225 tr\306\260\341\273\237ng ki\303\252m B\303\255 th\306\260). Quy\341\273\201n h\341\272\241n l\303\240 ph\303\251p h\341\273\243p c\341\273\247a c\303\241c vai tr\303\262; tr\303\252n giao di\341\273\207n hi\341\273\203n th\341\273\213 huy hi\341\273\207u c\341\273\247a vai tr\303\262 c\303\263 \304\221\341\273\231 \306\260u ti\303\252n cao nh\341\272\245t k\303\250m c\303\241c huy hi\341\273\207u c\303\262n l\341\272\241i. Th\341\273\251 t\341\273\261 \306\260u ti\303\252n: GV > L\341\273\233p tr\306\260\341\273\237ng > B\303\255 th\306\260 > L\341\273\233p ph\303\263 h\341\273\215c t\341\272\255p > L\341\273\233p ph\303\263 lao \304\221\341\273\231ng > T\341\273\225 tr\306\260\341\273\237ng > H\341\273\215c sinh.\r\nVai tr\303\262\tM\303\243\tH\341\273\215c sinh \304\221\306\260\341\273\243c ch\341\272\245m\tNh\303\263m n\341\273\231i quy \304\221\306\260\341\273\243c ch\341\272\245m (m\341\272\267c \304\221\341\273\213nh)\r\nH\341\273\215c sinh (v\303\240 ph\341\273\245 huynh d\303\271ng chung t\303\240i kho\341\272\243n c\341\273\247a con)\tHS\tKh\303\264ng \304\221\306\260\341\273\243c ch\341\272\245m\tKh\303\264ng\r\nT\341\273\225 tr\306\260\341\273\237ng\tTT\tCh\341\273\211 th\303\240nh vi\303\252n t\341\273\225 m\303\254nh (\303\251p \341\273\237 m\303\241y ch\341\273\247). Kh\303\264ng t\341\273\261 ch\341\272\245m cho ch\303\255nh m\303\254nh (c\303\263 c\303\264ng t\341\272\257c \304\221\341\273\203 GV \304\221\341\273\225i)\tChuy\303\252n c\341\272\247n, N\341\273\201 n\341\272\277p (GV ch\341\273\211nh \304\221\306\260\341\273\243c)\r\nL\341\273\233p tr\306\260\341\273\237ng\tLT\tC\341\272\243 l\341\273\233p\tM\341\273\215i nh\303\263m\r\nB\303\255 th\306\260\tBT\tC\341\272\243 l\341\273\233p\tM\341\273\215i nh\303\263m\r\nL\341\273\233p ph\303\263 h\341\273\215c t\341\272\255p\tLP_HT\tC\341\272\243 l\341\273\233p\tM\341\273\215i nh\303\263m\r\nL\341\273\233p ph\303\263 lao \304\221\341\273\231ng\tLP_LD\tC\341\272\243 l\341\273\233p v\303\240 c\341\272\243 t\341\273\225 tr\341\273\261c nh\341\272\255t\tLao \304\221\341\273\231ng \342\200\223 V\341\273\207 sinh (GV ch\341\273\211nh \304\221\306\260\341\273\243c)\r\nGi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m\tGV\tC\341\272\243 l\341\273\233p\tM\341\273\215i nh\303\263m, k\341\273\203 c\341\272\243 s\341\273\255a/h\341\273\247y sau th\341\273\235i h\341\272\241n kho\303\241 s\341\273\225\r\n\r\nB\303\255 th\306\260, L\341\273\233p ph\303\263 h\341\273\215c t\341\272\255p v\303\240 L\341\273\233p tr\306\260\341\273\237ng \304\221\341\273\201u \304\221\303\241nh gi\303\241 \304\221\306\260\341\273\243c m\341\273\215i kh\303\255a c\341\272\241nh vi ph\341\272\241m c\341\273\247a h\341\273\215c sinh (theo y\303\252u c\341\272\247u c\341\273\247a ch\341\273\247 d\341\273\261 \303\241n). Ma tr\341\272\255n quy\341\273\201n \304\221\306\260\341\273\243c l\306\260u \341\273\237 trang t\303\255nh 8_PhanQuyen v\303\240 ch\341\273\211nh \304\221\306\260\341\273\243c trong khu v\341\273\261c gi\303\241o vi\303\252n.\r\n3.2. Quy\341\273\201n chung c\341\273\247a Ban c\303\241n s\341\273\261 (LT, BT, LP_HT, LP_LD, TT)\r\n\342\200\242\tGhi nh\341\272\255n vi ph\341\272\241m trong ph\341\272\241m vi v\303\240 nh\303\263m n\341\273\231i quy \304\221\306\260\341\273\243c giao.\r\n\342\200\242\tS\341\273\255a ho\341\272\267c h\341\273\247y b\341\272\243n ghi do ch\303\255nh m\303\254nh t\341\272\241o trong th\341\273\235i h\341\272\241n cho ph\303\251p (m\341\272\267c \304\221\341\273\213nh 24 gi\341\273\235). Qu\303\241 h\341\272\241n th\303\254 kho\303\241, ch\341\273\211 GV can thi\341\273\207p. H\341\273\247y l\303\240 \342\200\234\304\221\303\241nh d\341\272\245u h\341\273\247y\342\200\235, kh\303\264ng xo\303\241 kh\341\273\217i s\341\273\225.\r\n\342\200\242\tXem \342\200\234S\341\273\225 c\341\273\247a t\303\264i\342\200\235 (c\303\241c l\306\260\341\273\243t m\303\254nh \304\221\303\243 ghi), xem t\341\273\225ng h\341\273\243p l\341\273\233p tr\303\252n m\303\240n h\303\254nh.\r\n\342\200\242\tX\341\273\255 l\303\275 gi\341\272\243i tr\303\254nh n\341\272\277u \304\221\306\260\341\273\243c GV giao quy\341\273\201n duy\341\273\207t (tu\341\273\263 ch\341\273\215n).\r\n\342\200\242\tKh\303\264ng c\303\263 quy\341\273\201n xu\341\272\245t, t\341\272\243i, nh\341\272\255p, sao ch\303\251p b\303\241o c\303\241o h\303\240ng lo\341\272\241t, \304\221\341\273\225i c\341\272\245u h\303\254nh hay \304\221\341\273\225i vai tr\303\262.\r\n3.3. Quy\341\273\201n c\341\273\247a h\341\273\215c sinh\r\n\342\200\242\tXem \304\221i\341\273\203m tu\341\272\247n, t\341\273\225ng tr\341\273\253, x\341\272\277p lo\341\272\241i d\341\273\261 ki\341\272\277n v\303\240 nh\341\272\255t k\303\275 c\341\273\247a ri\303\252ng m\303\254nh.\r\n\342\200\242\tG\341\273\255i gi\341\272\243i tr\303\254nh cho t\341\273\253ng l\341\273\227i c\341\273\247a m\303\254nh; xem tr\341\272\241ng th\303\241i x\341\273\255 l\303\275.\r\n\342\200\242\tXem s\306\241 \304\221\341\273\223 l\341\273\233p c\303\263 vi\341\273\201n m\303\240u tr\341\272\241ng th\303\241i c\341\273\247a c\341\272\243 l\341\273\233p (xem M\341\273\245c 6.6) v\303\240 b\341\272\243ng x\341\272\277p h\341\272\241ng gi\341\273\257a c\303\241c t\341\273\225.\r\n\342\200\242\t\304\220\341\273\225i m\341\272\255t kh\341\272\251u c\341\273\247a m\303\254nh. Kh\303\264ng xem \304\221\306\260\341\273\243c l\303\275 do, \304\221i\341\273\203m hay l\341\273\213ch s\341\273\255 chi ti\341\272\277t c\341\273\247a b\341\272\241n kh\303\241c.\r\n3.4. M\303\240u nh\341\272\255n di\341\273\207n vai tr\303\262\r\nM\341\273\227i vai tr\303\262 c\303\263 m\341\273\231t m\303\240u ri\303\252ng \304\221\341\273\203 nh\341\272\255n ra ngay ng\306\260\341\273\235i ghi nh\341\272\255n ho\341\272\267c ng\306\260\341\273\235i gi\341\273\257 ch\341\273\251c v\341\273\245. M\303\240u vai tr\303\262 hi\341\273\203n th\341\273\213 \341\273\237 huy hi\341\273\207u ch\341\273\257 vi\341\272\277t t\341\272\257t (g\303\263c \303\264 gh\341\272\277), chip vai tr\303\262 tr\303\252n th\341\272\273 h\341\273\215c sinh v\303\240 d\341\272\243i b\303\252n tr\303\241i t\341\273\253ng d\303\262ng nh\341\272\255t k\303\275. M\303\240u vai tr\303\262 tuy\341\273\207t \304\221\341\273\221i kh\303\264ng d\303\271ng xanh l\303\241, v\303\240ng hay \304\221\341\273\217 \304\221\341\273\203 kh\341\273\217i l\341\272\253n v\341\273\233i m\303\240u tr\341\272\241ng th\303\241i vi ph\341\272\241m. Lu\303\264n k\303\250m ch\341\273\257 vi\341\272\277t t\341\272\257t \304\221\341\273\203 ng\306\260\341\273\235i kh\303\263 ph\303\242n bi\341\273\207t m\303\240u v\341\272\253n nh\341\272\255n ra.\r\nVai tr\303\262\tHuy hi\341\273\207u\tM\303\240u (S\303\241ng)\tM\303\240u (T\341\273\221i)\r\nL\341\273\233p tr\306\260\341\273\237ng\tLT\t#C2410C (cam)\t#FB923C\r\nT\341\273\225 tr\306\260\341\273\237ng\tT1, T2, T3, T4\t#0F766E (xanh ng\341\273\215c)\t#2DD4BF\r\nL\341\273\233p ph\303\263 h\341\273\215c t\341\272\255p\tHT\t#6D28D9 (t\303\255m)\t#A78BFA\r\nL\341\273\233p ph\303\263 lao \304\221\341\273\231ng\tL\304\220\t#7C4A1D (n\303\242u)\t#D6A66B\r\nB\303\255 th\306\260\tBT\t#BE185D (h\341\273\223ng s\341\272\253m)\t#F472B6\r\nGi\303\241o vi\303\252n\tGV\t#1E3A8A (xanh navy)\t#93B4F5\r\n\r\nC\303\241ch d\303\271ng: ch\341\273\257 v\303\240 bi\341\273\203u t\306\260\341\273\243ng d\303\271ng \304\221\303\272ng m\303\240u trong b\341\272\243ng; n\341\273\201n chip l\303\240 ch\303\255nh m\303\240u \304\221\303\263 \341\273\237 \304\221\341\273\231 \304\221\341\272\255m 14% (S\303\241ng) ho\341\272\267c 22% (T\341\273\221i) tr\303\252n n\341\273\201n b\341\273\201 m\341\272\267t. Ph\341\272\243i ki\341\273\203m tra t\341\273\211 l\341\273\207 t\306\260\306\241ng ph\341\272\243n ch\341\273\257/n\341\273\201n t\341\273\221i thi\341\273\203u 4.5:1 \341\273\237 c\341\272\243 hai giao di\341\273\207n, n\341\272\277u thi\341\272\277u th\303\254 t\304\203ng \304\221\341\273\231 \304\221\341\272\255m ch\341\273\257.\r\n4. \304\220\304\203ng nh\341\272\255p v\303\240 b\341\272\243o m\341\272\255t\r\n4.1. C\341\273\225ng v\303\240o l\341\273\233p\r\n\342\200\242\tL\341\272\247n \304\221\341\272\247u m\341\273\237 \341\273\251ng d\341\273\245ng tr\303\252n m\341\273\231t thi\341\272\277t b\341\273\213, nh\341\272\255p M\303\243 l\341\273\233p (6 k\303\275 t\341\273\261 do GV \304\221\341\272\267t v\303\240 \304\221\341\273\225i \304\221\306\260\341\273\243c). Sau \304\221\303\263 thi\341\272\277t b\341\273\213 nh\341\273\233 m\303\243 l\341\273\233p. M\341\273\245c \304\221\303\255ch: ng\306\260\341\273\235i ngo\303\240i c\303\263 \304\221\306\260\341\273\235ng link c\305\251ng kh\303\264ng xem \304\221\306\260\341\273\243c danh s\303\241ch t\303\252n h\341\273\215c sinh.\r\n\342\200\242\tM\303\240n h\303\254nh \304\221\304\203ng nh\341\272\255p ch\341\273\211 hi\341\273\203n th\341\273\213 t\303\252n v\303\240 v\341\273\213 tr\303\255 gh\341\272\277. Tuy\341\273\207t \304\221\341\273\221i kh\303\264ng hi\341\273\203n th\341\273\213 m\303\240u tr\341\272\241ng th\303\241i, \304\221i\341\273\203m hay huy hi\341\273\207u vi ph\341\272\241m tr\306\260\341\273\233c khi \304\221\304\203ng nh\341\272\255p.\r\n4.2. \304\220\304\203ng nh\341\272\255p h\341\273\215c sinh v\303\240 Ban c\303\241n s\341\273\261\r\n\342\200\242\tCh\341\273\215n t\303\252n (b\341\272\261ng \303\264 t\303\254m ki\341\272\277m ho\341\272\267c ch\341\272\241m \304\221\303\272ng gh\341\272\277 tr\303\252n s\306\241 \304\221\341\273\223) r\341\273\223i nh\341\272\255p duy nh\341\272\245t m\341\273\231t \303\264 m\341\272\255t kh\341\272\251u. Kh\303\264ng c\341\272\247n nh\341\273\233 m\303\243 h\341\273\215c sinh.\r\n\342\200\242\tM\341\272\255t kh\341\272\251u ban \304\221\341\272\247u do h\341\273\207 th\341\273\221ng t\341\272\241o ng\341\272\253u nhi\303\252n (m\341\272\267c \304\221\341\273\213nh 6 ch\341\273\257 s\341\273\221), GV in phi\341\272\277u ph\303\241t cho t\341\273\253ng em. L\341\272\247n \304\221\304\203ng nh\341\272\255p \304\221\341\272\247u b\341\272\257t bu\341\273\231c \304\221\341\273\225i m\341\272\255t kh\341\272\251u. Cho ph\303\251p m\341\272\255t kh\341\272\251u t\341\273\221i thi\341\273\203u 6 k\303\275 t\341\273\261.\r\n\342\200\242\t\342\200\234Ghi nh\341\273\233 thi\341\272\277t b\341\273\213\342\200\235 m\341\272\267c \304\221\341\273\213nh b\341\272\255t, phi\303\252n k\303\251o d\303\240i 30 ng\303\240y (GV ch\341\273\211nh \304\221\306\260\341\273\243c). C\303\263 n\303\272t \342\200\234\304\220\304\203ng xu\341\272\245t\342\200\235.\r\n\342\200\242\tSai 5 l\341\272\247n li\303\252n ti\341\272\277p th\303\254 kho\303\241 15 ph\303\272t (\304\221\341\272\277m theo t\341\273\253ng h\341\273\215c sinh). M\341\273\215i l\341\272\247n \304\221\304\203ng nh\341\272\255p th\303\240nh c\303\264ng, th\341\272\245t b\341\272\241i v\303\240 kho\303\241 \304\221\341\273\201u ghi v\303\240o nh\341\272\255t k\303\275 h\341\273\207 th\341\273\221ng.\r\n\342\200\242\tPh\341\273\245 huynh d\303\271ng chung t\303\240i kho\341\272\243n c\341\273\247a con. H\341\273\207 th\341\273\221ng kh\303\264ng c\303\263 t\303\240i kho\341\272\243n ph\341\273\245 huynh ri\303\252ng.\r\n4.3. \304\220\304\203ng nh\341\272\255p gi\303\241o vi\303\252n (c\341\273\225ng ri\303\252ng)\r\nM\303\240n h\303\254nh \304\221\304\203ng nh\341\272\255p c\303\263 m\341\273\231t n\303\272t ri\303\252ng \342\200\234D\303\240nh cho Gi\303\241o vi\303\252n\342\200\235. Ph\306\260\306\241ng \303\241n ch\341\273\215n: \304\220\304\203ng nh\341\272\255p b\341\272\261ng Google, \304\221\341\273\221i chi\341\272\277u danh s\303\241ch email \304\221\306\260\341\273\243c ph\303\251p. \304\220\303\242y l\303\240 c\303\241ch \304\221\306\241n gi\341\272\243n nh\341\272\245t m\303\240 v\341\272\253n b\341\272\243o m\341\272\255t t\341\273\221t, kh\303\264ng c\341\272\247n nh\341\273\233 m\341\272\255t kh\341\272\251u ri\303\252ng v\303\240 kh\303\264ng th\341\273\203 b\341\273\213 gi\341\272\243 m\341\272\241o b\341\272\261ng c\303\241ch \304\221o\303\241n.\r\n\342\200\242\tGiao di\341\273\207n d\303\271ng Google Identity Services, g\341\273\255i ID token l\303\252n m\303\241y ch\341\273\247.\r\n\342\200\242\tApps Script ki\341\273\203m tra token v\341\273\233i Google (\304\221i\341\273\203m cu\341\273\221i tokeninfo), x\303\241c nh\341\272\255n aud tr\303\271ng GOOGLE_CLIENT_ID, email_verified = true, v\303\240 email n\341\272\261m trong trang t\303\255nh 9_TaiKhoanGV. N\341\272\277u \304\221\341\272\241t th\303\254 c\341\272\245p token phi\303\252n.\r\n\342\200\242\tPhi\303\252n gi\303\241o vi\303\252n kh\303\264ng h\341\272\277t h\341\272\241n theo th\341\273\235i gian (\304\221\304\203ng nh\341\272\255p m\341\273\231t l\341\272\247n, ghi nh\341\273\233 tr\303\252n thi\341\272\277t b\341\273\213). \304\220\341\273\203 v\341\272\253n an to\303\240n khi m\341\272\245t m\303\241y: c\303\263 m\341\273\245c \342\200\234Thi\341\272\277t b\341\273\213 \304\221\303\243 \304\221\304\203ng nh\341\272\255p\342\200\235 cho ph\303\251p thu h\341\273\223i t\341\273\253ng thi\341\272\277t b\341\273\213 ho\341\272\267c t\341\272\245t c\341\272\243; c\303\263 th\303\264ng b\303\241o email khi c\303\263 thi\341\272\277t b\341\273\213 m\341\273\233i \304\221\304\203ng nh\341\272\255p.\r\n\342\200\242\tPh\306\260\306\241ng \303\241n d\341\273\261 ph\303\262ng khi kh\303\264ng d\303\271ng \304\221\306\260\341\273\243c Google: m\303\243 OTP 6 s\341\273\221 g\341\273\255i v\341\273\201 email gi\303\241o vi\303\252n, hi\341\273\207u l\341\273\261c 10 ph\303\272t.\r\n\342\200\242\tKh\303\264ng y\303\252u c\341\272\247u x\303\241c th\341\273\261c l\341\272\241i khi xu\341\272\245t d\341\273\257 li\341\273\207u (theo y\303\252u c\341\272\247u ch\341\273\247 d\341\273\261 \303\241n).\r\n4.4. Quy t\341\272\257c b\341\272\243o m\341\272\255t \341\273\237 m\303\241y ch\341\273\247 (b\341\272\257t bu\341\273\231c)\r\n\342\200\242\tM\341\272\255t kh\341\272\251u l\306\260u d\341\272\241ng b\304\203m SHA-256 c\303\263 mu\341\273\221i ri\303\252ng t\341\273\253ng ng\306\260\341\273\235i c\341\273\231ng PEPPER (d\303\271ng Utilities.computeDigest). Kh\303\264ng bao gi\341\273\235 tr\341\272\243 c\341\273\231t m\341\272\255t kh\341\272\251u hay mu\341\273\221i v\341\273\201 giao di\341\273\207n. Kh\303\264ng bao gi\341\273\235 xu\341\272\245t m\341\272\255t kh\341\272\251u.\r\n\342\200\242\tToken phi\303\252n l\303\240 chu\341\273\227i ng\341\272\253u nhi\303\252n 32 byte; ch\341\273\211 l\306\260u b\341\272\243n b\304\203m trong 11_PhienDangNhap. M\341\273\227i l\341\273\207nh API \304\221\341\273\201u ki\341\273\203m tra token, l\341\272\245y vai tr\303\262, ki\341\273\203m tra ph\341\272\241m vi t\341\273\253 d\341\273\257 li\341\273\207u tr\303\252n m\303\241y ch\341\273\247, kh\303\264ng tin b\341\272\245t k\341\273\263 vai tr\303\262 n\303\240o do giao di\341\273\207n g\341\273\255i l\303\252n.\r\n\342\200\242\tT\341\273\225 tr\306\260\341\273\237ng ch\341\273\211 ghi \304\221\306\260\341\273\243c cho th\303\240nh vi\303\252n t\341\273\225 m\303\254nh: m\303\241y ch\341\273\247 t\341\273\261 \304\221\341\273\221i chi\341\272\277u MaHS v\341\273\233i t\341\273\225 c\341\273\247a ng\306\260\341\273\235i ghi, giao di\341\273\207n ch\341\273\211 l\303\240m m\341\273\235 cho ti\341\273\207n nh\303\254n.\r\n\342\200\242\tH\341\273\215c sinh ch\341\273\211 nh\341\272\255n v\341\273\201: d\341\273\257 li\341\273\207u chi ti\341\272\277t c\341\273\247a ri\303\252ng m\303\254nh v\303\240 m\341\273\251c tr\341\272\241ng th\303\241i m\303\240u c\341\273\247a t\341\273\253ng b\341\272\241n (kh\303\264ng k\303\250m l\303\275 do, kh\303\264ng k\303\250m \304\221i\341\273\203m).\r\n\342\200\242\tM\341\273\215i l\341\273\207nh ghi d\303\271ng LockService \304\221\341\273\203 tr\303\241nh ghi \304\221\303\250 khi nhi\341\273\201u ng\306\260\341\273\235i ch\341\272\245m c\303\271ng l\303\272c; m\341\273\227i b\341\272\243n ghi c\303\263 MaGhiNhan (UUID sinh t\341\273\253 thi\341\272\277t b\341\273\213) \304\221\341\273\203 ch\341\273\221ng ghi tr\303\271ng khi \304\221\341\273\223ng b\341\273\231 l\341\272\241i.\r\n\342\200\242\tTh\341\273\235i gian chu\341\272\251n l\303\240 th\341\273\235i gian m\303\241y ch\341\273\247. Th\341\273\235i \304\221i\341\273\203m ghi tr\303\252n m\303\241y (n\341\272\277u ngo\341\272\241i tuy\341\272\277n) \304\221\306\260\341\273\243c l\306\260u th\303\252m \341\273\237 c\341\273\231t ri\303\252ng \304\221\341\273\203 \304\221\341\273\221i chi\341\272\277u.\r\n5. B\341\273\231 ch\341\273\215n h\341\273\215c sinh (d\303\271ng chung cho \304\221\304\203ng nh\341\272\255p v\303\240 ghi nh\341\272\255n)\r\nM\341\273\231t th\303\240nh ph\341\272\247n duy nh\341\272\245t, c\303\263 thanh g\341\272\241t hai ch\341\272\277 \304\221\341\273\231 ngay \304\221\341\272\247u m\303\240n h\303\254nh: [Danh s\303\241ch] v\303\240 [S\306\241 \304\221\341\273\223 l\341\273\233p]. Th\303\240nh ph\341\272\247n n\303\240y d\303\271ng cho 3 vi\341\273\207c: ch\341\273\215n t\303\252n \304\221\341\273\203 \304\221\304\203ng nh\341\272\255p, ch\341\273\215n h\341\273\215c sinh \304\221\341\273\203 xem, ch\341\273\215n h\341\273\215c sinh \304\221\341\273\203 ghi nh\341\272\255n.\r\n5.1. Ch\341\272\277 \304\221\341\273\231 Danh s\303\241ch + T\303\254m ki\341\272\277m nhanh\r\n\342\200\242\tG\303\265 1\342\200\2232 k\303\275 t\341\273\261 l\303\240 danh s\303\241ch thu g\341\273\215n ngay. T\303\254m kh\303\264ng ph\303\242n bi\341\273\207t hoa th\306\260\341\273\235ng, c\303\263 d\341\272\245u ho\341\272\267c kh\303\264ng d\341\272\245u, theo h\341\273\215, t\303\252n \304\221\341\273\207m, t\303\252n ch\303\255nh ho\341\272\267c ch\341\273\257 c\303\241i \304\221\341\272\247u (v\303\255 d\341\273\245 huy, nkh).\r\n\342\200\242\tM\341\273\227i d\303\262ng: th\341\273\251 t\341\273\261, h\341\273\215 v\303\240 t\303\252n \304\221\341\272\247y \304\221\341\273\247, t\341\273\225, v\341\273\213 tr\303\255 b\303\240n. Trong ch\341\272\277 \304\221\341\273\231 ghi nh\341\272\255n c\303\263 th\303\252m ch\341\272\245m tr\341\272\241ng th\303\241i tu\341\272\247n. Tr\306\260\341\273\233c khi \304\221\304\203ng nh\341\272\255p th\303\254 kh\303\264ng c\303\263 ch\341\272\245m tr\341\272\241ng th\303\241i.\r\n\342\200\242\tV\341\273\233i T\341\273\225 tr\306\260\341\273\237ng \341\273\237 ch\341\272\277 \304\221\341\273\231 ghi nh\341\272\255n: ch\341\273\211 tr\341\272\243 v\341\273\201 h\341\273\215c sinh c\303\271ng t\341\273\225 (l\341\273\215c c\341\273\251ng c\341\272\243 \341\273\237 m\303\241y ch\341\273\247).\r\n\342\200\242\tS\341\272\257p x\341\272\277p m\341\272\267c \304\221\341\273\213nh theo t\303\252n ch\303\255nh theo b\341\272\243ng ch\341\273\257 c\303\241i ti\341\272\277ng Vi\341\273\207t; c\303\263 th\341\273\203 \304\221\341\273\225i sang s\341\272\257p x\341\272\277p theo th\341\273\251 t\341\273\261 danh s\303\241ch ho\341\272\267c theo t\341\273\225.\r\n5.2. Ch\341\272\277 \304\221\341\273\231 S\306\241 \304\221\341\273\223 l\341\273\233p t\306\260\306\241ng t\303\241c\r\n\342\200\242\tD\341\273\261ng t\341\273\253 c\341\272\245u h\303\254nh \303\264 l\306\260\341\273\233i (M\341\273\245c 11, trang 2_CauHinhSoDo): m\341\273\227i \303\264 c\303\263 lo\341\272\241i *gh\341\272\277 / tr\341\273\221ng / l\341\273\221i \304\221i / b\303\240n gi\303\241o vi\303\252n / c\341\273\255a ra v\303\240o / b\341\273\245c gi\341\272\243ng*. H\341\273\227 tr\341\273\243 s\306\241 \304\221\341\273\223 kh\303\264ng \304\221\341\273\201u (b\303\240n thi\341\272\277u, b\303\240n 3 ng\306\260\341\273\235i, l\341\273\221i \304\221i).\r\n\342\200\242\tR\303\272t g\341\273\215n t\303\252n: ch\341\273\257 c\303\241i \304\221\341\272\247u c\341\273\247a h\341\273\215 v\303\240 t\303\252n \304\221\341\273\207m, vi\341\272\277t \304\221\341\273\247 t\303\252n ch\303\255nh. V\303\255 d\341\273\245 Nguy\341\273\205n Kh\341\272\257c Huy th\303\240nh N.K.Huy; Tr\341\272\247n Th\341\273\213 Mai Anh th\303\240nh T.T.M.Anh. H\341\273\207 th\341\273\221ng t\341\273\261 ph\303\241t hi\341\273\207n tr\303\271ng t\303\252n r\303\272t g\341\273\215n v\303\240 cho GV ghi \304\221\303\250 \341\273\237 c\341\273\231t TenRutGon. Ch\341\272\241m v\303\240o \303\264 th\303\254 t\303\252n \304\221\341\272\247y \304\221\341\273\247 hi\341\273\207n \341\273\237 ti\303\252u \304\221\341\273\201 b\341\272\243ng thao t\303\241c.\r\n\342\200\242\t\304\220i\341\273\207n tho\341\272\241i d\341\273\215c: c\303\263 c\303\264ng t\341\272\257c \342\200\234To\303\240n l\341\273\233p thu g\341\273\215n\342\200\235 (v\341\273\253a kh\303\255t chi\341\273\201u ngang) ho\341\272\267c c\303\241c tab \342\200\234D\303\243y 1, D\303\243y 2, D\303\243y 3, D\303\243y 4\342\200\235 v\341\273\233i \303\264 l\341\273\233n. M\303\241y t\303\255nh b\341\272\243ng v\303\240 m\303\241y t\303\255nh: hi\341\273\203n th\341\273\213 \304\221\341\273\247 c\341\272\243 l\341\273\233p. V\303\271ng ch\341\272\241m t\341\273\221i thi\341\273\203u 44\303\22744 px, c\341\273\241 ch\341\273\257 t\303\252n t\341\273\221i thi\341\273\203u 12 px.\r\n\342\200\242\t\303\224 gh\341\272\277 g\341\273\223m: t\303\252n r\303\272t g\341\273\215n; vi\341\273\201n ngo\303\240i th\341\273\203 hi\341\273\207n tr\341\272\241ng th\303\241i vi ph\341\272\241m; huy hi\341\273\207u vai tr\303\262 \341\273\237 g\303\263c; n\341\273\201n th\341\273\203 hi\341\273\207n t\341\273\225 b\341\272\261ng s\341\272\257c r\341\272\245t nh\341\272\241t ho\341\272\267c nh\303\243n s\341\273\221 t\341\273\225 nh\341\273\217 (kh\303\264ng d\303\271ng m\303\240u tr\303\271ng m\303\240u vai tr\303\262).\r\n\342\200\242\tCh\341\272\241m ch\341\273\215n: \303\264 ph\303\241t s\303\241ng vi\341\273\201n (m\303\240u nh\341\272\245n), ph\303\263ng 105%, hi\341\273\207u \341\273\251ng g\341\273\243n s\303\263ng 300 ms. \341\273\236 ch\341\272\277 \304\221\341\273\231 ch\341\273\215n nhi\341\273\201u th\303\254 c\303\241c \303\264 \304\221\303\243 ch\341\273\215n c\303\271ng s\303\241ng v\303\240 c\303\263 d\341\272\245u t\303\255ch.\r\n\342\200\242\tL\303\240m s\303\241ng v\303\271ng t\341\273\225 cho T\341\273\225 tr\306\260\341\273\237ng: ch\341\273\211 c\303\241c \303\264 thu\341\273\231c t\341\273\225 m\303\254nh hi\341\273\203n th\341\273\213 r\303\265 v\303\240 ch\341\272\241m \304\221\306\260\341\273\243c; c\303\241c \303\264 t\341\273\225 kh\303\241c gi\341\272\243m \304\221\341\273\231 trong su\341\273\221t c\303\262n 30%, chuy\341\273\203n x\303\241m, kho\303\241 s\341\273\261 ki\341\273\207n ch\341\272\241m, k\341\273\203 c\341\272\243 khi c\303\241c t\341\273\225 ng\341\273\223i xen k\341\272\275.\r\n6. Quy tr\303\254nh ghi nh\341\272\255n vi ph\341\272\241m (ph\341\272\247n quan tr\341\273\215ng nh\341\272\245t)\r\nM\341\273\245c ti\303\252u: m\341\273\231t Ban c\303\241n s\341\273\261 ghi xong m\341\273\231t l\341\273\227i trong d\306\260\341\273\233i 5 gi\303\242y b\341\272\261ng m\341\273\231t ng\303\263n tay c\303\241i. M\341\273\215i quy\341\272\277t \304\221\341\273\213nh thi\341\272\277t k\341\272\277 \341\273\237 m\341\273\245c n\303\240y \304\221\341\273\201u \306\260u ti\303\252n t\341\273\221c \304\221\341\273\231 v\303\240 gi\341\272\243m nh\341\272\247m.\r\n6.1. Lu\341\273\223ng A: ch\341\273\215n ng\306\260\341\273\235i tr\306\260\341\273\233c (m\341\272\267c \304\221\341\273\213nh)\r\n\342\200\242\tCh\341\272\241m 1: ch\341\273\215n h\341\273\215c sinh tr\303\252n s\306\241 \304\221\341\273\223 ho\341\272\267c danh s\303\241ch. B\341\272\243ng thao t\303\241c tr\306\260\341\273\243t t\341\273\253 \304\221\303\241y m\303\240n h\303\254nh l\303\252n (kh\303\264ng che h\341\272\277t s\306\241 \304\221\341\273\223), hi\341\273\207n h\341\273\215 t\303\252n \304\221\341\272\247y \304\221\341\273\247, t\341\273\225, bu\341\273\225i hi\341\273\207n t\341\272\241i.\r\n\342\200\242\tCh\341\272\241m 2: ch\341\273\215n h\303\240nh vi. H\303\240ng \304\221\341\272\247u ti\303\252n l\303\240 \342\200\234Hay d\303\271ng\342\200\235: 6\342\200\2238 h\303\240nh vi ng\306\260\341\273\235i ghi d\303\271ng nhi\341\273\201u nh\341\272\245t (t\341\273\261 h\341\273\215c theo l\341\273\213ch s\341\273\255 c\341\273\247a ch\303\255nh ng\306\260\341\273\235i \304\221\303\263, kh\341\273\237i \304\221\341\272\247u b\341\272\261ng danh s\303\241ch GV ghim). B\303\252n d\306\260\341\273\233i l\303\240 c\303\241c tab nh\303\263m n\341\273\231i quy v\303\240 \303\264 t\303\254m h\303\240nh vi.\r\n\342\200\242\tL\306\260u: n\303\272t \342\200\234L\306\260u\342\200\235 to, c\341\273\221 \304\221\341\273\213nh \341\273\237 \304\221\303\241y b\341\272\243ng. Ch\341\272\241m v\303\240o h\303\240nh vi ch\341\273\211 ch\341\273\215n, b\341\272\245m L\306\260u m\341\273\233i ghi, n\303\252n hai b\306\260\341\273\233c sau khi ch\341\273\215n ng\306\260\341\273\235i.\r\n\342\200\242\tGhi ch\303\272, \304\221\341\273\225i ng\303\240y, \304\221\303\255nh k\303\250m minh ch\341\273\251ng \304\221\341\273\201u \341\272\251n sau n\303\272t \342\200\234Th\303\252m chi ti\341\272\277t\342\200\235; kh\303\264ng b\341\272\257t bu\341\273\231c.\r\n\342\200\242\tSau khi l\306\260u: th\303\264ng b\303\241o nh\341\273\217 \342\200\234\304\220\303\243 ghi: N.K.Huy \342\200\223 \304\220i mu\341\273\231n (\342\210\2222)\342\200\235 k\303\250m n\303\272t Ho\303\240n t\303\241c trong 8 gi\303\242y. Vi\341\273\201n \303\264 gh\341\272\277 \304\221\341\273\225i m\303\240u ngay l\341\272\255p t\341\273\251c (c\341\272\255p nh\341\272\255t l\341\272\241c quan), \304\221\341\273\223ng b\341\273\231 ng\341\272\247m sau \304\221\303\263.\r\n6.2. Lu\341\273\223ng B: ch\341\273\215n l\341\273\227i tr\306\260\341\273\233c, nhi\341\273\201u ng\306\260\341\273\235i\r\n\342\200\242\tN\303\272t n\341\273\225i \342\200\234Ghi nhi\341\273\201u ng\306\260\341\273\235i\342\200\235. Ch\341\273\215n m\341\273\231t h\303\240nh vi tr\306\260\341\273\233c, sau \304\221\303\263 ch\341\272\241m li\303\252n ti\341\272\277p nhi\341\273\201u gh\341\272\277 (ho\341\272\267c t\303\255ch nhi\341\273\201u t\303\252n trong danh s\303\241ch), b\341\272\245m L\306\260u m\341\273\231t l\341\272\247n.\r\n\342\200\242\tT\341\273\253 Lu\341\273\223ng A c\305\251ng c\303\263 n\303\272t \342\200\234Th\303\252m ng\306\260\341\273\235i\342\200\235 \304\221\341\273\203 m\341\273\237 r\341\273\231ng th\303\240nh ghi nhi\341\273\201u ng\306\260\341\273\235i cho c\303\271ng m\341\273\231t h\303\240nh vi.\r\n6.3. Ch\341\272\277 \304\221\341\273\231 l\306\260u nhanh m\341\273\231t ch\341\272\241m (tu\341\273\263 ch\341\273\215n c\303\241 nh\303\242n)\r\nTrong c\303\240i \304\221\341\272\267t c\303\241 nh\303\242n c\341\273\247a Ban c\303\241n s\341\273\261 c\303\263 c\303\264ng t\341\272\257c \342\200\234L\306\260u ngay khi ch\341\272\241m h\303\240nh vi\342\200\235, m\341\272\267c \304\221\341\273\213nh t\341\272\257t. Khi b\341\272\255t, ch\341\272\241m v\303\240o h\303\240nh vi l\303\240 l\306\260u lu\303\264n v\303\240 v\341\272\253n c\303\263 Ho\303\240n t\303\241c 8 gi\303\242y. D\303\240nh cho ng\306\260\341\273\235i thao t\303\241c th\303\240nh th\341\272\241o.\r\n6.4. C\341\272\243nh b\303\241o ghi tr\303\271ng\r\n\304\220i\341\273\201u ki\341\273\207n: t\341\273\253 l\341\272\247n vi ph\341\272\241m th\341\273\251 2 c\341\273\247a c\303\271ng m\341\273\231t h\341\273\215c sinh trong c\303\271ng m\341\273\231t bu\341\273\225i (m\341\273\221c gi\341\273\235 bu\341\273\225i s\303\241ng/chi\341\273\201u khai b\303\241o trong c\341\272\245u h\303\254nh), tr\306\260\341\273\233c khi g\341\273\255i ph\341\272\243i hi\341\273\207n h\341\273\231p x\303\241c nh\341\272\255n.\r\n\342\200\242\tH\341\273\231p li\341\273\207t k\303\252 c\303\241c l\341\273\227i \304\221\303\243 ghi cho em \304\221\303\263 trong bu\341\273\225i n\303\240y (gi\341\273\235, h\303\240nh vi, ng\306\260\341\273\235i ghi) v\303\240 hai n\303\272t: [Ghi th\303\252m] v\303\240 [H\341\273\247y].\r\n\342\200\242\tN\341\272\277u h\303\240nh vi m\341\273\233i gi\341\273\221ng h\341\273\207t h\303\240nh vi \304\221\303\243 ghi: \304\221\341\273\225i sang c\341\272\243nh b\303\241o m\341\272\241nh v\341\273\233i ti\303\252u \304\221\341\273\201 \342\200\234C\303\263 th\341\273\203 b\341\273\213 ghi tr\303\271ng\342\200\235, n\303\272t m\341\272\267c \304\221\341\273\213nh (\304\221\306\260\341\273\243c focus) l\303\240 [H\341\273\247y], n\303\272t [Ghi th\303\252m] \341\273\237 d\341\272\241ng ph\341\273\245.\r\n\342\200\242\tN\341\272\277u h\303\240nh vi kh\303\241c h\303\240nh vi \304\221\303\243 ghi: c\341\272\243nh b\303\241o nh\341\272\271, n\303\272t m\341\272\267c \304\221\341\273\213nh l\303\240 [Ghi th\303\252m].\r\n\342\200\242\tKhi ghi nhi\341\273\201u ng\306\260\341\273\235i: h\341\273\231p ch\341\273\211 li\341\273\207t k\303\252 nh\341\273\257ng em \304\221\303\243 c\303\263 l\341\273\227i trong bu\341\273\225i; m\341\273\227i em c\303\263 c\303\264ng t\341\272\257c \342\200\234V\341\272\253n ghi cho em n\303\240y\342\200\235 (m\341\272\267c \304\221\341\273\213nh T\341\272\256T n\341\272\277u tr\303\271ng h\303\240nh vi, B\341\272\254T n\341\272\277u kh\303\241c h\303\240nh vi). C\303\241c em c\303\262n l\341\272\241i v\341\272\253n \304\221\306\260\341\273\243c l\306\260u b\303\254nh th\306\260\341\273\235ng.\r\n\342\200\242\tM\303\241y ch\341\273\247 c\305\251ng ki\341\273\203m tra l\341\272\241i v\303\254 hai ng\306\260\341\273\235i c\303\263 th\341\273\203 ghi c\303\271ng l\303\272c. N\341\272\277u ph\303\241t hi\341\273\207n tr\303\271ng ch\306\260a x\303\241c nh\341\272\255n, m\303\241y ch\341\273\247 tr\341\272\243 m\303\243 NEED_CONFIRM_DUPLICATE; b\341\272\243n ghi \304\221\303\243 x\303\241c nh\341\272\255n l\306\260u c\341\273\235 DaXacNhanTrung = TRUE v\303\240 LanThuTrongBuoi.\r\n\342\200\242\tKhi ngo\341\272\241i tuy\341\272\277n: m\303\241y ki\341\273\203m tra c\341\273\245c b\341\273\231 tr\306\260\341\273\233c. N\341\272\277u l\303\272c \304\221\341\273\223ng b\341\273\231 v\341\272\253n ph\303\241t hi\341\273\207n tr\303\271ng ch\306\260a x\303\241c nh\341\272\255n th\303\254 b\341\272\243n ghi v\303\240o m\341\273\245c \342\200\234Ch\341\273\235 x\303\241c nh\341\272\255n\342\200\235 cho ng\306\260\341\273\235i ghi v\303\240 GV, ch\306\260a t\303\255nh \304\221i\341\273\203m.\r\n\342\200\242\tM\341\272\267c \304\221\341\273\213nh ch\341\273\211 \303\241p d\341\273\245ng cho \304\221i\341\273\203m tr\341\273\253; c\303\263 c\303\264ng t\341\272\257c cho GV \303\241p d\341\273\245ng th\303\252m cho \304\221i\341\273\203m c\341\273\231ng (khi \304\221i\341\273\203m c\341\273\231ng \304\221\306\260\341\273\243c b\341\272\255t).\r\n6.5. Quy t\341\272\257c t\303\255nh \304\221i\341\273\203m\r\n\342\200\242\tM\341\273\227i tu\341\272\247n m\341\273\227i h\341\273\215c sinh b\341\272\257t \304\221\341\272\247u 100 \304\221i\341\273\203m (GV ch\341\273\211nh). \304\220i\341\273\203m tu\341\272\247n = \304\221i\341\273\203m kh\341\273\237i \304\221\341\272\247u \342\210\222 t\341\273\225ng \304\221i\341\273\203m tr\341\273\253 c\341\273\247a c\303\241c b\341\272\243n ghi c\303\262n hi\341\273\207u l\341\273\261c. X\341\272\277p lo\341\272\241i d\341\273\261 ki\341\272\277n theo ng\306\260\341\273\241ng m\341\272\267c \304\221\341\273\213nh: T\341\273\221t \342\211\245 90; Kh\303\241 75\342\200\22389; \304\220\341\272\241t 60\342\200\22374; Ch\306\260a \304\221\341\272\241t < 60 (GV ch\341\273\211nh).\r\n\342\200\242\t\304\220i\341\273\203m t\341\273\225 = \304\221i\341\273\203m trung b\303\254nh tr\303\252n m\341\273\227i th\303\240nh vi\303\252n (tr\303\241nh b\341\272\245t c\303\264ng khi s\304\251 s\341\273\221 c\303\241c t\341\273\225 l\341\273\207ch nhau). C\303\263 c\303\264ng t\341\272\257c \304\221\341\273\225i sang t\341\273\225ng \304\221i\341\273\203m.\r\n\342\200\242\tB\341\272\243n ghi \304\221ang ch\341\273\235 gi\341\272\243i tr\303\254nh v\341\272\253n t\303\255nh \304\221i\341\273\203m cho \304\221\341\272\277n khi \304\221\306\260\341\273\243c ch\341\272\245p nh\341\272\255n; c\303\263 c\303\264ng t\341\272\257c \304\221\341\273\225i th\303\240nh \342\200\234t\341\272\241m kh\303\264ng t\303\255nh\342\200\235.\r\n\342\200\242\tC\303\263 th\341\273\203 ghi cho c\341\272\243 m\341\273\231t t\341\273\225 (\304\221\341\273\221i t\306\260\341\273\243ng = T\341\273\225), v\303\255 d\341\273\245 t\341\273\225 tr\341\273\261c nh\341\272\255t kh\303\264ng l\303\240m v\341\273\207 sinh; \304\221i\341\273\203m n\303\240y t\303\255nh v\303\240o \304\221i\341\273\203m t\341\273\225, kh\303\264ng tr\341\273\253 v\303\240o t\341\273\253ng h\341\273\215c sinh.\r\n\342\200\242\tGhi b\303\271 cho ng\303\240y tr\306\260\341\273\233c: ch\341\273\215n ng\303\240y trong tu\341\272\247n hi\341\273\207n t\341\272\241i (Ban c\303\241n s\341\273\261). Tu\341\272\247n \304\221\303\243 ch\341\273\221t ch\341\273\211 GV \304\221\306\260\341\273\243c can thi\341\273\207p.\r\n\342\200\242\t\304\220i\341\273\203m c\341\273\231ng (tu\341\273\263 ch\341\273\215n, m\341\272\267c \304\221\341\273\213nh t\341\272\257t): khi GV b\341\272\255t, xu\341\272\245t hi\341\273\207n nh\303\263m \342\200\234\304\220i\341\273\203m c\341\273\231ng\342\200\235 trong danh m\341\273\245c n\341\273\231i quy, vi\341\273\201n xanh l\303\241, v\303\240 c\303\241c m\303\240n h\303\254nh \342\200\234tuy\303\252n d\306\260\306\241ng\342\200\235. \304\220i\341\273\203m th\306\260\341\273\237ng g\341\273\241 l\341\273\227i (b\303\271 tr\341\273\253) l\303\240 tu\341\273\263 ch\341\273\215n ri\303\252ng, m\341\272\267c \304\221\341\273\213nh t\341\272\257t, c\303\263 tr\341\272\247n b\303\271 (v\303\255 d\341\273\245 t\341\273\221i \304\221a 50% \304\221i\341\273\203m tr\341\273\253) v\303\240 danh s\303\241ch l\341\273\227i n\341\272\267ng kh\303\264ng \304\221\306\260\341\273\243c b\303\271.\r\n6.6. M\303\240u tr\341\272\241ng th\303\241i tr\303\252n s\306\241 \304\221\341\273\223 l\341\273\233p\r\nSau khi \304\221\304\203ng nh\341\272\255p, m\341\273\215i h\341\273\215c sinh \304\221\341\273\201u th\341\272\245y vi\341\273\201n m\303\240u tr\341\272\241ng th\303\241i c\341\273\247a c\341\272\243 l\341\273\233p (theo y\303\252u c\341\272\247u ch\341\273\247 d\341\273\261 \303\241n). Ch\341\273\211 th\341\272\245y m\341\273\251c m\303\240u, kh\303\264ng th\341\272\245y l\303\275 do hay \304\221i\341\273\203m c\341\273\247a b\341\272\241n kh\303\241c. GV c\303\263 c\303\264ng t\341\272\257c \342\200\234H\341\273\215c sinh th\341\272\245y m\303\240u c\341\273\247a: C\341\272\243 l\341\273\233p / Ch\341\273\211 b\341\272\243n th\303\242n\342\200\235; m\341\272\267c \304\221\341\273\213nh \342\200\234C\341\272\243 l\341\273\233p\342\200\235.\r\nM\341\273\251c\tVi\341\273\201n\t\304\220i\341\273\201u ki\341\273\207n m\341\272\267c \304\221\341\273\213nh (GV ch\341\273\211nh)\tGhi ch\303\272\r\nB\303\254nh th\306\260\341\273\235ng\tX\303\241m\tCh\306\260a c\303\263 \304\221i\341\273\203m tr\341\273\253 trong tu\341\272\247n\tM\341\272\267c \304\221\341\273\213nh c\341\273\247a tu\341\272\247n m\341\273\233i\r\nNh\341\272\257c nh\341\273\237\tV\303\240ng\tC\303\263 \304\221i\341\273\203m tr\341\273\253 t\341\273\253 1 \304\221\341\272\277n d\306\260\341\273\233i 10 \304\221i\341\273\203m\tK\303\250m bi\341\273\203u t\306\260\341\273\243ng d\341\272\245u ch\341\272\245m than nh\341\273\217\r\nC\341\272\247n l\306\260u \303\275\t\304\220\341\273\217\tT\341\273\253 10 \304\221i\341\273\203m tr\341\273\253 tr\341\273\237 l\303\252n, ho\341\272\267c c\303\263 m\341\273\231t l\341\273\227i m\341\273\251c \342\200\234N\341\272\267ng\342\200\235\tK\303\250m bi\341\273\203u t\306\260\341\273\243ng c\341\272\243nh b\303\241o\r\nT\303\255ch c\341\273\261c\tXanh l\303\241\tCh\341\273\211 xu\341\272\245t hi\341\273\207n khi b\341\272\255t \304\221i\341\273\203m c\341\273\231ng v\303\240 c\303\263 \304\221i\341\273\203m c\341\273\231ng r\303\262ng\tK\303\250m bi\341\273\203u t\306\260\341\273\243ng d\341\272\245u t\303\255ch\r\n\r\nM\341\273\227i n\341\273\231i quy c\303\263 c\341\273\231t MucDo (Nh\341\272\271 / V\341\273\253a / N\341\272\267ng) \304\221\341\273\203 m\341\273\231t l\341\273\227i n\341\272\267ng c\303\263 th\341\273\203 chuy\341\273\203n \304\221\341\273\217 ngay m\303\240 kh\303\264ng c\341\272\247n t\303\255ch lu\341\273\271. Kh\303\264ng ch\341\273\211 d\303\271ng m\303\240u \304\221\341\273\203 ph\303\242n bi\341\273\207t: th\303\252m bi\341\273\203u t\306\260\341\273\243ng nh\341\273\217 ho\341\272\267c ki\341\273\203u vi\341\273\201n (n\303\251t \304\221\341\273\251t cho Nh\341\272\257c nh\341\273\237) \304\221\341\273\203 ng\306\260\341\273\235i kh\303\263 ph\303\242n bi\341\273\207t m\303\240u v\341\272\253n hi\341\273\203u.\r\n6.7. Gi\341\272\243i tr\303\254nh v\303\240 x\341\273\255 l\303\275\r\n\342\200\242\tT\341\272\241i m\341\273\227i d\303\262ng l\341\273\227i c\341\273\247a m\303\254nh, h\341\273\215c sinh c\303\263 n\303\272t \342\200\234Gi\341\272\243i tr\303\254nh\342\200\235 (t\341\273\221i \304\221a 300 k\303\275 t\341\273\261, h\341\272\241n g\341\273\255i m\341\272\267c \304\221\341\273\213nh 7 ng\303\240y sau ng\303\240y ghi, GV ch\341\273\211nh \304\221\306\260\341\273\243c).\r\n\342\200\242\tTr\341\272\241ng th\303\241i: Hi\341\273\207u l\341\273\261c \342\206\222 Ch\341\273\235 duy\341\273\207t \342\206\222 Ch\341\272\245p nh\341\272\255n (\304\221i\341\273\203m b\341\273\213 h\341\273\247y) ho\341\272\267c T\341\273\253 ch\341\273\221i (b\341\272\257t bu\341\273\231c ghi l\303\275 do). Ng\306\260\341\273\235i duy\341\273\207t m\341\272\267c \304\221\341\273\213nh l\303\240 GV; GV c\303\263 th\341\273\203 giao quy\341\273\201n duy\341\273\207t cho m\341\273\231t s\341\273\221 Ban c\303\241n s\341\273\261.\r\n\342\200\242\tTh\303\264ng b\303\241o trong \341\273\251ng d\341\273\245ng b\341\272\261ng ch\341\272\245m \304\221\341\273\217 tr\303\252n tab v\303\240 m\341\273\245c \342\200\234Vi\341\273\207c c\341\272\247n x\341\273\255 l\303\275\342\200\235 (kh\303\264ng c\341\272\247n th\303\264ng b\303\241o \304\221\341\272\251y). GV c\303\263 tu\341\273\263 ch\341\273\215n nh\341\272\255n email t\303\263m t\341\272\257t h\341\272\261ng ng\303\240y.\r\n\342\200\242\tM\341\273\215i thay \304\221\341\273\225i \304\221\341\273\201u ghi nh\341\272\255t k\303\275; kh\303\264ng xo\303\241 d\341\273\257 li\341\273\207u, ch\341\273\211 chuy\341\273\203n tr\341\272\241ng th\303\241i.\r\n7. M\303\240n h\303\254nh v\303\240 \304\221i\341\273\201u h\306\260\341\273\233ng theo vai tr\303\262\r\n7.1. H\341\273\215c sinh (\304\221\306\241n gi\341\272\243n t\341\273\221i \304\221a)\r\nThanh tab d\306\260\341\273\233i c\303\271ng g\341\273\223m 3 m\341\273\245c. \304\220\341\272\247u trang: t\303\252n l\341\273\233p, tu\341\272\247n h\341\273\215c, menu t\303\240i kho\341\272\243n (\304\220\341\273\225i m\341\272\255t kh\341\272\251u, Giao di\341\273\207n S\303\241ng/T\341\273\221i/Theo h\341\273\207 th\341\273\221ng, \304\220\304\203ng xu\341\272\245t).\r\nTab\tN\341\273\231i dung\r\nC\341\273\247a t\303\264i\tTh\341\272\273 \304\221i\341\273\203m tu\341\272\247n (\304\221i\341\273\203m, t\341\273\225ng tr\341\273\253, x\341\272\277p lo\341\272\241i d\341\273\261 ki\341\272\277n); danh s\303\241ch l\341\273\227i theo tu\341\272\247n v\341\273\233i n\303\272t \342\200\234Gi\341\272\243i tr\303\254nh\342\200\235 v\303\240 tr\341\272\241ng th\303\241i; kh\303\264ng c\303\263 g\303\254 kh\303\241c.\r\nS\306\241 \304\221\341\273\223\tS\306\241 \304\221\341\273\223 l\341\273\233p c\303\263 vi\341\273\201n m\303\240u tr\341\272\241ng th\303\241i (M\341\273\245c 6.6), ch\341\272\241m v\303\240o \303\264 ch\341\273\211 hi\341\273\207n t\303\252n \304\221\341\272\247y \304\221\341\273\247 v\303\240 t\341\273\225. Kh\303\264ng c\303\263 d\341\273\257 li\341\273\207u chi ti\341\272\277t c\341\273\247a b\341\272\241n kh\303\241c.\r\nThi \304\221ua\tBi\341\273\203u \304\221\341\273\223 c\341\273\231t so s\303\241nh \304\221i\341\273\203m trung b\303\254nh 4 t\341\273\225 trong tu\341\272\247n, h\341\272\241ng c\341\273\247a t\341\273\225 m\303\254nh; (khi b\341\272\255t \304\221i\341\273\203m c\341\273\231ng) danh s\303\241ch tuy\303\252n d\306\260\306\241ng.\r\n\r\n7.2. Ban c\303\241n s\341\273\261\r\n\342\200\242\tC\303\263 t\341\272\245t c\341\272\243 nh\341\273\257ng g\303\254 h\341\273\215c sinh c\303\263, c\341\273\231ng th\303\252m thanh g\341\272\241t tr\303\252n c\303\271ng [C\303\241 nh\303\242n | Ghi nh\341\272\255n].\r\n\342\200\242\tGhi nh\341\272\255n: B\341\273\231 ch\341\273\215n h\341\273\215c sinh (M\341\273\245c 5) + lu\341\273\223ng ghi nh\341\272\255n (M\341\273\245c 6) + n\303\272t n\341\273\225i \342\200\234Ghi nhi\341\273\201u ng\306\260\341\273\235i\342\200\235.\r\n\342\200\242\tS\341\273\225 c\341\273\247a t\303\264i: c\303\241c l\306\260\341\273\243t m\303\254nh \304\221\303\243 ghi trong tu\341\272\247n, c\303\263 n\303\272t S\341\273\255a/H\341\273\247y c\303\262n h\341\272\241n v\303\240 \304\221\341\273\223ng h\341\273\223 \304\221\341\272\277m ng\306\260\341\273\243c th\341\273\235i h\341\272\241n.\r\n\342\200\242\tT\341\273\225ng h\341\273\243p l\341\273\233p: b\341\272\243ng x\341\272\277p h\341\272\241ng v\303\240 th\341\273\221ng k\303\252 xem tr\303\252n m\303\240n h\303\254nh. Kh\303\264ng c\303\263 n\303\272t t\341\272\243i hay sao ch\303\251p h\303\240ng lo\341\272\241t.\r\n\342\200\242\tGi\341\272\243i tr\303\254nh: ch\341\273\211 hi\341\273\207n khi \304\221\306\260\341\273\243c GV giao quy\341\273\201n duy\341\273\207t.\r\n\342\200\242\tTu\341\273\263 ch\341\273\215n c\303\241 nh\303\242n: L\306\260u nhanh m\341\273\231t ch\341\272\241m; s\341\272\257p x\341\272\277p m\341\272\267c \304\221\341\273\213nh c\341\273\247a danh s\303\241ch.\r\n7.3. Gi\303\241o vi\303\252n\r\nKhu v\341\273\261c ri\303\252ng, \304\221\304\203ng nh\341\272\255p b\341\272\261ng Google. M\303\241y t\303\255nh: thanh b\303\252n tr\303\241i c\341\273\221 \304\221\341\273\213nh. \304\220i\341\273\207n tho\341\272\241i: thanh tab d\306\260\341\273\233i c\303\271ng v\341\273\233i m\341\273\245c \342\200\234Th\303\252m\342\200\235. C\303\241c trang:\r\nTrang\tCh\341\273\251c n\304\203ng ch\303\255nh\r\nT\341\273\225ng quan\t\304\220i\341\273\203m tu\341\272\247n t\341\273\253ng t\341\273\225, s\341\273\221 b\341\272\243n ghi h\303\264m nay, vi\341\273\207c c\341\272\247n x\341\273\255 l\303\275 (gi\341\272\243i tr\303\254nh ch\341\273\235 duy\341\273\207t, b\341\272\243n ghi ch\341\273\235 x\303\241c nh\341\272\255n tr\303\271ng), c\341\272\243nh b\303\241o b\341\272\245t th\306\260\341\273\235ng.\r\nGhi nh\341\272\255n\tGi\341\273\221ng Ban c\303\241n s\341\273\261 nh\306\260ng kh\303\264ng b\341\273\213 gi\341\273\233i h\341\272\241n ph\341\272\241m vi v\303\240 nh\303\263m n\341\273\231i quy.\r\nGi\341\272\243i tr\303\254nh\tH\303\240ng \304\221\341\273\243i duy\341\273\207t, duy\341\273\207t h\303\240ng lo\341\272\241t, l\341\273\215c theo tr\341\272\241ng th\303\241i.\r\nL\341\273\233p v\303\240 S\306\241 \304\221\341\273\223\tDanh s\303\241ch h\341\273\215c sinh, t\341\273\225, vai tr\303\262; tr\303\254nh s\341\273\255a s\306\241 \304\221\341\273\223 (k\303\251o th\341\272\243); l\341\273\213ch tr\341\273\261c nh\341\272\255t.\r\nN\341\273\231i quy\tDanh m\341\273\245c nh\303\263m, h\303\240nh vi, \304\221i\341\273\203m, m\341\273\251c \304\221\341\273\231; ghim h\303\240nh vi \342\200\234Hay d\303\271ng\342\200\235; b\341\272\255t/t\341\272\257t nh\303\263m \304\220i\341\273\203m c\341\273\231ng.\r\nNh\341\272\255p d\341\273\257 li\341\273\207u\tTr\303\254nh nh\341\272\255p th\303\264ng minh (M\341\273\245c 9).\r\nXu\341\272\245t d\341\273\257 li\341\273\207u\tTr\303\254nh xu\341\272\245t tu\341\273\263 ch\341\273\215n (M\341\273\245c 8.3) v\303\240 B\303\241o c\303\241o ph\341\273\245 huynh.\r\nNh\341\272\255t k\303\275\tNh\341\272\255t k\303\275 ghi nh\341\272\255n v\303\240 nh\341\272\255t k\303\275 h\341\273\207 th\341\273\221ng, l\341\273\215c theo ng\306\260\341\273\235i, vai tr\303\262, th\341\273\235i gian, h\303\240nh \304\221\341\273\231ng, ngu\341\273\223n.\r\nT\303\240i kho\341\272\243n v\303\240 Quy\341\273\201n\tM\341\272\255t kh\341\272\251u, b\341\273\225 nhi\341\273\207m vai tr\303\262, ma tr\341\272\255n quy\341\273\201n, thi\341\272\277t b\341\273\213 \304\221\304\203ng nh\341\272\255p.\r\nC\303\240i \304\221\341\272\267t\tTo\303\240n b\341\273\231 tu\341\273\263 ch\341\273\215n \341\273\237 M\341\273\245c 8.1, sao l\306\260u, chuy\341\273\203n n\304\203m h\341\273\215c.\r\n\r\n7.4. Tr\341\272\241ng th\303\241i h\341\273\207 th\341\273\221ng\r\n\342\200\242\tC\303\263 s\341\272\265n khung ch\341\273\235 (skeleton), tr\341\272\241ng th\303\241i tr\341\273\221ng c\303\263 h\306\260\341\273\233ng d\341\272\253n m\341\273\231t d\303\262ng, th\303\264ng b\303\241o l\341\273\227i b\341\272\261ng ti\341\272\277ng Vi\341\273\207t d\341\273\205 hi\341\273\203u (\342\200\234M\341\272\245t k\341\272\277t n\341\273\221i. D\341\273\257 li\341\273\207u s\341\272\275 \304\221\306\260\341\273\243c g\341\273\255i khi c\303\263 m\341\272\241ng.\342\200\235).\r\n\342\200\242\tThanh nh\341\273\217 b\303\241o \342\200\234Ch\306\260a \304\221\341\273\223ng b\341\273\231 (n)\342\200\235 khi c\303\262n b\341\272\243n ghi trong h\303\240ng \304\221\341\273\243i ngo\341\272\241i tuy\341\272\277n.\r\n8. Khu v\341\273\261c d\303\240nh cho Gi\303\241o vi\303\252n\r\nNguy\303\252n t\341\272\257c: gi\303\241o vi\303\252n c\303\263 nhi\341\273\201u tu\341\273\263 ch\341\273\215n \304\221\341\273\203 \304\221i\341\273\201u ch\341\273\211nh theo \303\275 mu\341\273\221n; m\341\273\215i thay \304\221\341\273\225i \304\221\306\260\341\273\243c ghi v\303\240o nh\341\272\255t k\303\275 h\341\273\207 th\341\273\221ng. M\341\273\215i tu\341\273\263 ch\341\273\215n l\306\260u \341\273\237 trang 7_CauHinh v\303\240 c\303\263 gi\303\241 tr\341\273\213 m\341\272\267c \304\221\341\273\213nh h\341\273\243p l\303\275 \304\221\341\273\203 l\341\273\233p ch\341\272\241y ngay m\303\240 kh\303\264ng c\341\272\247n ch\341\273\211nh.\r\n8.1. B\341\272\243ng tu\341\273\263 ch\341\273\215n\r\nNh\303\263m\tTu\341\273\263 ch\341\273\215n\tM\341\272\267c \304\221\341\273\213nh\r\nT\303\255nh \304\221i\341\273\203m\t\304\220i\341\273\203m kh\341\273\237i \304\221\341\272\247u m\341\273\227i tu\341\272\247n; tr\341\272\247n/s\303\240n \304\221i\341\273\203m; ng\306\260\341\273\241ng x\341\272\277p lo\341\272\241i; c\303\241ch x\341\272\277p h\341\272\241ng t\341\273\225 (trung b\303\254nh/t\341\273\225ng); b\341\272\243n ghi ch\341\273\235 gi\341\272\243i tr\303\254nh c\303\263 t\303\255nh \304\221i\341\273\203m kh\303\264ng\t100; kh\303\264ng tr\341\272\247n; T\341\273\221t \342\211\24590, Kh\303\241 \342\211\24575, \304\220\341\272\241t \342\211\24560; trung b\303\254nh; c\303\263 t\303\255nh\r\n\304\220i\341\273\203m c\341\273\231ng\tB\341\272\255t \304\221i\341\273\203m c\341\273\231ng; b\341\272\255t \304\221i\341\273\203m th\306\260\341\273\237ng g\341\273\241 l\341\273\227i; tr\341\272\247n b\303\271; danh s\303\241ch l\341\273\227i kh\303\264ng \304\221\306\260\341\273\243c b\303\271; b\341\272\255t m\303\240n h\303\254nh tuy\303\252n d\306\260\306\241ng\tT\341\272\256T\r\nC\341\272\243nh b\303\241o tr\303\271ng\tB\341\272\255t/t\341\272\257t; t\341\273\253 l\341\272\247n th\341\273\251 m\341\272\245y trong bu\341\273\225i; \303\241p d\341\273\245ng cho \304\221i\341\273\203m c\341\273\231ng; m\341\273\221c gi\341\273\235 bu\341\273\225i s\303\241ng/chi\341\273\201u\tB\341\272\255t; t\341\273\253 l\341\272\247n 2; kh\303\264ng; S\303\241ng 06:30\342\200\22311:30, Chi\341\273\201u 12:30\342\200\22317:30\r\nQuy\341\273\201n ghi\tTh\341\273\235i h\341\272\241n s\341\273\255a/h\341\273\247y c\341\273\247a ng\306\260\341\273\235i ghi; T\341\273\225 tr\306\260\341\273\237ng \304\221\306\260\341\273\243c t\341\273\261 ch\341\272\245m m\303\254nh; ma tr\341\272\255n vai tr\303\262 \303\227 nh\303\263m n\341\273\231i quy \303\227 ph\341\272\241m vi; kill switch t\341\272\241m kho\303\241 ghi nh\341\272\255n to\303\240n l\341\273\233p\t24 gi\341\273\235; kh\303\264ng; theo M\341\273\245c 3.1; t\341\272\257t\r\nHi\341\273\203n th\341\273\213 cho h\341\273\215c sinh\tH\341\273\215c sinh th\341\272\245y m\303\240u c\341\273\247a c\341\272\243 l\341\273\233p hay ch\341\273\211 b\341\272\243n th\303\242n; c\303\263 hi\341\273\207n h\341\272\241ng c\341\273\247a t\341\273\253ng t\341\273\225 kh\303\264ng; hi\341\273\207n t\303\252n \304\221\341\272\247y \304\221\341\273\247 hay r\303\272t g\341\273\215n tr\303\252n s\306\241 \304\221\341\273\223\tC\341\272\243 l\341\273\233p; c\303\263; r\303\272t g\341\273\215n\r\nM\303\240u tr\341\272\241ng th\303\241i\tNg\306\260\341\273\241ng \304\221i\341\273\203m tr\341\273\253 cho V\303\240ng v\303\240 \304\220\341\273\217; l\341\273\227i m\341\273\251c N\341\272\267ng chuy\341\273\203n \304\221\341\273\217 ngay\t\342\211\2451 v\303\240ng; \342\211\24510 ho\341\272\267c l\341\273\227i N\341\272\267ng \304\221\341\273\217\r\nGi\341\272\243i tr\303\254nh\tH\341\272\241n g\341\273\255i (ng\303\240y); ng\306\260\341\273\235i duy\341\273\207t (GV ho\341\272\267c BCS \304\221\306\260\341\273\243c giao); b\341\272\257t bu\341\273\231c l\303\275 do khi t\341\273\253 ch\341\273\221i\t7 ng\303\240y; GV; c\303\263\r\nPhi\303\252n \304\221\304\203ng nh\341\272\255p\tTh\341\273\235i h\341\272\241n phi\303\252n h\341\273\215c sinh/BCS; s\341\273\221 l\341\272\247n sai tr\306\260\341\273\233c khi kho\303\241; th\341\273\235i gian kho\303\241; t\341\273\261 kho\303\241 m\303\240n h\303\254nh Ban c\303\241n s\341\273\261 sau N ph\303\272t kh\303\264ng thao t\303\241c\t30 ng\303\240y; 5; 15 ph\303\272t; t\341\272\257t\r\nTu\341\272\247n h\341\273\215c\tNg\303\240y b\341\272\257t \304\221\341\272\247u n\304\203m h\341\273\215c; tu\341\272\247n ngh\341\273\211; ch\341\273\221t tu\341\272\247n th\341\273\247 c\303\264ng hay t\341\273\261 \304\221\341\273\231ng\tTh\341\273\247 c\303\264ng\r\nB\303\241o c\303\241o ph\341\273\245 huynh\tM\341\272\253u tin nh\341\272\257n (c\303\263 bi\341\272\277n {HoTen}, {Tuan}, {Diem}, {XepLoai}, {DanhSachLoi}); logo, t\303\252n tr\306\260\341\273\235ng, t\303\252n l\341\273\233p; c\341\273\241 v\303\240 b\341\273\221 c\341\273\245c th\341\272\273 \341\272\243nh\tM\341\272\253u s\341\272\265n c\303\263\r\nNh\341\272\255n d\341\272\241ng n\303\242ng cao\tB\341\272\255t nh\341\272\255n d\341\272\241ng b\341\272\261ng Gemini cho v\304\203n b\341\272\243n/\341\272\243nh kh\303\263 (M\341\273\245c 9)\tT\341\272\256T (k\303\250m c\341\272\243nh b\303\241o quy\341\273\201n ri\303\252ng t\306\260)\r\nGiao di\341\273\207n\tT\303\252n \341\273\251ng d\341\273\245ng, logo, m\303\240u nh\341\272\245n (ch\341\273\215n trong b\341\272\243ng m\303\240u \304\221\303\243 ki\341\273\203m tra t\306\260\306\241ng ph\341\272\243n), giao di\341\273\207n m\341\272\267c \304\221\341\273\213nh S\303\241ng/T\341\273\221i/Theo h\341\273\207 th\341\273\221ng\tTheo h\341\273\207 th\341\273\221ng\r\n\r\n8.2. Nh\341\272\255p d\341\273\257 li\341\273\207u (ch\341\273\211 gi\303\241o vi\303\252n)\r\n\342\200\242\tNh\341\272\255p danh s\303\241ch l\341\273\233p, th\303\240nh vi\303\252n t\341\273\225, vai tr\303\262, s\306\241 \304\221\341\273\223 l\341\273\233p, danh m\341\273\245c n\341\273\231i quy, l\341\273\213ch tr\341\273\261c nh\341\272\255t, b\341\272\243n ghi thi \304\221ua c\305\251, b\341\272\243n sao l\306\260u.\r\n\342\200\242\tNgu\341\273\223n: d\303\241n v\304\203n b\341\272\243n, t\341\273\207p .xlsx, .csv, .docx, .txt, .json, \341\272\243nh .jpg/.png. Chi ti\341\272\277t c\303\241ch nh\341\272\255n d\341\272\241ng \341\273\237 M\341\273\245c 9.\r\n\342\200\242\tM\341\273\227i l\341\272\247n nh\341\272\255p l\303\240 m\341\273\231t l\303\264 c\303\263 m\303\243 (MaLoNhap): xem tr\306\260\341\273\233c, s\341\273\255a, x\303\241c nh\341\272\255n, v\303\240 ho\303\240n t\303\241c nguy\303\252n l\303\264 n\341\272\277u nh\341\272\247m.\r\n8.3. Xu\341\272\245t d\341\273\257 li\341\273\207u (ch\341\273\211 gi\303\241o vi\303\252n)\r\nTr\303\254nh xu\341\272\245t d\341\272\241ng t\341\273\253ng b\306\260\341\273\233c, cho ph\303\251p ch\341\273\215n g\341\272\247n nh\306\260 m\341\273\215i th\341\273\251:\r\n\342\200\242\tLo\341\272\241i d\341\273\257 li\341\273\207u: danh s\303\241ch l\341\273\233p; nh\341\272\255t k\303\275 thi \304\221ua; b\303\241o c\303\241o tu\341\272\247n/th\303\241ng/k\341\273\263; gi\341\272\243i tr\303\254nh; nh\341\272\255t k\303\275 h\341\273\207 th\341\273\221ng; danh m\341\273\245c n\341\273\231i quy; s\306\241 \304\221\341\273\223 l\341\273\233p; ph\303\242n quy\341\273\201n.\r\n\342\200\242\tK\341\273\263 th\341\273\235i gian: tu\341\272\247n, th\303\241ng, h\341\273\215c k\341\273\263, c\341\272\243 n\304\203m, ho\341\272\267c kho\341\272\243ng ng\303\240y tu\341\273\263 ch\341\273\215n.\r\n\342\200\242\tPh\341\272\241m vi: c\341\272\243 l\341\273\233p, m\341\273\231t t\341\273\225, m\341\273\231t ho\341\272\267c nhi\341\273\201u h\341\273\215c sinh, theo ng\306\260\341\273\235i ghi, theo nh\303\263m n\341\273\231i quy, theo tr\341\272\241ng th\303\241i.\r\n\342\200\242\tC\341\273\231t c\341\272\247n xu\341\272\245t: t\303\255ch ch\341\273\215n t\341\273\253ng c\341\273\231t v\303\240 k\303\251o \304\221\341\273\203 \304\221\341\273\225i th\341\273\251 t\341\273\261. C\303\263 nh\303\263m c\341\273\231t \342\200\234Ngu\341\273\223n g\341\273\221c d\341\273\257 li\341\273\207u\342\200\235: ng\306\260\341\273\235i nh\341\272\255p, vai tr\303\262 ng\306\260\341\273\235i nh\341\272\255p, th\341\273\235i gian ghi (m\303\241y ch\341\273\247 v\303\240 m\303\241y), ngu\341\273\223n (tr\341\273\261c ti\341\272\277p / ngo\341\272\241i tuy\341\272\277n / nh\341\272\255p t\341\273\207p / nh\341\272\255p v\304\203n b\341\272\243n), lo\341\272\241i thi\341\272\277t b\341\273\213, m\303\243 l\303\264 nh\341\272\255p, ng\306\260\341\273\235i duy\341\273\207t, l\303\275 do h\341\273\247y. Nh\341\273\235 \304\221\303\263 xu\341\272\245t \304\221\306\260\341\273\243c \342\200\234l\341\273\213ch s\341\273\255 nh\341\272\255p d\341\273\257 li\341\273\207u, ai l\303\240 ng\306\260\341\273\235i nh\341\272\255p\342\200\235.\r\n\342\200\242\t\304\220\341\273\213nh d\341\272\241ng: .xlsx, .csv, .json, .pdf (b\341\272\243ng in), \341\272\243nh th\341\272\273 b\303\241o c\303\241o (xu\341\272\245t c\341\272\243 l\341\273\233p th\303\240nh m\341\273\231t t\341\273\207p .zip).\r\n\342\200\242\tXem tr\306\260\341\273\233c 20 d\303\262ng tr\306\260\341\273\233c khi xu\341\272\245t; l\306\260u th\303\240nh \342\200\234M\341\272\253u xu\341\272\245t\342\200\235 \304\221\341\273\203 d\303\271ng l\341\272\241i b\341\272\261ng m\341\273\231t ch\341\272\241m.\r\n\342\200\242\tB\303\241o c\303\241o ph\341\273\245 huynh: t\341\272\241o th\341\272\273 \341\272\243nh cho t\341\273\253ng em (h\341\273\215 t\303\252n, t\341\273\225, \304\221i\341\273\203m tu\341\272\247n, x\341\272\277p lo\341\272\241i, l\341\273\227i c\341\272\247n kh\341\272\257c ph\341\273\245c), tin nh\341\272\257n m\341\272\253u c\303\263 n\303\272t \342\200\234Sao ch\303\251p\342\200\235, n\303\272t m\341\273\237 zalo.me/S\304\220T ho\341\272\267c chia s\341\272\273 h\341\273\207 th\341\273\221ng. M\341\273\227i th\341\272\273 ch\341\273\211 ch\341\273\251a d\341\273\257 li\341\273\207u c\341\273\247a \304\221\303\272ng em \304\221\303\263.\r\n\342\200\242\tM\341\272\255t kh\341\272\251u v\303\240 mu\341\273\221i kh\303\264ng bao gi\341\273\235 n\341\272\261m trong b\341\272\245t k\341\273\263 t\341\273\207p xu\341\272\245t n\303\240o.\r\n\342\200\242\tM\341\273\227i l\341\272\247n xu\341\272\245t \304\221\306\260\341\273\243c ghi v\303\240o nh\341\272\255t k\303\275 h\341\273\207 th\341\273\221ng: ai xu\341\272\245t, l\303\272c n\303\240o, lo\341\272\241i d\341\273\257 li\341\273\207u, b\341\273\231 l\341\273\215c, s\341\273\221 d\303\262ng.\r\nKho\303\241 ch\341\273\251c n\304\203ng xu\341\272\245t: n\303\272t xu\341\272\245t, nh\341\272\255p, t\341\272\243i v\341\273\201 ch\341\273\211 \304\221\306\260\341\273\243c d\341\273\261ng khi vai tr\303\262 l\303\240 GV; \304\221\341\273\223ng th\341\273\235i c\303\241c l\341\273\207nh export*, import* \341\273\237 m\303\241y ch\341\273\247 t\341\273\253 ch\341\273\221i v\341\273\233i m\303\243 FORBIDDEN n\341\272\277u token kh\303\264ng thu\341\273\231c GV.\r\n8.4. T\303\255nh n\304\203ng qu\341\272\243n tr\341\273\213 \304\221\341\272\267c bi\341\273\207t\r\n\342\200\242\tQu\341\272\243n l\303\275 t\303\240i kho\341\272\243n: \304\221\341\272\267t l\341\272\241i m\341\272\255t kh\341\272\251u m\341\273\231t em ho\341\272\267c c\341\272\243 l\341\273\233p, in phi\341\272\277u m\341\272\255t kh\341\272\251u; kho\303\241/m\341\273\237 kho\303\241 t\303\240i kho\341\272\243n; bu\341\273\231c \304\221\304\203ng xu\341\272\245t; xem v\303\240 thu h\341\273\223i thi\341\272\277t b\341\273\213 \304\221\304\203ng nh\341\272\255p.\r\n\342\200\242\tB\341\273\225 nhi\341\273\207m vai tr\303\262 c\303\263 ng\303\240y hi\341\273\207u l\341\273\261c (khi b\341\272\247u l\341\272\241i ban c\303\241n s\341\273\261), l\341\273\213ch s\341\273\255 thay \304\221\341\273\225i vai tr\303\262.\r\n\342\200\242\tCh\341\273\221t k\341\273\263: ch\341\273\221t tu\341\272\247n/th\303\241ng/k\341\273\263 th\303\254 kho\303\241 s\341\273\225; m\341\273\237 l\341\272\241i ph\341\272\243i nh\341\272\255p l\303\275 do.\r\n\342\200\242\tS\341\273\255a/h\341\273\247y m\341\273\215i b\341\272\243n ghi (b\341\272\257t bu\341\273\231c ghi l\303\275 do). Th\303\271ng r\303\241c ch\341\273\251a b\341\272\243n ghi \304\221\303\243 h\341\273\247y, cho kh\303\264i ph\341\273\245c.\r\n\342\200\242\tS\341\273\255a h\303\240ng lo\341\272\241t: \304\221\341\273\225i t\341\273\225, \304\221\341\273\225i ch\341\273\227 ng\341\273\223i, \304\221\341\273\225i vai tr\303\262 cho nhi\341\273\201u em.\r\n\342\200\242\tDuy\341\273\207t gi\341\272\243i tr\303\254nh h\303\240ng lo\341\272\241t.\r\n\342\200\242\tXem th\341\273\255 nh\306\260 vai tr\303\262 kh\303\241c (ch\341\273\211 xem, kh\303\264ng s\341\273\255a) \304\221\341\273\203 ki\341\273\203m tra t\341\273\253ng vai tr\303\262 th\341\272\245y g\303\254.\r\n\342\200\242\tC\341\272\243nh b\303\241o b\341\272\245t th\306\260\341\273\235ng: ng\306\260\341\273\235i ghi qu\303\241 nhi\341\273\201u trong ng\303\240y; ch\341\273\211 c\341\273\231ng/tr\341\273\253 cho v\303\240i b\341\272\241n c\341\273\221 \304\221\341\273\213nh; ghi ngo\303\240i gi\341\273\235 h\341\273\215c; b\341\272\243n ghi b\341\273\213 h\341\273\247y nhi\341\273\201u.\r\n\342\200\242\tSao l\306\260u t\341\273\261 \304\221\341\273\231ng h\341\272\261ng ng\303\240y v\303\240o Google Drive, kh\303\264i ph\341\273\245c t\341\273\253 b\341\272\243n sao l\306\260u; chuy\341\273\203n n\304\203m h\341\273\215c (l\306\260u tr\341\273\257 n\304\203m c\305\251, gi\341\273\257 danh s\303\241ch l\341\273\233p).\r\n\342\200\242\tB\341\272\243ng tin l\341\273\233p: th\303\264ng b\303\241o c\303\263 ghim, hi\341\273\203n th\341\273\213 \341\273\237 m\303\240n h\303\254nh ch\303\255nh c\341\273\247a h\341\273\215c sinh.\r\n\342\200\242\tKho\303\241 kh\341\272\251n c\341\272\245p: t\341\272\241m d\341\273\253ng ghi nh\341\272\255n to\303\240n l\341\273\233p b\341\272\261ng m\341\273\231t c\303\264ng t\341\272\257c.\r\n9. Tr\303\254nh nh\341\272\255p th\303\264ng minh (nh\341\272\255n d\341\272\241ng v\304\203n b\341\272\243n g\341\273\255i v\303\240o)\r\nGi\303\241o vi\303\252n c\303\263 th\341\273\203 d\303\241n v\304\203n b\341\272\243n ho\341\272\267c t\341\272\243i t\341\273\207p v\303\240o, h\341\273\207 th\341\273\221ng nh\341\272\255n d\341\272\241ng v\303\240 bi\341\272\277n th\303\240nh d\341\273\257 li\341\273\207u \304\221\341\273\203 hi\341\273\203n th\341\273\213 trong \341\273\251ng d\341\273\245ng ho\341\272\267c xu\341\272\245t ra t\341\273\207p. Ch\341\273\211 gi\303\241o vi\303\252n \304\221\306\260\341\273\243c d\303\271ng. Kh\303\264ng bao gi\341\273\235 t\341\273\261 ghi v\303\240o s\341\273\225: m\341\273\215i k\341\272\277t qu\341\272\243 \304\221\341\273\201u \304\221i qua b\306\260\341\273\233c xem tr\306\260\341\273\233c v\303\240 x\303\241c nh\341\272\255n.\r\n9.1. C\303\241c lo\341\272\241i v\304\203n b\341\272\243n c\341\272\247n nh\341\272\255n d\341\272\241ng\r\nLo\341\272\241i\tV\303\255 d\341\273\245 \304\221\341\272\247u v\303\240o\tK\341\272\277t qu\341\272\243\r\nDanh s\303\241ch l\341\273\233p\tB\341\272\243ng c\303\263 c\341\273\231t H\341\273\215 t\303\252n, T\341\273\225, S\304\220T ph\341\273\245 huynh; ho\341\272\267c m\341\273\227i d\303\262ng m\341\273\231t t\303\252n\tC\341\272\255p nh\341\272\255t 1_DanhSachLop\r\nTh\303\240nh vi\303\252n t\341\273\225\tT\341\273\225 1: Nguy\341\273\205n V\304\203n A, Tr\341\272\247n Th\341\273\213 B, \342\200\246 ho\341\272\267c b\341\272\243ng c\341\273\231t T\341\273\225\tG\303\241n t\341\273\225 cho h\341\273\215c sinh\r\nS\306\241 \304\221\341\273\223 l\341\273\233p\tB\341\272\243ng Word d\341\272\241ng l\306\260\341\273\233i, m\341\273\227i \303\264 l\303\240 m\341\273\231t t\303\252n; c\303\263 d\303\262ng \342\200\234D\303\243y 1\342\200\246D\303\243y 4\342\200\235, \342\200\234B\303\240n gi\303\241o vi\303\252n\342\200\235, \342\200\234C\341\273\255a\342\200\235\tC\341\272\255p nh\341\272\255t 2_CauHinhSoDo v\303\240 t\341\273\215a \304\221\341\273\231 gh\341\272\277\r\nN\341\273\231i quy\t\304\220i mu\341\273\231n: -2, Kh\303\264ng l\303\240m b\303\240i t\341\272\255p (-3), M\341\272\245t tr\341\272\255t t\341\273\261 -1 (N\341\273\201 n\341\272\277p)\tC\341\272\255p nh\341\272\255t 3_DanhMucNoiQuy\r\nS\341\273\225 vi ph\341\272\241m d\341\272\241ng v\304\203n b\341\272\243n\t10/11 \342\200\223 S\303\241ng: Huy \304\221i mu\341\273\231n; Mai kh\303\264ng \304\221\341\273\223ng ph\341\273\245c\tT\341\272\241o c\303\241c b\341\272\243n ghi nh\303\241p \304\221\341\273\203 GV duy\341\273\207t (ngu\341\273\223n = nh\341\272\255p v\304\203n b\341\272\243n)\r\nL\341\273\213ch tr\341\273\261c nh\341\272\255t\tB\341\272\243ng th\341\273\251 \303\227 t\341\273\225\tC\341\272\255p nh\341\272\255t 10_LichTrucNhat\r\n\r\n9.2. Quy tr\303\254nh x\341\273\255 l\303\275\r\n\342\200\242\tB\306\260\341\273\233c 1 \342\200\223 Thu nh\341\272\255n: d\303\241n v\304\203n b\341\272\243n; d\303\241n t\341\273\253 Word (\304\221\341\273\215c HTML t\341\273\253 clipboard \304\221\341\273\203 gi\341\273\257 b\341\272\243ng); t\341\272\243i .docx (mammoth), .xlsx/.csv (SheetJS), .txt, .json, ho\341\272\267c \341\272\243nh ch\341\273\245p.\r\n\342\200\242\tB\306\260\341\273\233c 2 \342\200\223 Chu\341\272\251n ho\303\241: b\341\273\217 d\341\272\245u, h\341\272\241 ch\341\273\257 th\306\260\341\273\235ng, g\341\273\231p kho\341\272\243ng tr\341\272\257ng \304\221\341\273\203 so kh\341\273\233p; gi\341\273\257 b\341\272\243n g\341\273\221c \304\221\341\273\203 hi\341\273\203n th\341\273\213.\r\n\342\200\242\tB\306\260\341\273\233c 3 \342\200\223 Nh\341\272\255n d\341\272\241ng b\341\272\261ng quy t\341\272\257c c\341\273\245c b\341\273\231: \304\221o\303\241n lo\341\272\241i d\341\273\257 li\341\273\207u theo t\341\273\253 kho\303\241 v\303\240 c\341\272\245u tr\303\272c; t\303\241ch d\303\262ng, t\303\241ch b\341\272\243ng, t\303\241ch \342\200\234t\303\252n \342\200\223 h\303\240nh vi \342\200\223 \304\221i\341\273\203m \342\200\223 ng\303\240y \342\200\223 bu\341\273\225i\342\200\235.\r\n\342\200\242\tB\306\260\341\273\233c 4 \342\200\223 Nh\341\272\255n d\341\272\241ng n\303\242ng cao (tu\341\273\263 ch\341\273\215n, m\341\272\267c \304\221\341\273\213nh t\341\272\257t): khi quy t\341\272\257c c\341\273\245c b\341\273\231 kh\303\264ng \304\221\341\273\247 tin c\341\272\255y ho\341\272\267c \304\221\341\272\247u v\303\240o l\303\240 \341\272\243nh, giao di\341\273\207n g\341\273\255i l\303\252n Apps Script, Apps Script g\341\273\215i Gemini v\303\240 y\303\252u c\341\272\247u tr\341\272\243 v\341\273\201 JSON theo l\306\260\341\273\243c \304\221\341\273\223 c\341\273\221 \304\221\341\273\213nh. Kho\303\241 API ch\341\273\211 n\341\272\261m \341\273\237 m\303\241y ch\341\273\247. Khi GV b\341\272\255t l\341\272\247n \304\221\341\272\247u ph\341\272\243i hi\341\273\207n c\341\272\243nh b\303\241o: t\303\252n h\341\273\215c sinh s\341\272\275 \304\221\306\260\341\273\243c g\341\273\255i t\341\273\233i d\341\273\213ch v\341\273\245 AI c\341\273\247a Google \304\221\341\273\203 x\341\273\255 l\303\275. \341\272\242nh v\303\240 v\304\203n b\341\272\243n g\341\273\221c kh\303\264ng \304\221\306\260\341\273\243c l\306\260u l\341\272\241i sau khi x\341\273\255 l\303\275.\r\n\342\200\242\tB\306\260\341\273\233c 5 \342\200\223 Gh\303\251p t\303\252n h\341\273\215c sinh: kh\341\273\233p ch\303\255nh x\303\241c kh\303\264ng d\341\272\245u; n\341\272\277u kh\303\264ng th\303\254 kh\341\273\233p theo t\303\252n ch\303\255nh + ch\341\273\257 c\303\241i \304\221\341\272\247u h\341\273\215/\304\221\341\273\207m; n\341\272\277u v\341\272\253n kh\303\264ng th\303\254 kho\341\272\243ng c\303\241ch ch\341\273\211nh s\341\273\255a \342\211\244 2. C\303\263 nhi\341\273\201u \341\273\251ng vi\303\252n th\303\254 hi\341\273\207n danh s\303\241ch \304\221\341\273\203 ch\341\273\215n. Kh\303\264ng kh\341\273\233p th\303\254 \304\221\303\241nh d\341\272\245u \342\200\234Ch\306\260a kh\341\273\233p\342\200\235.\r\n\342\200\242\tB\306\260\341\273\233c 6 \342\200\223 Xem tr\306\260\341\273\233c: b\341\272\243ng k\341\272\277t qu\341\272\243 c\303\263 nh\303\243n \304\221\341\273\231 tin c\341\272\255y (Cao/Trung b\303\254nh/Th\341\272\245p), \303\264 n\303\240o ch\306\260a ch\341\272\257c th\303\254 t\303\264 n\341\273\225i v\303\240 cho s\341\273\255a t\341\272\241i ch\341\273\227, c\303\263 c\341\273\231t \342\200\234B\341\273\217 qua\342\200\235.\r\n\342\200\242\tB\306\260\341\273\233c 7 \342\200\223 X\303\241c nh\341\272\255n: t\341\272\241o m\341\273\231t l\303\264 nh\341\272\255p c\303\263 m\303\243; ghi nh\341\272\255t k\303\275; cho ph\303\251p ho\303\240n t\303\241c nguy\303\252n l\303\264.\r\n9.3. Y\303\252u c\341\272\247u b\341\273\225 sung\r\n\342\200\242\tC\303\263 ch\341\272\277 \304\221\341\273\231 \342\200\234Ch\341\273\211 ph\303\242n t\303\255ch, kh\303\264ng l\306\260u\342\200\235 \304\221\341\273\203 GV d\303\241n v\304\203n b\341\272\243n v\303\240 ch\341\273\211 xem b\341\272\243ng k\341\272\277t qu\341\272\243 ho\341\272\267c xu\341\272\245t ra t\341\273\207p.\r\n\342\200\242\tB\303\241o l\341\273\227i c\341\273\245 th\341\273\203 theo d\303\262ng (\342\200\234D\303\262ng 7: kh\303\264ng t\303\254m th\341\272\245y h\341\273\215c sinh \342\200\230H\303\271y\342\200\231. C\303\263 ph\341\272\243i \342\200\230Huy\342\200\231?\342\200\235).\r\n\342\200\242\tC\303\263 b\341\273\231 th\341\273\255 nghi\341\273\207m v\341\273\233i \303\255t nh\341\272\245t 10 m\341\272\253u \304\221\341\272\247u v\303\240o (g\341\273\223m l\341\273\227i ch\303\255nh t\341\272\243, vi\341\272\277t t\341\272\257t, t\303\252n tr\303\271ng) v\303\240 k\341\272\277t qu\341\272\243 mong \304\221\341\273\243i.\r\n10. Giao di\341\273\207n v\303\240 thi\341\272\277t k\341\272\277 h\303\254nh \341\272\243nh\r\nY\303\252u c\341\272\247u chung: giao di\341\273\207n ph\341\272\243i c\303\263 ch\341\272\245t l\306\260\341\273\243ng c\341\273\247a m\341\273\231t s\341\272\243n ph\341\272\251m th\306\260\306\241ng m\341\272\241i, ti\341\272\277t ch\341\272\277 v\303\240 tinh t\341\272\277, \303\255t \304\221\341\273\203 l\341\273\231 d\341\272\245u hi\341\273\207u do AI t\341\272\241o ra, \304\221\341\272\271p \341\273\237 c\341\272\243 giao di\341\273\207n S\303\241ng v\303\240 T\341\273\221i, v\303\240 kh\303\264ng bao gi\341\273\235 b\341\273\213 ch\303\254m ch\341\273\257 khi \304\221\341\273\225i giao di\341\273\207n.\r\n10.1. Phong c\303\241ch\r\n\342\200\242\tH\306\260\341\273\233ng \304\221\341\272\277n c\303\264ng c\341\273\245 qu\341\272\243n l\303\275 chuy\303\252n nghi\341\273\207p: nhi\341\273\201u kho\341\272\243ng tr\341\272\257ng, nh\341\273\213p l\306\260\341\273\233i 8 px, vi\341\273\201n m\341\272\243nh 1 px, b\303\263ng \304\221\341\273\225 r\341\272\245t nh\341\272\271 ho\341\272\267c kh\303\264ng d\303\271ng; ph\303\242n c\341\272\245p b\341\272\261ng c\341\273\241 ch\341\273\257, \304\221\341\273\231 \304\221\341\272\255m v\303\240 kho\341\272\243ng c\303\241ch thay v\303\254 m\303\240u m\303\250.\r\n\342\200\242\tM\341\273\231t m\303\240u nh\341\272\245n duy nh\341\272\245t (xanh lam \304\221\341\272\255m) cho tr\341\272\241ng th\303\241i ch\341\273\215n v\303\240 li\303\252n k\341\272\277t; n\303\272t ch\303\255nh d\303\271ng m\303\240u m\341\273\261c (g\341\272\247n \304\221en \341\273\237 S\303\241ng, g\341\272\247n tr\341\272\257ng \341\273\237 T\341\273\221i).\r\n\342\200\242\tBo g\303\263c v\341\273\253a ph\341\272\243i, \304\221\341\273\223ng nh\341\272\245t: 8 px cho n\303\272t v\303\240 \303\264 nh\341\272\255p, 12 px cho th\341\272\273 v\303\240 b\341\272\243ng thao t\303\241c, 6 px cho \303\264 gh\341\272\277.\r\n10.2. Nh\341\273\257ng d\341\272\245u hi\341\273\207u \342\200\234giao di\341\273\207n AI\342\200\235 ph\341\272\243i tr\303\241nh\r\n\342\200\242\tGradient t\303\255m\342\200\223xanh, n\341\273\201n h\303\240o quang, hi\341\273\207u \341\273\251ng k\303\255nh m\341\273\235 (glassmorphism) l\341\272\241m d\341\273\245ng, ch\341\273\257 chuy\341\273\203n m\303\240u.\r\n\342\200\242\tEmoji l\303\240m bi\341\273\203u t\306\260\341\273\243ng, bi\341\273\203u t\306\260\341\273\243ng l\341\272\245p l\303\241nh, m\341\273\215i t\341\273\253 ng\341\273\257 ki\341\273\203u \342\200\234\342\234\250 Th\303\264ng minh\342\200\235.\r\n\342\200\242\tM\341\273\215i th\341\273\251 \304\221\341\273\201u l\303\240 th\341\272\273 bo tr\303\262n c\303\263 b\303\263ng \304\221\341\273\225 \304\221\341\273\223ng lo\341\272\241t; ba th\341\272\273 gi\341\273\221ng h\341\273\207t nhau x\341\272\277p h\303\240ng l\303\240m \342\200\234t\303\255nh n\304\203ng n\341\273\225i b\341\272\255t\342\200\235; ti\303\252u \304\221\341\273\201 c\304\203n gi\341\273\257a to qu\303\241 c\341\273\241.\r\n\342\200\242\tC\303\242u ch\341\273\257 s\303\241o r\341\273\227ng (\342\200\234Ch\303\240o m\341\273\253ng b\341\272\241n \304\221\341\272\277n v\341\273\233i tr\341\272\243i nghi\341\273\207m\342\200\246\342\200\235). D\303\271ng c\303\242u ng\341\272\257n, t\341\273\261 nhi\303\252n, \304\221\303\272ng vi\341\273\207c (\342\200\234Ch\341\273\215n t\303\252n c\341\273\247a b\341\272\241n\342\200\235, \342\200\234\304\220\303\243 ghi\342\200\235, \342\200\234Ho\303\240n t\303\241c\342\200\235).\r\n\342\200\242\tBi\341\273\203u t\306\260\341\273\243ng n\303\251t kh\303\264ng \304\221\341\273\223ng nh\341\272\245t. Ch\341\273\211 d\303\271ng m\341\273\231t b\341\273\231 (lucide, n\303\251t 1.75 px) v\303\240 \304\221\341\272\267t \304\221\303\272ng k\303\255ch c\341\273\241 l\306\260\341\273\233i (16/20/24 px).\r\n10.3. Ch\341\273\257\r\n\342\200\242\tFont: Be Vietnam Pro (thi\341\272\277t k\341\272\277 cho ti\341\272\277ng Vi\341\273\207t) cho to\303\240n b\341\273\231 giao di\341\273\207n, c\303\241c \304\221\341\273\231 \304\221\341\272\255m 400, 500, 600, 700; c\303\263 ph\306\260\306\241ng \303\241n d\341\273\261 ph\303\262ng system-ui. Nh\303\272ng font v\303\240o \341\273\251ng d\341\273\245ng \304\221\341\273\203 th\341\272\273 \341\272\243nh b\303\241o c\303\241o hi\341\273\203n th\341\273\213 \304\221\303\272ng d\341\272\245u.\r\n\342\200\242\tC\341\273\241 ch\341\273\257: n\341\273\231i dung 15\342\200\22316 px; ch\303\272 th\303\255ch 12\342\200\22313 px; t\303\252n tr\303\252n \303\264 gh\341\272\277 t\341\273\221i thi\341\273\203u 12 px; ti\303\252u \304\221\341\273\201 m\303\240n h\303\254nh 20\342\200\22324 px. S\341\273\221 li\341\273\207u d\303\271ng font-variant-numeric: tabular-nums \304\221\341\273\203 c\341\273\231t s\341\273\221 th\341\272\263ng h\303\240ng.\r\n\342\200\242\tChi\341\273\201u cao d\303\262ng 1.45\342\200\2231.6 cho \304\221o\341\272\241n v\304\203n; kh\303\264ng bao gi\341\273\235 \304\221\341\273\203 ch\341\273\257 nh\341\273\217 h\306\241n 12 px.\r\n10.4. H\341\273\207 th\341\273\221ng m\303\240u b\341\272\261ng token (S\303\241ng / T\341\273\221i)\r\nM\341\273\215i m\303\240u ph\341\272\243i \304\221i qua token d\341\272\241ng bi\341\272\277n CSS v\303\240 \304\221\306\260\341\273\243c \304\221\341\273\213nh ngh\304\251a cho c\341\272\243 hai giao di\341\273\207n. C\341\272\245m vi\341\272\277t m\303\243 m\303\240u tr\341\273\261c ti\341\272\277p trong component. C\303\241c gi\303\241 tr\341\273\213 d\306\260\341\273\233i \304\221\303\242y l\303\240 \304\221i\341\273\203m kh\341\273\237i \304\221\341\272\247u, \304\221\303\243 ch\341\273\215n \304\221\341\273\203 \304\221\341\272\241t t\306\260\306\241ng ph\341\272\243n; AI Studio ph\341\272\243i t\341\273\261 ki\341\273\203m tra l\341\272\241i.\r\nToken\tS\303\241ng\tT\341\273\221i\tD\303\271ng cho\r\n--bg\t#F6F6F3\t#0E1114\tN\341\273\201n trang\r\n--surface\t#FFFFFF\t#161A1F\tTh\341\272\273, b\341\272\243ng thao t\303\241c, \303\264 nh\341\272\255p\r\n--surface-2\t#EFEFEA\t#1E242B\t\303\224 gh\341\272\277, v\303\271ng ph\341\273\245, h\303\240ng so le\r\n--border\t#DEDDD6\t#2B323A\tVi\341\273\201n m\341\272\243nh\r\n--text\t#15191E\t#ECEFF3\tCh\341\273\257 ch\303\255nh\r\n--text-muted\t#565D66\t#A2ABB6\tCh\341\273\257 ph\341\273\245, ch\303\272 th\303\255ch\r\n--accent\t#2457D6\t#7AA2F7\tTr\341\272\241ng th\303\241i ch\341\273\215n, li\303\252n k\341\272\277t, v\303\262ng focus\r\n--on-accent\t#FFFFFF\t#0B1220\tCh\341\273\257 tr\303\252n n\341\273\201n m\303\240u nh\341\272\245n\r\n--primary\t#15191E\t#ECEFF3\tN\341\273\201n n\303\272t ch\303\255nh\r\n--on-primary\t#FFFFFF\t#0E1114\tCh\341\273\257 tr\303\252n n\303\272t ch\303\255nh\r\n--st-ok\t#1B7F4B\t#4ADE80\tVi\341\273\201n T\303\255ch c\341\273\261c\r\n--st-none\t#9AA1AB\t#6B7480\tVi\341\273\201n B\303\254nh th\306\260\341\273\235ng\r\n--st-warn\t#C98A0B\t#F2C14E\tVi\341\273\201n Nh\341\272\257c nh\341\273\237\r\n--st-bad\t#C62828\t#FF6B6B\tVi\341\273\201n C\341\272\247n l\306\260u \303\275, n\303\272t nguy hi\341\273\203m\r\n\r\nM\303\240u vai tr\303\262 \341\273\237 M\341\273\245c 3.4 c\305\251ng l\303\240 token (--role-lt, --role-tt, --role-ht, --role-ld, --role-bt, --role-gv, m\341\273\227i m\303\240u c\303\263 c\341\272\267p -fg v\303\240 -bg).\r\n10.5. Quy t\341\272\257c ch\341\273\221ng ch\303\254m ch\341\273\257 khi \304\221\341\273\225i giao di\341\273\207n\r\n\342\200\242\tM\341\273\227i n\341\273\201n c\303\263 ch\341\273\257 \304\221i k\303\250m theo c\341\272\267p token (--surface \304\221i v\341\273\233i --text; --accent \304\221i v\341\273\233i --on-accent). Kh\303\264ng vi\341\272\277t ch\341\273\257 tr\341\272\257ng hay \304\221en c\341\273\221 \304\221\341\273\213nh.\r\n\342\200\242\tT\341\273\211 l\341\273\207 t\306\260\306\241ng ph\341\272\243n t\341\273\221i thi\341\273\203u (WCAG AA): ch\341\273\257 th\306\260\341\273\235ng 4.5:1, ch\341\273\257 l\341\273\233n t\341\273\253 18 px \304\221\341\272\255m 3:1, vi\341\273\201n tr\341\272\241ng th\303\241i v\303\240 bi\341\273\203u t\306\260\341\273\243ng 3:1 so v\341\273\233i n\341\273\201n ngay sau ch\303\272ng. Ph\341\272\243i ki\341\273\203m tra b\341\272\261ng c\303\264ng c\341\273\245 cho c\341\272\243 hai giao di\341\273\207n, \304\221\341\272\267c bi\341\273\207t: ch\341\273\257 tr\303\252n \303\264 gh\341\272\277, chip vai tr\303\262, ch\341\273\257 ph\341\273\245, \303\264 nh\341\272\255p \304\221ang t\341\272\257t, n\303\272t b\341\273\213 v\303\264 hi\341\273\207u ho\303\241.\r\n\342\200\242\tKh\303\264ng d\303\271ng \304\221\341\273\231 trong su\341\273\221t (opacity) \304\221\341\273\203 t\341\272\241o ch\341\273\257 ph\341\273\245; d\303\271ng --text-muted. \303\224 gh\341\272\277 b\341\273\213 kho\303\241 ph\341\272\241m vi t\341\273\225: n\341\273\201n v\303\240 ch\341\273\257 \304\221\341\273\201u chuy\341\273\203n x\303\241m nh\306\260ng ch\341\273\257 v\341\272\253n \304\221\341\272\241t 3:1 (\304\221\341\273\231 m\341\273\235 30% ch\341\273\211 \303\241p cho vi\341\273\201n v\303\240 n\341\273\201n, kh\303\264ng \303\241p cho ch\341\273\257 n\341\272\277u l\303\240m ch\341\273\257 t\341\273\245t d\306\260\341\273\233i ng\306\260\341\273\241ng).\r\n\342\200\242\tGiao di\341\273\207n T\341\273\221i: kh\303\264ng d\303\271ng \304\221en thu\341\272\247n hay tr\341\272\257ng thu\341\272\247n; thay b\303\263ng \304\221\341\273\225 b\341\272\261ng vi\341\273\201n m\341\272\243nh; vi\341\273\201n tr\341\272\241ng th\303\241i d\303\271ng b\341\272\243n s\303\241ng h\306\241n \304\221\303\243 khai b\303\241o.\r\n\342\200\242\tBi\341\273\203u t\306\260\341\273\243ng v\303\240 h\303\254nh SVG d\303\271ng currentColor. Kh\303\264ng \304\221\341\272\267t ch\341\273\257 l\303\252n \341\272\243nh n\341\273\201n. Kh\303\264ng c\303\263 ph\341\272\247n t\341\273\255 n\303\240o ch\341\273\211 \304\221\341\273\215c \304\221\306\260\341\273\243c \341\273\237 m\341\273\231t giao di\341\273\207n.\r\n\342\200\242\tC\303\264ng t\341\272\257c 3 tr\341\272\241ng th\303\241i S\303\241ng / T\341\273\221i / Theo h\341\273\207 th\341\273\221ng (m\341\272\267c \304\221\341\273\213nh Theo h\341\273\207 th\341\273\221ng), l\306\260u l\341\272\241i l\341\273\261a ch\341\273\215n. \303\201p d\341\273\245ng thu\341\273\231c t\303\255nh data-theme b\341\272\261ng m\341\273\231t \304\221o\341\272\241n script nh\341\273\217 trong <head> tr\306\260\341\273\233c khi v\341\272\275 giao di\341\273\207n \304\221\341\273\203 kh\303\264ng nh\303\241y sai m\303\240u; khai b\303\241o color-scheme v\303\240 meta theme-color theo giao di\341\273\207n.\r\n\342\200\242\tTh\341\272\273 \341\272\243nh b\303\241o c\303\241o g\341\273\255i ph\341\273\245 huynh lu\303\264n d\341\273\261ng \341\273\237 giao di\341\273\207n S\303\241ng c\341\273\221 \304\221\341\273\213nh, kh\303\264ng ph\341\273\245 thu\341\273\231c giao di\341\273\207n \304\221ang d\303\271ng.\r\n10.6. Th\303\240nh ph\341\272\247n giao di\341\273\207n\r\nTh\303\240nh ph\341\272\247n\tY\303\252u c\341\272\247u\r\nN\303\272t\tCh\303\255nh (n\341\273\201n m\341\273\261c), ph\341\273\245 (vi\341\273\201n), nguy hi\341\273\203m (ch\341\273\257 \304\221\341\273\217, vi\341\273\201n \304\221\341\273\217); chi\341\273\201u cao t\341\273\221i thi\341\273\203u 44 px; c\303\263 tr\341\272\241ng th\303\241i nh\341\272\245n, focus r\303\265 (v\303\262ng 2 px m\303\240u nh\341\272\245n), v\303\264 hi\341\273\207u ho\303\241, \304\221ang t\341\272\243i.\r\n\303\224 gh\341\272\277\tK\303\255ch th\306\260\341\273\233c \342\211\245 44 px; 5 tr\341\272\241ng th\303\241i: th\306\260\341\273\235ng, ch\341\273\215n (vi\341\273\201n nh\341\272\245n 2 px + ph\303\263ng 105% + g\341\273\243n s\303\263ng), b\341\273\213 kho\303\241 ph\341\272\241m vi, \304\221\303\243 ch\341\273\215n trong ch\341\272\277 \304\221\341\273\231 nhi\341\273\201u ng\306\260\341\273\235i (c\303\263 d\341\272\245u t\303\255ch), c\303\263 th\303\264ng b\303\241o ch\341\273\235 \304\221\341\273\223ng b\341\273\231 (ch\341\272\245m nh\341\273\217).\r\nB\341\272\243ng thao t\303\241c (bottom sheet)\tTr\306\260\341\273\243t t\341\273\253 \304\221\303\241y, k\303\251o xu\341\273\221ng \304\221\341\273\203 \304\221\303\263ng, c\303\263 tay n\341\272\257m, v\303\271ng n\303\272t ch\303\255nh n\341\272\261m trong t\341\272\247m ng\303\263n c\303\241i, t\303\264n tr\341\273\215ng v\303\271ng an to\303\240n (safe area).\r\nH\341\273\231p x\303\241c nh\341\272\255n\tD\303\271ng cho c\341\272\243nh b\303\241o tr\303\271ng v\303\240 h\303\240nh \304\221\341\273\231ng nguy hi\341\273\203m; n\303\272t nguy hi\341\273\203m kh\303\264ng \304\221\306\260\341\273\243c l\303\240 n\303\272t m\341\272\267c \304\221\341\273\213nh.\r\nB\341\272\243ng d\341\273\257 li\341\273\207u (GV)\tTi\303\252u \304\221\341\273\201 c\341\273\221 \304\221\341\273\213nh, c\341\273\231t c\303\263 th\341\273\203 \341\272\251n/hi\341\273\207n, l\341\273\215c, s\341\272\257p x\341\272\277p, ph\303\242n trang; tr\303\252n \304\221i\341\273\207n tho\341\272\241i chuy\341\273\203n th\303\240nh danh s\303\241ch th\341\272\273 g\341\273\215n.\r\nBi\341\273\203u \304\221\341\273\223\tC\341\273\231t ngang cho 4 t\341\273\225, c\303\263 nh\303\243n s\341\273\221 li\341\273\207u tr\341\273\261c ti\341\272\277p; m\303\240u l\341\272\245y t\341\273\253 token; kh\303\264ng ch\341\273\211 d\341\273\261a v\303\240o m\303\240u \304\221\341\273\203 ph\303\242n bi\341\273\207t (c\303\263 nh\303\243n t\303\252n t\341\273\225).\r\nTh\303\264ng b\303\241o nh\341\273\217 (toast)\tT\341\273\261 t\341\272\257t sau 8 gi\303\242y khi c\303\263 n\303\272t Ho\303\240n t\303\241c; c\303\263 th\341\273\203 \304\221\341\273\215c b\341\272\261ng tr\303\254nh \304\221\341\273\215c m\303\240n h\303\254nh.\r\n\r\n10.7. Chuy\341\273\203n \304\221\341\273\231ng v\303\240 kh\341\272\243 n\304\203ng ti\341\272\277p c\341\272\255n\r\n\342\200\242\tChuy\341\273\203n \304\221\341\273\231ng 150\342\200\223250 ms, \304\221\306\260\341\273\235ng cong ease-out, kh\303\264ng n\341\272\243y, kh\303\264ng xoay. T\303\264n tr\341\273\215ng prefers-reduced-motion (t\341\272\257t hi\341\273\207u \341\273\251ng ph\303\263ng to v\303\240 g\341\273\243n s\303\263ng).\r\n\342\200\242\tC\303\263 nh\303\243n cho bi\341\273\203u t\306\260\341\273\243ng, \304\221i\341\273\201u h\306\260\341\273\233ng b\303\240n ph\303\255m tr\303\252n m\303\241y t\303\255nh, th\341\273\251 t\341\273\261 focus h\341\273\243p l\303\275, v\303\271ng ch\341\272\241m \342\211\245 44 px, kh\303\264ng d\303\271ng m\303\240u l\303\240m c\303\241ch duy nh\341\272\245t truy\341\273\201n \304\221\341\272\241t th\303\264ng tin.\r\n\342\200\242\tB\341\273\221 c\341\273\245c \306\260u ti\303\252n \304\221i\341\273\207n tho\341\272\241i; c\303\241c m\341\273\221c 360 / 768 / 1024 px; h\341\273\227 tr\341\273\243 v\303\271ng an to\303\240n c\341\273\247a iPhone (env(safe-area-inset-*)).\r\n11. C\341\272\245u tr\303\272c Google Sheets\r\nsetupSheets() ph\341\272\243i t\341\272\241o \304\221\341\273\247 c\303\241c trang t\303\255nh d\306\260\341\273\233i \304\221\303\242y v\341\273\233i d\303\262ng ti