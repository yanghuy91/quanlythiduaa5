  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { \n  User, \n  LayoutGrid, \n  Trophy, \n  AlertCircle, \n  CheckCircle2, \n  Clock, \n  MessageSquare, \n  X, \n  Send, \n  Sparkles, \n  Award, \n  Flame, \n  Shield, \n  Star, \n  BookOpen, \n  Calendar, \n  ChevronRight,\n  Camera,\n  ChevronLeft\n} from \'lucide-react\';\nimport { \n  Student, \n  SeatLayoutNode, \n  DisciplineRecord, \n  StudentWeekSummary, \n  TeacherSettings,\n  HierarchyPeriodFilter\n} from \'../../types\';\nimport { SeatGrid } from \'../student-picker/SeatGrid\';\nimport { CadreBadge } from \'../common/CadreBadge\';\nimport { CadreHonorsModal } from \'../common/CadreHonorsModal\';\nimport { PeriodHierarchyFilter as PeriodFilterComponent } from \'../common/PeriodHierarchyFilter\';\nimport { filterRecordsByHierarchy, calculateStudentPeriodSummary, CURRENT_SCHOOL_YEAR } from \'../../utils/hierarchy\';\nimport { STUDENT_ACHIEVEMENTS } from \'../../data/badgeData\';\nimport { AvatarFrame } from \'../common/AvatarFrame\';\nimport { getFrameForStudent } from \'../../data/frameData\';\nimport { AvatarUploadModal } from \'../common/AvatarUploadModal\';\n\ninterface StudentViewProps {\n  currentStudent: Student;\n  allStudents: Student[];\n  layout: SeatLayoutNode[];\n  records: DisciplineRecord[];\n  studentSummaries: Record<string, StudentWeekSummary>;\n  currentWeek: number;\n  settings: TeacherSettings;\n  onSubmitExplanation: (recordId: string, explanation: string) => void;\n  onUpdateStudentAvatar?: (studentId: string, avatarUrl: string) => void;\n}\n\nexport const StudentView: React.FC<StudentViewProps> = ({\n  currentStudent,\n  allStudents,\n  layout,\n  records,\n  studentSummaries,\n  currentWeek,\n  settings,\n  onSubmitExplanation,\n  onUpdateStudentAvatar,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'my_score\' | \'badges\' | \'seating\' | \'ranking\'>(\'my_score\');\n  const [selectedRecordForExplanation, setSelectedRecordForExplanation] = useState<DisciplineRecord | null>(null);\n  const [explanationText, setExplanationText] = useState(\'\');\n  const [showCadreModal, setShowCadreModal] = useState(false);\n  const [showAvatarModal, setShowAvatarModal] = useState(false);\n\n  // Time hierarchy filter state: N\304\203m h\341\273\215c -> H\341\273\215c k\303\254 -> Tu\341\272\247n -> Bu\341\273\225i (B\341\273\217 qua th\303\241ng)\n  const [periodFilter, setPeriodFilter] = useState<HierarchyPeriodFilter>({\n    namHoc: CURRENT_SCHOOL_YEAR,\n    hocKi: 1,\n    thang: \'all\',\n    tuanHoc: currentWeek,\n    ngayHoc: \'all\',\n    buoi: \'all\',\n  });\n\n  // Filtered records based on hierarchy filter\n  const filteredRecords = useMemo(() => {\n    return filterRecordsByHierarchy(records, periodFilter);\n  }, [records, periodFilter]);\n\n  // Hierarchical summary for all students and current student\n  const studentPeriodSummaries = useMemo(() => {\n    const map: Record<string, ReturnType<typeof calculateStudentPeriodSummary>> = {};\n    allStudents.forEach(st => {\n      map[st.maHS] = calculateStudentPeriodSummary(st, records, periodFilter, settings);\n    });\n    return map;\n  }, [allStudents, records, periodFilter, settings]);\n\n  const myPeriodSummary = studentPeriodSummaries[currentStudent.maHS] || {\n    diemTrungBinh: settings.diemKhoiDau,\n    tongDiemTru: 0,\n    tongDiemCong: 0,\n    soLoi: 0,\n    xepLoai: \'Tot\',\n    mucMau: \'none\',\n    lichSuTuan: [],\n  };\n\n  // My summary for current week\n  const myWeekSummary = studentSummaries[currentStudent.maHS] || {\n    diemHienTai: settings.diemKhoiDau,\n    tongDiemTru: 0,\n    tongDiemCong: 0,\n    xepLoai: \'Tot\',\n    mucMau: \'none\',\n    soLoiTrongTuan: 0,\n    coLoiNang: false,\n  };\n\n  // My personal records in filtered period\n  const myRecords = useMemo(() => {\n    return filteredRecords\n      .filter(r => r.maHS === currentStudent.maHS && r.trangThai !== \'DaHuy\')\n      .sort((a, b) => new Date(b.thoiGianMayChu).getTime() - new Date(a.thoiGianMayChu).getTime());\n  }, [filteredRecords, currentStudent.maHS]);\n\n  // Compute Unlocked Badges for current student\n  const myBadges = useMemo(() => {\n    const hasLate = myRecords.some(r => r.maNoiQuy === \'NQ01\' || r.tenHanhVi.includes(\'mu\341\273\231n\'));\n    const hasStudyFault = myRecords.some(r => r.nhomHanhVi === \'H\341\273\215c t\341\272\255p\');\n    const hasSanitationFault = myRecords.some(r => r.nhomHanhVi === \'Lao \304\221\341\273\231ng - V\341\273\207 sinh\');\n    const isGoodScore = myWeekSummary.diemHienTai >= 90;\n    const isIronDiscipline = myWeekSummary.diemHienTai === 100 && myWeekSummary.soLoiTrongTuan === 0;\n\n    return STUDENT_ACHIEVEMENTS.map(badge => {\n      let unlocked = false;\n      if (badge.id === \'badge_iron_discipline\') unlocked = isIronDiscipline;\n      else if (badge.id === \'badge_punctual_master\') unlocked = !hasLate;\n      else if (badge.id === \'badge_academic_spark\') unlocked = !hasStudyFault;\n      else if (badge.id === \'badge_green_classroom\') unlocked = !hasSanitationFault;\n      else if (badge.id === \'badge_streak_master\' || badge.id === \'badge_active_spirit\') unlocked = isGoodScore;\n\n      return { ...badge, unlocked };\n    });\n  }, [myRecords, myWeekSummary]);\n\n  // Class Individual Ranking (NO group ranking)\n  const classRankings = useMemo(() => {\n    const list = allStudents.map(student => {\n      const summary = studentPeriodSummaries[student.maHS] || {\n        diemTrungBinh: settings.diemKhoiDau,\n        tongDiemTru: 0,\n        tongDiemCong: 0,\n        xepLoai: \'Tot\',\n      };\n      return {\n        student,\n        score: summary.diemTrungBinh,\n        xepLoai: summary.xepLoai,\n        deductions: summary.tongDiemTru,\n      };\n    });\n\n    return list.sort((a, b) => {\n      if (b.score !== a.score) return b.score - a.score;\n      return a.student.hoTen.localeCompare(b.student.hoTen, \'vi\');\n    });\n  }, [allStudents, studentPeriodSummaries, settings.diemKhoiDau]);\n\n  // Current Student Rank & Frame\n  const myRank = useMemo(() => {\n    const idx = classRankings.findIndex(item => item.student.maHS === currentStudent.maHS);\n    return idx >= 0 ? idx + 1 : 1;\n  }, [classRankings, currentStudent.maHS]);\n\n  const myFrame = useMemo(() => {\n    return getFrameForStudent(myRank, myPeriodSummary.diemTrungBinh, currentStudent.customFrameId);\n  }, [myRank, myPeriodSummary.diemTrungBinh, currentStudent.customFrameId]);\n\n  const handleOpenExplanation = (record: DisciplineRecord) => {\n    setSelectedRecordForExplanation(record);\n    setExplanationText(record.noiDungGiaiTrinh || \'\');\n  };\n\n  const handleSubmitExplanation = () => {\n    if (!selectedRecordForExplanation || !explanationText.trim()) return;\n    onSubmitExplanation(selectedRecordForExplanation.maGhiNhan, explanationText.trim());\n    setSelectedRecordForExplanation(null);\n    setExplanationText(\'\');\n  };\n\n  const isCadre = currentStudent.vaiTro.some(r => r !== \'HS\');\n  const cadreRole = currentStudent.vaiTro.find(r => r !== \'HS\');\n\n  return (\n    <div className=\"w-full flex flex-col gap-4 animate-fadeIn\">\n      {/* Top Class Info Bar without cheesy slogans */}\n      <div className=\"px-4 py-2.5 rounded-2xl bg-surface border border-token flex items-center justify-between gap-2 shadow-xs\">\n        <div className=\"flex items-center gap-2 text-xs font-bold text-main\">\n          <span className=\"w-2 h-2 rounded-full bg-accent animate-pulse\" />\n          <span>L\341\273\233p 10A5 \302\267 THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225 \302\267 N\304\203m h\341\273\215c {CURRENT_SCHOOL_YEAR}</span>\n        </div>\n        {isCadre && (\n          <button\n            onClick={() => setShowCadreModal(true)}\n            className=\"shrink-0 px-2.5 py-1 rounded-xl bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 text-[11px] font-bold flex items-center gap-1 hover:bg-amber-500/25 transition-all cursor-pointer shadow-xs\"\n          >\n            <span>\360\237\221\221 Ban c\303\241n s\341\273\261</span>\n          </button>\n        )}\n      </div>\n\n      {/* Sub-tab \"Quay l\341\272\241i\" (Back) button when viewing secondary tabs */}\n      {activeTab !== \'my_score\' && (\n        <div className=\"flex items-center justify-between px-1\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'my_score\')}\n            className=\"px-3.5 py-1.5 rounded-xl bg-surface hover:bg-surface-2 border border-token text-main text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95 hover:border-accent\"\n          >\n            <ChevronLeft className=\"w-3.5 h-3.5 text-accent\" />\n            <span>\342\206\220 Quay l\341\272\241i H\341\273\223 s\306\241 C\341\273\247a t\303\264i</span>\n          </button>\n          <span className=\"text-xs font-bold text-muted\">\n            {activeTab === \'badges\' ? \'Huy hi\341\273\207u th\303\240nh t\303\255ch\' : activeTab === \'seating\' ? \'S\306\241 \304\221\341\273\223 l\341\273\233p h\341\273\215c\' : \'B\341\272\243ng x\341\272\277p h\341\272\241ng thi \304\221ua\'}\n          </span>\n        </div>\n      )}\n\n      {/* Student Nav Tabs */}\n      <div className=\"flex items-center justify-center p-1 bg-surface-2 rounded-2xl border border-token max-w-lg mx-auto w-full\">\n        <button\n          onClick={() => setActiveTab(\'my_score\')}\n          className={`flex-1 py-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeTab === \'my_score\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <User className=\"w-3.5 h-3.5 text-accent\" />\n          <span>C\341\273\247a t\303\264i</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'badges\')}\n          className={`flex-1 py-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeTab === \'badges\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Award className=\"w-3.5 h-3.5 text-amber-500\" />\n          <span>Huy hi\341\273\207u ({myBadges.filter(b => b.unlocked).length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'seating\')}\n          className={`flex-1 py-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeTab === \'seating\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <LayoutGrid className=\"w-3.5 h-3.5 text-accent\" />\n          <span>S\306\241 \304\221\341\273\223 l\341\273\233p</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'ranking\')}\n          className={`flex-1 py-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeTab === \'ranking\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Trophy className=\"w-3.5 h-3.5 text-accent\" />\n          <span>B\341\272\243ng thi \304\221ua</span>\n        </button>\n      </div>\n\n      {/* TAB 1: C\341\273\246A T\303\224I */}\n      {activeTab === \'my_score\' && (\n        <div className=\"space-y-4\">\n          {/* Main Score & Profile Card */}\n          <div className=\"relative overflow-hidden p-4 sm:p-5 rounded-3xl bg-surface border border-token shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-3.5 w-full sm:w-auto\">\n              {/* Avatar with Custom Frame, Photo & Camera Upload Button */}\n              <div className=\"relative shrink-0\">\n                <AvatarFrame\n                  frame={myFrame}\n                  cadreRole={\n                    currentStudent.vaiTro.includes(\'LT\')\n                      ? \'LT\'\n                      : currentStudent.vaiTro.includes(\'BT\')\n                      ? \'BT\'\n                      : currentStudent.vaiTro.includes(\'LP_HT\')\n                      ? \'LP_HT\'\n                      : currentStudent.vaiTro.includes(\'LP_LD\')\n                      ? \'LP_LD\'\n                      : currentStudent.vaiTro.includes(\'TT\')\n                      ? `TT_${currentStudent.to}`\n                      : undefined\n                  }\n                  size=\"lg\"\n                >\n                  {currentStudent.avatarUrl ? (\n                    <img\n                      src={currentStudent.avatarUrl}\n                      alt={currentStudent.hoTen}\n                      className=\"w-full h-full object-cover rounded-full\"\n                    />\n                  ) : (\n                    <div\n                      className={`w-full h-full rounded-full flex items-center justify-center font-black text-lg ${\n                        currentStudent.gioiTinh === \'Nu\'\n                          ? \'bg-rose-100 text-rose-700\'\n                          : \'bg-sky-100 text-sky-700\'\n                      }`}\n                    >\n                      {currentStudent.tenRutGon.slice(-2)}\n                    </div>\n                  )}\n                </AvatarFrame>\n\n                {/* Seat badge */}\n                <span className=\"absolute -bottom-1 -left-1 text-[10px] font-extrabold px-1.5 py-0.2 rounded-md bg-surface text-main border border-token shadow-xs z-20\">\n                  #{currentStudent.viTriGhe}\n                </span>\n\n                {/* Camera upload button */}\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAvatarModal(true)}\n                  title=\"T\341\272\243i \341\272\243nh \304\221\341\272\241i di\341\273\207n c\341\273\247a b\341\272\241n\"\n                  className=\"absolute -top-1 -right-1 z-20 p-1.5 rounded-full bg-slate-900/80 hover:bg-slate-900 text-white shadow-md transition-all cursor-pointer hover:scale-110 active:scale-95\"\n                >\n                  <Camera className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n\n              <div className=\"min-w-0\">\n                <div className=\"flex items-center gap-2 flex-wrap\">\n                  <h2 className=\"text-base sm:text-lg font-bold text-main leading-tight truncate\">\n                    {currentStudent.hoTen}\n                  </h2>\n                  {cadreRole && (\n                    <CadreBadge \n                      role={cadreRole} \n                      toTruongTo={currentStudent.toTruongTo} \n                      size=\"sm\" \n                      onClick={() => setShowCadreModal(true)}\n                    />\n                  )}\n                </div>\n                <p className=\"text-xs text-muted mt-0.5\">\n                  T\341\273\225 {currentStudent.to} \302\267 D\303\243y {currentStudent.dayBan} - B\303\240n {currentStudent.soBan} \302\267 THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\n                </p>\n                <div className=\"flex items-center gap-2 mt-1\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowAvatarModal(true)}\n                    className=\"text-[11px] font-bold text-accent hover:underline flex items-center gap-1 cursor-pointer\"\n                  >\n                    <Camera className=\"w-3 h-3\" />\n                    <span>\304\220\341\273\225i \341\272\243nh \304\221\341\272\241i di\341\273\207n</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Score & Ranking Pill with Trophy Visual */}\n            <div className=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-3 sm:pt-0 border-token\">\n              {myWeekSummary.diemHienTai >= 90 && (\n                <div className=\"w-12 h-12 rounded-2xl overflow-hidden border border-amber-500/30 shadow-xs hidden sm:block shrink-0\">\n                  <img\n                    src=\"/src/assets/images/honor_student_trophy_1794145975161.jpg\"\n                    alt=\"C\303\272p vinh danh\"\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                </div>\n              )}\n\n              <div className=\"text-right\">\n                <div className=\"text-[11px] text-muted font-medium\">\n                  {periodFilter.tuanHoc !== \'all\' ? `\304\220i\341\273\203m tu\341\272\247n ${periodFilter.tuanHoc}` : \'\304\220i\341\273\203m trung b\303\254nh\'}\n                </div>\n                <div className=\"text-2xl sm:text-3xl font-extrabold tabular-nums text-main leading-none mt-1\">\n                  {myPeriodSummary.diemTrungBinh} <span className=\"text-xs font-normal text-muted\">/ 100</span>\n                </div>\n              </div>\n\n              <div className={`px-3 py-1.5 rounded-2xl text-xs font-extrabold shadow-xs ${\n                myPeriodSummary.xepLoai === \'Tot\' \n                  ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)] border border-[var(--st-ok)]/30\'\n                  : myPeriodSummary.xepLoai === \'Kha\'\n                  ? \'bg-accent/15 text-accent border border-accent/30\'\n                  : myPeriodSummary.xepLoai === \'Dat\'\n                  ? \'bg-[var(--st-warn)]/15 text-[var(--st-warn)] border border-[var(--st-warn)]/30\'\n                  : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)] border border-[var(--st-bad)]/30\'\n              }`}>\n                {myPeriodSummary.xepLoai === \'Tot\' ? \'\360\237\214\237 Lo\341\272\241i T\341\273\221t\' :\n                 myPeriodSummary.xepLoai === \'Kha\' ? \'\360\237\232\200 Lo\341\272\241i Kh\303\241\' :\n                 myPeriodSummary.xepLoai === \'Dat\' ? \'\342\232\240\357\270\217 Lo\341\272\241i \304\220\341\272\241t\' : \'\342\235\227 C\341\272\247n c\341\273\221 g\341\272\257ng\'}\n              </div>\n            </div>\n          </div>\n\n          {/* Time Hierarchy Period Filter */}\n          <PeriodFilterComponent\n            filter={periodFilter}\n            onChangeFilter={setPeriodFilter}\n            compact={true}\n          />\n\n          {/* Period Summary Statistics */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"p-3 rounded-2xl bg-surface border border-token\">\n              <span className=\"text-[11px] text-muted font-medium\">Kh\341\273\237i \304\221\341\272\247u</span>\n              <div className=\"text-lg font-bold text-main mt-0.5\">{settings.diemKhoiDau} \304\221i\341\273\203m</div>\n            </div>\n\n            <div className=\"p-3 rounded-2xl bg-surface border border-token\">\n              <span className=\"text-[11px] text-muted font-medium\">T\341\273\225ng \304\221i\341\273\203m tr\341\273\253</span>\n              <div className=\"text-lg font-bold text-[var(--st-bad)] mt-0.5\">-{myPeriodSummary.tongDiemTru}\304\221</div>\n            </div>\n\n            <div className=\"p-3 rounded-2xl bg-surface border border-token\">\n              <span className=\"text-[11px] text-muted font-medium\">\304\220i\341\273\203m c\341\273\231ng b\303\271</span>\n              <div className=\"text-lg font-bold text-[var(--st-ok)] mt-0.5\">+{myPeriodSummary.tongDiemCong}\304\221</div>\n            </div>\n\n            <div className=\"p-3 rounded-2xl bg-surface border border-token\">\n              <span className=\"text-[11px] text-muted font-medium\">T\341\273\225ng s\341\273\221 l\341\273\227i</span>\n              <div className=\"text-lg font-bold text-main mt-0.5\">{myPeriodSummary.soLoi} l\341\273\227i</div>\n            </div>\n          </div>\n\n          {/* My Records Timeline in Period */}\n          <div className=\"bg-surface rounded-3xl border border-token overflow-hidden shadow-xs\">\n            <div className=\"px-4 py-3 border-b border-token flex items-center justify-between\">\n              <div>\n                <h3 className=\"text-xs font-bold text-main uppercase tracking-wider flex items-center gap-1.5\">\n                  <Clock className=\"w-3.5 h-3.5 text-accent\" />\n                  <span>Nh\341\272\255t k\303\275 n\341\273\201 n\341\272\277p c\303\241 nh\303\242n</span>\n                </h3>\n                <p className=\"text-[11px] text-muted mt-0.5\">\n                  Hi\341\273\203n th\341\273\213 c\303\241c ghi nh\341\272\255n trong k\341\273\263 \304\221\303\243 ch\341\273\215n ({myRecords.length} s\341\273\261 vi\341\273\207c)\n                </p>\n              </div>\n            </div>\n\n            <div className=\"divide-y divide-token max-h-96 overflow-y-auto\">\n              {myRecords.length === 0 ? (\n                <div className=\"p-8 text-center text-muted text-xs\">\n                  Kh\303\264ng c\303\263 ghi nh\341\272\255n vi ph\341\272\241m n\303\240o trong kho\341\272\243ng th\341\273\235i gian n\303\240y. R\341\272\245t xu\341\272\245t s\341\272\257c! \360\237\216\211\n                </div>\n              ) : (\n                myRecords.map(record => {\n                  const isBonus = record.loaiDiem === \'Cong\';\n                  const canExplain = record.trangThai === \'HieuLuc\' && !record.noiDungGiaiTrinh;\n\n                  return (\n                    <div key={record.maGhiNhan} className=\"p-3 sm:p-4 hover:bg-surface-2 transition-colors\">\n                      <div className=\"flex items-start justify-between gap-3\">\n                        <div className=\"space-y-1 min-w-0\">\n                          <div className=\"flex items-center gap-2 flex-wrap\">\n                            <span className=\"text-xs font-bold text-main\">\n                              {record.tenHanhVi}\n                            </span>\n                            <span className={`text-[10px] font-bold px-1.5 py-0.2 rounded-md ${\n                              isBonus ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' : \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\n                            }`}>\n                              {isBonus ? `+${record.diemSo}` : `-${record.diemSo}`}\304\221\n                            </span>\n                            <span className=\"text-[10px] text-muted\">\n                              HK{record.hocKi} \302\267 Tu\341\272\247n {record.tuanHoc} \302\267 Bu\341\273\225i {record.buoi === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'} \302\267 {record.ngayHoc}\n                            </span>\n                          </div>\n\n                          {record.ghiChu && (\n                            <p className=\"text-xs text-muted\">\n                              Chi ti\341\272\277t: {record.ghiChu}\n                            </p>\n                          )}\n\n                          <div className=\"text-[11px] text-muted flex items-center gap-2\">\n                            <span>Ng\306\260\341\273\235i ghi: {record.nguoiGhi} ({record.vaiTroNguoiGhi})</span>\n                            {record.trangThai === \'ChoDuyet\' && (\n                              <span className=\"text-[var(--st-warn)] font-semibold flex items-center gap-1\">\n                                <Clock className=\"w-3 h-3\" /> \304\220ang ch\341\273\235 GV duy\341\273\207t gi\341\272\243i tr\303\254nh\n                              </span>\n                            )}\n                            {record.trangThai === \'DaChapNhan\' && (\n                              <span className=\"text-[var(--st-ok)] font-semibold flex items-center gap-1\">\n                                <CheckCircle2 className=\"w-3 h-3\" /> \304\220\303\243 ch\341\272\245p nh\341\272\255n gi\341\272\243i tr\303\254nh\n                              </span>\n                            )}\n                            {record.trangThai === \'BiTuChoi\' && (\n                              <span className=\"text-[var(--st-bad)] font-semibold flex items-center gap-1\">\n                                <AlertCircle className=\"w-3 h-3\" /> Gi\341\272\243i tr\303\254nh b\341\273\213 t\341\273\253 ch\341\273\221i: {record.lyDoDuyet}\n                              </span>\n                            )}\n                          </div>\n                        </div>\n\n                        {canExplain && (\n                          <button\n                            type=\"button\"\n                            onClick={() => handleOpenExplanation(record)}\n                            className=\"shrink-0 px-2.5 py-1 rounded-xl bg-accent/15 text-accent hover:bg-accent/25 border border-accent/30 text-xs font-semibold flex items-center gap-1 cursor-pointer transition-colors\"\n                          >\n                            <MessageSquare className=\"w-3 h-3\" />\n                            <span>Gi\341\272\243i tr\303\254nh</span>\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: HUY HI\341\273\206U */}\n      {activeTab === \'badges\' && (\n        <div className=\"space-y-4\">\n          <div className=\"p-4 rounded-3xl bg-surface border border-token shadow-xs space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h3 className=\"text-sm font-bold text-main uppercase tracking-wider flex items-center gap-2\">\n                  <Award className=\"w-4 h-4 text-amber-500\" />\n                  <span>B\341\273\231 s\306\260u t\341\272\255p Huy hi\341\273\207u &amp; Vinh danh</span>\n                </h3>\n                <p className=\"text-xs text-muted mt-0.5\">\n                  \304\220\303\243 m\341\273\237 kh\303\263a: <strong>{myBadges.filter(b => b.unlocked).length}</strong> / {myBadges.length} danh hi\341\273\207u\n                </p>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'my_score\')}\n                className=\"px-3 py-1 rounded-xl bg-surface-2 border border-token text-xs font-bold text-main cursor-pointer\"\n              >\n                \342\206\220 Quay l\341\272\241i\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n              {myBadges.map(badge => (\n                <div\n                  key={badge.id}\n                  className={`p-3.5 rounded-2xl border transition-all flex items-start gap-3 ${\n                    badge.unlocked\n                      ? \'bg-amber-500/10 border-amber-500/30 text-main shadow-xs\'\n                      : \'bg-surface-2 border-token opacity-50 grayscale\'\n                  }`}\n                >\n                  <span className=\"text-2xl p-2 rounded-xl bg-surface border border-token shrink-0\">\n                    {badge.icon}\n                  </span>\n                  <div>\n                    <h4 className=\"text-xs font-bold text-main flex items-center gap-1.5\">\n                      <span>{badge.title}</span>\n                      {badge.unlocked && (\n                        <span className=\"text-[10px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-700 dark:text-amber-300 font-bold\">\n                          \304\220\303\243 \304\221\341\272\241t\n                        </span>\n                      )}\n                    </h4>\n                    <p className=\"text-[11px] text-muted mt-0.5 leading-snug\">\n                      {badge.description}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3: S\306\240 \304\220\341\273\222 L\341\273\232P */}\n      {activeTab === \'seating\' && (\n        <div className=\"space-y-3\">\n          <div className=\"bg-surface p-3 sm:p-4 rounded-3xl border border-token space-y-3\">\n            <div className=\"text-xs text-muted flex items-center justify-between\">\n              <span>S\306\241 \304\221\341\273\223 v\341\273\213 tr\303\255 42 h\341\273\215c sinh &amp; Tr\341\272\241ng th\303\241i n\341\273\201 n\341\272\277p</span>\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'my_score\')}\n                className=\"px-3 py-1 rounded-xl bg-surface-2 border border-token text-xs font-bold text-main cursor-pointer\"\n              >\n                \342\206\220 Quay l\341\272\241i\n              </button>\n            </div>\n\n            <SeatGrid\n              layout={layout}\n              students={allStudents}\n              studentSummaries={studentSummaries}\n              selectedStudentIds={[currentStudent.maHS]}\n              onSelectStudent={() => {}}\n              viewerRole=\"HS\"\n              showStatusColors={settings.hocSinhThayMau === \'CaLop\'}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* TAB 4: B\341\272\242NG THI \304\220UA C\303\201 NH\303\202N (NO GROUP LEADERBOARD) */}\n      {activeTab === \'ranking\' && (\n        <div className=\"bg-surface rounded-3xl border border-token overflow-hidden shadow-xs\">\n          <div className=\"px-4 py-3.5 border-b border-token flex items-center justify-between\">\n            <div>\n              <h3 className=\"text-xs font-bold text-main uppercase tracking-wider flex items-center gap-1.5\">\n                <Trophy className=\"w-4 h-4 text-amber-500\" />\n                <span>B\341\272\243ng x\341\272\277p h\341\272\241ng c\303\241 nh\303\242n l\341\273\233p 10A5</span>\n              </h3>\n              <p className=\"text-[11px] text-muted mt-0.5\">\n                Kh\341\273\237i \304\221\341\272\247u 100 \304\221i\341\273\203m \302\267 X\341\272\277p lo\341\272\241i: T\341\273\221t (\342\211\24590), Kh\303\241 (\342\211\24575), \304\220\341\272\241t (\342\211\24560)\n              </p>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'my_score\')}\n              className=\"px-3 py-1 rounded-xl bg-surface-2 border border-token text-xs font-bold text-main cursor-pointer\"\n            >\n              \342\206\220 Quay l\341\272\241i\n            </button>\n          </div>\n\n          <div className=\"divide-y divide-token max-h-[600px] overflow-y-auto\">\n            {classRankings.map((item, idx) => {\n              const isMe = item.student.maHS === currentStudent.maHS;\n              const rank = idx + 1;\n              const frameConfig = getFrameForStudent(rank, item.score, item.student.customFrameId);\n\n              return (\n                <div\n                  key={item.student.maHS}\n                  className={`px-4 py-3 flex items-center justify-between transition-colors ${\n                    isMe ? \'bg-accent/10 font-bold\' : \'hover:bg-surface-2\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span className={`w-6 text-center text-xs font-bold shrink-0 ${\n                      rank === 1 ? \'text-amber-500 font-extrabold text-sm\' :\n                      rank === 2 ? \'text-slate-400 font-bold\' :\n                      rank === 3 ? \'text-amber-700 font-bold\' : \'text-muted\'\n                    }`}>\n                      {rank === 1 ? \'\360\237\245\207\' : rank === 2 ? \'\360\237\245\210\' : rank === 3 ? \'\360\237\245\211\' : `#${rank}`}\n                    </span>\n\n                    <AvatarFrame frame={frameConfig} size=\"sm\">\n                      {item.student.avatarUrl ? (\n                        <img\n                          src={item.student.avatarUrl}\n                          alt={item.student.hoTen}\n                          className=\"w-full h-full object-cover rounded-full\"\n                        />\n                      ) : (\n                        <div\n                          className={`w-full h-full rounded-full flex items-center justify-center font-bold text-[10px] ${\n                            item.student.gioiTinh === \'Nu\'\n                              ? \'bg-rose-100 text-rose-700\'\n                              : \'bg-sky-100 text-sky-700\'\n                          }`}\n                        >\n                          {item.student.tenRutGon.slice(-2)}\n                        </div>\n                      )}\n                    </AvatarFrame>\n\n                    <div className=\"min-w-0\">\n                      <div className=\"text-xs text-main truncate\">\n                        {item.student.hoTen} {isMe && <span className=\"text-accent font-bold\">(B\341\272\241n)</span>}\n                      </div>\n                      <div className=\"text-[10px] text-muted\">\n                        T\341\273\225 {item.student.to} \302\267 Gh\341\272\277 {item.student.viTriGhe} \302\267 D\303\243y {item.student.dayBan}\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <span className=\"text-xs font-extrabold tabular-nums text-main\">\n                      {item.score} \304\221\n                    </span>\n                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${\n                      item.xepLoai === \'Tot\' ? \'bg-[var(--st-ok)]/15 text-[var(--st-ok)]\' :\n                      item.xepLoai === \'Kha\' ? \'bg-accent/15 text-accent\' :\n                      item.xepLoai === \'Dat\' ? \'bg-[var(--st-warn)]/15 text-[var(--st-warn)]\' :\n                      \'bg-[var(--st-bad)]/15 text-[var(--st-bad)]\'\n                    }`}>\n                      {item.xepLoai}\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* Cadre Honors Modal */}\n      <CadreHonorsModal\n        isOpen={showCadreModal}\n        onClose={() => setShowCadreModal(false)}\n        students={allStudents}\n      />\n\n      {/* Explanation Modal */}\n      {selectedRecordForExplanation && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\">\n          <div className=\"w-full max-w-md bg-surface border border-token rounded-3xl shadow-2xl p-4 sm:p-5 space-y-3.5 animate-scale-up\">\n            <div className=\"flex items-center justify-between border-b border-token pb-2.5\">\n              <h4 className=\"text-sm font-bold text-main\">\n                G\341\273\255i gi\341\272\243i tr\303\254nh vi ph\341\272\241m\n              </h4>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedRecordForExplanation(null)}\n                className=\"p-1 rounded-md text-muted hover:text-main\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"text-xs space-y-1\">\n              <span className=\"font-semibold text-main\">\n                {selectedRecordForExplanation.tenHanhVi} (-{selectedRecordForExplanation.diemSo}\304\221)\n              </span>\n              <p className=\"text-[11px] text-muted\">\n                HK{selectedRecordForExplanation.hocKi} \302\267 Tu\341\272\247n {selectedRecordForExplanation.tuanHoc} \302\267 Ng\303\240y {selectedRecordForExplanation.ngayHoc} ({selectedRecordForExplanation.buoi === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'})\n              </p>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-main mb-1\">\n                L\303\275 do &amp; Minh ch\341\273\251ng gi\341\272\243i tr\303\254nh:\n              </label>\n              <textarea\n                rows={3}\n                value={explanationText}\n                onChange={e => setExplanationText(e.target.value)}\n                placeholder=\"Tr\303\254nh b\303\240y l\303\275 do kh\303\241ch quan ho\341\272\267c hi\341\273\203u l\341\272\247m...\"\n                className=\"w-full p-2.5 bg-surface-2 border border-token rounded-xl text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-token\">\n              <button\n                type=\"button\"\n                onClick={() => setSelectedRecordForExplanation(null)}\n                className=\"px-3 py-1.5 rounded-xl border border-token text-xs text-muted hover:text-main\"\n              >\n                H\341\273\247y\n              </button>\n              <button\n                type=\"button\"\n                disabled={!explanationText.trim()}\n                onClick={handleSubmitExplanation}\n                className=\"px-4 py-1.5 rounded-xl bg-accent text-on-accent text-xs font-bold hover:opacity-90 disabled:opacity-50 cursor-pointer shadow-xs\"\n              >\n                G\341\273\255i \304\221\306\241n gi\341\272\243i tr\303\254nh\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Avatar Upload & Crop Modal */}\n      <AvatarUploadModal\n        isOpen={showAvatarModal}\n        onClose={() => setShowAvatarModal(false)}\n        student={currentStudent}\n        onSaveAvatar={(newAvatarUrl) => {\n          if (onUpdateStudentAvatar) {\n            onUpdateStudentAvatar(currentStudent.maHS, newAvatarUrl);\n          }\n        }}\n      />\n    </div>\n  );\n};\n"
