div>\n            </div>\n          </div>"
        replacement_content: "      {/* Sub-tab \"Quay l\341\272\241i\" (Back) button when in any secondary tab */}\n      {activeTab !== \'overview\' && (\n        <div className=\"flex items-center justify-between px-1\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'overview\')}\n            className=\"px-3.5 py-1.5 rounded-xl bg-surface hover:bg-surface-2 border border-token text-main text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95 hover:border-accent\"\n          >\n            <span>\342\206\220 Quay l\341\272\241i T\341\273\225ng quan</span>\n          </button>\n          <span className=\"text-xs font-bold text-muted\">\n            {activeTab === \'apps\' ? \'10 Tr\303\262 ch\306\241i g\341\273\215i h\341\273\215c sinh l\303\252n b\341\272\243ng\' : activeTab === \'record\' ? \'B\303\240n ghi nh\341\272\255n\' : activeTab === \'roster\' ? \'Danh s\303\241ch & S\306\241 \304\221\341\273\223\' : activeTab === \'rules\' ? \'N\341\273\231i quy l\341\273\233p\' : activeTab === \'import_export\' ? \'Nh\341\272\255p & Xu\341\272\245t d\341\273\257 li\341\273\207u\' : activeTab === \'explanations\' ? \'Duy\341\273\207t gi\341\272\243i tr\303\254nh\' : \'C\303\240i \304\221\341\272\267t h\341\273\207 th\341\273\221ng\'}\n          </span>\n        </div>\n      )}\n\n      {/* 1. OVERVIEW */}\n      {activeTab === \'overview\' && (\n        <div className=\"space-y-4\">\n          {/* Hero Banner with High School Classroom Illustration */}\n          <div className=\"relative overflow-hidden rounded-3xl border border-token shadow-xs bg-surface\">\n            <div className=\"relative h-44 sm:h-52 w-full overflow-hidden\">\n              <img\n                src=\"/src/assets/images/hero_class_10a5_1794145975717.jpg\"\n                alt=\"T\341\272\255p th\341\273\203 L\341\273\233p 10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\"\n                className=\"w-full h-full object-cover object-center\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent\" />\n              \n              <div className=\"absolute bottom-3.5 left-4 right-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3 text-white\">\n                <div>\n                  <div className=\"flex items-center gap-2 text-xs font-bold text-amber-300\">\n                    <SparklesIcon className=\"w-3.5 h-3.5\" />\n                    <span>L\341\273\232P 10A5 \302\267 THPT S\341\273\220 2 \304\220\341\273\250C PH\341\273\224</span>\n                  </div>\n                  <h2 className=\"text-lg sm:text-xl font-extrabold tracking-tight mt-0.5\">\n                    H\341\273\207 Th\341\273\221ng N\341\273\201 N\341\272\277p &amp; Thi \304\220ua L\341\273\233p H\341\273\215c \360\237\216\257\n                  </h2>\n                  <p className=\"text-xs text-slate-200 mt-0.5 max-w-xl\">\n                    42 H\341\273\215c sinh \302\267 6 D\303\243y b\303\240n \302\267 N\304\203m h\341\273\215c {CURRENT_SCHOOL_YEAR}\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2 shrink-0 flex-wrap\">\n                  <button\n                    onClick={() => setActiveTab(\'apps\')}\n                    className=\"px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-md active:scale-95\"\n                  >\n                    <Dices className=\"w-3.5 h-3.5\" />\n                    <span>G\341\273\215i b\341\272\243ng (10 tr\303\262) \360\237\216\262</span>\n                  </button>\n\n                  <button\n                    onClick={() => setShowFrameModal(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-purple-600/90 hover:bg-purple-600 backdrop-blur-md text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-md active:scale-95\"\n                  >\n                    <Crown className=\"w-3.5 h-3.5 text-amber-300\" />\n                    <span>Vinh danh &amp; Khung \360\237\221\221</span>\n                  </button>\n\n                  <button\n                    onClick={() => setIsLayoutEditorOpen(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs font-bold border border-white/30 transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <Move className=\"w-3.5 h-3.5 text-amber-300\" />\n                    <span>S\306\241 \304\221\341\273\223 \360\237\252\221</span>\n                  </button>\n\n                  <button\n                    onClick={() => setShowCadreModal(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <span>Ban c\303\241n s\341\273\261</span>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Quick Calling Games Showcase Banner */}\n          <div className=\"p-4 rounded-3xl bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-rose-500/10 border-2 border-amber-500/30 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-3xl p-2 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 text-white shadow-md shrink-0\">\360\237\216\262</span>\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"text-sm font-extrabold text-main uppercase tracking-wide\">\n                    10 Tr\303\262 Ch\306\241i G\341\273\215i H\341\273\215c Sinh L\303\252n B\341\272\243ng \304\220ang Hot\n                  </h3>\n                  <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-rose-500 text-white font-black animate-pulse\">\n                    HOT \360\237\224\245\n                  </span>\n                </div>\n                <p className=\"text-xs text-muted mt-0.5\">\n                  V\303\262ng quay may m\341\272\257n, Bom n\341\273\225 ch\341\272\255m, M\303\241y g\341\272\257p th\303\272, \304\220ua xe F1, Slot machine, Tarot th\341\272\247n b\303\255, T\303\252n l\341\273\255a v\305\251 tr\341\273\245, Bao l\303\254 x\303\254, Ma tr\341\272\255n 42 s\341\273\221, DJ \304\221\304\251a than.\n                </p>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'apps\')}\n              className=\"px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white text-xs font-extrabold shadow-md transition-all cursor-pointer active:scale-95 shrink-0 flex items-center gap-1.5\"\n            >\n              <span>M\341\273\237 tr\303\262 ch\306\241i ngay \342\206\222</span>\n            </button>\n          </div>"
        start_line: 315
