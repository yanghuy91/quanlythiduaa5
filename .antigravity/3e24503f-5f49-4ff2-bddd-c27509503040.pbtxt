      thinking_signature: "\022\361\004\n\356\004\001i\024}\023)\263Zp\315\210\003\a\222Q\216\016\270\340X\260\372\t%\354B\236\233(\262\240\006\377\005Y\024\250\002H/@6J\232.\316\214\324=\260\326\221\254\207\333\f\034q\320}\343\261O@\355\201?\324\245\345s\2355\217\264\232*\335\345\3445\\\242`+\325\345\rsz\f2\004\035\324\265\037\242\244\376\371\341@E\031\'m\031\210{\344w\364\025\224\353\347\273r\263l\027E> \001\344\275\347\260\354\223\355zB\225\250\r}\322D\346\310Nd\223\240\201\262p\320\311G|\267s\215\245+\216tOY\272\242\222%\212\177\271\241\336\333#\275\350\334(\rP\200p)m\362\245N\376\320b\223;\373:\352$\307\344\267\316\325O\206\245\253\313R \354\312\213\240\347\206\027\376\2412\354\037\"\n\037P]\204\006n\356\3111\227\302\217_\307\225 (\317@\224L\236\275\333\235p^\"\001\217\356\373\317\256\004\r%0\257\237g\2370\r8\n\264\262\231\256v\201j\321q/o\323\201\302^wH9\035V\001\344\253\016\221d-i\252\260$\300\202\352\253\a\257\315\324\024\372\303\177\177\253\267\037\306=\262\212\201\' \035\0272\v\216\244\020?\325\314.\266\235\307\310H\245\361{\033Zt\220\256\207\226\201s\211y*Ie\213\246\352\227\027\310y8\021\255\035\032\253\322\307\373r\001\372\316\n\270\357e\"\'\240\272T(\364C\256\350m\324O\2237\257J \314\212\177\030F\016A \360Y\340CR\276}\031B\026\252\372\000\215\2711\2124\307#\313B$n\355\240\r\271\025F6\264\335\207\f7!?\005~\nc\372\363\305\220\236cj\rv~X9\237\024\231\225\bZ&\216\343\301\316\247\375\205\352\233\354\320\252\266`\035\220\000\261x\332\305\035\274\260)\251\b\f\270\267\24716R\031A\217G\312A]\3274\253\340YF%\206\356\377B\331!\314K\217\200C\3345\315\333\262#\370\356\021\307\205\017N\034\300\347I\273N\006\214\327\354g=\306\'\225\b\263!\256)`&\370H\360\310\233M\350%\221m\351\254\3208\361\330NmH\247G;\3778x\200\306\334G\245\305\357\217\217<\361\025\317\254R\251\022\024V-H\001\201\016I\273[\264H/\243\226\347\373\273\221V"
