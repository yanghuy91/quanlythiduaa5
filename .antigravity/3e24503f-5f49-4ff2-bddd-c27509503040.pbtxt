          target_content: "      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n            onImportRecords={handleImportRecords}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n            onAssignFrame={handleAssignFrame}\n            onBatchAutoAssignByRank={handleBatchAutoAssignByRank}\n          />\n        )}\n\n        {currentUser && currentRole !== \'GV\' && currentRole !== \'HS\' && (\n          <CadreView\n            currentCadre={currentUser as Student}\n            cadreRole={currentRole}\n            allStudents={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onAddRecord={handleAddRecord}\n            onVoidRecord={handleVoidRecord}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n\n        {currentUser && currentRole === \'HS\' && (\n          <StudentView\n            currentStudent={currentUser as Student}\n            allStudents={students}\n            layout={layout}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onSubmitExplanation={handleSubmitExplanation}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n          />\n        )}\n      </main>\n\n      {/* Footer with exact title \"10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\" (without teacher name) */}\n      <Footer />\n\n      {/* 8-second Toast with Undo */}\n      <Toast\n        toast={toast}\n        onUndo={handleUndoRecord}\n        onClose={() => setToast(null)}\n      />\n\n      {/* Login Gate Modal if logged out */}\n      {isLoginModalOpen && (\n        <LoginModal\n          students={students}\n          layout={layout}\n          onLoginStudent={handleLoginStudent}\n          onLoginTeacher={handleLoginTeacher}\n          classCode={settings.maLop}\n        />\n      )}\n    </div>\n  );\n}"
          replacement_content: "      {/* Header */}\n      <Header\n        currentUser={currentUser}\n        currentRole={currentRole}\n        onSwitchDemoRole={handleSwitchDemoRole}\n        onLogout={handleLogout}\n        currentWeek={currentWeek}\n        theme={theme}\n        onThemeChange={setTheme}\n        onOpenCallingGames={() => setShowCallingGamesModal(true)}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 w-full max-w-4xl mx-auto px-3 sm:px-4 py-4\">\n        {currentUser && currentRole === \'GV\' && (\n          <TeacherDashboard\n            students={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onUpdateSettings={newSets => setSettings(prev => ({ ...prev, ...newSets }))}\n            onAddRecord={handleAddRecord}\n            onResolveExplanation={handleResolveExplanation}\n            onToggleRulePin={handleToggleRulePin}\n            onUpdateLayout={handleUpdateLayout}\n            onImportRecords={handleImportRecords}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n            onAssignFrame={handleAssignFrame}\n            onBatchAutoAssignByRank={handleBatchAutoAssignByRank}\n          />\n        )}\n\n        {currentUser && currentRole !== \'GV\' && currentRole !== \'HS\' && (\n          <CadreView\n            currentCadre={currentUser as Student}\n            cadreRole={currentRole}\n            allStudents={students}\n            layout={layout}\n            rules={rules}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onAddRecord={handleAddRecord}\n            onVoidRecord={handleVoidRecord}\n            onSubmitExplanation={handleSubmitExplanation}\n          />\n        )}\n\n        {currentUser && currentRole === \'HS\' && (\n          <StudentView\n            currentStudent={currentUser as Student}\n            allStudents={students}\n            layout={layout}\n            records={records}\n            studentSummaries={studentSummaries}\n            currentWeek={currentWeek}\n            settings={settings}\n            onSubmitExplanation={handleSubmitExplanation}\n            onUpdateStudentAvatar={handleUpdateStudentAvatar}\n          />\n        )}\n      </main>\n\n      {/* Footer with exact title \"10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\" (without teacher name) */}\n      <Footer />\n\n      {/* 8-second Toast with Undo */}\n      <Toast\n        toast={toast}\n        onUndo={handleUndoRecord}\n        onClose={() => setToast(null)}\n      />\n\n      {/* 10 Calling Games Modal (Direct Launch from anywhere) */}\n      {showCallingGamesModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-slate-900/70 backdrop-blur-md animate-fadeIn\">\n          <div className=\"bg-surface rounded-3xl shadow-2xl border border-token w-full max-w-4xl max-h-[95vh] flex flex-col overflow-hidden\">\n            {/* Modal Top Header */}\n            <div className=\"px-4 py-3 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white flex items-center justify-between shrink-0\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xl\">\360\237\216\262</span>\n                <span className=\"font-extrabold text-sm sm:text-base\">10 Tr\303\262 Ch\306\241i G\341\273\215i H\341\273\215c Sinh L\303\252n B\341\272\243ng (10A5)</span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowCallingGamesModal(false)}\n                className=\"px-3.5 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold transition-all cursor-pointer shadow-xs active:scale-95\"\n              >\n                \342\206\220 Quay l\341\272\241i \341\273\251ng d\341\273\245ng\n              </button>\n            </div>\n\n            {/* Modal Body */}\n            <div className=\"flex-1 overflow-y-auto p-3 sm:p-5\">\n              <CallingGamesHub\n                students={students}\n                onQuickRecord={(st) => {\n                  setShowCallingGamesModal(false);\n                  handleSwitchDemoRole(\'GV\');\n                }}\n              />\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Login Gate Modal if logged out */}\n      {isLoginModalOpen && (\n        <LoginModal\n          students={students}\n          layout={layout}\n          onLoginStudent={handleLoginStudent}\n          onLoginTeacher={handleLoginTeacher}\n          classCode={settings.maLop}\n        />\n      )}\n    </div>\n  );\n}"
