  planner_response {
    thinking: "**Developing Modal Features**\n\nI\'m currently focused on developing the `FrameManagementModal.tsx` component. The primary function will be to provide the teacher with a preview of all six special avatar frames. This includes \"Qu\303\241n qu\303\242n Top 1,\" \"B\341\272\241ch Kim Top 2-3,\" \"Ho\303\240ng Kim Top 10,\" and \"K\341\273\267 Lu\341\272\255t Th\303\251p\" frames, among others. I\'m prioritizing the preview functionality and ensuring a smooth user experience for the teacher.\n\n\n"
    tool_calls {
      id: "call_10721821597059001856"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Student } from \'../../types\';\\nimport { AVATAR_FRAMES, CADRE_EMBLEMS, getFrameForStudent } from \'../../data/frameData\';\\nimport { AvatarFrame } from \'../common/AvatarFrame\';\\n\\ninterface FrameManagementModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  students: Student[];\\n  studentRanks?: Record<string, { rank: number; score: number }>;\\n  onAssignFrame: (studentId: string, frameId: string | undefined) => void;\\n  onBatchAutoAssignByRank: () => void;\\n}\\n\\nexport const FrameManagementModal: React.FC<FrameManagementModalProps> = ({\\n  isOpen,\\n  onClose,\\n  students,\\n  studentRanks = {},\\n  onAssignFrame,\\n  onBatchAutoAssignByRank,\\n}) => {\\n  const [searchTerm, setSearchTerm] = useState(\'\');\\n  const [selectedTo, setSelectedTo] = useState<\'all\' | 1 | 2 | 3 | 4>(\'all\');\\n  const [selectedCategory, setSelectedCategory] = useState<\'all\' | \'cadre\' | \'framed\'>(\'all\');\\n  const [notification, setNotification] = useState<string | null>(null);\\n\\n  if (!isOpen) return null;\\n\\n  const showToast = (msg: string) => {\\n    setNotification(msg);\\n    setTimeout(() => setNotification(null), 3000);\\n  };\\n\\n  const filteredStudents = students.filter((s) => {\\n    const matchesSearch =\\n      s.hoTen.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      s.maHS.toLowerCase().includes(searchTerm.toLowerCase()) ||\\n      s.viTriGhe.toString() === searchTerm;\\n    const matchesTo = selectedTo === \'all\' || s.to === selectedTo;\\n\\n    const isCadre = s.vaiTro.some((r) => [\'LT\', \'BT\', \'LP_HT\', \'LP_LD\', \'TT\'].includes(r));\\n    const isFramed = Boolean(s.customFrameId || studentRanks[s.maHS]);\\n\\n    if (selectedCategory === \'cadre\') return matchesSearch && matchesTo && isCadre;\\n    if (selectedCategory === \'framed\') return matchesSearch && matchesTo && isFramed;\\n    return matchesSearch && matchesTo;\\n  });\\n\\n  const handleApplyAuto = () => {\\n    onBatchAutoAssignByRank();\\n    showToast(\'\342\234\250 \304\220\303\243 t\341\273\261 \304\221\341\273\231ng c\341\272\255p nh\341\272\255t khung vinh danh theo b\341\272\243ng x\341\272\277p h\341\272\241ng thi \304\221ua!\');\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-sm animate-fadeIn\\\">\\n      <div className=\\\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden\\\">\\n        {/* Header */}\\n        <div className=\\\"px-6 py-4 bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 text-white flex items-center justify-between shrink-0\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <span className=\\\"text-2xl p-2 bg-white/20 rounded-xl backdrop-blur-sm\\\">\360\237\221\221</span>\\n            <div>\\n              <h2 className=\\\"text-lg sm:text-xl font-bold tracking-tight\\\">\\n                H\341\273\207 Th\341\273\221ng Huy Hi\341\273\207u & Khung Avatar Vinh Danh 10A5\\n              </h2>\\n              <p className=\\\"text-xs text-amber-100\\\">\\n                T\341\273\261 \304\221\341\273\231ng theo th\341\273\251 h\341\272\241ng thi \304\221ua ho\341\272\267c GVCN tr\341\273\261c ti\341\272\277p phong t\341\272\267ng\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-white transition-all text-sm font-bold\\\"\\n          >\\n            \342\234\225\\n          </button>\\n        </div>\\n\\n        {/* Toast Alert */}\\n        {notification && (\\n          <div className=\\\"px-6 py-2.5 bg-emerald-50 text-emerald-800 text-xs font-semibold border-b border-emerald-200 flex items-center justify-between animate-fadeIn\\\">\\n            <span>{notification}</span>\\n            <button onClick={() => setNotification(null)} className=\\\"text-emerald-600 hover:underline\\\">\\n              \304\220\303\263ng\\n            </button>\\n          </div>\\n        )}\\n\\n        {/* Content Body */}\\n        <div className=\\\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-6\\\">\\n          {/* Showcase of Available Frames */}\\n          <section className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between flex-wrap gap-2\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2\\\">\\n                <span>\342\234\250</span> Danh S\303\241ch 6 Khung \304\220\341\272\267c S\341\272\257c\\n              </h3>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleApplyAuto}\\n                className=\\\"px-3.5 py-1.5 text-xs font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-lg shadow-sm transition-all flex items-center gap-1.5 cursor-pointer active:scale-95\\\"\\n              >\\n                <span>\342\232\241</span> T\341\273\261 \304\221\341\273\231ng phong t\341\272\267ng theo Top BXH\\n              </button>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\\\">\\n              {AVATAR_FRAMES.map((f) => (\\n                <div\\n                  key={f.id}\\n                  className=\\\"p-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-amber-300 transition-all flex items-start gap-3 shadow-xs\\\"\\n                >\\n                  <AvatarFrame frame={f} size=\\\"md\\\">\\n                    <span className=\\\"text-lg\\\">{f.icon}</span>\\n                  </AvatarFrame>\\n                  <div className=\\\"flex-1 min-w-0\\\">\\n                    <h4 className=\\\"text-xs font-bold text-slate-900 truncate\\\">{f.name}</h4>\\n                    <p className=\\\"text-[11px] text-slate-500 leading-snug line-clamp-2 mt-0.5\\\">\\n                      {f.description}\\n                    </p>\\n                    <span\\n                      className={`inline-block mt-1 text-[9px] font-bold px-1.5 py-0.5 rounded-full ${f.tagClass}`}\\n                    >\\n                      {f.tagLabel}\\n                    </span>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n\\n          {/* Cadre Emblems Preview */}\\n          <section className=\\\"p-3.5 bg-slate-100/70 rounded-xl border border-slate-200 space-y-2\\\">\\n            <h4 className=\\\"text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5\\\">\\n              <span>\360\237\233\241\357\270\217</span> Bi\341\273\203u T\306\260\341\273\243ng Ban C\303\241n S\341\273\261 L\341\273\233p & T\341\273\225 Tr\306\260\341\273\237ng\\n            </h4>\\n            <div className=\\\"flex flex-wrap gap-2\\\">\\n              {Object.values(CADRE_EMBLEMS).map((c) => (\\n                <div\\n                  key={c.code}\\n                  className=\\\"flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg border border-slate-200 text-xs shadow-xs\\\"\\n                >\\n                  <span className=\\\"text-base\\\">{c.icon}</span>\\n                  <span className=\\\"font-semibold text-slate-800\\\">{c.shortLabel}</span>\\n                  <span className={`text-[9px] font-bold px-1 rounded ${c.badgeClass}`}>\\n                    {c.code}\\n                  </span>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n\\n          {/* Student Assignment List */}\\n          <section className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between flex-wrap gap-2\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\\\">\\n                <span>\360\237\221\245</span> Danh S\303\241ch 42 H\341\273\215c Sinh & Qu\341\272\243n L\303\275 Khung\\n              </h3>\\n              <span className=\\\"text-xs text-slate-500 font-medium\\\">\\n                Hi\341\273\203n th\341\273\213: <b>{filteredStudents.length}</b> / {students.length} h\341\273\215c sinh\\n              </span>\\n            </div>\\n\\n            {/* Filter controls */}\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <div className=\\\"relative flex-1 min-w-[180px]\\\">\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"T\303\254m theo h\341\273\215 t\303\252n, m\303\243 HS, s\341\273\221 b\303\240n...\\\"\\n                  value={searchTerm}\\n                  onChange={(e) => setSearchTerm(e.target.value)}\\n                  className=\\\"w-full px-3 py-1.5 pl-8 text-xs bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500\\\"\\n                />\\n                <span className=\\\"absolute left-2.5 top-2 text-slate-400 text-xs\\\">\360\237\224\215</span>\\n                {searchTerm && (\\n                  <button\\n                    onClick={() => setSearchTerm(\'\')}\\n                    className=\\\"absolute right-2 top-1.5 text-xs text-slate-400 hover:text-slate-600\\\"\\n                  >\\n                    \342\234\225\\n                  </button>\\n                )}\\n              </div>\\n\\n              {/* T\341\273\225 filter */}\\n              <select\\n                value={selectedTo}\\n                onChange={(e) =>\\n                  setSelectedTo(e.target.value === \'all\' ? \'all\' : (Number(e.target.value) as 1 | 2 | 3 | 4))\\n                }\\n                className=\\\"px-2.5 py-1.5 text-xs bg-white border border-slate-300 rounded-lg text-slate-700\\\"\\n              >\\n                <option value=\\\"all\\\">T\341\272\245t c\341\272\243 c\303\241c T\341\273\225</option>\\n                <option value=\\\"1\\\">T\341\273\225 1</option>\\n                <option value=\\\"2\\\">T\341\273\225 2</option>\\n                <option value=\\\"3\\\">T\341\273\225 3</option>\\n                <option value=\\\"4\\\">T\341\273\225 4</option>\\n              </select>\\n\\n              {/* Category filter */}\\n              <select\\n                value={selectedCategory}\\n                onChange={(e) => setSelectedCategory(e.target.value as any)}\\n                className=\\\"px-2.5 py-1.5 text-xs bg-white border border-slate-300 rounded-lg text-slate-700\\\"\\n              >\\n                <option value=\\\"all\\\">T\341\272\245t c\341\272\243 h\341\273\215c sinh</option>\\n                <option value=\\\"cadre\\\">Ban C\303\241n s\341\273\261 & T\341\273\225 tr\306\260\341\273\237ng</option>\\n                <option value=\\\"framed\\\">\304\220ang c\303\263 Khung/Top</option>\\n              </select>\\n            </div>\\n\\n            {/* Student Table */}\\n            <div className=\\\"border border-slate-200 rounded-xl overflow-hidden shadow-xs\\\">\\n              <div className=\\\"max-h-80 overflow-y-auto divide-y divide-slate-100\\\">\\n                {filteredStudents.length === 0 ? (\\n                  <div className=\\\"p-8 text-center text-slate-400 text-xs\\\">\\n                    Kh\303\264ng t\303\254m th\341\272\245y h\341\273\215c sinh n\303\240o ph\303\271 h\341\273\243p b\341\273\231 l\341\273\215c.\\n                  </div>\\n                ) : (\\n                  filteredStudents.map((s) => {\\n                    const rankInfo = studentRanks[s.maHS];\\n                    const activeFrame = getFrameForStudent(\\n                      rankInfo?.rank,\\n                      rankInfo?.score,\\n                      s.customFrameId\\n                    );\\n\\n                    // Cadre badge check\\n                    let cadreRoleKey: string | undefined;\\n                    if (s.vaiTro.includes(\'LT\')) cadreRoleKey = \'LT\';\\n                    else if (s.vaiTro.includes(\'BT\')) cadreRoleKey = \'BT\';\\n                    else if (s.vaiTro.includes(\'LP_HT\')) cadreRoleKey = \'LP_HT\';\\n                    else if (s.vaiTro.includes(\'LP_LD\')) cadreRoleKey = \'LP_LD\';\\n                    else if (s.vaiTro.includes(\'TT\')) cadreRoleKey = `TT_${s.to}`;\\n\\n                    return (\\n                      <div\\n                        key={s.maHS}\\n                        className=\\\"p-2.5 sm:p-3 hover:bg-slate-50 transition-colors flex items-center justify-between gap-3\\\"\\n                      >\\n                        {/* Student avatar & info */}\\n                        <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                          <AvatarFrame frame={activeFrame} cadreRole={cadreRoleKey} size=\\\"sm\\\">\\n                            {s.avatarUrl ? (\\n                              <img\\n                                src={s.avatarUrl}\\n                                alt={s.hoTen}\\n                                className=\\\"w-full h-full object-cover rounded-full\\\"\\n                              />\\n                            ) : (\\n                              <div\\n                                className={`w-full h-full rounded-full flex items-center justify-center font-bold text-xs ${\\n                                  s.gioiTinh === \'Nu\'\\n                                    ? \'bg-rose-100 text-rose-700\'\\n                                    : \'bg-sky-100 text-sky-700\'\\n                                }`}\\n                              >\\n                                {s.tenRutGon.slice(-2)}\\n                              </div>\\n                            )}\\n                          </AvatarFrame>\\n\\n                          <div className=\\\"min-w-0\\\">\\n                            <div className=\\\"flex items-center gap-1.5 flex-wrap\\\">\\n                              <span className=\\\"font-bold text-slate-900 text-xs sm:text-sm\\\">\\n                                {s.hoTen}\\n                              </span>\\n                              <span\\n                                className={`text-[10px] px-1.5 py-0.2 rounded font-medium ${\\n                                  s.gioiTinh === \'Nu\'\\n                                    ? \'bg-rose-100 text-rose-700\'\\n                                    : \'bg-sky-100 text-sky-700\'\\n                                }`}\\n                              >\\n                                {s.gioiTinh === \'Nu\' ? \'N\341\273\257\' : \'Nam\'}\\n                              </span>\\n                              <span className=\\\"text-[10px] text-slate-400\\\">\\n                                Gh\341\272\277 #{s.viTriGhe} \302\267 T\341\273\225 {s.to}\\n                              </span>\\n                            </div>\\n                            <div className=\\\"flex items-center gap-1.5 mt-0.5 text-[11px] text-slate-500\\\">\\n                              <span>M\303\243: {s.maHS}</span>\\n                              {rankInfo && (\\n                                <span className=\\\"font-semibold text-amber-700\\\">\\n                                  H\341\272\241ng #{rankInfo.rank} ({rankInfo.score}\304\221)\\n                                </span>\\n                              )}\\n                              {s.customFrameId && (\\n                                <span className=\\\"text-[10px] text-purple-600 bg-purple-50 px-1 rounded font-medium border border-purple-200\\\">\\n                                  GV ch\341\273\211 \304\221\341\273\213nh\\n                                </span>\\n                              )}\\n                            </div>\\n                          </div>\\n                        </div>\\n\\n                        {/* Assign Frame dropdown */}\\n                        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                          <select\\n                            value={s.customFrameId || \'\'}\\n                            onChange={(e) => {\\n                              const val = e.target.value;\\n                              onAssignFrame(s.maHS, val ? val : undefined);\\n                              showToast(`\304\220\303\243 c\341\272\255p nh\341\272\255t khung cho ${s.hoTen}!`);\\n                            }}\\n                            className=\\\"text-xs bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500 max-w-[150px] sm:max-w-[200px]\\\"\\n                          >\\n                            <option value=\\\"\\\">(M\341\272\267c \304\221\341\273\213nh theo BXH)</option>\\n                            {AVATAR_FRAMES.map((f) => (\\n                              <option key={f.id} value={f.id}>\\n                                {f.icon} {f.name}\\n                              </option>\\n                            ))}\\n                          </select>\\n\\n                          {s.customFrameId && (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => {\\n                                onAssignFrame(s.maHS, undefined);\\n                                showToast(`\304\220\303\243 x\303\263a khung ch\341\273\211 \304\221\341\273\213nh c\341\273\247a ${s.hoTen}`);\\n                              }}\\n                              title=\\\"X\303\263a khung t\303\271y ch\341\273\211nh, quay l\341\272\241i t\341\273\261 \304\221\341\273\231ng\\\"\\n                              className=\\\"text-xs text-slate-400 hover:text-red-500 p-1\\\"\\n                            >\\n                              \342\234\225\\n                            </button>\\n                          )}\\n                        </div>\\n                      </div>\\n                    );\\n                  })\\n                )}\\n              </div>\\n            </div>\\n          </section>\\n        </div>\\n\\n        {/* Footer */}\\n        <div className=\\\"px-6 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between shrink-0\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">\\n            Khung v\303\240 huy hi\341\273\207u hi\341\273\203n th\341\273\213 tr\341\273\261c ti\341\272\277p tr\303\252n S\306\241 \304\221\341\273\223 l\341\273\233p, B\341\272\243ng x\341\272\277p h\341\272\241ng v\303\240 H\341\273\223 s\306\241 c\303\241 nh\303\242n.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"px-4 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg shadow-sm transition-all\\\"\\n          >\\n            \304\220\303\263ng\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create FrameManagementModal for GVCN to assign or auto-award special frames and badges\", \"Overwrite\":true, \"TargetFile\":\"/src/components/teacher/FrameManagementModal.tsx\", \"toolAction\":\"Writing FrameManagementModal component\", \"toolSummary\":\"Create FrameManagementModal component\"}"
      thinking_signature: "\022\247\t\n\244\t\001i\024}\023\242\325\276VU\031\331#,\006\206`\2628\256\034f\200~g\024\247\231\207^\002\204f\t\357\022\025\352xs\361\372\343\361\277\337W\030\032\020\r\350\210H\023\237N\254\027|\020/\303\233\251Gd\035\237J@\214\036\234\332z\226\245\251&/\033\350\304\333\244\252)\v\257\3323\3149*\022\225\233\352\024b\024\330<\272\nm\221\327\246\203\253\324\031\251\321n\220X\300\217\343=\222\322\340c\3028\243Ka\277\372\231\252E\345\316\207}}\030\222\272\277S\227\177V\214\347X9\324\\\n\315\202\377\024\002b\220\234\003\037\225\331+[\266\vh\224\304\262\267\020\211\204\t\035\277\332`\353{2ji%.\311J\004\361\212\227\340\260\006\337\323\335Qc=\204\004]D\233J\343\322o,\264\255\'\226R\344V\332M\205\t\252\320]*!\340\321\320\024\370\366\246\2604H\b\247\000\306p\020Z\254\315\334z\261Z\351\356|\021\276(*|&\272\372#\336\377\322\365\220\321n\016\202\203\203#S\304J\v\305\262=k\311\377&S\307\031\232\322K\001\n<\364\300O\324\032\355\002R\210\234\215\343\360\330\231\301\244Y\342>\023\274\3328E\267\035J\371qQ\262\322i$\344\374\300\266A&\203D\252\277j\317\3665\264\032S$<~T\021\336*\001\306\027\366C\226\233\202\320@\\\023\324>\366\356\n\222\346\272\021\206y\264:\253\232G\303\375\205\370\222\272q\026&e^\200\036@jJu\323\352\343\034\335\265;R\262\363\030;\022\376\3326\303|\fHkS\221\255=\246zj=\v\247\375g\023\277;=b0I/x\327\247x\243\302\330c\303\317\332\3058\002\276\256@\310\177~\030h\036P+1\203r\217\267\351\210\253\265j\302\321*\342lR\\\330\354F\221\312\370~\226\320f\345\350\233u\vUx\320\034\021\v\314\037\303]eLB>\b\250iU\217\321\326\333\330,\021\307\247\376x\272\241\350\356n#\027\305\312\324*@\001\a\361\020^d\005\350\362\353\365\327?\250\350\333\211\223\354\364\"\265n\237\223\2451\003\254\b\n\227\360\222\237u\'*#3\374\bO\2723\211\360\254\333\363\276\215\334\211ZY#l\242\310\257h[1\323ZX>\346#\216\373\024:\205\256\250\361x\230\275\331\303*\327N\304\207M\020\247,6\246\346^\262n\306TC\350\351\016\217sD\341<\360l\332\230\006\221\367\254\327\252\030\267\367\2345\\1\313\246\360\377#\375\321\022\254\204\300\361\221\334\033\326\303k\037\236\234\362\a\367\222\265\353\331Q\230\331T \366\271\266+\205\321\261%a\253R\270;_\305C\374u\326f\b\307z\235\250\223\213W\362\332\252\'\314X,d\301\2446\371\362\255\250\201\226!\305\353\353;\227V\206\002\372\037\371\266\263K\225^\222\r{\023@\254W\311}\372\2734\367\221O\336\"\327\002?\261\026\r@\367\247@\n\273%\270B\263\276S\261$\262\275\027\265\234\207\224%,\177\177\364\307\274\326/RC9\346zb! 4\362\256\031i2u\332X\023\222\367\211\371\223\376\b\022DVu\377x\232\3374\243\310[\243i|\230g\000Amh\270\222$w~\3555[,\221.m\036F9\323I=\311\021\\%\030VSe\a\\\341<\t\371\226Zn\222\234lC\v\372rn\363`L\263\215\000,\2621?\221\371\362^6}\210i\302F\017\026+\237\226\032B\265\232\243W\201\327ti\036\0005z\332\246\354\205\b\265\264-\204~{rs\tf\b\206\342|\244\263\232\3663\211\037\330\272\033Y\305\322\211W\376\301V\005a3.\314\3511\313\026\310\257\335l\371\355:\f\257qB\rtt\300t\034\020\304\370\002\242\'\235O(\363\263\204\243\320\375\341\032\257\224\000H_Z\005\321G\376\370\244\341\006;f/\a=\233V_2-`\316\311\20180H/\033}*3\326\323k%\003\341\v6TRq9\271\375\307H\261!>i\324\333D\017u\271|\027\322\337\322\356\261\246u\021A\350\320F\373\316\312\275*\260B\037\347\224\311Q\267B\f\2644\370\212\202\303>\270f\337O\200R\202\364,\262\313\021\301\243\316[K\364\364\0175\324\231\327y\230\006>\335\236\251\242\034\371>%\340\f\030\f\222 \a\232U\344\264\310H3k\254B\203\002e\340`\201\234\236\325k\313"
