      thinking_signature: "\022\231\t\n\226\t\001i\024}\023\220\360\351\326;\222[\234\200\363\357\211z/tG\324\004`\306\177\236\346\207-\274\277\205V\030\002\235n\224\035\003\006^\000\340\230o\323\305\222\037P\217\253\355\376LS\365\336\205\267\"\267i\364t\003\317\030t\363\332\217\016\325s\370\322\004~\214\324\255Ir\265\"\030\261\237\343\362\035l\244\222\260\346\355\227i\250\307.\375.\321\366\225x\275sM\277\266\224\024)\000\300\234_\347\342K%c,\322mIAS\0229\326\000\315t\'\340Ri\301\356\016\351\251l\034\026\016\240p\232\315\306^\2677[\246~Y\260\fh\004\366v\265\343\273\024\332\356\a\254\315\275\320\252\a\213H\261\341\332\363\332\326\034\0065h\341:`= \371\224l\202\to\233`\221\241\201\004bm\277\234\024;\260\022j~\"^\236\372T\361\325\317\031\330M4.\242Io\227j\222\037\'\247\024\263\315\251\362!\370\r\325\016\v\326\334!\261Jp4| \2011\026\245\202\252\346\342 \335\302\265\220\361\200\021\b;Q\236\036\310\006\350c\024\270iE\000\332\350\316 \230m\b\260i\261\357,p\332w\b\b\210\376O\312&\210\322cJ\033X\222\233\345\267\263\207p:\372\177@\250\365\350\240\240\b9h\265P\006\354r(CP\037\375\267\252>\t\202\336\2463\016\337X\305{\260\242\271\213\031b\375p\204\214a>\207G\016}T\f>S:\'\017\027\340\365oZH\212\037\205&\232\000\372sr\274\357 ;\344\3005\"#an\016\234\005\216\030\235x#k=O#\333\214\242 \232\345\234\347u\244\370Z\206\031TJj\325f[1\233\035\201\027V\277k\232G\344\230%\353\366\264B\215\227\266\210\304\363\303\0016\360\351\366w\277\350\347s\357V\033WMJ\222\2548\206\031W\305\252\266Yi\232\307J\262\221\3131dO\204\353\265\036/Em\241&\026ZX\2707\262i\223\031#{\002\004\370\023\376\365\3776`D\222\302_&\300\025\034\273I\333\233f\034>\325.\205\227\354\000{\303G\323l\202\'\330}\222\244\022[K\351D@\256\274A\257\260\363r\313;\216T\306\302\260\304\243\000\023\033\373\017\362\371\354\203\212\251\274/o\r\260\032\312\031y\242\272\257N!\325G)\225\202\305\312\355`}\206t\334\365-\016\236\375\261\260\241!\216\vL^\212\021V8\270\365\002\374\001f\213\354\033\263p\311kr\237\222\210V\224)\"3l\241\315V\330\221\3