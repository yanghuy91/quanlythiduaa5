  planner_response {
    thinking: "**Designing the Editor**\n\nI\'m focusing now on building `src/components/teacher/ClassroomLayoutEditor.tsx`. I need to design this so the GVCN can drag and drop student positions, rearrange door locations, and adjust teacher desk placements, as required. My priority is to ensure the UI is intuitive and responsive for a smooth user experience.\n\n\n**Refining Swap Logic**\n\nI\'ve been drilling down on the drag-and-drop and the mobile click-to-swap mechanics. The logic for `onDrop` is crucial, handling seat swaps and student movements with great care. I\'m focusing on the user experience in the mobile click-to-swap mode, with instant swaps and clear confirmation banners. I\'m also preparing for the implementation of the button to cancel the swap. Next, I\'ll move on to the architectural elements like doors and desks.\n\n\n**Defining Element Types**\n\nI\'m now outlining the different elements that will make up the classroom layout. This includes teacher desks, doors, podiums, aisles, empty spaces, and student seats. The interface will likely feature either a click-to-paint system or mini-inspectors that pop up when clicking cells, which will open a mini-inspector to allow quick cell assignment. I need to make the editor\'s \"Edit Architectural Structure\" mode a simple toggle.\n\n\n"
    tool_calls {
      id: "call_3482963028416766529"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { \\n  Move, \\n  RotateCcw, \\n  Save, \\n  Armchair, \\n  DoorOpen, \\n  BookOpen, \\n  Check, \\n  X, \\n  Shuffle, \\n  Sparkles,\\n  Info,\\n  ArrowRightLeft,\\n  Settings2,\\n  Trash2,\\n  Plus\\n} from \'lucide-react\';\\nimport { Student, SeatLayoutNode, SeatNodeType, RoleCode } from \'../../types\';\\nimport { CADRE_ROLES_INFO } from \'../../data/badgeData\';\\n\\ninterface ClassroomLayoutEditorProps {\\n  initialLayout: SeatLayoutNode[];\\n  initialStudents: Student[];\\n  onSave: (newLayout: SeatLayoutNode[], updatedStudents: Student[]) => void;\\n  onClose: () => void;\\n}\\n\\nexport const ClassroomLayoutEditor: React.FC<ClassroomLayoutEditorProps> = ({\\n  initialLayout,\\n  initialStudents,\\n  onSave,\\n  onClose,\\n}) => {\\n  const [layout, setLayout] = useState<SeatLayoutNode[]>(() => JSON.parse(JSON.stringify(initialLayout)));\\n  const [students, setStudents] = useState<Student[]>(() => JSON.parse(JSON.stringify(initialStudents)));\\n  \\n  // Drag and drop state\\n  const [draggedNode, setDraggedNode] = useState<{ hang: number; cot: number; maHS?: string } | null>(null);\\n  const [dragOverNode, setDragOverNode] = useState<{ hang: number; cot: number } | null>(null);\\n  \\n  // Click-to-swap state (for mobile touchscreens)\\n  const [selectedSlotForSwap, setSelectedSlotForSwap] = useState<{ hang: number; cot: number; maHS?: string } | null>(null);\\n\\n  // Structure edit mode\\n  const [mode, setMode] = useState<\'seating\' | \'structure\'>(\'seating\');\\n  const [activeStructureTool, setActiveStructureTool] = useState<SeatNodeType>(\'banGV\');\\n  const [hasChanges, setHasChanges] = useState(false);\\n  const [feedbackMsg, setFeedbackMsg] = useState<string | null>(null);\\n\\n  // Map student by ID\\n  const studentMap = useMemo(() => {\\n    const map = new Map<string, Student>();\\n    students.forEach(s => map.set(s.maHS, s));\\n    return map;\\n  }, [students]);\\n\\n  // Group nodes by row\\n  const rows = useMemo(() => {\\n    const grouped: Record<number, SeatLayoutNode[]> = {};\\n    layout.forEach(node => {\\n      if (!grouped[node.hang]) {\\n        grouped[node.hang] = [];\\n      }\\n      grouped[node.hang].push(node);\\n    });\\n\\n    Object.keys(grouped).forEach(r => {\\n      grouped[Number(r)].sort((a, b) => a.cot - b.cot);\\n    });\\n\\n    return grouped;\\n  }, [layout]);\\n\\n  // Show a temporary feedback message\\n  const showFeedback = (msg: string) => {\\n    setFeedbackMsg(msg);\\n    setTimeout(() => {\\n      setFeedbackMsg(prev => (prev === msg ? null : prev));\\n    }, 4000);\\n  };\\n\\n  // Swap two slots in layout and recalculate positions if needed\\n  const performSwap = (\\n    src: { hang: number; cot: number; maHS?: string },\\n    tgt: { hang: number; cot: number; maHS?: string }\\n  ) => {\\n    if (src.hang === tgt.hang && src.cot === tgt.cot) {\\n      setSelectedSlotForSwap(null);\\n      return;\\n    }\\n\\n    const newLayout = [...layout];\\n    const srcIndex = newLayout.findIndex(n => n.hang === src.hang && n.cot === src.cot);\\n    const tgtIndex = newLayout.findIndex(n => n.hang === tgt.hang && n.cot === tgt.cot);\\n\\n    if (srcIndex === -1 || tgtIndex === -1) return;\\n\\n    const srcNode = newLayout[srcIndex];\\n    const tgtNode = newLayout[tgtIndex];\\n\\n    // If both are student seats (or empty/student seats)\\n    if (mode === \'seating\') {\\n      const srcStudent = srcNode.maHS ? studentMap.get(srcNode.maHS) : undefined;\\n      const tgtStudent = tgtNode.maHS ? studentMap.get(tgtNode.maHS) : undefined;\\n\\n      // Swap students\\n      const tempMaHS = srcNode.maHS;\\n      srcNode.maHS = tgtNode.maHS;\\n      tgtNode.maHS = tempMaHS;\\n\\n      // If one was \'trong\', convert to \'ghe\' if receiving a student\\n      if (tgtNode.loaiO === \'trong\' && tgtNode.maHS) {\\n        tgtNode.loaiO = \'ghe\';\\n      }\\n      if (srcNode.loaiO === \'ghe\' && !srcNode.maHS) {\\n        srcNode.loaiO = \'trong\';\\n      }\\n\\n      // Update student positions (dayBan, soBan)\\n      const updatedStudents = students.map(s => {\\n        if (srcStudent && s.maHS === srcStudent.maHS) {\\n          return {\\n            ...s,\\n            dayBan: getDayFromCot(tgt.cot),\\n            soBan: getBanFromHang(tgt.hang)\\n          };\\n        }\\n        if (tgtStudent && s.maHS === tgtStudent.maHS) {\\n          return {\\n            ...s,\\n            dayBan: getDayFromCot(src.cot),\\n            soBan: getBanFromHang(src.hang)\\n          };\\n        }\\n        return s;\\n      });\\n\\n      setLayout(newLayout);\\n      setStudents(updatedStudents);\\n      setHasChanges(true);\\n\\n      const srcName = srcStudent?.hoTen || \'Ch\341\273\227 tr\341\273\221ng\';\\n      const tgtName = tgtStudent?.hoTen || \'Ch\341\273\227 tr\341\273\221ng\';\\n      showFeedback(`\304\220\303\243 ho\303\241n \304\221\341\273\225i v\341\273\213 tr\303\255: ${srcName} \342\207\204 ${tgtName}`);\\n    } else {\\n      // In structure mode, swap entire node types & notes\\n      const tempType = srcNode.loaiO;\\n      const tempNote = srcNode.ghiChu;\\n      const tempMaHS = srcNode.maHS;\\n\\n      srcNode.loaiO = tgtNode.loaiO;\\n      srcNode.ghiChu = tgtNode.ghiChu;\\n      srcNode.maHS = tgtNode.maHS;\\n\\n      tgtNode.loaiO = tempType;\\n      tgtNode.ghiChu = tempNote;\\n      tgtNode.maHS = tempMaHS;\\n\\n      setLayout(newLayout);\\n      setHasChanges(true);\\n      showFeedback(`\304\220\303\243 ho\303\241n \304\221\341\273\225i c\341\272\245u tr\303\272c gi\341\273\257a \303\264 (${src.hang}, ${src.cot}) v\303\240 (${tgt.hang}, ${tgt.cot})`);\\n    }\\n\\n    setSelectedSlotForSwap(null);\\n    setDraggedNode(null);\\n    setDragOverNode(null);\\n  };\\n\\n  // Helper to get D\303\243y b\303\240n (1..6) from column index\\n  const getDayFromCot = (cot: number): number => {\\n    if (cot === 0) return 1;\\n    if (cot === 1) return 2;\\n    if (cot === 3) return 3;\\n    if (cot === 4) return 4;\\n    if (cot === 6) return 5;\\n    if (cot === 7) return 6;\\n    return 1;\\n  };\\n\\n  // Helper to get S\341\273\221 b\303\240n (1..4) from row index\\n  const getBanFromHang = (hang: number): number => {\\n    if (hang <= 2) return 1;\\n    if (hang <= 4) return 2;\\n    if (hang <= 6) return 3;\\n    return 4;\\n  };\\n\\n  // Handle cell click\\n  const handleCellClick = (node: SeatLayoutNode) => {\\n    if (mode === \'structure\') {\\n      // Apply active structure tool to this node\\n      const newLayout = layout.map(n => {\\n        if (n.hang === node.hang && n.cot === node.cot) {\\n          return {\\n            ...n,\\n            loaiO: activeStructureTool,\\n            ghiChu: activeStructureTool === \'cua\' ? \'C\341\273\255a ra v\303\240o\' :\\n                    activeStructureTool === \'banGV\' ? \'B\303\240n Gi\303\241o vi\303\252n\' :\\n                    activeStructureTool === \'buc\' ? \'B\341\273\245c gi\341\272\243ng\' :\\n                    activeStructureTool === \'loidi\' ? \'L\341\273\221i \304\221i\' :\\n                    activeStructureTool === \'trong\' ? \'V\341\273\213 tr\303\255 tr\341\273\221ng\' : \'B\303\240n h\341\273\215c sinh\',\\n            maHS: activeStructureTool === \'ghe\' ? n.maHS : undefined\\n          };\\n        }\\n        return n;\\n      });\\n      setLayout(newLayout);\\n      setHasChanges(true);\\n      showFeedback(`\304\220\303\243 chuy\341\273\203n \303\264 (${node.hang}, ${node.cot}) th\303\240nh ${activeStructureTool}`);\\n      return;\\n    }\\n\\n    // Seating Mode: Click-to-swap\\n    if (!selectedSlotForSwap) {\\n      if (node.loaiO === \'loidi\' || node.loaiO === \'cua\' || node.loaiO === \'banGV\' || node.loaiO === \'buc\') {\\n        showFeedback(\'Vui l\303\262ng ch\341\273\215n \303\264 gh\341\272\277 h\341\273\215c sinh ho\341\272\267c v\341\273\213 tr\303\255 tr\341\273\221ng \304\221\341\273\203 \304\221\341\273\225i ch\341\273\227.\');\\n        return;\\n      }\\n      setSelectedSlotForSwap({ hang: node.hang, cot: node.cot, maHS: node.maHS });\\n      const student = node.maHS ? studentMap.get(node.maHS) : undefined;\\n      showFeedback(`\304\220ang ch\341\273\215n: ${student ? student.hoTen : \'Ch\341\273\227 tr\341\273\221ng\'}. Ch\341\272\241m \303\264 ti\341\272\277p theo \304\221\341\273\203 ho\303\241n \304\221\341\273\225i!`);\\n    } else {\\n      performSwap(selectedSlotForSwap, { hang: node.hang, cot: node.cot, maHS: node.maHS });\\n    }\\n  };\\n\\n  // HTML5 Drag Events\\n  const handleDragStart = (e: React.DragEvent, node: SeatLayoutNode) => {\\n    if (node.loaiO === \'loidi\') {\\n      e.preventDefault();\\n      return;\\n    }\\n    setDraggedNode({ hang: node.hang, cot: node.cot, maHS: node.maHS });\\n    e.dataTransfer.setData(\'text/plain\', JSON.stringify({ hang: node.hang, cot: node.cot, maHS: node.maHS }));\\n    e.dataTransfer.effectAllowed = \'move\';\\n  };\\n\\n  const handleDragOver = (e: React.DragEvent, node: SeatLayoutNode) => {\\n    e.preventDefault();\\n    e.dataTransfer.dropEffect = \'move\';\\n    if (!dragOverNode || dragOverNode.hang !== node.hang || dragOverNode.cot !== node.cot) {\\n      setDragOverNode({ hang: node.hang, cot: node.cot });\\n    }\\n  };\\n\\n  const handleDrop = (e: React.DragEvent, targetNode: SeatLayoutNode) => {\\n    e.preventDefault();\\n    if (!draggedNode) return;\\n    performSwap(draggedNode, { hang: targetNode.hang, cot: targetNode.cot, maHS: targetNode.maHS });\\n  };\\n\\n  // Preset: Move Teacher Desk to Left vs Right\\n  const applyPresetTeacherDesk = (side: \'left\' | \'right\') => {\\n    const newLayout = layout.map(node => {\\n      if (node.hang === 0) {\\n        if (side === \'left\') {\\n          // B\303\240n GV at col 0, 1; B\341\273\245c col 3, 4; C\341\273\255a col 7\\n          if (node.cot === 0 || node.cot === 1) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n Gi\303\241o vi\303\252n\' };\\n          if (node.cot === 7) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a tr\306\260\341\273\233c\' };\\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\273\245c gi\341\272\243ng\' };\\n        } else {\\n          // Standard: C\341\273\255a col 0; B\341\273\245c col 3, 4; B\303\240n GV col 6, 7\\n          if (node.cot === 0) return { ...node, loaiO: \'cua\' as SeatNodeType, ghiChu: \'C\341\273\255a tr\306\260\341\273\233c\' };\\n          if (node.cot === 6 || node.cot === 7) return { ...node, loaiO: \'banGV\' as SeatNodeType, ghiChu: \'B\303\240n Gi\303\241o vi\303\252n\' };\\n          if (node.cot === 3 || node.cot === 4) return { ...node, loaiO: \'buc\' as SeatNodeType, ghiChu: \'B\341\273\245c gi\341\272\243ng\' };\\n        }\\n      }\\n      return node;\\n    });\\n    setLayout(newLayout);\\n    setHasChanges(true);\\n    showFeedback(`\304\220\303\243 chuy\341\273\203n B\303\240n Gi\303\241o vi\303\252n sang b\303\252n ${side === \'left\' ? \'Tr\303\241i\' : \'Ph\341\272\243i\'}`);\\n  };\\n\\n  // Reset to default initial layout\\n  const handleReset = () => {\\n    if (window.confirm(\'Kh\303\264i ph\341\273\245c l\341\272\241i s\306\241 \304\221\341\273\223 v\341\273\213 tr\303\255 ban \304\221\341\272\247u?\')) {\\n      setLayout(JSON.parse(JSON.stringify(initialLayout)));\\n      setStudents(JSON.parse(JSON.stringify(initialStudents)));\\n      setSelectedSlotForSwap(null);\\n      setHasChanges(false);\\n      showFeedback(\'\304\220\303\243 kh\303\264i ph\341\273\245c l\341\272\241i s\306\241 \304\221\341\273\223 g\341\273\221c.\');\\n    }\\n  };\\n\\n  // Save changes\\n  const handleSave = () => {\\n    onSave(layout, students);\\n    setHasChanges(false);\\n    onClose();\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/70 backdrop-blur-xs animate-fade-in\\\">\\n      <div \\n        className=\\\"w-full max-w-4xl bg-surface border border-token rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[95vh] animate-scale-up\\\"\\n        onClick={e => e.stopPropagation()}\\n      >\\n        {/* Header */}\\n        <div className=\\\"p-4 sm:p-5 bg-gradient-to-r from-blue-500/15 via-accent/10 to-purple-500/15 border-b border-token flex items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-2xl bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0\\\">\\n              <Move className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h3 className=\\\"text-base sm:text-lg font-extrabold text-main leading-tight\\\">\\n                  S\341\272\257p x\341\272\277p S\306\241 \304\221\341\273\223 &amp; K\303\251o th\341\272\243 Ch\341\273\227 ng\341\273\223i\\n                </h3>\\n                <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-accent/20 text-accent\\\">\\n                  D\303\240nh cho GVCN\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-muted mt-0.5\\\">\\n                K\303\251o th\341\272\243 ho\341\272\267c ch\341\272\241m 2 \303\264 \304\221\341\273\203 ho\303\241n \304\221\341\273\225i v\341\273\213 tr\303\255 h\341\273\215c sinh, b\341\273\221 tr\303\255 c\341\273\255a, b\303\240n GV, b\341\273\245c gi\341\272\243ng\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={handleReset}\\n              className=\\\"px-3 py-1.5 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main hover:bg-surface-2 transition-colors flex items-center gap-1.5 cursor-pointer\\\"\\n              title=\\\"Kh\303\264i ph\341\273\245c s\306\241 \304\221\341\273\223 g\341\273\221c\\\"\\n            >\\n              <RotateCcw className=\\\"w-3.5 h-3.5\\\" />\\n              <span className=\\\"hidden sm:inline\\\">Kh\303\264i ph\341\273\245c</span>\\n            </button>\\n            <button\\n              onClick={handleSave}\\n              className=\\\"px-4 py-1.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 shadow-md transition-opacity flex items-center gap-1.5 cursor-pointer\\\"\\n            >\\n              <Save className=\\\"w-3.5 h-3.5\\\" />\\n              <span>L\306\260u s\306\241 \304\221\341\273\223</span>\\n            </button>\\n            <button\\n              onClick={onClose}\\n              className=\\\"p-1.5 rounded-xl text-muted hover:text-main hover:bg-surface-2 transition-colors cursor-pointer\\\"\\n              aria-label=\\\"\304\220\303\263ng\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Toolbar & Mode Switcher */}\\n        <div className=\\\"px-4 py-2.5 bg-surface-2 border-b border-token flex flex-wrap items-center justify-between gap-2.5\\\">\\n          {/* Mode Tabs */}\\n          <div className=\\\"flex items-center p-1 bg-surface rounded-xl border border-token text-xs font-semibold\\\">\\n            <button\\n              onClick={() => {\\n                setMode(\'seating\');\\n                setSelectedSlotForSwap(null);\\n              }}\\n              className={`px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer ${\\n                mode === \'seating\' \\n                  ? \'bg-primary text-on-primary shadow-xs\' \\n                  : \'text-muted hover:text-main\'\\n              }`}\\n            >\\n              <ArrowRightLeft className=\\\"w-3.5 h-3.5\\\" />\\n              <span>K\303\251o th\341\272\243 \304\220\341\273\225i ch\341\273\227 HS</span>\\n            </button>\\n            <button\\n              onClick={() => {\\n                setMode(\'structure\');\\n                setSelectedSlotForSwap(null);\\n              }}\\n              className={`px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-colors cursor-pointer ${\\n                mode === \'structure\' \\n                  ? \'bg-primary text-on-primary shadow-xs\' \\n                  : \'text-muted hover:text-main\'\\n              }`}\\n            >\\n              <Settings2 className=\\\"w-3.5 h-3.5\\\" />\\n              <span>B\341\273\221 tr\303\255 C\341\273\255a / B\303\240n GV / B\341\273\245c</span>\\n            </button>\\n          </div>\\n\\n          {/* Quick Tools depending on Mode */}\\n          {mode === \'structure\' ? (\\n            <div className=\\\"flex items-center gap-1.5 overflow-x-auto text-xs\\\">\\n              <span className=\\\"text-[11px] text-muted mr-1 font-medium\\\">Ch\341\273\215n lo\341\272\241i \303\264 \304\221\341\273\203 \304\221\341\272\267t:</span>\\n              <button\\n                onClick={() => setActiveStructureTool(\'banGV\')}\\n                className={`px-2.5 py-1 rounded-lg border text-[11px] font-bold flex items-center gap-1 transition-all ${\\n                  activeStructureTool === \'banGV\'\\n                    ? \'bg-[var(--role-gv-bg)] text-[var(--role-gv-fg)] border-[var(--role-gv-fg)] shadow-xs\'\\n                    : \'bg-surface border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                <Armchair className=\\\"w-3 h-3\\\" />\\n                <span>B\303\240n GV</span>\\n              </button>\\n              <button\\n                onClick={() => setActiveStructureTool(\'cua\')}\\n                className={`px-2.5 py-1 rounded-lg border text-[11px] font-bold flex items-center gap-1 transition-all ${\\n                  activeStructureTool === \'cua\'\\n                    ? \'bg-amber-500/20 text-amber-600 dark:text-amber-400 border-amber-500 shadow-xs\'\\n                    : \'bg-surface border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                <DoorOpen className=\\\"w-3 h-3\\\" />\\n                <span>C\341\273\255a ra v\303\240o</span>\\n              </button>\\n              <button\\n                onClick={() => setActiveStructureTool(\'buc\')}\\n                className={`px-2.5 py-1 rounded-lg border text-[11px] font-bold flex items-center gap-1 transition-all ${\\n                  activeStructureTool === \'buc\'\\n                    ? \'bg-blue-500/20 text-blue-600 dark:text-blue-400 border-blue-500 shadow-xs\'\\n                    : \'bg-surface border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                <BookOpen className=\\\"w-3 h-3\\\" />\\n                <span>B\341\273\245c gi\341\272\243ng</span>\\n              </button>\\n              <button\\n                onClick={() => setActiveStructureTool(\'trong\')}\\n                className={`px-2.5 py-1 rounded-lg border text-[11px] font-bold flex items-center gap-1 transition-all ${\\n                  activeStructureTool === \'trong\'\\n                    ? \'bg-purple-500/20 text-purple-600 dark:text-purple-400 border-purple-500 shadow-xs\'\\n                    : \'bg-surface border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                <span>Ch\341\273\227 tr\341\273\221ng</span>\\n              </button>\\n              <button\\n                onClick={() => setActiveStructureTool(\'ghe\')}\\n                className={`px-2.5 py-1 rounded-lg border text-[11px] font-bold flex items-center gap-1 transition-all ${\\n                  activeStructureTool === \'ghe\'\\n                    ? \'bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border-emerald-500 shadow-xs\'\\n                    : \'bg-surface border-token text-muted hover:text-main\'\\n                }`}\\n              >\\n                <span>B\303\240n HS</span>\\n              </button>\\n            </div>\\n          ) : (\\n            <div className=\\\"flex items-center gap-2 text-xs\\\">\\n              <span className=\\\"text-[11px] text-muted\\\">B\341\273\221 tr\303\255 nhanh:</span>\\n              <button\\n                onClick={() => applyPresetTeacherDesk(\'right\')}\\n                className=\\\"px-2.5 py-1 rounded-lg bg-surface border border-token text-muted hover:text-main text-[11px] font-medium\\\"\\n              >\\n                B\303\240n GV b\303\252n ph\341\272\243i\\n              </button>\\n              <button\\n                onClick={() => applyPresetTeacherDesk(\'left\')}\\n                className=\\\"px-2.5 py-1 rounded-lg bg-surface border border-token text-muted hover:text-main text-[11px] font-medium\\\"\\n              >\\n                B\303\240n GV b\303\252n tr\303\241i\\n              </button>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Feedback / Instruction Banner */}\\n        <div className=\\\"px-4 py-2 bg-accent/10 border-b border-token flex items-center justify-between text-xs text-main\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Info className=\\\"w-4 h-4 text-accent shrink-0\\\" />\\n            <span>\\n              {feedbackMsg ? (\\n                <strong className=\\\"text-accent\\\">{feedbackMsg}</strong>\\n              ) : mode === \'seating\' ? (\\n                selectedSlotForSwap ? (\\n                  <span>\\n                    \304\220ang ch\341\273\215n 1 \303\264. <strong>Ch\341\272\241m ho\341\272\267c k\303\251o v\303\240o \303\264 th\341\273\251 2</strong> \304\221\341\273\203 ho\303\241n \304\221\341\273\225i ch\341\273\227 ng\341\273\223i!\\n                  </span>\\n                ) : (\\n                  <span>\\n                    <strong>M\341\272\271o:</strong> K\303\251o chu\341\273\231t k\303\251o th\341\272\243 h\341\273\215c sinh, ho\341\272\267c ch\341\272\241m l\341\272\247n l\306\260\341\273\243t 2 gh\341\272\277 \304\221\341\273\203 \304\221\341\273\225i ch\341\273\227!\\n                  </span>\\n                )\\n              ) : (\\n                <span>\\n                  \304\220ang \341\273\237 ch\341\272\277 \304\221\341\273\231 s\341\273\255a ki\341\272\277n tr\303\272c. <strong>Ch\341\272\241m v\303\240o b\341\272\245t k\341\273\263 \303\264 n\303\240o</strong> \304\221\341\273\203 \304\221\341\272\267t <strong>{activeStructureTool}</strong>.\\n                </span>\\n              )}\\n            </span>\\n          </div>\\n\\n          {selectedSlotForSwap && (\\n            <button\\n              onClick={() => setSelectedSlotForSwap(null)}\\n              className=\\\"px-2 py-0.5 rounded text-[11px] font-bold text-muted hover:text-main border border-token bg-surface\\\"\\n            >\\n              H\341\273\247y ch\341\273\215n\\n            </button>\\n          )}\\n        </div>\\n\\n        {/* Classroom Grid Container */}\\n        <div className=\\\"p-4 sm:p-6 overflow-auto flex-1 bg-surface-2/40\\\">\\n          <div className=\\\"min-w-[500px] max-w-full mx-auto flex flex-col gap-2\\\">\\n            {Object.entries(rows).map(([rowKey, nodes]) => {\\n              const rowIndex = Number(rowKey);\\n\\n              return (\\n                <div key={rowKey} className=\\\"grid grid-cols-8 gap-1.5 sm:gap-2 items-center\\\">\\n                  {nodes.map(node => {\\n                    const isSelectedForSwap = selectedSlotForSwap && \\n                      selectedSlotForSwap.hang === node.hang && \\n                      selectedSlotForSwap.cot === node.cot;\\n                    \\n                    const isDragOver = dragOverNode &&\\n                      dragOverNode.hang === node.hang &&\\n                      dragOverNode.cot === node.cot;\\n\\n                    // AISLE\\n                    if (node.loaiO === \'loidi\') {\\n                      return (\\n                        <div\\n                          key={`${node.hang}-${node.cot}`}\\n                          onClick={() => mode === \'structure\' && handleCellClick(node)}\\n                          className={`h-12 flex items-center justify-center text-[10px] text-muted opacity-40 select-none ${\\n                            mode === \'structure\' ? \'hover:opacity-100 hover:bg-surface cursor-pointer rounded-md\' : \'\'\\n                          }`}\\n                        >\\n                          \302\267\\n                        </div>\\n                      );\\n                    }\\n\\n                    // DOOR\\n                    if (node.loaiO === \'cua\') {\\n                      return (\\n                        <div\\n                          key={`${node.hang}-${node.cot}`}\\n                          onClick={() => handleCellClick(node)}\\n                          className={`h-12 rounded-xl bg-amber-500/15 border border-dashed border-amber-500/40 flex flex-col items-center justify-center text-[10px] text-amber-700 dark:text-amber-300 font-semibold p-1 cursor-pointer transition-transform hover:scale-105 ${\\n                            isSelectedForSwap ? \'ring-2 ring-accent\' : \'\'\\n                          }`}\\n                        >\\n                          <DoorOpen className=\\\"w-4 h-4\\\" />\\n                          <span className=\\\"text-[9px] mt-0.5\\\">{node.ghiChu || \'C\341\273\255a\'}</span>\\n                        </div>\\n                      );\\n                    }\\n\\n                    // TEACHER DESK\\n                    if (node.loaiO === \'banGV\') {\\n                      return (\\n                        <div\\n                          key={`${node.hang}-${node.cot}`}\\n                          onClick={() => handleCellClick(node)}\\n                          className={`h-12 rounded-xl bg-[var(--role-gv-bg)] border border-[var(--role-gv-fg)] flex flex-col items-center justify-center text-[10px] text-[var(--role-gv-fg)] font-bold p-1 cursor-pointer transition-transform hover:scale-105 shadow-xs ${\\n                            isSelectedForSwap ? \'ring-2 ring-accent\' : \'\'\\n                          }`}\\n                        >\\n                          <Armchair className=\\\"w-4 h-4\\\" />\\n                          <span className=\\\"text-[9px] mt-0.5\\\">B\303\240n GV</span>\\n                        </div>\\n                      );\\n                    }\\n\\n                    // PODIUM / BOARD\\n                    if (node.loaiO === \'buc\') {\\n                      return (\\n                        <div\\n                          key={`${node.hang}-${node.cot}`}\\n                          onClick={() => handleCellClick(node)}\\n                          className={`h-12 rounded-xl bg-blue-500/15 border border-blue-500/40 flex flex-col items-center justify-center text-[10px] text-blue-700 dark:text-blue-300 font-semibold p-1 cursor-pointer transition-transform hover:scale-105 ${\\n                            isSelectedForSwap ? \'ring-2 ring-accent\' : \'\'\\n                          }`}\\n                        >\\n                          <BookOpen className=\\\"w-4 h-4\\\" />\\n                          <span className=\\\"text-[9px] mt-0.5\\\">{node.ghiChu || \'B\341\273\245c\'}</span>\\n                        </div>\\n                      );\\n                    }\\n\\n                    // EMPTY SEAT\\n                    if (node.loaiO === \'trong\') {\\n                      return (\\n                        <div\\n                          key={`${node.hang}-${node.cot}`}\\n                          onClick={() => handleCellClick(node)}\\n                          onDragOver={e => handleDragOver(e, node)}\\n                          onDrop={e => handleDrop(e, node)}\\n                          className={`h-12 rounded-xl border-2 border-dashed border-token/60 bg-surface/50 flex flex-col items-center justify-center text-[10px] text-muted transition-all cursor-pointer ${\\n                            isDragOver ? \'border-accent bg-accent/20 scale-105\' : \'hover:border-accent hover:bg-surface\'\\n                          } ${isSelectedForSwap ? \'ring-2 ring-accent bg-accent/15\' : \'\'}`}\\n                        >\\n                          <span className=\\\"text-[10px] font-medium opacity-60\\\">Ch\341\273\227 tr\341\273\221ng</span>\\n                          {mode === \'seating\' && selectedSlotForSwap && (\\n                            <span className=\\\"text-[8px] text-accent font-bold mt-0.5\\\">Chuy\341\273\203n v\303\240o</span>\\n                          )}\\n                        </div>\\n                      );\\n                    }\\n\\n                    // STUDENT SEAT\\n                    const student = node.maHS ? studentMap.get(node.maHS) : undefined;\\n                    const topRole = student?.vaiTro[0] || \'HS\';\\n                    const cadreInfo = CADRE_ROLES_INFO[topRole];\\n\\n                    return (\\n                      <div\\n                        key={`${node.hang}-${node.cot}`}\\n                        draggable={mode === \'seating\'}\\n                        onDragStart={e => handleDragStart(e, node)}\\n                        onDragOver={e => handleDragOver(e, node)}\\n                        onDrop={e => handleDrop(e, node)}\\n                        onClick={() => handleCellClick(node)}\\n                        className={`\\n                          relative h-12 rounded-xl p-1.5 flex flex-col justify-between text-left transition-all select-none\\n                          bg-surface border shadow-xs cursor-grab active:cursor-grabbing\\n                          ${isSelectedForSwap ? \'ring-2 ring-accent border-accent scale-105 bg-accent/10 z-10\' : \'border-token hover:border-accent\'}\\n                          ${isDragOver ? \'border-accent border-2 bg-accent/20 scale-105 z-10\' : \'\'}\\n                        `}\\n                      >\\n                        {/* Top: Cadre Emoji & Group */}\\n                        <div className=\\\"flex items-center justify-between w-full leading-none\\\">\\n                          <span className=\\\"text-[9px] font-bold text-muted\\\">\\n                            T{student?.to || 1}\\n                          </span>\\n\\n                          <div className=\\\"flex items-center gap-1\\\">\\n                            {cadreInfo && topRole !== \'HS\' && (\\n                              <span \\n                                className=\\\"text-[10px]\\\"\\n                                title={cadreInfo.badgeName}\\n                              >\\n                                {cadreInfo.shortEmoji}\\n                              </span>\\n                            )}\\n                            <span className=\\\"text-[9px] text-muted font-medium\\\">\\n                              G{student?.viTriGhe || node.cot}\\n                            </span>\\n                          </div>\\n                        </div>\\n\\n                        {/* Student Name */}\\n                        <div className=\\\"text-[11px] sm:text-xs font-bold text-main truncate tracking-tight\\\">\\n                          {student?.tenRutGon || \'Tr\341\273\221ng\'}\\n                        </div>\\n                      </div>\\n                    );\\n                  })}\\n                </div>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Footer info & Actions */}\\n        <div className=\\\"p-3.5 bg-surface-2 border-t border-token flex items-center justify-between\\\">\\n          <div className=\\\"text-xs text-muted flex items-center gap-2\\\">\\n            <span className=\\\"w-2.5 h-2.5 rounded-full bg-[var(--st-ok)]\\\" />\\n            <span>S\306\241 \304\221\341\273\223 42 h\341\273\215c sinh \302\267 6 D\303\243y b\303\240n \302\267 10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225</span>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={onClose}\\n              className=\\\"px-3 py-1.5 rounded-xl border border-token text-xs font-semibold text-muted hover:text-main\\\"\\n            >\\n              H\341\273\247y\\n            </button>\\n            <button\\n              onClick={handleSave}\\n              className=\\\"px-4 py-1.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 shadow-md flex items-center gap-1.5 cursor-pointer\\\"\\n            >\\n              <Check className=\\\"w-3.5 h-3.5\\\" />\\n              <span>\303\201p d\341\273\245ng s\306\241 \304\221\341\273\223</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Classroom layout and student seating drag-and-drop editor for homeroom teacher\", \"Overwrite\":true, \"TargetFile\":\"/src/components/teacher/ClassroomLayoutEditor.tsx\", \"toolAction\":\"Writing ClassroomLayoutEditor\", \"toolSummary\":\"Create ClassroomLayoutEditor for GVCN\"}"
