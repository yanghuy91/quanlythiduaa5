  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { \n  Lock, \n  KeyRound, \n  GraduationCap, \n  User, \n  AlertCircle, \n  CheckCircle2, \n  ArrowRight,\n  ShieldAlert\n} from \'lucide-react\';\nimport { Student, SeatLayoutNode, RoleCode } from \'../../types\';\nimport { StudentPicker } from \'../student-picker/StudentPicker\';\n\ninterface LoginModalProps {\n  students: Student[];\n  layout: SeatLayoutNode[];\n  onLoginStudent: (student: Student, role: RoleCode) => void;\n  onLoginTeacher: () => void;\n  classCode: string;\n}\n\nexport const LoginModal: React.FC<LoginModalProps> = ({\n  students,\n  layout,\n  onLoginStudent,\n  onLoginTeacher,\n  classCode,\n}) => {\n  const [enteredClassCode, setEnteredClassCode] = useState(classCode);\n  const [isClassCodeVerified, setIsClassCodeVerified] = useState(true);\n  const [selectedStudent, setSelectedStudent] = useState<Student | null>(null);\n  const [password, setPassword] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState(\'\');\n  const [attempts, setAttempts] = useState(0);\n  const [isLocked, setIsLocked] = useState(false);\n  const [teacherLoginMode, setTeacherLoginMode] = useState(false);\n  const [teacherEmail, setTeacherEmail] = useState(\'gvcn.10a5@thptso2ducpho.edu.vn\');\n  const [teacherOtp, setTeacherOtp] = useState(\'\');\n  const [otpSent, setOtpSent] = useState(false);\n\n  // Verify class code\n  const handleVerifyClassCode = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (enteredClassCode.trim().toUpperCase() === classCode.toUpperCase()) {\n      setIsClassCodeVerified(true);\n      setErrorMsg(\'\');\n    } else {\n      setErrorMsg(\'M\303\243 l\341\273\233p kh\303\264ng ch\303\255nh x\303\241c. Vui l\303\262ng li\303\252n h\341\273\207 Gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m.\');\n    }\n  };\n\n  // Student login\n  const handleStudentSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedStudent) {\n      setErrorMsg(\'Vui l\303\262ng ch\341\273\215n h\341\273\215c sinh t\341\273\253 danh s\303\241ch ho\341\272\267c s\306\241 \304\221\341\273\223.\');\n      return;\n    }\n\n    if (isLocked) {\n      setErrorMsg(\'T\303\240i kho\341\272\243n t\341\272\241m kho\303\241 15 ph\303\272t do nh\341\272\255p sai 5 l\341\272\247n li\303\252n ti\341\272\277p.\');\n      return;\n    }\n\n    // In demo mode: default password is \'123456\' or any 6-digit code\n    if (password.length >= 6) {\n      // Determine highest priority role\n      const primaryRole = selectedStudent.vaiTro[0] || \'HS\';\n      onLoginStudent(selectedStudent, primaryRole);\n    } else {\n      const newAttempts = attempts + 1;\n      setAttempts(newAttempts);\n      if (newAttempts >= 5) {\n        setIsLocked(true);\n        setErrorMsg(\'Sai m\341\272\255t kh\341\272\251u 5 l\341\272\247n! T\303\240i kho\341\272\243n b\341\273\213 t\341\272\241m kho\303\241 15 ph\303\272t.\');\n      } else {\n        setErrorMsg(`M\341\272\255t kh\341\272\251u kh\303\264ng \304\221\303\272ng. C\303\262n ${5 - newAttempts} l\341\272\247n th\341\273\255.`);\n      }\n    }\n  };\n\n  // Teacher Google Login simulation\n  const handleTeacherGoogleLogin = () => {\n    onLoginTeacher();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"w-full max-w-lg bg-surface border border-token rounded-2xl shadow-2xl p-5 my-8 space-y-4 animate-scale-up\">\n        {/* Brand Header */}\n        <div className=\"text-center space-y-1\">\n          <div className=\"w-12 h-12 rounded-2xl bg-primary text-on-primary font-bold text-lg flex items-center justify-center mx-auto shadow-sm\">\n            10A5\n          </div>\n          <h2 className=\"text-base font-bold text-main\">\n            Qu\341\272\243n l\303\275 N\341\273\201 n\341\272\277p &amp; Thi \304\221ua L\341\273\233p h\341\273\215c\n          </h2>\n          <p className=\"text-xs text-muted\">\n            10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\n          </p>\n        </div>\n\n        {/* Step 1: Class Gate Code (if not verified) */}\n        {!isClassCodeVerified ? (\n          <form onSubmit={handleVerifyClassCode} className=\"space-y-3 pt-2\">\n            <div className=\"p-3 rounded-xl bg-surface-2 border border-token text-xs text-main\">\n              Nh\341\272\255p m\303\243 l\341\273\233p (6 k\303\275 t\341\273\261) do Gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m cung c\341\272\245p \304\221\341\273\203 truy c\341\272\255p v\303\240o h\341\273\207 th\341\273\221ng l\341\273\233p 10A5:\n            </div>\n\n            <div>\n              <input\n                type=\"text\"\n                value={enteredClassCode}\n                onChange={e => setEnteredClassCode(e.target.value)}\n                placeholder=\"VD: 10A5DP\"\n                className=\"w-full px-3 py-2 bg-surface border border-token rounded-xl text-center font-bold text-main text-sm uppercase tracking-widest focus:outline-none focus:ring-2 focus:ring-accent/40\"\n              />\n            </div>\n\n            {errorMsg && (\n              <p className=\"text-xs text-[var(--st-bad)] flex items-center gap-1 justify-center\">\n                <AlertCircle className=\"w-3.5 h-3.5\" />\n                <span>{errorMsg}</span>\n              </p>\n            )}\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-2.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 transition-opacity cursor-pointer flex items-center justify-center gap-1.5\"\n            >\n              <span>V\303\240o l\341\273\233p h\341\273\215c</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </form>\n        ) : teacherLoginMode ? (\n          /* Step 2: Teacher Portal */\n          <div className=\"space-y-4 pt-2\">\n            <div className=\"p-3 rounded-xl bg-[var(--role-gv-bg)] text-[var(--role-gv-fg)] border border-[var(--role-gv-fg)]/20 text-xs flex items-center justify-between\">\n              <span className=\"font-semibold\">C\341\273\225ng \304\221\304\203ng nh\341\272\255p Gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m</span>\n              <button\n                type=\"button\"\n                onClick={() => setTeacherLoginMode(false)}\n                className=\"text-xs underline font-bold cursor-pointer\"\n              >\n                V\341\273\201 h\341\273\215c sinh\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              <button\n                type=\"button\"\n                onClick={handleTeacherGoogleLogin}\n                className=\"w-full py-2.5 rounded-xl border border-token bg-surface hover:bg-surface-2 text-main text-xs font-bold flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs\"\n              >\n                <svg className=\"w-4 h-4\" viewBox=\"0 0 24 24\">\n                  <path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n                  <path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n                  <path fill=\"#FBBC05\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\"/>\n                  <path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\"/>\n                </svg>\n                <span>\304\220\304\203ng nh\341\272\255p b\341\272\261ng Google (Email gi\303\241o vi\303\252n)</span>\n              </button>\n\n              <div className=\"relative flex py-1 items-center\">\n                <div className=\"flex-grow border-t border-token\"></div>\n                <span className=\"flex-shrink mx-2 text-[10px] text-muted uppercase\">Ho\341\272\267c m\303\243 OTP d\341\273\261 ph\303\262ng</span>\n                <div className=\"flex-grow border-t border-token\"></div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <input\n                  type=\"email\"\n                  value={teacherEmail}\n                  onChange={e => setTeacherEmail(e.target.value)}\n                  placeholder=\"Email gi\303\241o vi\303\252n...\"\n                  className=\"w-full px-3 py-2 bg-surface-2 border border-token rounded-xl text-xs text-main\"\n                />\n                {!otpSent ? (\n                  <button\n                    type=\"button\"\n                    onClick={() => setOtpSent(true)}\n                    className=\"w-full py-2 rounded-xl border border-token text-xs font-semibold text-main hover:bg-surface-2 cursor-pointer\"\n                  >\n                    G\341\273\255i m\303\243 OTP qua Email\n                  </button>\n                ) : (\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      value={teacherOtp}\n                      onChange={e => setTeacherOtp(e.target.value)}\n                      placeholder=\"M\303\243 6 ch\341\273\257 s\341\273\221...\"\n                      className=\"flex-1 px-3 py-2 bg-surface border border-token rounded-xl text-center text-xs font-bold text-main\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={handleTeacherGoogleLogin}\n                      className=\"px-4 py-2 rounded-xl bg-primary text-on-primary text-xs font-bold cursor-pointer\"\n                    >\n                      X\303\241c nh\341\272\255n\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        ) : (\n          /* Step 2: Student & Cadre Login */\n          <div className=\"space-y-4\">\n            {/* Student Picker: Note: showStatusColors = FALSE as required by spec */}\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-xs font-semibold text-main\">\n                  1. Ch\341\273\215n t\303\252n c\341\273\247a b\341\272\241n:\n                </label>\n                {selectedStudent && (\n                  <span className=\"text-xs font-bold text-accent\">\n                    {selectedStudent.hoTen}\n                  </span>\n                )}\n              </div>\n\n              <StudentPicker\n                students={students}\n                layout={layout}\n                selectedStudentIds={selectedStudent ? [selectedStudent.maHS] : []}\n                onSelectStudent={st => {\n                  setSelectedStudent(st);\n                  setErrorMsg(\'\');\n                }}\n                showStatusColors={false} // NEVER reveal status colors before login!\n              />\n            </div>\n\n            {/* Password input */}\n            <form onSubmit={handleStudentSubmit} className=\"space-y-3 pt-1 border-t border-token\">\n              <div>\n                <label className=\"block text-xs font-semibold text-main mb-1\">\n                  2. Nh\341\272\255p m\341\272\255t kh\341\272\251u (M\341\272\267c \304\221\341\273\213nh: 123456):\n                </label>\n                <div className=\"relative\">\n                  <KeyRound className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none\" />\n                  <input\n                    type=\"password\"\n                    disabled={!selectedStudent || isLocked}\n                    value={password}\n                    onChange={e => setPassword(e.target.value)}\n                    placeholder=\"M\341\272\255t kh\341\272\251u t\341\273\221i thi\341\273\203u 6 k\303\275 t\341\273\261...\"\n                    className=\"w-full pl-9 pr-3 py-2 bg-surface border border-token rounded-xl text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40 disabled:opacity-50\"\n                  />\n                </div>\n              </div>\n\n              {errorMsg && (\n                <p className=\"text-xs text-[var(--st-bad)] flex items-center gap-1\">\n                  <AlertCircle className=\"w-3.5 h-3.5\" />\n                  <span>{errorMsg}</span>\n                </p>\n              )}\n\n              <button\n                type=\"submit\"\n                disabled={!selectedStudent || isLocked}\n                className=\"w-full py-2.5 rounded-xl bg-primary text-on-primary text-xs font-bold hover:opacity-95 disabled:opacity-50 transition-opacity cursor-pointer flex items-center justify-center gap-2\"\n              >\n                <span>\304\220\304\203ng nh\341\272\255p</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </form>\n\n            {/* Teacher Entry Point Button */}\n            <div className=\"pt-2 text-center border-t border-token\">\n              <button\n                type=\"button\"\n                onClick={() => setTeacherLoginMode(true)}\n                className=\"text-xs font-semibold text-muted hover:text-accent transition-colors cursor-pointer\"\n              >\n                D\303\240nh cho Gi\303\241o vi\303\252n ch\341\273\247 nhi\341\273\207m &rarr;\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
