              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <span className=\"text-xs font-bold text-accent px-2.5 py-0.5 rounded-full bg-accent/15 border border-accent/30\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
