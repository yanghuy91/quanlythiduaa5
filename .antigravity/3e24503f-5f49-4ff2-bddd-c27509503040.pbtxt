    content: "    mucMau,\n    soLoiTrongTuan: studentRecords.length,\n    coLoiNang\n  };\n}\n\nexport function getCurrentSession(): \'Sang\' | \'Chieu\' {\n  const hour = new Date().getHours();\n  // Bu\341\273\225i s\303\241ng: 06:30 -> 12:00, Bu\341\273\225i chi\341\273\201u: 12:00 -> 18:00\n  return hour < 12 ? \'Sang\' : \'Chieu\';\n}\n\nexport function checkDuplicateRecord(\n  records: DisciplineRecord[],\n  maHS: string,\n  ngayHoc: string,\n  buoi: \'Sang\' | \'Chieu\',\n  maNoiQuy: string\n): {\n  isDuplicate: boolean;\n  isIdentical: boolean;\n  existingRecords: DisciplineRecord[];\n  lanThu: number;\n} {\n  const existing = records.filter(\n    r => r.maHS === maHS &&\n         r.ngayHoc === ngayHoc &&\n         r.buoi === buoi &&\n         r.trangThai !== \'DaHuy\'\n  );\n\n  if (existing.length === 0) {\n    return {\n      isDuplicate: false,\n      isIdentical: false,\n      existingRecords: [],\n      lanThu: 1\n    };\n  }\n\n  const isIdentical = existing.some(r => r.maNoiQuy === maNoiQuy);\n\n  return {\n    isDuplicate: true,\n    isIdentical,\n    existingRecords: existing,\n    lanThu: existing.length + 1\n  };\n}"
    num_lines: 119
    num_bytes: 2897
    line_range_bytes: 1045
  }
