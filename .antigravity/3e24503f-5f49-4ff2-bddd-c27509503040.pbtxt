  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { \n  ClipboardList, \n  UserCheck, \n  Clock, \n  Edit3, \n  Trash2, \n  Sliders, \n  AlertCircle,\n  PlusCircle,\n  CheckCircle2,\n  X\n} from \'lucide-react\';\nimport { \n  Student, \n  SeatLayoutNode, \n  DisciplineRecord, \n  RuleItem, \n  StudentWeekSummary, \n  RoleCode, \n  TeacherSettings \n} from \'../../types\';\nimport { StudentPicker } from \'../student-picker/StudentPicker\';\nimport { RecordBottomSheet } from \'../record/RecordBottomSheet\';\nimport { DuplicateWarningModal } from \'../record/DuplicateWarningModal\';\nimport { StudentView } from \'../student/StudentView\';\nimport { checkDuplicateRecord } from \'../../utils/emulation\';\n\ninterface CadreViewProps {\n  currentCadre: Student;\n  cadreRole: RoleCode;\n  allStudents: Student[];\n  layout: SeatLayoutNode[];\n  rules: RuleItem[];\n  records: DisciplineRecord[];\n  studentSummaries: Record<string, StudentWeekSummary>;\n  currentWeek: number;\n  settings: TeacherSettings;\n  onAddRecord: (record: Omit<DisciplineRecord, \'maGhiNhan\' | \'thoiGianMayChu\' | \'thoiGianMay\'>) => void;\n  onVoidRecord: (recordId: string, reason: string) => void;\n  onSubmitExplanation: (recordId: string, explanation: string) => void;\n}\n\nexport const CadreView: React.FC<CadreViewProps> = ({\n  currentCadre,\n  cadreRole,\n  allStudents,\n  layout,\n  rules,\n  records,\n  studentSummaries,\n  currentWeek,\n  settings,\n  onAddRecord,\n  onVoidRecord,\n  onSubmitExplanation,\n}) => {\n  const [activeMode, setActiveMode] = useState<\'record\' | \'my_log\' | \'personal\'>(\'record\');\n  const [fastSaveEnabled, setFastSaveEnabled] = useState(false);\n  const [isMultiSelect, setIsMultiSelect] = useState(false);\n  const [selectedStudentIds, setSelectedStudentIds] = useState<string[]>([]);\n  const [isBottomSheetOpen, setIsBottomSheetOpen] = useState(false);\n\n  // Duplicate warning modal state\n  const [duplicateModalOpen, setDuplicateModalOpen] = useState(false);\n  const [pendingRecordPayload, setPendingRecordPayload] = useState<{\n    students: Student[];\n    rule: RuleItem;\n    date: string;\n    session: \'Sang\' | \'Chieu\';\n    note?: string;\n  } | null>(null);\n\n  // Void modal state\n  const [voidModalRecord, setVoidModalRecord] = useState<DisciplineRecord | null>(null);\n  const [voidReason, setVoidReason] = useState(\'\');\n\n  // T\341\273\225 tr\306\260\341\273\237ng group constraint\n  const viewerTo = cadreRole === \'TT\' ? currentCadre.toTruongTo || currentCadre.to : undefined;\n\n  // Records created by this cadre in the current week (\"S\341\273\225 c\341\273\247a t\303\264i\")\n  const myCreatedRecords = useMemo(() => {\n    return records\n      .filter(r => r.nguoiGhi === currentCadre.hoTen && r.tuanHoc === currentWeek)\n      .sort((a, b) => new Date(b.thoiGianMayChu).getTime() - new Date(a.thoiGianMayChu).getTime());\n  }, [records, currentCadre.hoTen, currentWeek]);\n\n  // Selected student objects\n  const selectedStudents = useMemo(() => {\n    return allStudents.filter(s => selectedStudentIds.includes(s.maHS));\n  }, [allStudents, selectedStudentIds]);\n\n  // Handle student selection from picker\n  const handleSelectStudent = (student: Student) => {\n    if (isMultiSelect) {\n      setSelectedStudentIds(prev => \n        prev.includes(student.maHS)\n          ? prev.filter(id => id !== student.maHS)\n          : [...prev, student.maHS]\n      );\n    } else {\n      setSelectedStudentIds([student.maHS]);\n      setIsBottomSheetOpen(true);\n    }\n  };\n\n  // Check duplicates and proceed with save\n  const handleRequestSave = (payload: {\n    students: Student[];\n    rule: RuleItem;\n    date: string;\n    session: \'Sang\' | \'Chieu\';\n    note?: string;\n  }) => {\n    const existingMap: Record<string, DisciplineRecord[]> = {};\n    let hasDuplicate = false;\n\n    payload.students.forEach(st => {\n      const dupCheck = checkDuplicateRecord(\n        records,\n        st.maHS,\n        payload.date,\n        payload.session,\n        payload.rule.maNoiQuy\n      );\n      if (dupCheck.isDuplicate) {\n        hasDuplicate = true;\n        existingMap[st.maHS] = dupCheck.existingRecords;\n      }\n    });\n\n    if (hasDuplicate) {\n      setPendingRecordPayload(payload);\n      setDuplicateModalOpen(true);\n    } else {\n      executeSave(payload.students, payload.rule, payload.date, payload.session, payload.note);\n    }\n  };\n\n  // Actual execution of save\n  const executeSave = (\n    targetStudents: Student[],\n    rule: RuleItem,\n    date: string,\n    session: \'Sang\' | \'Chieu\',\n    note?: string\n  ) => {\n    targetStudents.forEach(st => {\n      const dupCheck = checkDuplicateRecord(records, st.maHS, date, session, rule.maNoiQuy);\n\n      onAddRecord({\n        ngayHoc: date,\n        buoi: session,\n        tuanHoc: currentWeek,\n        doiTuong: \'HocSinh\',\n        maHS: st.maHS,\n        hoTen: st.hoTen,\n        to: st.to,\n        maNoiQuy: rule.maNoiQuy,\n        nhomHanhVi: rule.nhomHanhVi,\n        tenHanhVi: rule.tenHanhVi,\n        mucDo: rule.mucDo,\n        diemSo: rule.diemSo,\n        loaiDiem: rule.loaiDiem,\n        ghiChu: note,\n        nguoiGhi: currentCadre.hoTen,\n        vaiTroNguoiGhi: cadreRole,\n        nguonGhi: \'TrucTiep\',\n        lanThuTrongBuoi: dupCheck.lanThu,\n        daXacNhanTrung: dupCheck.isDuplicate,\n        trangThai: \'HieuLuc\',\n      });\n    });\n\n    setSelectedStudentIds([]);\n    setIsMultiSelect(false);\n    setIsBottomSheetOpen(false);\n  };\n\n  // Remaining time in 24h window\n  const getRemainingHours = (createdAt: string): number => {\n    const createdTime = new Date(createdAt).getTime();\n    const now = Date.now();\n    const diffMs = createdTime + settings.thoiHanSuaHuyPhut * 60 * 1000 - now;\n    return Math.max(0, Math.floor(diffMs / (1000 * 60 * 60)));\n  };\n\n  const handleConfirmVoid = () => {\n    if (!voidModalRecord || !voidReason.trim()) return;\n    onVoidRecord(voidModalRecord.maGhiNhan, voidReason.trim());\n    setVoidModalRecord(null);\n    setVoidReason(\'\');\n  };\n\n  return (\n    <div className=\"w-full flex flex-col gap-4\">\n      {/* Top Cadre Navigation Tabs */}\n      <div className=\"flex items-center justify-center p-1 bg-surface-2 rounded-xl border border-token max-w-md mx-auto w-full\">\n        <button\n          onClick={() => setActiveMode(\'record\')}\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeMode === \'record\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <ClipboardList className=\"w-3.5 h-3.5 text-accent\" />\n          <span>Ghi nh\341\272\255n</span>\n        </button>\n\n        <button\n          onClick={() => setActiveMode(\'my_log\')}\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeMode === \'my_log\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Clock className=\"w-3.5 h-3.5 text-accent\" />\n          <span>S\341\273\225 c\341\273\247a t\303\264i ({myCreatedRecords.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveMode(\'personal\')}\n          className={`flex-1 py-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n            activeMode === \'personal\' \n              ? \'bg-surface text-main shadow-xs\' \n              : \'text-muted hover:text-main\'\n          }`}\n        >\n          <UserCheck className=\"w-3.5 h-3.5 text-accent\" />\n          <span>C\303\241 nh\303\242n</span>\n        </button>\n      </div>\n\n      {/* MODE 1: GHI NH\341\272\254N */}\n      {activeMode === \'record\' && (\n        <div className=\"space-y-3\">\n          {/* Cadre instructions bar */}\n          <div className=\"px-3 py-2 bg-surface rounded-xl border border-token flex items-center justify-between text-xs\">\n            <div className=\"flex items-center gap-2 text-main\">\n              <span className=\"font-semibold\">\n                {cadreRole === \'TT\' ? `Ch\341\272\245m n\341\273\201 n\341\272\277p T\341\273\225 ${viewerTo}` : \'Ghi nh\341\272\255n n\341\273\201 n\341\272\277p c\341\272\243 l\341\273\233p\'}\n              </span>\n              <span className=\"text-[11px] text-muted\">\n                {cadreRole === \'TT\' ? \'(Ch\341\273\211 ghi \304\221\306\260\341\273\243c th\303\240nh vi\303\252n t\341\273\225 m\303\254nh)\' : \'(To\303\240n quy\341\273\201n ghi nh\341\272\255n)\'}\n              </span>\n            </div>\n\n            {/* 1-touch Fast Save Indicator & Toggle */}\n            <label className=\"flex items-center gap-1.5 cursor-pointer text-[11px] text-muted select-none\">\n              <span>L\306\260u nhanh 1 ch\341\272\241m:</span>\n              <input\n                type=\"checkbox\"\n                checked={fastSaveEnabled}\n                onChange={e => setFastSaveEnabled(e.target.checked)}\n                className=\"w-4 h-4 accent-accent rounded\"\n              />\n            </label>\n          </div>\n\n          {/* Student Picker */}\n          <StudentPicker\n            students={allStudents}\n            layout={layout}\n            studentSummaries={studentSummaries}\n            selectedStudentIds={selectedStudentIds}\n            onSelectStudent={handleSelectStudent}\n            viewerRole={cadreRole}\n            viewerTo={viewerTo}\n            showStatusColors={true}\n            isMultiSelect={isMultiSelect}\n            onToggleMultiSelect={() => {\n              setIsMultiSelect(!isMultiSelect);\n              if (isMultiSelect) setSelectedStudentIds([]);\n            }}\n          />\n\n          {/* Floating Action Bar when selecting multiple students */}\n          {isMultiSelect && selectedStudentIds.length > 0 && (\n            <div className=\"fixed bottom-20 left-1/2 -translate-x-1/2 z-30 w-11/12 max-w-md bg-primary text-on-primary rounded-xl shadow-2xl p-3 border border-token flex items-center justify-between animate-slide-up\">\n              <div className=\"text-xs font-semibold\">\n                \304\220\303\243 ch\341\273\215n <strong className=\"text-accent underline\">{selectedStudentIds.length}</strong> h\341\273\215c sinh\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setIsBottomSheetOpen(true)}\n                className=\"px-4 py-2 rounded-lg bg-accent text-on-accent text-xs font-bold shadow-xs hover:opacity-95 transition-opacity cursor-pointer flex items-center gap-1.5\"\n              >\n                <span>Ti\341\272\277p t\341\273\245c ch\341\273\215n l\341\273\227i</span>\n              </button>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* MODE 2: S\341\273\224 C\341\273\246A T\303\224I (My created records & 24h edit/void) */}\n      {activeMode === \'my_log\' && (\n        <div className=\"bg-surface rounded-2xl border border-token overflow-hidden shadow-xs\">\n          <div className=\"px-4 py-3 border-b border-token flex items-center justify-between\">\n            <div>\n              <h3 className=\"text-xs font-bold text-main uppercase tracking-wider\">\n                S\341\273\225 ghi nh\341\272\255n tu\341\272\247n {currentWeek} c\341\273\247a b\341\272\241n\n              </h3>\n              <p className=\"text-[11px] text-muted mt-0.5\">\n                C\303\241c l\306\260\341\273\243t b\341\272\241n \304\221\303\243 ghi. C\303\263 th\341\273\203 s\341\273\255a ho\341\272\267c h\341\273\247y trong th\341\273\235i h\341\272\241n 24 gi\341\273\235.\n              </p>\n            </div>\n            <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-surface-2 text-muted\">\n              {myCreatedRecords.length} l\306\260\341\273\243t\n            </span>\n          </div>\n\n          <div className=\"divide-y divide-token\">\n            {myCreatedRecords.length === 0 ? (\n              <div className=\"p-8 text-center text-xs text-muted\">\n                B\341\272\241n ch\306\260a ghi nh\341\272\255n l\306\260\341\273\243t vi ph\341\272\241m n\303\240o trong tu\341\272\247n n\303\240y.\n              </div>\n            ) : (\n              myCreatedRecords.map(rec => {\n                const isVoided = rec.trangThai === \'DaHuy\';\n                const remainingHours = getRemainingHours(rec.thoiGianMayChu);\n                const canModify = !isVoided && remainingHours > 0;\n\n                return (\n                  <div key={rec.maGhiNhan} className=\"p-3.5 space-y-2\">\n                    <div className=\"flex items-start justify-between gap-2\">\n                      <div className=\"min-w-0\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"text-xs font-bold text-main\">\n                            {rec.hoTen}\n                          </span>\n                          <span className=\"text-[11px] text-muted\">\n                            (T\341\273\225 {rec.to})\n                          </span>\n                          <span className=\"text-xs font-bold text-[var(--st-bad)]\">\n                            -{rec.diemSo}\304\221\n                          </span>\n                        </div>\n                        <div className=\"text-xs font-medium text-main mt-0.5\">\n                          {rec.tenHanhVi}\n                        </div>\n                        <div className=\"text-[11px] text-muted flex items-center gap-2 mt-0.5\">\n                          <span>{rec.ngayHoc} ({rec.buoi === \'Sang\' ? \'S\303\241ng\' : \'Chi\341\273\201u\'})</span>\n                          <span>\302\267</span>\n                          <span>L\341\272\247n {rec.lanThuTrongBuoi} trong bu\341\273\225i</span>\n                        </div>\n                      </div>\n\n                      {/* Right actions: Void / Countdown */}\n                      <div className=\"flex flex-col items-end gap-1 shrink-0\">\n                        {isVoided ? (\n                          <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-surface-2 text-muted\">\n                            \304\220\303\243 h\341\273\247y\n                          </span>\n                        ) : canModify ? (\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className=\"text-[10px] text-muted flex items-center gap-1\">\n                              <Clock className=\"w-3 h-3 text-accent\" />\n                              <span>C\303\262n {remainingHours}h</span>\n                            </span>\n                            <button\n                              type=\"button\"\n                              onClick={() => setVoidModalRecord(rec)}\n                              className=\"p-1 rounded-md text-[var(--st-bad)] hover:bg-[var(--st-bad)]/10 transition-colors cursor-pointer\"\n                              title=\"H\341\273\247y b\341\272\243n ghi n\303\240y\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </div>\n                        ) : (\n                          <span className=\"text-[10px] text-muted\">\n                            \304\220\303\243 h\341\272\277t h\341\272\241n 24h\n                          </span>\n                        )}\n                      </div>\n                    </div>\n\n                    {rec.lyDoHuy && (\n                      <div className=\"text-[10px] text-[var(--st-bad)] italic bg-[var(--st-bad)]/5 p-1.5 rounded-lg border border-[var(--st-bad)]/20\">\n                        L\303\275 do h\341\273\247y: {rec.lyDoHuy}\n                      </div>\n                    )}\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* MODE 3: C\303\201 NH\303\202N (Student View of this cadre) */}\n      {activeMode === \'personal\' && (\n        <StudentView\n          currentStudent={currentCadre}\n          allStudents={allStudents}\n          layout={layout}\n          records={records}\n          studentSummaries={studentSummaries}\n          currentWeek={currentWeek}\n          settings={settings}\n          onSubmitExplanation={onSubmitExplanation}\n        />\n      )}\n\n      {/* Recording Bottom Sheet */}\n      <RecordBottomSheet\n        isOpen={isBottomSheetOpen}\n        onClose={() => {\n          setIsBottomSheetOpen(false);\n          if (!isMultiSelect) setSelectedStudentIds([]);\n        }}\n        students={selectedStudents}\n        rules={rules}\n        allowBonus={settings.batDiemCong}\n        fastSaveMode={fastSaveEnabled}\n        onSave={handleRequestSave}\n        currentUserRole={cadreRole}\n      />\n\n      {/* Duplicate Warning Modal */}\n      {pendingRecordPayload && (\n        <DuplicateWarningModal\n          isOpen={duplicateModalOpen}\n          onClose={() => {\n            setDuplicateModalOpen(false);\n            setPendingRecordPayload(null);\n          }}\n          onConfirm={(confirmedStudents) => {\n            executeSave(\n              confirmedStudents,\n              pendingRecordPayload.rule,\n              pendingRecordPayload.date,\n              pendingRecordPayload.session,\n              pendingRecordPayload.note\n            );\n            setDuplicateModalOpen(false);\n            setPendingRecordPayload(null);\n          }}\n          selectedStudents={pendingRecordPayload.students}\n          selectedRule={pendingRecordPayload.rule}\n          existingRecordsByStudent={\n            pendingRecordPayload.students.reduce((acc, st) => {\n              const res = checkDuplicateRecord(\n                records,\n                st.maHS,\n                pendingRecordPayload.date,\n                pendingRecordPayload.session,\n                pendingRecordPayload.rule.maNoiQuy\n              );\n              acc[st.maHS] = res.existingRecords;\n              return acc;\n            }, {} as Record<string, DisciplineRecord[]>)\n          }\n        />\n      )}\n\n      {/* Void Record Confirmation Modal */}\n      {voidModalRecord && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\">\n          <div className=\"w-full max-w-md bg-surface border border-token rounded-2xl shadow-2xl p-4 space-y-3 animate-scale-up\">\n            <div className=\"flex items-center justify-between border-b border-token pb-2.5\">\n              <h4 className=\"text-sm font-bold text-main\">\n                H\341\273\247y b\341\272\243n ghi vi ph\341\272\241m\n              </h4>\n              <button\n                onClick={() => setVoidModalRecord(null)}\n                className=\"p-1 rounded-md text-muted hover:text-main\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <p className=\"text-xs text-muted\">\n              B\341\272\241n \304\221ang chu\341\272\251n b\341\273\213 h\341\273\247y b\341\272\243n ghi l\341\273\227i <strong>{voidModalRecord.tenHanhVi}</strong> c\341\273\247a h\341\273\215c sinh <strong>{voidModalRecord.hoTen}</strong>. D\341\273\257 li\341\273\207u s\341\272\275 \304\221\306\260\341\273\243c \304\221\303\241nh d\341\272\245u h\341\273\247y ch\341\273\251 kh\303\264ng xo\303\241 kh\341\273\217i h\341\273\207 th\341\273\221ng.\n            </p>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-main mb-1\">\n                L\303\275 do h\341\273\247y (b\341\272\257t bu\341\273\231c):\n              </label>\n              <input\n                type=\"text\"\n                value={voidReason}\n                onChange={e => setVoidReason(e.target.value)}\n                placeholder=\"VD: Ghi nh\341\272\247m t\303\252n h\341\273\215c sinh, b\341\272\241n \304\221\303\243 gi\341\272\243i th\303\255ch r\303\265...\"\n                className=\"w-full p-2.5 bg-surface-2 border border-token rounded-xl text-xs text-main placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/40\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-token\">\n              <button\n                type=\"button\"\n                onClick={() => setVoidModalRecord(null)}\n                className=\"px-3 py-1.5 rounded-lg border border-token text-xs text-muted hover:text-main\"\n              >\n                Kh\303\264ng h\341\273\247y\n              </button>\n              <button\n                type=\"button\"\n                disabled={!voidReason.trim()}\n                onClick={handleConfirmVoid}\n                className=\"px-4 py-1.5 rounded-lg bg-[var(--st-bad)] text-white text-xs font-bold hover:opacity-95 disabled:opacity-50 cursor-pointer\"\n              >\n                X\303\241c nh\341\272\255n H\341\273\247y b\341\272\243n ghi\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/cadre/CadreView.tsx"
        }
        overwrite: true
      }
    }
    action_result {
