        replacement_content: "          ) : (\n            <div className=\"flex items-center gap-1.5 text-xs\">\n              <button\n                onClick={handleToggleDeskDoorSwap}\n                className=\"px-3 py-1 rounded-lg bg-surface border border-token text-muted hover:text-main text-[11px] font-bold flex items-center gap-1.5 transition-colors cursor-pointer shadow-xs\"\n                title=\"\304\220\341\273\225i v\341\273\213 tr\303\255 B\303\240n GV v\303\240 C\341\273\255a ch\303\255nh\"\n              >\n                <ArrowRightLeft className=\"w-3.5 h-3.5 text-accent\" />\n                <span>Ho\303\241n \304\221\341\273\225i B\303\240n GV \342\207\204 C\341\273\255a ch\303\255nh</span>\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Feedback / Instruction Banner */}\n        <div className=\"px-4 py-2 bg-accent/10 border-b border-token flex items-center justify-between text-xs text-main\">\n          <div className=\"flex items-center gap-2\">\n            <Info className=\"w-4 h-4 text-accent shrink-0\" />\n            <span>\n              {feedbackMsg ? (\n                <strong className=\"text-accent\">{feedbackMsg}</strong>\n              ) : mode === \'seating\' ? (\n                selectedSlotForSwap ? (\n                  <span>\n                    \304\220ang ch\341\273\215n 1 \303\264. <strong>Ch\341\272\241m ho\341\272\267c k\303\251o v\303\240o \303\264 th\341\273\251 2</strong> \304\221\341\273\203 ho\303\241n \304\221\341\273\225i ch\341\273\227 ng\341\273\223i!\n                  </span>\n                ) : (\n                  <span>\n                    <strong>M\341\272\271o:</strong> K\303\251o chu\341\273\231t k\303\251o th\341\272\243 h\341\273\215c sinh, ho\341\272\267c ch\341\272\241m l\341\272\247n l\306\260\341\273\243t 2 gh\341\272\277 \304\221\341\273\203 \304\221\341\273\225i ch\341\273\227!\n                  </span>\n                )\n              ) : (\n                <span>\n                  \304\220ang \341\273\237 ch\341\272\277 \304\221\341\273\231 s\341\273\255a ki\341\272\277n tr\303\272c. <strong>Ch\341\272\241m v\303\240o b\341\272\245t k\341\273\263 \303\264 n\303\240o</strong> \304\221\341\273\203 \304\221\341\272\267t <strong>{activeStructureTool}</strong>.\n                </span>\n              )}\n            </span>\n          </div>\n\n          {selectedSlotForSwap && (\n            <button\n              onClick={() => setSelectedSlotForSwap(null)}\n              className=\"px-2 py-0.5 rounded text-[11px] font-bold text-muted hover:text-main border border-token bg-surface\"\n            >\n              H\341\273\247y ch\341\273\215n\n            </button>\n          )}\n        </div>\n\n        {/* Classroom Grid Container */}\n        <div className=\"p-4 sm:p-6 overflow-auto flex-1 bg-surface-2/40\">\n          <div className=\"min-w-[500px] max-w-full mx-auto flex flex-col gap-2\">\n            {Object.entries(rows).map(([rowKey, nodes]) => {\n              const rowIndex = Number(rowKey);\n\n              // H\303\240ng 0: \304\220\341\272\247u l\341\273\233p - Khi \341\273\237 ch\341\272\277 \304\221\341\273\231 \'seating\', hi\341\273\203n th\341\273\213 d\341\272\241ng ch\341\273\257 KH\303\224NG \304\220\303\223NG \303\224\n              if (rowIndex === 0 && mode === \'seating\') {\n                const banGVNode = nodes.find(n => n.loaiO === \'banGV\');\n                const cuaNode = nodes.find(n => n.loaiO === \'cua\');\n                const isBanGVLeft = (banGVNode?.cot ?? 0) <= (cuaNode?.cot ?? 7);\n\n                return (\n                  <div \n                    key={rowKey}\n                    className=\"w-full flex items-center justify-between px-4 py-2 bg-surface/70 rounded-xl border-b border-dashed border-token/60 mb-2 select-none font-medium\"\n                  >\n                    {isBanGVLeft ? (\n                      <>\n                        <div className=\"flex items-center gap-1.5 text-[var(--role-gv-fg)] font-bold text-xs\">\n                          <span className=\"w-2 h-2 rounded-full bg-[var(--role-gv-fg)]\" />\n                          <span>B\303\240n GV</span>\n                        </div>\n                        <span className=\"text-main font-bold tracking-widest text-xs uppercase opacity-75\">\n                          \342\200\224 B\341\272\242NG \342\200\224\n                        </span>\n                        <div className=\"flex items-center gap-1.5 text-muted font-bold text-xs\">\n                          <span>C\341\273\255a ch\303\255nh</span>\n                        </div>\n                      </>\n                    ) : (\n                      <>\n                        <div className=\"flex items-center gap-1.5 text-muted font-bold text-xs\">\n                          <span>C\341\273\255a ch\303\255nh</span>\n                        </div>\n                        <span className=\"text-main font-bold tracking-widest text-xs uppercase opacity-75\">\n                          \342\200\224 B\341\272\242NG \342\200\224\n                        </span>\n                        <div className=\"flex items-center gap-1.5 text-[var(--role-gv-fg)] font-bold text-xs\">\n                          <span className=\"w-2 h-2 rounded-full bg-[var(--role-gv-fg)]\" />\n                          <span>B\303\240n GV</span>\n                        </div>\n                      </>\n                    )}\n                  </div>\n                );\n              }\n\n              // H\303\240ng 8: Cu\341\273\221i l\341\273\233p - Khi \341\273\237 ch\341\272\277 \304\221\341\273\231 \'seating\', hi\341\273\203n th\341\273\213 d\341\272\241ng ch\341\273\257 \304\221\306\241n gi\341\272\243n\n              if (rowIndex === 8 && mode === \'seating\') {\n                return (\n                  <div \n                    key={rowKey}\n                    className=\"w-full flex items-center justify-between px-4 py-1.5 text-[11px] text-muted opacity-50 select-none border-t border-dashed border-token/30 mt-2\"\n                  >\n                    <span>C\341\273\255a sau</span>\n                    <span>Cu\341\273\221i l\341\273\233p</span>\n                  </div>\n                );\n              }\n\n              return (\n                <div key={rowKey} className=\"grid grid-cols-8 gap-1.5 sm:gap-2 items-center\">"
