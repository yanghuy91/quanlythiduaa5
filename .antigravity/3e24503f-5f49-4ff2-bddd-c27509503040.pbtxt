    content: "\n    setSelectedStudentIds([]);\n    setIsMultiSelect(false);\n    setIsBottomSheetOpen(false);\n  };\n\n  return (\n    <div className=\"w-full flex flex-col gap-4\">\n      {/* Teacher Navigation Tabs */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar p-1 bg-surface-2 rounded-xl border border-token\">\n        <button\n          onClick={() => setActiveTab(\'overview\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'overview\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <BarChart3 className=\"w-3.5 h-3.5 text-accent\" />\n          <span>T\341\273\225ng quan</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'record\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'record\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <ClipboardList className=\"w-3.5 h-3.5 text-accent\" />\n          <span>Ghi nh\341\272\255n</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'explanations\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'explanations\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <CheckSquare className=\"w-3.5 h-3.5 text-accent\" />\n          <span>Gi\341\272\243i tr\303\254nh</span>\n          {pendingExplanations.length > 0 && (\n            <span className=\"w-4 h-4 rounded-full bg-[var(--st-bad)] text-white text-[10px] flex items-center justify-center font-bold\">\n              {pendingExplanations.length}\n            </span>\n          )}\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'roster\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'roster\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Users className=\"w-3.5 h-3.5 text-accent\" />\n          <span>L\341\273\233p &amp; S\306\241 \304\221\341\273\223 (42 HS)</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'rules\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'rules\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Layers className=\"w-3.5 h-3.5 text-accent\" />\n          <span>N\341\273\231i quy</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'import_export\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'import_export\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <FileSpreadsheet className=\"w-3.5 h-3.5 text-accent\" />\n          <span>Nh\341\272\255p / Xu\341\272\245t</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'settings\')}\n          className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n            activeTab === \'settings\' ? \'bg-surface text-main shadow-xs\' : \'text-muted hover:text-main\'\n          }`}\n        >\n          <Settings className=\"w-3.5 h-3.5 text-accent\" />\n          <span>C\303\240i \304\221\341\272\267t</span>\n        </button>\n      </div>\n\n      {/* 1. OVERVIEW */}\n      {activeTab === \'overview\' && (\n        <div className=\"space-y-4\">\n          {/* Hero Banner with High School Classroom Illustration */}\n          <div className=\"relative overflow-hidden rounded-3xl border border-token shadow-xs bg-surface\">\n            <div className=\"relative h-44 sm:h-52 w-full overflow-hidden\">\n              <img\n                src=\"/src/assets/images/hero_class_10a5_1794145975717.jpg\"\n                alt=\"T\341\272\255p th\341\273\203 L\341\273\233p 10A5 - THPT S\341\273\221 2 \304\220\341\273\251c Ph\341\273\225\"\n                className=\"w-full h-full object-cover object-center\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent\" />\n              \n              <div className=\"absolute bottom-3.5 left-4 right-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3 text-white\">\n                <div>\n                  <div className=\"flex items-center gap-2 text-xs font-bold text-amber-300\">\n                    <SparklesIcon className=\"w-3.5 h-3.5\" />\n                    <span>L\341\273\232P 10A5 \302\267 THPT S\341\273\220 2 \304\220\341\273\250C PH\341\273\224</span>\n                  </div>\n                  <h2 className=\"text-lg sm:text-xl font-extrabold tracking-tight mt-0.5\">\n                    H\341\273\207 Th\341\273\221ng N\341\273\201 N\341\272\277p &amp; Thi \304\220ua L\341\273\233p H\341\273\215c \360\237\216\257\n                  </h2>\n                  <p className=\"text-xs text-slate-200 mt-0.5 max-w-xl\">\n                    42 H\341\273\215c sinh \302\267 6 D\303\243y b\303\240n \302\267 \304\220o\303\240n k\341\272\277t - N\304\203ng \304\221\341\273\231ng - K\341\273\267 lu\341\272\255t - T\341\273\217a s\303\241ng\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    onClick={() => setIsLayoutEditorOpen(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs font-bold border border-white/30 transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <Move className=\"w-3.5 h-3.5 text-amber-300\" />\n                    <span>K\303\251o th\341\272\243 S\306\241 \304\221\341\273\223 \360\237\252\221</span>\n                  </button>\n\n                  <button\n                    onClick={() => setShowCadreModal(true)}\n                    className=\"px-3 py-1.5 rounded-xl bg-amber-500/80 hover:bg-amber-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-xs\"\n                  >\n                    <span>\360\237\221\221 Ban c\303\241n s\341\273\261</span>\n                  </button>\n                </div>\n              </div>"
