--text-muted	#565D66	#A2ABB6	Chữ phụ, chú thích
--accent	#2457D6	#7AA2F7	Trạng thái chọn, liên kết, vòng focus
--on-accent	#FFFFFF	#0B1220	Chữ trên nền màu nhấn
--primary	#15191E	#ECEFF3	Nền nút chính
--on-primary	#FFFFFF	#0E1114	Chữ trên nút chính
