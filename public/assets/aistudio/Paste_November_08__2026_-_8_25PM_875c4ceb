--surface	#FFFFFF	#161A1F	Thẻ, bảng thao tác, ô nhập
--surface-2	#EFEFEA	#1E242B	Ô ghế, vùng phụ, hàng so le
--border	#DEDDD6	#2B323A	Viền mảnh
